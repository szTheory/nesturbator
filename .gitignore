# Game and BIOS images never enter this repository. Licensed test ROMs are the
# one exception: each is listed in tests/roms/manifest.txt and added with
# `git add -f`, and scripts/hygiene.sh rejects any image that is not listed.
*.nes
*.fds
*.unf
*.unif
*.nsf
*.nsfe
*.sav
*.srm
*.state
/roms/
/bios/
/private/

# Local configuration and secrets
.env
.env.*
!.env.example

# Build output
/build/
/out/
/CMakeUserPresets.json
compile_commands.json

# GSD and agent state that is local to one machine
/.planning/state.json
/.planning/milestone.lock
/.planning/research/.cache/
/.gsd/
/.claude/worktrees/
/.claude/settings.local.json

# OS noise
.DS_Store
