cmake_minimum_required(VERSION 3.25)
# --bench checks (15-CONTEXT D-07). Inputs: -DRUNNER -DROM -DMODE=nohash|format
# [-DFRAMES=120] [-DSTATE=0|1]. Timings are never compared, only shapes (D-07).
if(NOT DEFINED FRAMES)
  set(FRAMES 120)
endif()
if(NOT DEFINED STATE)
  set(STATE 0)
endif()

function(run_runner out_var err_var rc_var)
  execute_process(COMMAND "${RUNNER}" ${ARGN}
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  string(REPLACE "\r" "" out "${out}")
  string(REPLACE "\r" "" err "${err}")
  set(${out_var} "${out}" PARENT_SCOPE)
  set(${err_var} "${err}" PARENT_SCOPE)
  set(${rc_var} "${rc}" PARENT_SCOPE)
endfunction()

if(MODE STREQUAL "nohash")
  run_runner(plain_out plain_err plain_rc --rom "${ROM}" --frames ${FRAMES}
    --hash-frame ${FRAMES} --hash-audio)
  run_runner(bench_out bench_err bench_rc --rom "${ROM}" --bench ${FRAMES}
    --hash-frame ${FRAMES} --hash-audio)
  run_runner(state_out state_err state_rc --rom "${ROM}" --bench ${FRAMES} --bench-state
    --hash-frame ${FRAMES} --hash-audio)
  if(NOT plain_rc EQUAL 0 OR NOT bench_rc EQUAL 0 OR NOT state_rc EQUAL 0)
    message(FATAL_ERROR "exit status: --frames ${plain_rc}, --bench ${bench_rc}, "
      "--bench-state ${state_rc}\n${bench_err}\n${state_err}")
  endif()
  if(NOT plain_out STREQUAL state_out)
    message(FATAL_ERROR "stdout differs\n--frames:\n${plain_out}\n--bench-state:\n${state_out}")
  endif()
  if(NOT plain_out STREQUAL bench_out)
    message(FATAL_ERROR "stdout differs\n--frames:\n${plain_out}\n--bench:\n${bench_out}")
  endif()
  if(NOT plain_out MATCHES "frame ${FRAMES} ticks ")
    message(FATAL_ERROR "no frame ${FRAMES} hash line in:\n${plain_out}")
  endif()
elseif(MODE STREQUAL "format")
  set(extra "")
  if(STATE EQUAL 1)
    set(extra --bench-state)
  endif()
  run_runner(out err rc --rom "${ROM}" --bench ${FRAMES} ${extra})
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "exit status ${rc}\n${err}")
  endif()
  set(us "[0-9]+\\.[0-9][0-9][0-9]")
  set(series "p50=${us} p90=${us} p99=${us} p99\\.9=${us} max=${us}")
  set(want
    "^nesturbator-run: bench frames=${FRAMES} time_ms=${us} fps=[0-9]+\\.[0-9][0-9]$"
    "^nesturbator-run: bench frame_us ${series}$")
  if(STATE EQUAL 1)
    list(APPEND want
      "^nesturbator-run: bench save_us ${series}$"
      "^nesturbator-run: bench load_us ${series}$")
  endif()
  string(REGEX REPLACE "\n$" "" err "${err}")
  string(REPLACE "\n" ";" lines "${err}")
  list(LENGTH lines n_lines)
  list(LENGTH want n_want)
  if(NOT n_lines EQUAL n_want)
    message(FATAL_ERROR "expected ${n_want} stderr lines, got ${n_lines}:\n${err}")
  endif()
  set(i 0)
  foreach(re IN LISTS want)
    list(GET lines ${i} line)
    if(NOT line MATCHES "${re}")
      message(FATAL_ERROR "stderr line does not match ${re}:\n${line}")
    endif()
    math(EXPR i "${i} + 1")
  endforeach()
  if(NOT out STREQUAL "")
    message(FATAL_ERROR "stdout must be empty without --hash-frame, got:\n${out}")
  endif()
else()
  message(FATAL_ERROR "MODE must be nohash or format")
endif()
