cmake_minimum_required(VERSION 3.25)

set(release_push_guard
  "github.event_name != 'push' || github.ref != 'refs/heads/main' || github.workflow != 'CI' || !startsWith(github.event.head_commit.message, 'chore(main): release ')")
set(perf_guard
  "(${release_push_guard}) && (github.event_name == 'pull_request' || (github.event_name == 'workflow_dispatch' && inputs.control))")
set(required_guard "always() && (${release_push_guard})")
set(nightly_pr_guard
  "github.event_name != 'pull_request' || github.event.pull_request.user.login != 'nesturbator-release[bot]' || !startsWith(github.event.pull_request.title, 'chore(main): release ')")

function(strip_yaml_comments text out)
  string(REPLACE "\r\n" "\n" text "${text}")
  set(clean "")
  set(rest "${text}")
  while(NOT rest STREQUAL "")
    string(FIND "${rest}" "\n" newline_position)
    if(newline_position LESS 0)
      set(line "${rest}")
      set(rest "")
      set(has_newline FALSE)
    else()
      string(SUBSTRING "${rest}" 0 ${newline_position} line)
      math(EXPR next_position "${newline_position} + 1")
      string(SUBSTRING "${rest}" ${next_position} -1 rest)
      set(has_newline TRUE)
    endif()
    string(FIND "${line}" "#" hash_position)
    if(hash_position EQUAL 0)
      set(line "")
    elseif(hash_position GREATER 0)
      math(EXPR before_hash "${hash_position} - 1")
      string(SUBSTRING "${line}" ${before_hash} 1 before_hash_char)
      if(before_hash_char MATCHES "[ \t]")
        string(SUBSTRING "${line}" 0 ${hash_position} line)
      endif()
    endif()
    string(APPEND clean "${line}")
    if(has_newline)
      string(APPEND clean "\n")
    endif()
  endwhile()
  set(${out} "${clean}" PARENT_SCOPE)
endfunction()

function(extract_jobs workflow prefix out_names)
  string(FIND "${workflow}" "\njobs:\n" jobs_marker)
  if(jobs_marker LESS 0)
    set(${out_names} "" PARENT_SCOPE)
    return()
  endif()
  math(EXPR jobs_start "${jobs_marker} + 7")
  string(SUBSTRING "${workflow}" ${jobs_start} -1 jobs_text)
  set(jobs_text "\n${jobs_text}")
  string(REGEX MATCHALL "\n  [A-Za-z0-9_-]+:\n" headers "${jobs_text}")
  set(names "")
  foreach(header IN LISTS headers)
    string(REGEX REPLACE "^\n  |:\n$" "" id "${header}")
    string(FIND "${jobs_text}" "${header}" header_position)
    string(LENGTH "${header}" header_length)
    math(EXPR body_position "${header_position} + ${header_length}")
    string(SUBSTRING "${jobs_text}" ${body_position} -1 tail)
    string(REGEX MATCH "\n  [A-Za-z0-9_-]+:\n" next_header "${tail}")
    if(next_header STREQUAL "")
      set(job_text "\n${tail}")
    else()
      string(FIND "${tail}" "${next_header}" next_position)
      string(SUBSTRING "${tail}" 0 ${next_position} job_text)
      set(job_text "\n${job_text}")
    endif()
    list(APPEND names "${id}")
    set("${prefix}_${id}" "${job_text}" PARENT_SCOPE)
  endforeach()
  set(${out_names} "${names}" PARENT_SCOPE)
endfunction()

function(job_if job_text out)
  string(REGEX MATCH "\n    if: >-[ \t]*\n(      [^\n]*(\n      [^\n]*)*)" folded "${job_text}")
  if(NOT folded STREQUAL "")
    string(REGEX REPLACE "^\n    if: >-[ \t]*\n" "" expression "${folded}")
    string(REPLACE "\n      " " " expression "${expression}")
  else()
    string(REGEX MATCH "\n    if: ([^\n]+)" inline "${job_text}")
    if(inline STREQUAL "")
      set(expression "")
    else()
      set(expression "${CMAKE_MATCH_1}")
    endif()
  endif()
  string(STRIP "${expression}" expression)
  string(REGEX REPLACE "[ \t\r\n]+" " " expression "${expression}")
  set(${out} "${expression}" PARENT_SCOPE)
endfunction()

function(require_fragment text fragment label out_error)
  string(FIND "${text}" "${fragment}" position)
  if(position LESS 0)
    set(${out_error} "${label}: missing required live contract '${fragment}'\n" PARENT_SCOPE)
  else()
    set(${out_error} "" PARENT_SCOPE)
  endif()
endfunction()

function(check_policy ci_source release_source nightly_source out_errors)
  set(errors "")
  strip_yaml_comments("${ci_source}" ci)
  strip_yaml_comments("${release_source}" release)
  strip_yaml_comments("${nightly_source}" nightly)

  if(NOT ci MATCHES "(^|\n)name: CI(\n|$)")
    string(APPEND errors "ci-workflow-name: expected workflow name CI\n")
  endif()
  foreach(trigger IN ITEMS
      "  pull_request:\n"
      "  push:\n    branches: [main]"
      "  workflow_dispatch:\n"
      "  workflow_call:\n")
    require_fragment("${ci}" "${trigger}" "ci-triggers" missing)
    string(APPEND errors "${missing}")
  endforeach()

  extract_jobs("${ci}" ci_job ci_jobs)
  if(NOT ci_jobs)
    string(APPEND errors "ci-jobs: cannot find jobs in .github/workflows/ci.yml\n")
  endif()
  if(NOT "ci-required" IN_LIST ci_jobs OR NOT "perf" IN_LIST ci_jobs)
    string(APPEND errors "ci-jobs: perf and ci-required jobs must remain present\n")
  endif()
  foreach(job IN LISTS ci_jobs)
    job_if("${ci_job_${job}}" expression)
    if(job STREQUAL "perf")
      set(expected "${perf_guard}")
    elseif(job STREQUAL "ci-required")
      set(expected "${required_guard}")
    else()
      set(expected "${release_push_guard}")
    endif()
    if(NOT expression STREQUAL expected)
      string(APPEND errors "ci-job-guard: ${job} must own the canonical direct-release-push guard (got '${expression}')\n")
    endif()
  endforeach()

  foreach(platform IN ITEMS
      "runner: ubuntu-24.04, preset: ci, workflow: ci-build, os: linux, arch: x64"
      "runner: ubuntu-24.04-arm, preset: ci, workflow: ci-build, os: linux, arch: arm64"
      "runner: macos-15, preset: ci, workflow: ci-build, os: macos, arch: arm64"
      "runner: macos-15-intel, preset: ci, workflow: ci-build, os: macos, arch: x64"
      "runner: windows-2025, preset: ci-msvc, os: windows, arch: x64"
      "runner: windows-11-arm, preset: ci-msvc, os: windows, arch: arm64")
    require_fragment("${ci}" "${platform}" "ci-build-matrix" missing)
    string(APPEND errors "${missing}")
  endforeach()
  foreach(fragment IN ITEMS
      "name: archives-\${{ matrix.os }}-\${{ matrix.arch }}"
      "path: build/\${{ matrix.preset }}/packages/*.zip"
      "name: hashes-\${{ matrix.os }}-\${{ matrix.arch }}"
      "path: build/\${{ matrix.preset }}/tests/hashes.txt"
      "needs: [hygiene, title, vector-inventory, session-controls, build, asan, nofp, hash-equality, retroarch-e2e, perf]"
      "run: echo \"\$NEEDS\" | jq -e --arg event \"\$EVENT\" 'to_entries | all(.value.result == \"success\" or (.key == \"perf\" and .value.result == \"skipped\" and \$event != \"pull_request\"))'")
    require_fragment("${ci}" "${fragment}" "ci-required-and-artifacts" missing)
    string(APPEND errors "${missing}")
  endforeach()
  foreach(fragment IN ITEMS
      "  ci:\n    needs: release-please\n    if: needs.release-please.outputs.release_created == 'true'\n    uses: ./.github/workflows/ci.yml"
      "  publish:\n    needs: [release-please, ci]\n    if: needs.release-please.outputs.release_created == 'true'"
      "pattern: archives-*"
      "name: Exactly the 18 archives"
      "name: Write SHA256SUMS"
      "uses: actions/attest@"
      "gh attestation verify \"$zip\" --repo \"$GITHUB_REPOSITORY\""
      "gh attestation verify \"$copy\" --repo \"$GITHUB_REPOSITORY\"")
    require_fragment("${release}" "${fragment}" "release-validation-and-publication" missing)
    string(APPEND errors "${missing}")
  endforeach()

  require_fragment("${nightly}" "name: Nightly" "nightly-workflow-name" missing)
  string(APPEND errors "${missing}")
  require_fragment("${nightly}" "  push:\n    branches: [main]" "nightly-push-trigger" missing)
  string(APPEND errors "${missing}")
  extract_jobs("${nightly}" nightly_job nightly_jobs)
  foreach(job IN ITEMS vectors-full mmc3-oracle rom-loader-fuzz state-fuzz execution-fuzz suite-flake session-controls)
    if(NOT job IN_LIST nightly_jobs)
      string(APPEND errors "nightly-release-pr-control: missing generated-PR lane ${job}\n")
    else()
      job_if("${nightly_job_${job}}" expression)
      if(NOT expression STREQUAL nightly_pr_guard)
        string(APPEND errors "nightly-release-pr-control: ${job} must skip only generated release PRs\n")
      endif()
    endif()
  endforeach()
  if("report" IN_LIST nightly_jobs)
    job_if("${nightly_job_report}" expression)
    if(NOT expression STREQUAL "always() && (github.event_name == 'schedule' || (github.event_name == 'push' && github.ref == 'refs/heads/main'))")
      string(APPEND errors "nightly-report-control: report must keep scheduled and main-push reporting\n")
    endif()
  else()
    string(APPEND errors "nightly-report-control: report job is required\n")
  endif()
  if(nightly MATCHES "github.event_name != 'push'")
    string(APPEND errors "nightly-push-skip: Nightly may not add a main-push skip\n")
  endif()

  set(${out_errors} "${errors}" PARENT_SCOPE)
endfunction()

if(NOT DEFINED ROOT)
  message(FATAL_ERROR "ci_release_push_policy: pass -DROOT=<repository root>")
endif()

file(READ "${ROOT}/.github/workflows/ci.yml" ci_source)
file(READ "${ROOT}/.github/workflows/release.yml" release_source)
file(READ "${ROOT}/.github/workflows/nightly.yml" nightly_source)
check_policy("${ci_source}" "${release_source}" "${nightly_source}" errors)
if(NOT errors STREQUAL "")
  message(FATAL_ERROR "ci_release_push_policy:\n${errors}")
endif()
message(STATUS "ci_release_push_policy: caller routing, required gate, release publication, and Nightly are preserved")
