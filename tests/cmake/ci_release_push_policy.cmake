cmake_minimum_required(VERSION 3.25)

set(release_push_guard
  "github.event_name != 'push' || github.ref != 'refs/heads/main' || github.workflow != 'CI' || !startsWith(github.event.head_commit.message, 'chore(main): release ')")
set(perf_guard
  "(${release_push_guard}) && (github.event_name == 'pull_request' || (github.event_name == 'workflow_dispatch' && inputs.control))")
set(required_guard "always() && (${release_push_guard})")
set(nightly_pr_guard
  "github.event_name != 'pull_request' || github.event.pull_request.user.login != 'nesturbator-release[bot]' || !startsWith(github.event.pull_request.title, 'chore(main): release ')")

function(strip_yaml_comments text out)
  string(REPLACE "\r\n" "\n" text "${text}")
  set(clean "")
  set(rest "${text}")
  while(NOT rest STREQUAL "")
    string(FIND "${rest}" "\n" newline_position)
    if(newline_position LESS 0)
      set(line "${rest}")
      set(rest "")
      set(has_newline FALSE)
    else()
      string(SUBSTRING "${rest}" 0 ${newline_position} line)
      math(EXPR next_position "${newline_position} + 1")
      string(SUBSTRING "${rest}" ${next_position} -1 rest)
      set(has_newline TRUE)
    endif()
    string(FIND "${line}" "#" hash_position)
    if(hash_position EQUAL 0)
      set(line "")
    elseif(hash_position GREATER 0)
      math(EXPR before_hash "${hash_position} - 1")
      string(SUBSTRING "${line}" ${before_hash} 1 before_hash_char)
      if(before_hash_char MATCHES "[ \t]")
        string(SUBSTRING "${line}" 0 ${hash_position} line)
      endif()
    endif()
    string(APPEND clean "${line}")
    if(has_newline)
      string(APPEND clean "\n")
    endif()
  endwhile()
  set(${out} "${clean}" PARENT_SCOPE)
endfunction()

function(extract_jobs workflow prefix out_names)
  string(FIND "${workflow}" "\njobs:\n" jobs_marker)
  if(jobs_marker LESS 0)
    set(${out_names} "" PARENT_SCOPE)
    return()
  endif()
  math(EXPR jobs_start "${jobs_marker} + 7")
  string(SUBSTRING "${workflow}" ${jobs_start} -1 jobs_text)
  set(jobs_text "\n${jobs_text}")
  string(REGEX MATCHALL "\n  [A-Za-z0-9_-]+:\n" headers "${jobs_text}")
  set(names "")
  foreach(header IN LISTS headers)
    string(REGEX REPLACE "^\n  |:\n$" "" id "${header}")
    string(FIND "${jobs_text}" "${header}" header_position)
    string(LENGTH "${header}" header_length)
    math(EXPR body_position "${header_position} + ${header_length}")
    string(SUBSTRING "${jobs_text}" ${body_position} -1 tail)
    string(REGEX MATCH "\n  [A-Za-z0-9_-]+:\n" next_header "${tail}")
    if(next_header STREQUAL "")
      set(job_text "\n${tail}")
    else()
      string(FIND "${tail}" "${next_header}" next_position)
      string(SUBSTRING "${tail}" 0 ${next_position} job_text)
      set(job_text "\n${job_text}")
    endif()
    list(APPEND names "${id}")
    set("${prefix}_${id}" "${job_text}" PARENT_SCOPE)
  endforeach()
  set(${out_names} "${names}" PARENT_SCOPE)
endfunction()

function(job_if job_text out)
  string(REGEX MATCH "\n    if: >-[ \t]*\n(      [^\n]*(\n      [^\n]*)*)" folded "${job_text}")
  if(NOT folded STREQUAL "")
    string(REGEX REPLACE "^\n    if: >-[ \t]*\n" "" expression "${folded}")
    string(REPLACE "\n      " " " expression "${expression}")
  else()
    string(REGEX MATCH "\n    if: ([^\n]+)" inline "${job_text}")
    if(inline STREQUAL "")
      set(expression "")
    else()
      set(expression "${CMAKE_MATCH_1}")
    endif()
  endif()
  string(STRIP "${expression}" expression)
  string(REGEX REPLACE "[ \t\r\n]+" " " expression "${expression}")
  set(${out} "${expression}" PARENT_SCOPE)
endfunction()

function(require_fragment text fragment label out_error)
  string(FIND "${text}" "${fragment}" position)
  if(position LESS 0)
    set(${out_error} "${label}: missing required live contract '${fragment}'\n" PARENT_SCOPE)
  else()
    set(${out_error} "" PARENT_SCOPE)
  endif()
endfunction()

function(check_policy ci_source release_source nightly_source out_errors)
  set(errors "")
  strip_yaml_comments("${ci_source}" ci)
  strip_yaml_comments("${release_source}" release)
  strip_yaml_comments("${nightly_source}" nightly)

  if(NOT ci MATCHES "(^|\n)name: CI(\n|$)")
    string(APPEND errors "ci-workflow-name: expected workflow name CI\n")
  endif()
  foreach(trigger IN ITEMS
      "  pull_request:\n"
      "  push:\n    branches: [main]"
      "  workflow_dispatch:\n"
      "  workflow_call:\n")
    require_fragment("${ci}" "${trigger}" "ci-triggers" missing)
    string(APPEND errors "${missing}")
  endforeach()

  extract_jobs("${ci}" ci_job ci_jobs)
  if(NOT ci_jobs)
    string(APPEND errors "ci-jobs: cannot find jobs in .github/workflows/ci.yml\n")
  endif()
  if(NOT "ci-required" IN_LIST ci_jobs OR NOT "perf" IN_LIST ci_jobs)
    string(APPEND errors "ci-jobs: perf and ci-required jobs must remain present\n")
  endif()
  foreach(job IN LISTS ci_jobs)
    job_if("${ci_job_${job}}" expression)
    if(job STREQUAL "perf")
      set(expected "${perf_guard}")
    elseif(job STREQUAL "ci-required")
      set(expected "${required_guard}")
    else()
      set(expected "${release_push_guard}")
    endif()
    if(NOT expression STREQUAL expected)
      string(APPEND errors "ci-job-guard: ${job} must own the canonical direct-release-push guard (got '${expression}')\n")
    endif()
  endforeach()

  foreach(platform IN ITEMS
      "runner: ubuntu-24.04, preset: ci, workflow: ci-build, os: linux, arch: x64"
      "runner: ubuntu-24.04-arm, preset: ci, workflow: ci-build, os: linux, arch: arm64"
      "runner: macos-15, preset: ci, workflow: ci-build, os: macos, arch: arm64"
      "runner: macos-15-intel, preset: ci, workflow: ci-build, os: macos, arch: x64"
      "runner: windows-2025, preset: ci-msvc, os: windows, arch: x64"
      "runner: windows-11-arm, preset: ci-msvc, os: windows, arch: arm64")
    require_fragment("${ci}" "${platform}" "ci-build-matrix" missing)
    string(APPEND errors "${missing}")
  endforeach()
  foreach(fragment IN ITEMS
      "name: archives-\${{ matrix.os }}-\${{ matrix.arch }}"
      "path: build/\${{ matrix.preset }}/packages/*.zip"
      "name: hashes-\${{ matrix.os }}-\${{ matrix.arch }}"
      "path: build/\${{ matrix.preset }}/tests/hashes.txt"
      "needs: [hygiene, title, vector-inventory, session-controls, build, asan, nofp, hash-equality, retroarch-e2e, perf]"
      "run: echo \"\$NEEDS\" | jq -e --arg event \"\$EVENT\" 'to_entries | all(.value.result == \"success\" or (.key == \"perf\" and .value.result == \"skipped\" and \$event != \"pull_request\"))'")
    require_fragment("${ci}" "${fragment}" "ci-required-and-artifacts" missing)
    string(APPEND errors "${missing}")
  endforeach()
  foreach(fragment IN ITEMS
      "  ci:\n    needs: release-please\n    if: needs.release-please.outputs.release_created == 'true'\n    uses: ./.github/workflows/ci.yml"
      "  publish:\n    needs: [release-please, ci]\n    if: needs.release-please.outputs.release_created == 'true'"
      "pattern: archives-*"
      "name: Exactly the 18 archives"
      "name: Write SHA256SUMS"
      "uses: actions/attest@"
      "gh attestation verify \"$zip\" --repo \"$GITHUB_REPOSITORY\""
      "gh attestation verify \"$copy\" --repo \"$GITHUB_REPOSITORY\"")
    require_fragment("${release}" "${fragment}" "release-validation-and-publication" missing)
    string(APPEND errors "${missing}")
  endforeach()

  require_fragment("${nightly}" "name: Nightly" "nightly-workflow-name" missing)
  string(APPEND errors "${missing}")
  require_fragment("${nightly}" "  push:\n    branches: [main]" "nightly-push-trigger" missing)
  string(APPEND errors "${missing}")
  extract_jobs("${nightly}" nightly_job nightly_jobs)
  foreach(job IN ITEMS vectors-full mmc3-oracle rom-loader-fuzz state-fuzz execution-fuzz suite-flake session-controls)
    if(NOT job IN_LIST nightly_jobs)
      string(APPEND errors "nightly-release-pr-control: missing generated-PR lane ${job}\n")
    else()
      job_if("${nightly_job_${job}}" expression)
      if(NOT expression STREQUAL nightly_pr_guard)
        string(APPEND errors "nightly-release-pr-control: ${job} must skip only generated release PRs\n")
      endif()
    endif()
  endforeach()
  if("report" IN_LIST nightly_jobs)
    job_if("${nightly_job_report}" expression)
    if(NOT expression STREQUAL "always() && (github.event_name == 'schedule' || (github.event_name == 'push' && github.ref == 'refs/heads/main'))")
      string(APPEND errors "nightly-report-control: report must keep scheduled and main-push reporting\n")
    endif()
  else()
    string(APPEND errors "nightly-report-control: report job is required\n")
  endif()
  if(nightly MATCHES "github.event_name != 'push'")
    string(APPEND errors "nightly-push-skip: Nightly may not add a main-push skip\n")
  endif()

  set(${out_errors} "${errors}" PARENT_SCOPE)
endfunction()

function(classify_release_push expression event_name ref workflow head_present message out_skip out_error)
  if(NOT "${expression}" STREQUAL "${release_push_guard}")
    set(${out_skip} FALSE PARENT_SCOPE)
    set(${out_error} "unsupported release-push expression: ${expression}" PARENT_SCOPE)
    return()
  endif()
  set(skip FALSE)
  if(event_name STREQUAL "push" AND ref STREQUAL "refs/heads/main" AND
     workflow STREQUAL "CI" AND head_present)
    string(FIND "${message}" "chore(main): release " title_prefix)
    if(title_prefix EQUAL 0)
      set(skip TRUE)
    endif()
  endif()
  set(${out_skip} "${skip}" PARENT_SCOPE)
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(classify_perf expression event_name ref workflow head_present message control out_run out_error)
  if(NOT "${expression}" STREQUAL "${perf_guard}")
    set(${out_run} FALSE PARENT_SCOPE)
    set(${out_error} "unsupported perf expression: ${expression}" PARENT_SCOPE)
    return()
  endif()
  classify_release_push("${release_push_guard}" "${event_name}" "${ref}" "${workflow}"
    "${head_present}" "${message}" release_skip error)
  if(NOT error STREQUAL "")
    set(${out_run} FALSE PARENT_SCOPE)
    set(${out_error} "${error}" PARENT_SCOPE)
    return()
  endif()
  set(eligible FALSE)
  if(event_name STREQUAL "pull_request" OR
     (event_name STREQUAL "workflow_dispatch" AND control))
    set(eligible TRUE)
  endif()
  if(eligible AND NOT release_skip)
    set(run TRUE)
  else()
    set(run FALSE)
  endif()
  set(${out_run} "${run}" PARENT_SCOPE)
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(remove_if_field body out)
  set(rest "${body}")
  set(clean "")
  set(in_if FALSE)
  while(NOT rest STREQUAL "")
    string(FIND "${rest}" "\n" newline_position)
    if(newline_position LESS 0)
      set(line "${rest}")
      set(rest "")
      set(has_newline FALSE)
    else()
      string(SUBSTRING "${rest}" 0 ${newline_position} line)
      math(EXPR next_position "${newline_position} + 1")
      string(SUBSTRING "${rest}" ${next_position} -1 rest)
      set(has_newline TRUE)
    endif()
    if(in_if)
      if(line MATCHES "^      ")
        continue()
      endif()
      set(in_if FALSE)
    endif()
    if(line MATCHES "^    if:")
      if(line MATCHES "^    if: >-")
        set(in_if TRUE)
      endif()
      continue()
    endif()
    string(APPEND clean "${line}")
    if(has_newline)
      string(APPEND clean "\n")
    endif()
  endwhile()
  set(${out} "${clean}" PARENT_SCOPE)
endfunction()

function(replace_job_if workflow job new_if out)
  set(header "\n  ${job}:\n")
  string(FIND "${workflow}" "${header}" header_position)
  if(header_position LESS 0)
    set(${out} "${workflow}" PARENT_SCOPE)
    return()
  endif()
  string(LENGTH "${header}" header_length)
  math(EXPR body_start "${header_position} + ${header_length}")
  string(SUBSTRING "${workflow}" 0 ${header_position} prefix)
  string(SUBSTRING "${workflow}" ${body_start} -1 tail)
  string(REGEX MATCH "\n  [A-Za-z0-9_-]+:\n" next_header "${tail}")
  if(next_header STREQUAL "")
    set(body "${tail}")
    set(suffix "")
  else()
    string(FIND "${tail}" "${next_header}" next_position)
    string(SUBSTRING "${tail}" 0 ${next_position} body)
    string(SUBSTRING "${tail}" ${next_position} -1 suffix)
  endif()
  remove_if_field("${body}" clean_body)
  if(NOT new_if STREQUAL "")
    set(clean_body "${new_if}\n${clean_body}")
  endif()
  set(${out} "${prefix}${header}${clean_body}${suffix}" PARENT_SCOPE)
endfunction()

function(expect_rejected label original_ci mutated_ci release nightly expected_reason)
  if("${mutated_ci}" STREQUAL "${original_ci}")
    message(FATAL_ERROR "ci_release_push_policy self-test mutation ${label} changed nothing")
  endif()
  check_policy("${mutated_ci}" "${release}" "${nightly}" errors)
  if(errors STREQUAL "")
    message(FATAL_ERROR "ci_release_push_policy self-test accepted ${label}")
  endif()
  string(FIND "${errors}" "${expected_reason}" reason_position)
  if(reason_position LESS 0)
    message(FATAL_ERROR "ci_release_push_policy self-test ${label} failed for the wrong reason:\n${errors}")
  endif()
endfunction()

function(expect_rejected_nightly label original_ci release original_nightly mutated_nightly expected_reason)
  if("${mutated_nightly}" STREQUAL "${original_nightly}")
    message(FATAL_ERROR "ci_release_push_policy self-test mutation ${label} changed nothing")
  endif()
  check_policy("${original_ci}" "${release}" "${mutated_nightly}" errors)
  if(errors STREQUAL "")
    message(FATAL_ERROR "ci_release_push_policy self-test accepted ${label}")
  endif()
  string(FIND "${errors}" "${expected_reason}" reason_position)
  if(reason_position LESS 0)
    message(FATAL_ERROR "ci_release_push_policy self-test ${label} failed for the wrong reason:\n${errors}")
  endif()
endfunction()

function(expect_rejected_release label ci original_release mutated_release nightly expected_reason)
  if("${mutated_release}" STREQUAL "${original_release}")
    message(FATAL_ERROR "ci_release_push_policy self-test mutation ${label} changed nothing")
  endif()
  check_policy("${ci}" "${mutated_release}" "${nightly}" errors)
  if(errors STREQUAL "")
    message(FATAL_ERROR "ci_release_push_policy self-test accepted ${label}")
  endif()
  string(FIND "${errors}" "${expected_reason}" reason_position)
  if(reason_position LESS 0)
    message(FATAL_ERROR "ci_release_push_policy self-test ${label} failed for the wrong reason:\n${errors}")
  endif()
endfunction()

function(check_input_case name expression event_name ref workflow head_present message want_skip)
  classify_release_push("${expression}" "${event_name}" "${ref}" "${workflow}"
    "${head_present}" "${message}" actual_skip error)
  if(NOT error STREQUAL "")
    message(FATAL_ERROR "ci_release_push_policy self-test ${name}: ${error}")
  endif()
  if(NOT "${actual_skip}" STREQUAL "${want_skip}")
    message(FATAL_ERROR "ci_release_push_policy self-test ${name}: skip=${actual_skip}, expected ${want_skip}")
  endif()
endfunction()

function(run_selftest ci_source release_source nightly_source)
  check_policy("${ci_source}" "${release_source}" "${nightly_source}" errors)
  if(NOT errors STREQUAL "")
    message(FATAL_ERROR "ci_release_push_policy self-test: current workflows rejected:\n${errors}")
  endif()
  strip_yaml_comments("${ci_source}" ci)
  extract_jobs("${ci}" ci_job ci_jobs)
  foreach(job IN LISTS ci_jobs)
    job_if("${ci_job_${job}}" expression)
    if(job STREQUAL "perf")
      set(component_guard "${expression}")
    elseif(job STREQUAL "ci-required")
      set(component_guard "${expression}")
      if(NOT component_guard STREQUAL required_guard)
        message(FATAL_ERROR "ci_release_push_policy self-test: ci-required guard is not the pinned expression")
      endif()
      set(component_guard "${release_push_guard}")
    else()
      set(component_guard "${expression}")
    endif()
    if(job STREQUAL "perf" AND NOT expression STREQUAL perf_guard)
      message(FATAL_ERROR "ci_release_push_policy self-test: perf guard is not the pinned expression")
    endif()
    if(job STREQUAL "perf")
      set(component_guard "${release_push_guard}")
    endif()
    if(NOT component_guard STREQUAL release_push_guard)
      message(FATAL_ERROR "ci_release_push_policy self-test: ${job} has no supported release-push predicate")
    endif()
    set("component_${job}" "${component_guard}")
  endforeach()

  set(event_cases
    direct-release
    release-caller
    ordinary-main-push
    phrase-not-at-start
    missing-head-commit
    matching-title-pr
    matching-title-dispatch
    other-ref
    release-squash-notes)
  set(case_direct-release "push|refs/heads/main|CI|TRUE|chore(main): release 0.1.13|TRUE")
  set(case_release-caller "push|refs/heads/main|Release|TRUE|chore(main): release 0.1.13|FALSE")
  set(case_ordinary-main-push "push|refs/heads/main|CI|TRUE|feat: document controls|FALSE")
  set(case_phrase-not-at-start "push|refs/heads/main|CI|TRUE|prefix chore(main): release 0.1.13|FALSE")
  set(case_missing-head-commit "push|refs/heads/main|CI|FALSE||FALSE")
  set(case_matching-title-pr "pull_request|refs/pull/57/merge|CI|TRUE|chore(main): release 0.1.13|FALSE")
  set(case_matching-title-dispatch "workflow_dispatch|refs/heads/main|CI|TRUE|chore(main): release 0.1.13|FALSE")
  set(case_other-ref "push|refs/heads/feature/example|CI|TRUE|chore(main): release 0.1.13|FALSE")
  set(case_release-squash-notes "push|refs/heads/main|CI|TRUE|chore(main): release 0.1.13 (#57)\n\n## Release notes\n- Change details|TRUE")
  foreach(case IN LISTS event_cases)
    set(row "${case_${case}}")
    string(REPLACE "|" ";" fields "${row}")
    list(GET fields 0 event_name)
    list(GET fields 1 ref)
    list(GET fields 2 workflow)
    list(GET fields 3 head_present)
    list(GET fields 4 message)
    list(GET fields 5 want_skip)
    foreach(job IN LISTS ci_jobs)
      check_input_case("${case}/${job}" "${component_${job}}" "${event_name}" "${ref}" "${workflow}"
        "${head_present}" "${message}" "${want_skip}")
    endforeach()
  endforeach()

  classify_perf("${perf_guard}" pull_request refs/pull/57/merge CI TRUE
    "chore(main): release 0.1.13" FALSE perf_pr error)
  if(NOT error STREQUAL "" OR NOT perf_pr)
    message(FATAL_ERROR "ci_release_push_policy self-test: perf pull-request eligibility changed")
  endif()
  classify_perf("${perf_guard}" workflow_dispatch refs/heads/main CI TRUE
    "chore(main): release 0.1.13" TRUE perf_control error)
  if(NOT error STREQUAL "" OR NOT perf_control)
    message(FATAL_ERROR "ci_release_push_policy self-test: perf manual-control eligibility changed")
  endif()
  classify_perf("${perf_guard}" workflow_dispatch refs/heads/main CI TRUE
    "chore(main): release 0.1.13" FALSE perf_no_control error)
  if(NOT error STREQUAL "" OR perf_no_control)
    message(FATAL_ERROR "ci_release_push_policy self-test: perf ran without manual control")
  endif()
  classify_perf("${perf_guard}" push refs/heads/main Release TRUE
    "chore(main): release 0.1.13" FALSE perf_release_call error)
  if(NOT error STREQUAL "" OR perf_release_call)
    message(FATAL_ERROR "ci_release_push_policy self-test: Release perf skip eligibility changed")
  endif()
  classify_release_push("${release_push_guard} || true" push refs/heads/main CI TRUE
    "chore(main): release 0.1.13" unsupported_skip error)
  if(error STREQUAL "")
    message(FATAL_ERROR "ci_release_push_policy self-test: unsupported expression syntax was evaluated")
  endif()

  foreach(job IN LISTS ci_jobs)
    set(mutated_ci "${ci_source}")
    if(job STREQUAL "perf")
      replace_job_if("${mutated_ci}" perf
        "    if: github.event_name == 'pull_request' || (github.event_name == 'workflow_dispatch' && inputs.control)"
        mutated_ci)
    elseif(job STREQUAL "ci-required")
      replace_job_if("${mutated_ci}" ci-required "    if: always()" mutated_ci)
    else()
      replace_job_if("${mutated_ci}" "${job}" "" mutated_ci)
    endif()
    expect_rejected("remove ${job} guard" "${ci_source}" "${mutated_ci}" "${release_source}" "${nightly_source}"
      "ci-job-guard: ${job}")
  endforeach()

  set(mutated_ci "${ci_source}")
  string(REPLACE "github.workflow != 'CI' ||" "github.workflow != 'Release' ||" mutated_ci "${mutated_ci}")
  expect_rejected("caller distinction" "${ci_source}" "${mutated_ci}" "${release_source}" "${nightly_source}" "ci-job-guard:")
  set(mutated_ci "${ci_source}")
  string(REPLACE "github.event_name != 'push' ||" "" mutated_ci "${mutated_ci}")
  expect_rejected("event limitation" "${ci_source}" "${mutated_ci}" "${release_source}" "${nightly_source}" "ci-job-guard:")
  set(mutated_ci "${ci_source}")
  string(REPLACE "github.ref != 'refs/heads/main' ||" "" mutated_ci "${mutated_ci}")
  expect_rejected("main-ref limitation" "${ci_source}" "${mutated_ci}" "${release_source}" "${nightly_source}" "ci-job-guard:")
  set(mutated_ci "${ci_source}")
  string(REPLACE
    [=[!startsWith(github.event.head_commit.message, 'chore(main): release ')]=]
    [=[contains(github.event.head_commit.message, 'chore(main): release ')]=]
    mutated_ci "${mutated_ci}")
  expect_rejected("broad title match" "${ci_source}" "${mutated_ci}" "${release_source}" "${nightly_source}" "ci-job-guard:")
  set(mutated_ci "${ci_source}")
  replace_job_if("${mutated_ci}" perf "    if: >-\n      ${release_push_guard}" mutated_ci)
  expect_rejected("perf eligibility overwrite" "${ci_source}" "${mutated_ci}" "${release_source}" "${nightly_source}" "ci-job-guard: perf")
  set(mutated_ci "${ci_source}")
  string(REPLACE "always() &&" "success() &&" mutated_ci "${mutated_ci}")
  expect_rejected("required always removal" "${ci_source}" "${mutated_ci}" "${release_source}" "${nightly_source}" "ci-job-guard: ci-required")
  set(mutated_ci "${ci_source}")
  string(REPLACE
    [=[all(.value.result == "success" or (.key == "perf" and .value.result == "skipped" and $event != "pull_request"))]=]
    [=[all(.value.result == "success" or (.key == "build" and .value.result == "skipped") or (.key == "perf" and .value.result == "skipped" and $event != "pull_request"))]=]
    mutated_ci "${mutated_ci}")
  expect_rejected("skipped build accepted" "${ci_source}" "${mutated_ci}" "${release_source}" "${nightly_source}" "ci-required-and-artifacts")
  set(mutated_ci "${ci_source}")
  string(REPLACE "  workflow_call:\n" "" mutated_ci "${mutated_ci}")
  expect_rejected("workflow_call removed" "${ci_source}" "${mutated_ci}" "${release_source}" "${nightly_source}" "ci-triggers")
  set(mutated_ci "${ci_source}")
  replace_job_if("${mutated_ci}" hygiene "" mutated_ci)
  string(APPEND mutated_ci "\n# github.event_name != 'push' || github.ref != 'refs/heads/main' || github.workflow != 'CI'\n")
  expect_rejected("comment fakes job guard" "${ci_source}" "${mutated_ci}" "${release_source}" "${nightly_source}" "ci-job-guard: hygiene")
  set(mutated_ci "${ci_source}")
  string(REPLACE "  workflow_call:\n" "" mutated_ci "${mutated_ci}")
  string(APPEND mutated_ci "\n#   workflow_call:\n")
  expect_rejected("comment fakes workflow_call" "${ci_source}" "${mutated_ci}" "${release_source}" "${nightly_source}" "ci-triggers")

  set(mutated_release "${release_source}")
  string(REPLACE "uses: ./.github/workflows/ci.yml" "uses: ./.github/workflows/other.yml" mutated_release "${mutated_release}")
  expect_rejected_release("Release reusable CI removed" "${ci_source}" "${release_source}"
    "${mutated_release}" "${nightly_source}" "release-validation-and-publication")
  set(mutated_release "${release_source}")
  string(REPLACE "needs: [release-please, ci]" "needs: release-please" mutated_release "${mutated_release}")
  expect_rejected_release("publish CI dependency removed" "${ci_source}" "${release_source}"
    "${mutated_release}" "${nightly_source}" "release-validation-and-publication")
  set(mutated_release "${release_source}")
  replace_job_if("${mutated_release}" publish "" mutated_release)
  expect_rejected_release("publish release condition removed" "${ci_source}" "${release_source}"
    "${mutated_release}" "${nightly_source}" "release-validation-and-publication")
  set(mutated_ci "${ci_source}")
  string(REPLACE "path: build/\${{ matrix.preset }}/packages/*.zip" "path: build/wrong/packages/*.zip" mutated_ci "${mutated_ci}")
  expect_rejected("archive path changed" "${ci_source}" "${mutated_ci}" "${release_source}" "${nightly_source}" "ci-required-and-artifacts")

  set(mutated_nightly "${nightly_source}")
  string(REPLACE "github.event_name != 'pull_request' ||" "github.event_name != 'push' ||" mutated_nightly "${mutated_nightly}")
  expect_rejected_nightly("Nightly skips main pushes" "${ci_source}" "${release_source}" "${nightly_source}"
    "${mutated_nightly}" "nightly-release-pr-control")

  message(STATUS "ci_release_push_policy: event controls and all routing/release mutation checks passed")
endfunction()

