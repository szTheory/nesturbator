# Numeric-only release updates must preserve the public header's formatting.
# CI checks the guard contract; hygiene also formats full-header mutations.
cmake_minimum_required(VERSION 3.25)

if(NOT DEFINED SOURCE_DIR OR NOT DEFINED WORK)
  message(FATAL_ERROR "release_version_format: pass SOURCE_DIR and WORK")
endif()
file(READ "${SOURCE_DIR}/include/nesturbator.h" header)

function(validate text result)
  set(lines "")
  foreach(component MAJOR MINOR PATCH)
    string(TOLOWER "${component}" lower)
    string(REGEX MATCHALL "\n#define NESTURBATOR_VERSION_${component}[^\n]*" matches "${text}")
    list(LENGTH matches count)
    if(NOT count EQUAL 1)
      set(${result} "expected one ${component} macro" PARENT_SCOPE)
      return()
    endif()
    string(REGEX MATCHALL "x-release-please-${lower}" markers "${text}")
    list(LENGTH markers count)
    if(NOT count EQUAL 1 OR NOT matches MATCHES
        "^\n#define NESTURBATOR_VERSION_${component} [0-9]+ /\\* x-release-please-${lower} \\*/$")
      set(${result} "expected one inline ${component} marker" PARENT_SCOPE)
      return()
    endif()
    string(APPEND lines "${matches}")
  endforeach()
  string(FIND "${text}" "/* clang-format off */${lines}" start)
  if(start LESS 0)
    set(${result} "missing format-off guard before version macros" PARENT_SCOPE)
    return()
  endif()
  string(FIND "${text}" "${lines}\n/* clang-format on */" end)
  if(end LESS 0)
    set(${result} "format-on guard must immediately follow PATCH" PARENT_SCOPE)
    return()
  endif()
  set(${result} "" PARENT_SCOPE)
endfunction()

function(require_valid text)
  validate("${text}" problem)
  if(NOT problem STREQUAL "")
    message(FATAL_ERROR "release_version_format: ${problem}")
  endif()
endfunction()

function(require_rejected text expected)
  validate("${text}" problem)
  if(NOT problem STREQUAL expected)
    message(FATAL_ERROR "negative control: expected '${expected}', got '${problem}'")
  endif()
endfunction()

function(normalize text result)
  foreach(component MAJOR MINOR PATCH)
    string(REGEX REPLACE "(#define NESTURBATOR_VERSION_${component} )[0-9]+"
      "\\1<value>" text "${text}")
  endforeach()
  set(${result} "${text}" PARENT_SCOPE)
endfunction()

function(format text result)
  file(WRITE "${WORK}/mutation.h" "${text}")
  execute_process(COMMAND "${CLANG_FORMAT}"
    "--assume-filename=${SOURCE_DIR}/include/nesturbator.h"
    INPUT_FILE "${WORK}/mutation.h"
    OUTPUT_VARIABLE formatted ERROR_VARIABLE error RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "clang-format failed (${rc}): ${error}")
  endif()
  set(${result} "${formatted}" PARENT_SCOPE)
endfunction()

require_valid("${header}")
# Remove only the new guard, leaving the header's other formatting regions.
string(REGEX MATCH "/\\* clang-format off \\*/\n#define NESTURBATOR_VERSION_MAJOR[^\n]*\n#define NESTURBATOR_VERSION_MINOR[^\n]*\n#define NESTURBATOR_VERSION_PATCH[^\n]*\n/\\* clang-format on \\*/" block "${header}")
string(REPLACE "/* clang-format off */\n" "" no_off "${block}")
string(REPLACE "\n/* clang-format on */" "" no_on "${block}")
string(REPLACE "${block}" "${no_off}" bad "${header}")
require_rejected("${bad}" "missing format-off guard before version macros")
string(REPLACE "${block}" "${no_on}" bad "${header}")
require_rejected("${bad}" "format-on guard must immediately follow PATCH")
string(REPLACE "${block}" "${no_on}\n#define NESTURBATOR_ABI_VERSION 1\n/* clang-format on */" bad "${header}")
require_rejected("${bad}" "format-on guard must immediately follow PATCH")
foreach(component MAJOR MINOR PATCH)
  string(TOLOWER "${component}" lower)
  string(REPLACE "/* x-release-please-${lower} */" "" bad "${header}")
  require_rejected("${bad}" "expected one inline ${component} marker")
  set(bad "${header}\n#define NESTURBATOR_VERSION_${component} 1\n")
  require_rejected("${bad}" "expected one ${component} macro")
endforeach()

if(DEFINED CLANG_FORMAT)
  execute_process(COMMAND "${CLANG_FORMAT}" --version
    OUTPUT_VARIABLE version ERROR_VARIABLE error RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0 OR NOT version MATCHES "version 18\\.")
    message(FATAL_ERROR "release_version_format needs clang-format 18: ${version}${error}")
  endif()
  file(MAKE_DIRECTORY "${WORK}")
endif()

normalize("${header}" original)
foreach(case "0.1.9" "0.1.10" "0.1.99" "0.1.100"
    "9.9.10" "10.10.10" "99.99.100" "100.100.100")
  string(REPLACE "." ";" values "${case}")
  set(mutated "${header}")
  set(index 0)
  foreach(component MAJOR MINOR PATCH)
    list(GET values ${index} value)
    string(REGEX REPLACE "(#define NESTURBATOR_VERSION_${component} )[0-9]+"
      "\\1${value}" mutated "${mutated}")
    if(NOT mutated MATCHES "\n#define NESTURBATOR_VERSION_${component} ${value} ")
      message(FATAL_ERROR "mutation ${case}: wrong ${component} value")
    endif()
    math(EXPR index "${index} + 1")
  endforeach()
  require_valid("${mutated}")
  normalize("${mutated}" normalized)
  if(NOT normalized STREQUAL original)
    message(FATAL_ERROR "mutation ${case}: changed bytes outside version values")
  endif()
  if(DEFINED CLANG_FORMAT)
    format("${mutated}" formatted)
    if(NOT formatted STREQUAL mutated)
      message(FATAL_ERROR "mutation ${case}: clang-format changed header bytes")
    endif()
  endif()
endforeach()

if(DEFINED CLANG_FORMAT)
  string(REPLACE "/* clang-format off */\n" "" unguarded "${block}")
  string(REPLACE "\n/* clang-format on */" "" unguarded "${unguarded}")
  string(REPLACE "${block}" "${unguarded}" sensitive "${header}")
  string(REGEX REPLACE "(#define NESTURBATOR_VERSION_PATCH )[0-9]+"
    "\\110" sensitive "${sensitive}")
  format("${sensitive}" formatted)
  if(formatted STREQUAL sensitive)
    message(FATAL_ERROR "sensitivity control: unguarded PATCH 10 stayed formatted")
  endif()
endif()
message(STATUS "release_version_format: 8 numeric mutations and 9 negative controls passed")
