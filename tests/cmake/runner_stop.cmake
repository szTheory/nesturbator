# The runner.stop.* cases: nesturbator-run stopped by its own signal (--raise-after) on the
# synthetic cartridges from runner.save_rom.
#
#   cmake -DRUNNER=<nesturbator-run> -DFIXTURE=<runner.save_rom output dir>
#         -DWORK=<scratch dir, recreated> -DCASE=<case> -P runner_stop.cmake

cmake_minimum_required(VERSION 3.25)

foreach(var RUNNER FIXTURE WORK CASE)
  if(NOT DEFINED ${var} OR "${${var}}" STREQUAL "")
    message(FATAL_ERROR "runner_stop: -D${var}=... is required")
  endif()
endforeach()

file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")

# Runs the runner with ARGN; sets run_exit, run_out and run_err in the caller.
function(run_runner)
  execute_process(COMMAND "${RUNNER}" ${ARGN}
    OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE rc)
  set(run_exit "${rc}" PARENT_SCOPE)
  set(run_out "${out}" PARENT_SCOPE)
  set(run_err "${err}" PARENT_SCOPE)
endfunction()

function(expect_exit want)
  if(NOT "${run_exit}" STREQUAL "${want}")
    message(FATAL_ERROR "runner_stop ${CASE}: exit ${run_exit}, wanted ${want}\n${run_err}")
  endif()
endfunction()

function(expect_absent path)
  if(EXISTS "${path}")
    message(FATAL_ERROR "runner_stop ${CASE}: ${path} must not exist")
  endif()
endfunction()

function(expect_stop_line n)
  string(FIND "${run_err}" "nesturbator-run: stopped by signal after frame ${n}\n" at)
  if(at LESS 0)
    message(FATAL_ERROR "runner_stop ${CASE}: no stop line for frame ${n} in:\n${run_err}")
  endif()
endfunction()

set(battery "${FIXTURE}/battery.nes")

if(CASE MATCHES "^frame_exact\\.(.+)$")
  set(sig "${CMAKE_MATCH_1}")
  file(MAKE_DIRECTORY "${WORK}/a" "${WORK}/b")
  run_runner(--rom "${battery}" --frames 4294967295 --hash-frame 5 --raise-after 5:${sig}
    --save-dir "${WORK}/a")
  set(a_out "${run_out}")
  expect_exit(0)
  expect_stop_line(5)
  run_runner(--rom "${battery}" --frames 5 --hash-frame 5 --save-dir "${WORK}/b")
  expect_exit(0)
  if(NOT "${a_out}" STREQUAL "${run_out}")
    message(FATAL_ERROR "runner_stop ${CASE}: stopped stdout differs:\n${a_out}\nvs\n${run_out}")
  endif()
  if(NOT "${a_out}" MATCHES "^frame 5 [^\n]*\n$")
    message(FATAL_ERROR "runner_stop ${CASE}: stdout is not one frame 5 line:\n${a_out}")
  endif()
  file(SHA256 "${WORK}/a/battery.sav" sum_a)
  file(SHA256 "${WORK}/b/battery.sav" sum_b)
  if(NOT sum_a STREQUAL sum_b)
    message(FATAL_ERROR "runner_stop ${CASE}: battery.sav differs between stopped and plain run")
  endif()
  expect_absent("${WORK}/a/battery.sav.tmp")
elseif(CASE STREQUAL "flush_missing_dir")
  run_runner(--rom "${battery}" --frames 4294967295 --raise-after 2
    --save-dir "${WORK}/missing/dir")
  expect_exit(1)
  if(NOT "${run_err}" MATCHES "cannot save [^\n]*battery\\.sav")
    message(FATAL_ERROR "runner_stop ${CASE}: no cannot-save message in:\n${run_err}")
  endif()
  expect_stop_line(2)
elseif(CASE STREQUAL "flush_dir_at_tmp")
  file(MAKE_DIRECTORY "${WORK}/saves/battery.sav.tmp")
  file(WRITE "${WORK}/saves/battery.sav.tmp/inner" "x")
  run_runner(--rom "${battery}" --frames 4294967295 --raise-after 2 --save-dir "${WORK}/saves")
  expect_exit(1)
  if(NOT "${run_err}" MATCHES "cannot save")
    message(FATAL_ERROR "runner_stop ${CASE}: no cannot-save message in:\n${run_err}")
  endif()
  expect_stop_line(2)
  if(NOT IS_DIRECTORY "${WORK}/saves/battery.sav.tmp" OR NOT EXISTS "${WORK}/saves/battery.sav.tmp/inner")
    message(FATAL_ERROR "runner_stop ${CASE}: the foreign directory was disturbed")
  endif()
  expect_absent("${WORK}/saves/battery.sav")
elseif(CASE STREQUAL "at_zero")
  file(MAKE_DIRECTORY "${WORK}/saves")
  file(COPY_FILE "${FIXTURE}/seed.sav" "${WORK}/saves/battery.sav")
  run_runner(--rom "${battery}" --frames 4294967295 --raise-after 0 --save-dir "${WORK}/saves")
  expect_exit(0)
  if(NOT "${run_out}" STREQUAL "")
    message(FATAL_ERROR "runner_stop ${CASE}: stdout must be empty:\n${run_out}")
  endif()
  expect_stop_line(0)
  file(SHA256 "${FIXTURE}/seed.sav" sum_seed)
  file(SHA256 "${WORK}/saves/battery.sav" sum_sav)
  if(NOT sum_seed STREQUAL sum_sav)
    message(FATAL_ERROR "runner_stop ${CASE}: battery.sav changed from the seed")
  endif()
  expect_absent("${WORK}/saves/battery.sav.tmp")
elseif(CASE STREQUAL "nodir")
  file(MAKE_DIRECTORY "${WORK}/rom")
  file(COPY_FILE "${battery}" "${WORK}/rom/battery.nes")
  execute_process(COMMAND "${RUNNER}" --rom rom/battery.nes --frames 4294967295 --raise-after 2
    WORKING_DIRECTORY "${WORK}"
    OUTPUT_VARIABLE run_out ERROR_VARIABLE run_err RESULT_VARIABLE run_exit)
  expect_exit(0)
  expect_stop_line(2)
  file(GLOB_RECURSE found RELATIVE "${WORK}" "${WORK}/*")
  if(NOT "${found}" STREQUAL "rom/battery.nes")
    message(FATAL_ERROR "runner_stop ${CASE}: unexpected files: ${found}")
  endif()
elseif(CASE MATCHES "^double(\\.int)?$")
  if(CASE STREQUAL "double.int")
    set(sig int)
  elseif(CMAKE_HOST_WIN32)
    set(sig break)
  else()
    set(sig term)
  endif()
  file(MAKE_DIRECTORY "${WORK}/saves")
  file(COPY_FILE "${FIXTURE}/seed.sav" "${WORK}/saves/battery.sav")
  run_runner(--rom "${battery}" --frames 4294967295 --raise-after 2:${sig}:2
    --save-dir "${WORK}/saves")
  if(CMAKE_HOST_WIN32)
    if("${run_exit}" STREQUAL "0" OR "${run_exit}" STREQUAL "1")
      message(FATAL_ERROR "runner_stop ${CASE}: exit ${run_exit}, wanted neither 0 nor 1")
    endif()
  elseif(NOT "${run_exit}" MATCHES "terminated|interrupt")
    message(FATAL_ERROR "runner_stop ${CASE}: result '${run_exit}', wanted death by signal")
  endif()
  string(FIND "${run_err}" "stopped by signal" at)
  if(NOT at LESS 0)
    message(FATAL_ERROR "runner_stop ${CASE}: a stop line was printed:\n${run_err}")
  endif()
  file(SIZE "${WORK}/saves/battery.sav" size)
  file(SHA256 "${FIXTURE}/seed.sav" sum_seed)
  file(SHA256 "${WORK}/saves/battery.sav" sum_sav)
  if(NOT size EQUAL 8192 OR NOT sum_seed STREQUAL sum_sav)
    message(FATAL_ERROR "runner_stop ${CASE}: battery.sav is not the whole seed")
  endif()
  expect_absent("${WORK}/saves/battery.sav.tmp")
elseif(CASE STREQUAL "load_state_at" OR CASE STREQUAL "load_state_below")
  run_runner(--rom "${battery}" --frames 3 --state-at-frame 3:${WORK}/s3.state)
  expect_exit(0)
  if(CASE STREQUAL "load_state_at")
    set(want_n 3)
  else()
    set(want_n 2)
  endif()
  run_runner(--rom "${battery}" --frames 4294967295 --load-state "${WORK}/s3.state"
    --raise-after ${want_n})
  if(CASE STREQUAL "load_state_at")
    expect_exit(0)
    if(NOT "${run_out}" STREQUAL "")
      message(FATAL_ERROR "runner_stop ${CASE}: stdout must be empty:\n${run_out}")
    endif()
    expect_stop_line(3)
  else()
    expect_exit(2)
    string(FIND "${run_err}" "--raise-after" at)
    if(at LESS 0)
      message(FATAL_ERROR "runner_stop ${CASE}: stderr does not name --raise-after:\n${run_err}")
    endif()
  endif()
else()
  message(FATAL_ERROR "runner_stop: unknown case ${CASE}")
endif()
