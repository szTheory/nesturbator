cmake_minimum_required(VERSION 3.25)

include("${CMAKE_CURRENT_LIST_DIR}/accuracycoin_input_fingerprint.cmake")

set(NESTURBATOR_PHASE20_REPOSITORY "szTheory/nesturbator")
set(NESTURBATOR_PHASE20_PLATFORMS
  linux-x64 linux-arm64 macos-x64 macos-arm64 windows-x64 windows-arm64)
set(NESTURBATOR_PHASE20_NMI_KEYS
  "accuracycoin/$2002 flag timing"
  "accuracycoin/NMI Timing"
  "accuracycoin/NMI Suppression"
  "accuracycoin/NMI Control"
  "accuracycoin/NMI at VBlank end"
  "accuracycoin/NMI disabled at VBlank")

function(phase20_read_properties path prefix out_ok out_error)
  if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
    set(${out_ok} FALSE PARENT_SCOPE)
    set(${out_error} "missing evidence file: ${path}" PARENT_SCOPE)
    return()
  endif()
  file(STRINGS "${path}" lines)
  set(keys)
  foreach(line IN LISTS lines)
    if(NOT line MATCHES "^([a-z][a-z0-9_]*)=([^=]*)$")
      set(${out_ok} FALSE PARENT_SCOPE)
      set(${out_error} "malformed evidence property in ${path}" PARENT_SCOPE)
      return()
    endif()
    set(key "${CMAKE_MATCH_1}")
    set(value "${CMAKE_MATCH_2}")
    if(key IN_LIST keys)
      set(${out_ok} FALSE PARENT_SCOPE)
      set(${out_error} "duplicate evidence property ${key} in ${path}" PARENT_SCOPE)
      return()
    endif()
    list(APPEND keys "${key}")
    set("${prefix}_${key}" "${value}")
  endforeach()
  set(${out_ok} TRUE PARENT_SCOPE)
  set(${out_error} "" PARENT_SCOPE)
  foreach(key IN LISTS keys)
    set("${prefix}_${key}" "${${prefix}_${key}}" PARENT_SCOPE)
  endforeach()
endfunction()

function(phase20_json_get out json)
  set(path ${ARGN})
  list(LENGTH path path_count)
  if(path_count GREATER 0)
    math(EXPR last "${path_count} - 1")
    list(GET path ${last} operation)
  else()
    set(operation "")
  endif()
  if(operation STREQUAL "LENGTH")
    list(POP_BACK path)
    string(JSON value ERROR_VARIABLE json_error LENGTH "${json}" ${path})
  else()
    string(JSON value ERROR_VARIABLE json_error GET "${json}" ${path})
  endif()
  if(json_error)
    set(${out} "" PARENT_SCOPE)
  else()
    if(value STREQUAL "ON")
      set(value "true")
    elseif(value STREQUAL "OFF")
      set(value "false")
    endif()
    set(${out} "${value}" PARENT_SCOPE)
  endif()
endfunction()

function(phase20_is_lower_hex value digits out)
  string(LENGTH "${value}" value_length)
  if("${value}" MATCHES "^[0-9a-f]+$" AND value_length EQUAL digits)
    set(${out} TRUE PARENT_SCOPE)
  else()
    set(${out} FALSE PARENT_SCOPE)
  endif()
endfunction()

function(phase20_compute_effective_digest source_dir out_digest out_count out_manifest out_error)
  execute_process(
    COMMAND git ls-files --cached --others --exclude-standard
    WORKING_DIRECTORY "${source_dir}"
    RESULT_VARIABLE list_result OUTPUT_VARIABLE tracked_paths ERROR_VARIABLE list_error)
  if(NOT "${list_result}" STREQUAL "0")
    set(${out_digest} "" PARENT_SCOPE)
    set(${out_count} 0 PARENT_SCOPE)
    set(${out_manifest} "" PARENT_SCOPE)
    set(${out_error} "cannot enumerate effective source files: ${list_error}" PARENT_SCOPE)
    return()
  endif()
  string(REPLACE "\r\n" "\n" tracked_paths "${tracked_paths}")
  string(REPLACE "\r" "\n" tracked_paths "${tracked_paths}")
  string(REPLACE "\n" ";" path_list "${tracked_paths}")
  list(REMOVE_DUPLICATES path_list)
  list(SORT path_list)
  set(manifest "")
  set(count 0)
  foreach(relative IN LISTS path_list)
    if(relative STREQUAL "" OR relative MATCHES "^\.planning(/|$)" OR
       relative STREQUAL "tests/accuracy/measurements.md")
      continue()
    endif()
    if(IS_ABSOLUTE "${relative}" OR relative MATCHES "^\\.\\./" OR
       relative MATCHES "/\\.\\./" OR relative MATCHES "/\\.\\.$")
      set(${out_digest} "" PARENT_SCOPE)
      set(${out_count} 0 PARENT_SCOPE)
      set(${out_manifest} "" PARENT_SCOPE)
      set(${out_error} "unsafe effective source path: ${relative}" PARENT_SCOPE)
      return()
    endif()
    set(absolute "${source_dir}/${relative}")
    if(NOT EXISTS "${absolute}" OR IS_DIRECTORY "${absolute}")
      set(${out_digest} "" PARENT_SCOPE)
      set(${out_count} 0 PARENT_SCOPE)
      set(${out_manifest} "" PARENT_SCOPE)
      set(${out_error} "effective source file is missing or not regular: ${relative}" PARENT_SCOPE)
      return()
    endif()
    if(IS_SYMLINK "${absolute}")
      file(READ_SYMLINK "${absolute}" link_target)
      string(SHA256 file_digest "symlink:${link_target}")
    else()
      file(SHA256 "${absolute}" file_digest)
    endif()
    string(APPEND manifest "${relative}\t${file_digest}\n")
    math(EXPR count "${count} + 1")
  endforeach()
  if(count EQUAL 0)
    set(${out_digest} "" PARENT_SCOPE)
    set(${out_count} 0 PARENT_SCOPE)
    set(${out_manifest} "" PARENT_SCOPE)
    set(${out_error} "effective source manifest is empty" PARENT_SCOPE)
    return()
  endif()
  string(SHA256 digest "${manifest}")
  set(${out_digest} "${digest}" PARENT_SCOPE)
  set(${out_count} "${count}" PARENT_SCOPE)
  set(${out_manifest} "${manifest}" PARENT_SCOPE)
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(phase20_compute_evidence_manifest root out_manifest out_digest out_error)
  file(GLOB_RECURSE evidence_files LIST_DIRECTORIES FALSE
    "${root}/artifacts/*" "${root}/provenance/*")
  list(SORT evidence_files)
  set(manifest "")
  foreach(path IN LISTS evidence_files)
    if(path STREQUAL "${root}/provenance/evidence-files.sha256")
      continue()
    endif()
    file(RELATIVE_PATH relative "${root}" "${path}")
    file(SHA256 "${path}" digest)
    string(APPEND manifest "${relative}\t${digest}\n")
  endforeach()
  if(manifest STREQUAL "")
    set(${out_manifest} "" PARENT_SCOPE)
    set(${out_digest} "" PARENT_SCOPE)
    set(${out_error} "hosted evidence bundle has no content files" PARENT_SCOPE)
    return()
  endif()
  string(SHA256 digest "${manifest}")
  set(${out_manifest} "${manifest}" PARENT_SCOPE)
  set(${out_digest} "${digest}" PARENT_SCOPE)
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(phase20_verify_evidence_manifest root expected_digest out_error)
  set(stored_path "${root}/provenance/evidence-files.sha256")
  if(NOT EXISTS "${stored_path}")
    set(${out_error} "hosted evidence file checksum manifest is missing" PARENT_SCOPE)
    return()
  endif()
  phase20_compute_evidence_manifest("${root}" actual_manifest actual_digest manifest_error)
  if(NOT manifest_error STREQUAL "")
    set(${out_error} "${manifest_error}" PARENT_SCOPE)
    return()
  endif()
  file(READ "${stored_path}" stored_manifest)
  file(SHA256 "${stored_path}" stored_digest)
  if(NOT stored_manifest STREQUAL actual_manifest OR
     NOT stored_digest STREQUAL expected_digest OR
     NOT actual_digest STREQUAL expected_digest)
    set(${out_error} "hosted evidence file checksum mismatch" PARENT_SCOPE)
    return()
  endif()
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(phase20_validate_clean_source source_dir out_error)
  execute_process(
    COMMAND git status --porcelain --untracked-files=all
    WORKING_DIRECTORY "${source_dir}"
    RESULT_VARIABLE status_result OUTPUT_VARIABLE status_text ERROR_VARIABLE status_error)
  if(NOT "${status_result}" STREQUAL "0")
    set(${out_error} "cannot inspect source checkout status: ${status_error}" PARENT_SCOPE)
    return()
  endif()
  string(REPLACE "\r\n" "\n" status_text "${status_text}")
  string(REPLACE "\n" ";" status_rows "${status_text}")
  foreach(row IN LISTS status_rows)
    if(row STREQUAL "")
      continue()
    endif()
    string(SUBSTRING "${row}" 3 -1 path)
    if(path MATCHES "^\.planning(/|$)" OR path MATCHES " -> \.planning(/|$)")
      continue()
    endif()
    if(path STREQUAL "tests/accuracy/measurements.md")
      continue()
    endif()
    set(${out_error} "effective source checkout is dirty: ${path}" PARENT_SCOPE)
    return()
  endforeach()
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(phase20_check_remote_tree tree_path source_dir file_manifest out_error)
  if(NOT EXISTS "${tree_path}")
    set(${out_error} "missing API source tree: ${tree_path}" PARENT_SCOPE)
    return()
  endif()
  file(READ "${tree_path}" tree_json)
  phase20_json_get(truncated "${tree_json}" truncated)
  if(truncated STREQUAL "true")
    set(${out_error} "GitHub source tree is truncated" PARENT_SCOPE)
    return()
  endif()
  phase20_json_get(tree_count "${tree_json}" tree LENGTH)
  if(NOT tree_count MATCHES "^[0-9]+$")
    set(${out_error} "GitHub source tree response is malformed" PARENT_SCOPE)
    return()
  endif()
  set(remote_count 0)
  if(tree_count GREATER 0)
    math(EXPR last "${tree_count} - 1")
    foreach(index RANGE 0 ${last})
      phase20_json_get(path "${tree_json}" tree ${index} path)
      phase20_json_get(type "${tree_json}" tree ${index} type)
      phase20_json_get(blob "${tree_json}" tree ${index} sha)
      if(NOT type STREQUAL "blob" OR path MATCHES "^\.planning(/|$)" OR
         path STREQUAL "tests/accuracy/measurements.md")
        continue()
      endif()
      string(SHA1 path_key "${path}")
      set("remote_${path_key}" "${blob}")
      math(EXPR remote_count "${remote_count} + 1")
    endforeach()
  endif()

  string(REPLACE "\n" ";" rows "${file_manifest}")
  set(local_count 0)
  foreach(row IN LISTS rows)
    if(row STREQUAL "")
      continue()
    endif()
    string(REPLACE "\t" ";" fields "${row}")
    list(GET fields 0 path)
    if(NOT path MATCHES "^\.planning(/|$)" AND
       NOT path STREQUAL "tests/accuracy/measurements.md")
      string(SHA1 path_key "${path}")
      if(NOT DEFINED remote_${path_key})
        set(${out_error} "effective source path is absent from the GitHub tree: ${path}" PARENT_SCOPE)
        return()
      endif()
      execute_process(
        COMMAND git hash-object --no-filters -- "${path}"
        WORKING_DIRECTORY "${source_dir}"
        RESULT_VARIABLE hash_result OUTPUT_VARIABLE blob ERROR_VARIABLE hash_error
        OUTPUT_STRIP_TRAILING_WHITESPACE)
      if(NOT "${hash_result}" STREQUAL "0" OR
         NOT "${blob}" STREQUAL "${remote_${path_key}}")
        set(${out_error} "effective source content differs from hosted tree at ${path}: ${hash_error}" PARENT_SCOPE)
        return()
      endif()
      math(EXPR local_count "${local_count} + 1")
    endif()
  endforeach()
  if(NOT local_count EQUAL remote_count)
    set(${out_error} "effective source file set differs from hosted GitHub tree" PARENT_SCOPE)
    return()
  endif()
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(phase20_resolve_tested_sha run_json pr_json candidate_sha pr_number out_sha out_error)
  # The Actions API's head_sha names the candidate; checkout tests the PR merge.
  # Bind the current PR snapshot to the run's immutable head/base before using
  # merge_commit_sha. Artifacts and merge parents are checked independently.
  # https://docs.github.com/en/rest/pulls/pulls#get-a-pull-request
  set(${out_sha} "" PARENT_SCOPE)
  phase20_json_get(run_head "${run_json}" head_sha)
  phase20_json_get(run_pr_head "${run_json}" pull_requests 0 head sha)
  phase20_json_get(run_pr_base "${run_json}" pull_requests 0 base sha)
  phase20_json_get(run_pr_number "${run_json}" pull_requests 0 number)
  phase20_json_get(snapshot_head "${pr_json}" head sha)
  phase20_json_get(snapshot_base "${pr_json}" base sha)
  phase20_json_get(snapshot_number "${pr_json}" number)
  phase20_json_get(merge_sha "${pr_json}" merge_commit_sha)
  phase20_is_lower_hex("${merge_sha}" 40 valid_merge_sha)
  if(NOT run_head STREQUAL candidate_sha OR NOT run_pr_head STREQUAL candidate_sha OR
     NOT run_pr_number STREQUAL pr_number OR NOT snapshot_number STREQUAL pr_number OR
     NOT snapshot_head STREQUAL run_pr_head OR NOT snapshot_base STREQUAL run_pr_base)
    set(${out_error} "PR snapshot does not match the run candidate/base identity" PARENT_SCOPE)
    return()
  endif()
  if(NOT valid_merge_sha)
    set(${out_error} "PR snapshot has no tested merge SHA" PARENT_SCOPE)
    return()
  endif()
  set(${out_sha} "${merge_sha}" PARENT_SCOPE)
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(phase20_validate_run_json run_path job_path artifact_path prefix run_id attempt
    candidate_sha tested_sha base_sha expected_pr_number out_error)
  foreach(path IN ITEMS "${run_path}" "${job_path}" "${artifact_path}")
    if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
      set(${out_error} "missing hosted ${prefix} provenance JSON" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  file(READ "${run_path}" run_json)
  file(READ "${job_path}" job_json)
  file(READ "${artifact_path}" artifact_json)
  phase20_json_get(id "${run_json}" id)
  phase20_json_get(actual_attempt "${run_json}" run_attempt)
  phase20_json_get(event "${run_json}" event)
  phase20_json_get(head_sha "${run_json}" head_sha)
  phase20_json_get(run_started_at "${run_json}" run_started_at)
  phase20_json_get(repository "${run_json}" repository full_name)
  if(NOT "${id}" STREQUAL "${run_id}" OR
     NOT "${actual_attempt}" STREQUAL "${attempt}" OR
     NOT repository STREQUAL NESTURBATOR_PHASE20_REPOSITORY OR
     NOT event STREQUAL "pull_request")
    set(${out_error} "${prefix} run identity does not match delivery run/attempt/repository/event" PARENT_SCOPE)
    return()
  endif()
  phase20_json_get(pr_count "${run_json}" pull_requests LENGTH)
  if(NOT pr_count EQUAL 1)
    set(${out_error} "${prefix} run is not bound to exactly one pull request" PARENT_SCOPE)
    return()
  endif()
  phase20_json_get(pr_number "${run_json}" pull_requests 0 number)
  phase20_json_get(pr_base "${run_json}" pull_requests 0 base sha)
  phase20_json_get(pr_head "${run_json}" pull_requests 0 head sha)
  if(NOT "${pr_head}" STREQUAL "${candidate_sha}" OR
     NOT "${pr_base}" STREQUAL "${base_sha}" OR
     NOT "${pr_number}" STREQUAL "${expected_pr_number}")
    set(${out_error} "${prefix} PR candidate/base mapping does not match delivery identity" PARENT_SCOPE)
    return()
  endif()
  if(NOT head_sha STREQUAL candidate_sha)
    set(${out_error} "${prefix} run head SHA does not match the PR candidate SHA" PARENT_SCOPE)
    return()
  endif()

  phase20_json_get(job_count "${job_json}" jobs LENGTH)
  if(NOT job_count MATCHES "^[0-9]+$" OR job_count EQUAL 0)
    set(${out_error} "${prefix} job inventory is empty or malformed" PARENT_SCOPE)
    return()
  endif()
  set(job_names)
  if(job_count GREATER 0)
    math(EXPR job_last "${job_count} - 1")
    foreach(index RANGE 0 ${job_last})
      phase20_json_get(name "${job_json}" jobs ${index} name)
      phase20_json_get(status "${job_json}" jobs ${index} status)
      phase20_json_get(conclusion "${job_json}" jobs ${index} conclusion)
      if(name STREQUAL "" OR name IN_LIST job_names)
        set(${out_error} "${prefix} job inventory has missing/duplicate job identity" PARENT_SCOPE)
        return()
      endif()
      list(APPEND job_names "${name}")
      if((prefix STREQUAL "ci" OR name STREQUAL "vectors-full" OR name STREQUAL "mmc3-oracle") AND
         (NOT status STREQUAL "completed" OR NOT conclusion STREQUAL "success"))
        set(${out_error} "${prefix} skipped/cancelled/failed job: ${name} (${status}/${conclusion})" PARENT_SCOPE)
        return()
      endif()
    endforeach()
  endif()

  phase20_json_get(artifact_count "${artifact_json}" artifacts LENGTH)
  if(NOT artifact_count MATCHES "^[0-9]+$")
    set(${out_error} "${prefix} artifact inventory is malformed" PARENT_SCOPE)
    return()
  endif()
  set(artifact_names)
  set(artifact_ids)
  if(artifact_count GREATER 0)
    math(EXPR artifact_last "${artifact_count} - 1")
    foreach(index RANGE 0 ${artifact_last})
      phase20_json_get(name "${artifact_json}" artifacts ${index} name)
      phase20_json_get(artifact_id "${artifact_json}" artifacts ${index} id)
      phase20_json_get(expired "${artifact_json}" artifacts ${index} expired)
      phase20_json_get(wf_id "${artifact_json}" artifacts ${index} workflow_run id)
      phase20_json_get(wf_attempt "${artifact_json}" artifacts ${index} workflow_run run_attempt)
      phase20_json_get(created_at "${artifact_json}" artifacts ${index} created_at)
      if(name STREQUAL "" OR name IN_LIST artifact_names)
        set(${out_error} "${prefix} duplicate artifact identity: ${name}" PARENT_SCOPE)
        return()
      endif()
      if(NOT artifact_id MATCHES "^[0-9]+$" OR artifact_id IN_LIST artifact_ids)
        set(${out_error} "${prefix} duplicate or invalid artifact ID" PARENT_SCOPE)
        return()
      endif()
      list(APPEND artifact_ids "${artifact_id}")
      list(APPEND artifact_names "${name}")
      if(NOT wf_id STREQUAL run_id)
        set(${out_error} "${prefix} artifact is attached to the wrong workflow run: ${name}" PARENT_SCOPE)
        return()
      endif()
      if(NOT wf_attempt STREQUAL "" AND NOT wf_attempt STREQUAL attempt)
        set(${out_error} "${prefix} artifact belongs to another run attempt: ${name}" PARENT_SCOPE)
        return()
      endif()
      if(NOT run_started_at STREQUAL "" AND NOT created_at STREQUAL "" AND
         created_at STRLESS run_started_at)
        set(${out_error} "${prefix} artifact predates this run attempt: ${name}" PARENT_SCOPE)
        return()
      endif()
      if(expired STREQUAL "true")
        set("expired_${name}" TRUE)
      else()
        set("expired_${name}" FALSE)
      endif()
      set("artifact_id_${name}" "${artifact_id}")
    endforeach()
  endif()

  set(required_artifacts)
  if(prefix STREQUAL "ci")
    foreach(platform IN LISTS NESTURBATOR_PHASE20_PLATFORMS)
      string(REPLACE "-" ";" parts "${platform}")
      list(GET parts 0 os)
      list(GET parts 1 arch)
      list(APPEND required_artifacts "hashes-${os}-${arch}"
        "accuracycoin-evidence-${os}-${arch}-${run_id}-${attempt}")
    endforeach()
    list(APPEND required_artifacts "phase20-perf-${run_id}-${attempt}" "retroarch-marker-progression")
  else()
    list(APPEND required_artifacts "vectors-full-evidence-${run_id}" "mmc3-oracle-evidence-${run_id}")
  endif()
  foreach(name IN LISTS required_artifacts)
    if(NOT name IN_LIST artifact_names)
      set(${out_error} "${prefix} required artifact missing: ${name}" PARENT_SCOPE)
      return()
    endif()
    if(expired_${name})
      set(${out_error} "${prefix} required artifact expired: ${name}" PARENT_SCOPE)
      return()
    endif()
    set("${prefix}_artifact_id_${name}" "${artifact_id_${name}}" PARENT_SCOPE)
  endforeach()
  if(prefix STREQUAL "ci")
    foreach(name IN ITEMS hygiene title vector-inventory asan hash-equality retroarch-e2e perf "CI required"
        "session-controls (ubuntu-24.04)" "session-controls (macos-15)"
        "nofp (ubuntu-24.04)" "nofp (ubuntu-24.04-arm)")
      if(NOT name IN_LIST job_names)
        set(${out_error} "CI job missing from hosted run: ${name}" PARENT_SCOPE)
        return()
      endif()
    endforeach()
    foreach(platform IN LISTS NESTURBATOR_PHASE20_PLATFORMS)
      string(REPLACE "-" ";" parts "${platform}")
      list(GET parts 0 os)
      list(GET parts 1 arch)
      if(os STREQUAL "linux" AND arch STREQUAL "x64")
        set(runner "ubuntu-24.04")
        set(preset "ci-build")
      elseif(os STREQUAL "linux")
        set(runner "ubuntu-24.04-arm")
        set(preset "ci-build")
      elseif(os STREQUAL "macos" AND arch STREQUAL "arm64")
        set(runner "macos-15")
        set(preset "ci-build")
      elseif(os STREQUAL "macos")
        set(runner "macos-15-intel")
        set(preset "ci-build")
      elseif(arch STREQUAL "arm64")
        set(runner "windows-11-arm")
        set(preset "ci-msvc")
      else()
        set(runner "windows-2025")
        set(preset "ci-msvc")
      endif()
      set(expected_job "build (${runner}, ${preset}, ${os}, ${arch})")
      if(NOT os STREQUAL "windows")
        set(expected_job "build (${runner}, ci, ci-build, ${os}, ${arch})")
      endif()
      if(NOT expected_job IN_LIST job_names)
        set(${out_error} "CI platform job missing from hosted run: ${platform}" PARENT_SCOPE)
        return()
      endif()
    endforeach()
  else()
    foreach(name IN ITEMS vectors-full mmc3-oracle)
      if(NOT name IN_LIST job_names)
        set(${out_error} "Nightly job missing from hosted run: ${name}" PARENT_SCOPE)
        return()
      endif()
    endforeach()
    foreach(name IN ITEMS "vectors-full-evidence-${run_id}" "mmc3-oracle-evidence-${run_id}")
      if(NOT name IN_LIST artifact_names OR expired_${name})
        set(${out_error} "Nightly artifact missing or expired: ${name}" PARENT_SCOPE)
        return()
      endif()
      set("${prefix}_artifact_id_${name}" "${artifact_id_${name}}" PARENT_SCOPE)
    endforeach()
  endif()
  set(${out_error} "" PARENT_SCOPE)
  foreach(name IN LISTS job_names)
    string(MAKE_C_IDENTIFIER "${name}" job_key)
    set("${prefix}_job_${job_key}" TRUE PARENT_SCOPE)
  endforeach()
  set("${prefix}_run_json" "${run_json}" PARENT_SCOPE)
endfunction()

function(phase20_require_property prefix key expected label out_error)
  if(NOT DEFINED ${prefix}_${key})
    set(${out_error} "${label} metadata missing ${key}" PARENT_SCOPE)
  elseif(NOT "${${prefix}_${key}}" STREQUAL "${expected}")
    set(${out_error} "${label} metadata ${key} mismatch" PARENT_SCOPE)
  else()
    set(${out_error} "" PARENT_SCOPE)
  endif()
endfunction()

function(phase20_validate_scoreboard candidate_path protected_path metadata_path base_sha out_error)
  if(NOT EXISTS "${candidate_path}" OR NOT EXISTS "${protected_path}" OR NOT EXISTS "${metadata_path}")
    set(${out_error} "protected scoreboard/artifact missing" PARENT_SCOPE)
    return()
  endif()
  phase20_read_properties("${metadata_path}" protected metadata_valid metadata_error)
  if(NOT metadata_error STREQUAL "")
    set(${out_error} "protected scoreboard metadata malformed" PARENT_SCOPE)
    return()
  endif()
  if(NOT protected_authority STREQUAL "protected-main" OR
     NOT protected_protected_revision STREQUAL base_sha OR
     NOT protected_scoreboard_rows STREQUAL "108" OR
     NOT protected_scoreboard_denominator STREQUAL "108")
    set(${out_error} "protected scoreboard identity/count mismatch" PARENT_SCOPE)
    return()
  endif()
  file(SHA256 "${protected_path}" protected_sha)
  if(NOT protected_sha STREQUAL protected_scoreboard_sha256)
    set(${out_error} "protected scoreboard content digest mismatch" PARENT_SCOPE)
    return()
  endif()
  file(STRINGS "${protected_path}" protected_rows)
  list(LENGTH protected_rows protected_count)
  if(NOT protected_count EQUAL 108)
    set(${out_error} "protected scoreboard must contain exactly 108 initial keys" PARENT_SCOPE)
    return()
  endif()
  file(STRINGS "${candidate_path}" candidate_rows)
  set(candidate_passes)
  set(nmi_passes)
  set(previous "")
  foreach(line IN LISTS candidate_rows)
    if(NOT line MATCHES "^([^\t]+)\t(pass|fail|skip|not_run|timeout)\t[^\t]+\t[^\t]+\t[^\t]+$")
      set(${out_error} "candidate scoreboard contains a malformed row" PARENT_SCOPE)
      return()
    endif()
    set(key "${CMAKE_MATCH_1}")
    set(status "${CMAKE_MATCH_2}")
    if(NOT previous STREQUAL "" AND NOT previous STRLESS key)
      set(${out_error} "candidate scoreboard is not unique/sorted" PARENT_SCOPE)
      return()
    endif()
    set(previous "${key}")
    if(status STREQUAL "pass")
      list(APPEND candidate_passes "${key}")
    endif()
    if(key IN_LIST NESTURBATOR_PHASE20_NMI_KEYS AND status STREQUAL "pass")
      list(APPEND nmi_passes "${key}")
    endif()
  endforeach()
  foreach(line IN LISTS protected_rows)
    if(NOT line MATCHES "^(accuracycoin/[^\t]+)\tpass\t0x[0-9a-f][0-9a-f]\t-\t-$")
      set(${out_error} "protected scoreboard has malformed or non-PASS initial key" PARENT_SCOPE)
      return()
    endif()
    set(key "${CMAKE_MATCH_1}")
    if(NOT key IN_LIST candidate_passes)
      set(${out_error} "protected key lost in candidate scoreboard: ${key}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  list(LENGTH nmi_passes nmi_count)
  if(NOT nmi_count EQUAL 6)
    set(${out_error} "candidate scoreboard does not pass the exact six NMI target keys" PARENT_SCOPE)
    return()
  endif()
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(phase20_validate_campaign root source_dir tested_sha out_error)
  set(campaign_dir "${root}/artifacts/build-linux-x64/accuracycoin/full")
  foreach(name IN ITEMS metadata.txt report.tsv inventory.tsv)
    if(NOT EXISTS "${campaign_dir}/${name}")
      set(${out_error} "clean Linux x64 campaign artifact missing ${name}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  phase20_read_properties("${campaign_dir}/metadata.txt" campaign valid metadata_error)
  if(NOT metadata_error STREQUAL "")
    set(${out_error} "campaign metadata malformed" PARENT_SCOPE)
    return()
  endif()
  string(SUBSTRING "${tested_sha}" 0 12 tested_short_sha)
  foreach(pair IN ITEMS "report_schema|1" "inventory_schema|1" "source_revision|${tested_short_sha}"
      "library_version|0.1.11" "behaviour_revision|8" "source_dirty|0" "rom_pin|6bee919529289c555803b612b8c9e4f7eaaeeabb"
      "rom_sha256|8ac8904a3cf26fbdfa6be501e414d45886ff4478d30dee8e58fa436cf5fd5adc"
      "mode|campaign" "boot_frame_budget|32" "navigation_frame_budget_per_page|5"
      "execution_frame_budget|1800" "total_frame_budget|41503" "pages_launched|22" "pages_start_attributed|22"
      "pages_completed|22" "attempted_scored_rows|146" "scored_total|146"
      "draw|5" "skip|0" "not_run|0" "timeout|0"
      "trustworthy_observation|1" "infrastructure_verdict|complete")
    string(REPLACE "|" ";" fields "${pair}")
    list(GET fields 0 key)
    list(GET fields 1 value)
    phase20_require_property(campaign "${key}" "${value}" "AccuracyCoin" error)
    if(NOT error STREQUAL "")
      set(${out_error} "${error}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  accuracycoin_compute_input_fingerprint("${source_dir}" current_fingerprint current_count)
  if(NOT campaign_build_inputs_sha256 STREQUAL current_fingerprint OR
     NOT campaign_build_inputs_count STREQUAL current_count)
    set(${out_error} "campaign source fingerprint is stale" PARENT_SCOPE)
    return()
  endif()
  file(SHA256 "${campaign_dir}/report.tsv" report_sha)
  if(NOT report_sha STREQUAL campaign_campaign_report_sha256)
    set(${out_error} "campaign report content digest mismatch" PARENT_SCOPE)
    return()
  endif()
  file(SHA256 "${campaign_dir}/inventory.tsv" inventory_sha)
  if(NOT inventory_sha STREQUAL campaign_inventory_sha256)
    set(${out_error} "campaign inventory content digest mismatch" PARENT_SCOPE)
    return()
  endif()

  file(STRINGS "${campaign_dir}/inventory.tsv" inventory_rows)
  file(STRINGS "${campaign_dir}/report.tsv" report_rows)
  string(ASCII 9 tab)
  list(LENGTH inventory_rows inventory_count)
  list(LENGTH report_rows report_count)
  if(NOT inventory_count EQUAL 152 OR NOT report_count EQUAL 152)
    set(${out_error} "campaign terminal inventory/report row count mismatch" PARENT_SCOPE)
    return()
  endif()
  set(report_keys)
  set(target_passes)
  set(pass_count 0)
  set(fail_count 0)
  list(REMOVE_AT inventory_rows 0)
  list(REMOVE_AT report_rows 0)
  foreach(line IN LISTS inventory_rows)
    string(REPLACE "${tab}" ";" fields "${line}")
    list(LENGTH fields count)
    if(NOT count EQUAL 6)
      set(${out_error} "campaign inventory row malformed" PARENT_SCOPE)
      return()
    endif()
    list(GET fields 0 page)
    list(GET fields 1 row)
    list(GET fields 2 kind)
    list(GET fields 3 key)
    set(found FALSE)
    foreach(report IN LISTS report_rows)
      string(REPLACE "${tab}" ";" report_fields "${report}")
      list(LENGTH report_fields report_field_count)
      if(NOT report_field_count EQUAL 10)
        set(${out_error} "campaign terminal report row malformed" PARENT_SCOPE)
        return()
      endif()
      list(GET report_fields 0 report_key)
      list(GET report_fields 1 report_page)
      list(GET report_fields 2 report_row)
      list(GET report_fields 3 report_kind)
      list(GET report_fields 4 status)
      list(GET report_fields 5 observed)
      if(report_key STREQUAL key AND report_page STREQUAL page AND report_row STREQUAL row)
        if(found OR NOT observed STREQUAL "1")
          set(${out_error} "campaign terminal inventory has duplicate/unobserved row ${key}" PARENT_SCOPE)
          return()
        endif()
        if(kind STREQUAL "DRAW")
          if(NOT report_kind STREQUAL "draw" OR NOT status STREQUAL "draw")
            set(${out_error} "campaign DRAW inventory terminal status mismatch" PARENT_SCOPE)
            return()
          endif()
        elseif(NOT report_kind STREQUAL "test" OR
           NOT status MATCHES "^(pass|fail)$")
          set(${out_error} "campaign TEST inventory terminal status mismatch" PARENT_SCOPE)
          return()
        endif()
        set(found TRUE)
        list(APPEND report_keys "${key}")
        if(status STREQUAL "pass")
          math(EXPR pass_count "${pass_count} + 1")
          if(key IN_LIST NESTURBATOR_PHASE20_NMI_KEYS)
            list(APPEND target_passes "${key}")
          endif()
        elseif(status STREQUAL "fail")
          math(EXPR fail_count "${fail_count} + 1")
        endif()
      endif()
    endforeach()
    if(NOT found)
      set(${out_error} "campaign terminal report missing inventory row ${key}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  list(LENGTH target_passes target_count)
  if(NOT target_count EQUAL 6 OR NOT pass_count STREQUAL campaign_pass OR
     NOT fail_count STREQUAL campaign_fail OR
     NOT campaign_attempted_scored_rows STREQUAL "146" OR
     NOT campaign_terminal_scored_rows STREQUAL "146" OR
     NOT campaign_observed_scored_rows STREQUAL "146")
    set(${out_error} "campaign six-target/count summary disagrees with observed terminal rows" PARENT_SCOPE)
    return()
  endif()
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(phase20_validate_build_logs root out_error)
  set(required_tests
    accuracycoin.protected_observation accuracycoin.protected
    accuracy.scoreboard.no_lost_pass vectors.n65v
    holymapperel.M2_P128K_CR8K_V.decode runner.boot_to_play)
  foreach(platform IN LISTS NESTURBATOR_PHASE20_PLATFORMS)
    set(log "${root}/artifacts/build-${platform}/LastTest.log")
    if(NOT EXISTS "${log}")
      set(${out_error} "build ${platform} LastTest.log missing" PARENT_SCOPE)
      return()
    endif()
    file(READ "${log}" text)
    foreach(test IN LISTS required_tests)
      string(REPLACE "." "\\." test_re "${test}")
      if(NOT text MATCHES "Test #[0-9]+: ${test_re}[ \t.]+Passed")
        set(${out_error} "build ${platform} did not record actual passing ${test}" PARENT_SCOPE)
        return()
      endif()
    endforeach()
  endforeach()
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(phase20_validate_perf root source_dir ci_run_id ci_attempt candidate_sha tested_sha expected_base_sha out_error)
  set(perf_dir "${root}/artifacts/perf")
  foreach(name IN ITEMS identity.txt summary.md)
    if(NOT EXISTS "${perf_dir}/${name}")
      set(${out_error} "performance artifact missing ${name}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  phase20_read_properties("${perf_dir}/identity.txt" perf valid metadata_error)
  phase20_is_lower_hex("${perf_base_sha}" 40 valid_perf_base)
  if(NOT metadata_error STREQUAL "" OR
     NOT perf_run_id STREQUAL ci_run_id OR NOT perf_run_attempt STREQUAL ci_attempt OR
     NOT valid_perf_base OR NOT perf_base_sha STREQUAL expected_base_sha OR
     NOT perf_head_sha STREQUAL tested_sha OR
     NOT perf_candidate_head_sha STREQUAL candidate_sha OR
     perf_valgrind_version STREQUAL "" OR perf_gcc_version STREQUAL "")
    set(${out_error} "performance raw identity does not bind CI attempt/base/tested source/toolchain" PARENT_SCOPE)
    return()
  endif()
  set(recomputed "${root}/artifacts/perf/recomputed-summary.md")
  execute_process(
    COMMAND "${CMAKE_COMMAND}" -DMODE=gate "-DDIR=${perf_dir}"
      "-DALLOW=${source_dir}/tests/perf/allow.txt" "-DOUT=${recomputed}"
      "-DBASE_SHA=${perf_base_sha}" "-DHEAD_SHA=${perf_head_sha}"
      "-DVALGRIND_VERSION=${perf_valgrind_version}" "-DGCC_VERSION=${perf_gcc_version}"
      -P "${source_dir}/tests/cmake/perf_compare.cmake"
    RESULT_VARIABLE compare_result OUTPUT_VARIABLE compare_stdout ERROR_VARIABLE compare_stderr)
  if(NOT "${compare_result}" STREQUAL "0")
    if("${compare_stdout}${compare_stderr}" MATCHES "UNSTABLE")
      set(${out_error} "performance base_a/base_b spread is nonzero" PARENT_SCOPE)
    else()
      string(FIND "${compare_stdout}${compare_stderr}" "exceeds +1.00%" over_limit_position)
      if(NOT over_limit_position EQUAL -1)
        set(${out_error} "performance per-ROM slowdown exceeds +1.00%" PARENT_SCOPE)
      else()
        set(${out_error} "performance raw measurement is missing, n/a or failed its +1.00% gate" PARENT_SCOPE)
      endif()
    endif()
    return()
  endif()
  file(READ "${perf_dir}/summary.md" summary)
  file(READ "${recomputed}" recomputed_text)
  foreach(rom IN ITEMS nesteroids runner M4_P256K_C256K)
    if(NOT summary MATCHES "\\| ${rom} \\| [014] \\| [0-9]+ \\| [0-9]+ \\| [^|]+ \\| [^|]+ \\| ok \\|")
      set(${out_error} "performance summary lacks an actual passing row for ${rom}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  if(summary MATCHES "n/a" OR summary MATCHES "ALLOWED" OR summary MATCHES "UNSTABLE" OR
     NOT summary MATCHES "base ${perf_base_sha} head ${perf_head_sha}" OR
     NOT summary MATCHES "${perf_valgrind_version}" OR
     NOT summary MATCHES "${perf_gcc_version}")
    set(${out_error} "performance summary contains n/a/ALLOWED or does not match measured raw identity" PARENT_SCOPE)
    return()
  endif()
  foreach(rom IN ITEMS nesteroids runner M4_P256K_C256K)
    file(STRINGS "${perf_dir}/summary.md" summary_rows REGEX "^\\| ${rom} \\|")
    file(STRINGS "${recomputed}" recomputed_rows REGEX "^\\| ${rom} \\|")
    if(NOT summary_rows STREQUAL recomputed_rows)
      set(${out_error} "performance summary and raw recomputation disagree for ${rom}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(phase20_validate_nightly root out_error)
  foreach(lane IN ITEMS vectors-full mmc3-oracle)
    set(dir "${root}/artifacts/nightly/${lane}")
    file(GLOB inventories "${dir}/*registered-tests.json")
    file(GLOB junit_files "${dir}/*.junit.xml")
    list(LENGTH inventories inventory_count)
    list(LENGTH junit_files junit_count)
    if(NOT inventory_count EQUAL 1 OR NOT junit_count EQUAL 1)
      set(${out_error} "Nightly ${lane} inventory/JUnit evidence missing or ambiguous" PARENT_SCOPE)
      return()
    endif()
    file(READ "${inventories}" inventory_json)
    file(READ "${junit_files}" junit)
    phase20_json_get(test_count "${inventory_json}" tests LENGTH)
    if(NOT test_count MATCHES "^[0-9]+$" OR test_count EQUAL 0)
      set(${out_error} "Nightly ${lane} registered test inventory is empty" PARENT_SCOPE)
      return()
    endif()
    if(NOT junit MATCHES "tests=\"[1-9][0-9]*\"" OR
       NOT junit MATCHES "failures=\"0\"" OR NOT junit MATCHES "errors=\"0\"" OR
       NOT junit MATCHES "skipped=\"0\"" OR NOT junit MATCHES "<testcase ")
      set(${out_error} "Nightly ${lane} JUnit does not show successful executed tests" PARENT_SCOPE)
      return()
    endif()
    if(lane STREQUAL "vectors-full")
      if(NOT inventory_json MATCHES "cpu\\.vectors-full" OR NOT junit MATCHES "cpu\\.vectors-full")
        set(${out_error} "Nightly vectors-full evidence lacks its full-vector tests" PARENT_SCOPE)
        return()
      endif()
    elseif(NOT inventory_json MATCHES "mmc3\\.oracle\\." OR NOT junit MATCHES "mmc3\\.oracle\\.")
      set(${out_error} "Nightly mmc3-oracle evidence lacks its oracle tests" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(nesturbator_phase20_validate_evidence root source_dir out_ok out_reason)
  set(${out_ok} FALSE PARENT_SCOPE)
  set(${out_reason} "incomplete: hosted evidence validation has not run" PARENT_SCOPE)
  if(ARGC GREATER 4 AND ARGV4)
    set(allow_fixture TRUE)
  else()
    set(allow_fixture FALSE)
  endif()
  if(ARGC GREATER 5 AND ARGV5)
    set(skip_file_hash TRUE)
  else()
    set(skip_file_hash FALSE)
  endif()
  set(provenance "${root}/provenance/source-identity.txt")
  phase20_read_properties("${provenance}" identity valid property_error)
  if(NOT property_error STREQUAL "")
    set(${out_reason} "source identity: ${property_error}" PARENT_SCOPE)
    return()
  endif()
  if(identity_repository STREQUAL "" OR NOT identity_repository STREQUAL NESTURBATOR_PHASE20_REPOSITORY)
    set(${out_reason} "source identity: wrong repository" PARENT_SCOPE)
    return()
  endif()
  if(identity_provenance_kind STREQUAL "fixture")
    if(NOT allow_fixture)
      set(${out_reason} "fixture provenance cannot establish hosted evidence" PARENT_SCOPE)
      return()
    endif()
  elseif(NOT identity_provenance_kind STREQUAL "hosted")
    set(${out_reason} "source identity: unknown provenance kind" PARENT_SCOPE)
    return()
  endif()
  foreach(key candidate_head_sha tested_sha base_sha source_digest)
    if(key STREQUAL "source_digest")
      set(hex_digits 64)
    else()
      set(hex_digits 40)
    endif()
    phase20_is_lower_hex("${identity_${key}}" ${hex_digits} valid_identity_hex)
    if(NOT valid_identity_hex)
      set(${out_reason} "source identity: invalid ${key}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  phase20_compute_effective_digest("${source_dir}" current_digest current_count current_manifest digest_error)
  if(NOT digest_error STREQUAL "")
    set(${out_reason} "source digest: ${digest_error}" PARENT_SCOPE)
    return()
  endif()
  if(NOT identity_source_digest STREQUAL current_digest)
    set(${out_reason} "source digest mismatch: source changed after tested artifact capture" PARENT_SCOPE)
    return()
  endif()
  if(identity_provenance_kind STREQUAL "hosted")
    phase20_validate_clean_source("${source_dir}" clean_error)
    if(NOT clean_error STREQUAL "")
      set(${out_reason} "source digest: ${clean_error}" PARENT_SCOPE)
      return()
    endif()
    if(NOT EXISTS "${root}/provenance/effective-inputs.tsv")
      set(${out_reason} "source digest: full effective-inputs.tsv manifest is missing" PARENT_SCOPE)
      return()
    endif()
    file(READ "${root}/provenance/effective-inputs.tsv" stored_manifest)
    file(SHA256 "${root}/provenance/effective-inputs.tsv" stored_manifest_sha)
    if(NOT stored_manifest STREQUAL current_manifest OR
       NOT stored_manifest_sha STREQUAL identity_effective_inputs_sha256)
      set(${out_reason} "source digest: full effective input list differs from the hosted source" PARENT_SCOPE)
      return()
    endif()
  endif()
  if(DEFINED identity_source_count AND NOT identity_source_count STREQUAL current_count)
    set(${out_reason} "source digest mismatch: effective input count changed" PARENT_SCOPE)
    return()
  endif()

  if(identity_provenance_kind STREQUAL "hosted")
    foreach(name IN ITEMS pr.json ci-run.json ci-commit.json candidate-commit.json ci-jobs.json ci-artifacts.json
        nightly-run.json nightly-commit.json nightly-jobs.json nightly-artifacts.json
        ci-tested-tree.json ci-candidate-tree.json nightly-tested-tree.json)
      if(NOT EXISTS "${root}/provenance/${name}")
        set(${out_reason} "hosted provenance missing ${name}" PARENT_SCOPE)
        return()
      endif()
    endforeach()
  phase20_validate_run_json("${root}/provenance/ci-run.json"
      "${root}/provenance/ci-jobs.json" "${root}/provenance/ci-artifacts.json" ci
      "${identity_ci_run_id}" "${identity_ci_run_attempt}" "${identity_candidate_head_sha}"
      "${identity_tested_sha}" "${identity_base_sha}" "${identity_pr_number}" error)
    if(NOT error STREQUAL "")
      set(${out_reason} "CI provenance: ${error}" PARENT_SCOPE)
      return()
    endif()
    set(ci_run_json "${ci_run_json}")
    set(required_artifact_ids)
    foreach(platform IN LISTS NESTURBATOR_PHASE20_PLATFORMS)
      string(REPLACE "-" ";" parts "${platform}")
      list(GET parts 0 os)
      list(GET parts 1 arch)
      list(APPEND required_artifact_ids "${ci_artifact_id_hashes-${os}-${arch}}"
        "${ci_artifact_id_accuracycoin-evidence-${os}-${arch}-${identity_ci_run_id}-${identity_ci_run_attempt}}")
    endforeach()
    list(APPEND required_artifact_ids
      "${ci_artifact_id_phase20-perf-${identity_ci_run_id}-${identity_ci_run_attempt}}"
      "${ci_artifact_id_retroarch-marker-progression}")
    foreach(name IN ITEMS ci-commit.json candidate-commit.json nightly-commit.json)
      set(file "${root}/provenance/${name}")
      file(READ "${file}" commit_json)
      phase20_json_get(sha "${commit_json}" sha)
      phase20_json_get(tree "${commit_json}" tree sha)
      phase20_is_lower_hex("${sha}" 40 valid_sha)
      phase20_is_lower_hex("${tree}" 40 valid_tree)
      if(NOT valid_sha OR NOT valid_tree)
        set(${out_reason} "hosted source commit metadata malformed" PARENT_SCOPE)
        return()
      endif()
    endforeach()
    file(READ "${root}/provenance/ci-commit.json" tested_commit)
    phase20_json_get(tested_sha "${tested_commit}" sha)
    phase20_json_get(parent_count "${tested_commit}" parents LENGTH)
    phase20_json_get(parent0 "${tested_commit}" parents 0 sha)
    phase20_json_get(parent1 "${tested_commit}" parents 1 sha)
    if(NOT tested_sha STREQUAL identity_tested_sha OR NOT parent_count EQUAL 2 OR
       NOT ((parent0 STREQUAL identity_base_sha AND parent1 STREQUAL identity_candidate_head_sha) OR
            (parent1 STREQUAL identity_base_sha AND parent0 STREQUAL identity_candidate_head_sha)))
      set(${out_reason} "source mapping: tested merge parents do not match PR base/head" PARENT_SCOPE)
      return()
    endif()
    file(READ "${root}/provenance/candidate-commit.json" candidate_commit)
    phase20_json_get(candidate_sha "${candidate_commit}" sha)
    if(NOT candidate_sha STREQUAL identity_candidate_head_sha)
      set(${out_reason} "source mapping: candidate commit SHA mismatch" PARENT_SCOPE)
      return()
    endif()
    phase20_check_remote_tree("${root}/provenance/ci-tested-tree.json" "${source_dir}"
      "${current_manifest}" tree_error)
    if(NOT tree_error STREQUAL "")
      set(${out_reason} "source digest: ${tree_error}" PARENT_SCOPE)
      return()
    endif()
    phase20_check_remote_tree("${root}/provenance/ci-candidate-tree.json" "${source_dir}"
      "${current_manifest}" tree_error)
    if(NOT tree_error STREQUAL "")
      set(${out_reason} "source digest: candidate ${tree_error}" PARENT_SCOPE)
      return()
    endif()
    phase20_validate_run_json("${root}/provenance/nightly-run.json"
      "${root}/provenance/nightly-jobs.json" "${root}/provenance/nightly-artifacts.json" nightly
      "${identity_nightly_run_id}" "${identity_nightly_run_attempt}" "${identity_candidate_head_sha}"
      "${identity_tested_sha}" "${identity_base_sha}" "${identity_pr_number}" error)
    if(NOT error STREQUAL "")
      set(${out_reason} "Nightly provenance: ${error}" PARENT_SCOPE)
      return()
    endif()
    file(READ "${root}/provenance/nightly-commit.json" nightly_commit)
    phase20_json_get(nightly_tested "${nightly_commit}" sha)
    phase20_json_get(nightly_parent_count "${nightly_commit}" parents LENGTH)
    phase20_json_get(nightly_parent0 "${nightly_commit}" parents 0 sha)
    phase20_json_get(nightly_parent1 "${nightly_commit}" parents 1 sha)
    if(NOT nightly_tested STREQUAL identity_tested_sha OR NOT nightly_parent_count EQUAL 2 OR
       NOT ((nightly_parent0 STREQUAL identity_base_sha AND nightly_parent1 STREQUAL identity_candidate_head_sha) OR
            (nightly_parent1 STREQUAL identity_base_sha AND nightly_parent0 STREQUAL identity_candidate_head_sha)))
      set(${out_reason} "Nightly source mapping does not match the tested PR source" PARENT_SCOPE)
      return()
    endif()
    phase20_check_remote_tree("${root}/provenance/nightly-tested-tree.json" "${source_dir}"
      "${current_manifest}" tree_error)
    if(NOT tree_error STREQUAL "")
      set(${out_reason} "source digest: Nightly ${tree_error}" PARENT_SCOPE)
      return()
    endif()
    foreach(name IN ITEMS ci-logs.txt nightly-logs.txt)
      if(NOT EXISTS "${root}/provenance/${name}")
        set(${out_reason} "hosted provenance missing captured workflow logs" PARENT_SCOPE)
        return()
      endif()
    endforeach()
  else()
    # Fixture provenance is structurally complete but remains explicitly local.
    foreach(name IN ITEMS pr.json ci-run.json ci-commit.json candidate-commit.json ci-jobs.json ci-artifacts.json
        nightly-run.json nightly-jobs.json nightly-artifacts.json)
      if(NOT EXISTS "${root}/provenance/${name}")
        set(${out_reason} "fixture provenance missing ${name}" PARENT_SCOPE)
        return()
      endif()
    endforeach()
    phase20_validate_run_json("${root}/provenance/ci-run.json"
      "${root}/provenance/ci-jobs.json" "${root}/provenance/ci-artifacts.json" ci
      "1001" "1" "${identity_candidate_head_sha}" "${identity_tested_sha}" "${identity_base_sha}" "42" error)
    if(NOT error STREQUAL "")
      set(${out_reason} "fixture CI provenance: ${error}" PARENT_SCOPE)
      return()
    endif()
    phase20_validate_run_json("${root}/provenance/nightly-run.json"
      "${root}/provenance/nightly-jobs.json" "${root}/provenance/nightly-artifacts.json" nightly
      "2002" "1" "${identity_candidate_head_sha}" "${identity_tested_sha}" "${identity_base_sha}" "42" error)
    if(NOT error STREQUAL "")
      set(${out_reason} "fixture Nightly provenance: ${error}" PARENT_SCOPE)
      return()
    endif()
    file(READ "${root}/provenance/ci-commit.json" fixture_tested_commit)
    phase20_json_get(fixture_tested_sha "${fixture_tested_commit}" sha)
    phase20_json_get(fixture_parent_count "${fixture_tested_commit}" parents LENGTH)
    phase20_json_get(fixture_parent0 "${fixture_tested_commit}" parents 0 sha)
    phase20_json_get(fixture_parent1 "${fixture_tested_commit}" parents 1 sha)
    if(NOT fixture_tested_sha STREQUAL identity_tested_sha OR NOT fixture_parent_count EQUAL 2 OR
       NOT ((fixture_parent0 STREQUAL identity_base_sha AND fixture_parent1 STREQUAL identity_candidate_head_sha) OR
            (fixture_parent1 STREQUAL identity_base_sha AND fixture_parent0 STREQUAL identity_candidate_head_sha)))
      set(${out_reason} "source mapping: tested merge parents do not match PR base/head" PARENT_SCOPE)
      return()
    endif()
    file(READ "${root}/provenance/candidate-commit.json" fixture_candidate_commit)
    phase20_json_get(fixture_candidate_sha "${fixture_candidate_commit}" sha)
    if(NOT fixture_candidate_sha STREQUAL identity_candidate_head_sha)
      set(${out_reason} "source mapping: candidate commit SHA mismatch" PARENT_SCOPE)
      return()
    endif()
  endif()

  # Both offline fixtures and hosted bundles resolve the tested merge through
  # the same run/PR identity checks.
  file(READ "${root}/provenance/ci-run.json" source_run)
  file(READ "${root}/provenance/pr.json" source_pr)
  phase20_resolve_tested_sha("${source_run}" "${source_pr}" "${identity_candidate_head_sha}"
    "${identity_pr_number}" resolved_tested_sha error)
  if(NOT error STREQUAL "")
    set(${out_reason} "source mapping: ${error}" PARENT_SCOPE)
    return()
  endif()
  if(NOT resolved_tested_sha STREQUAL identity_tested_sha)
    set(${out_reason} "source mapping: PR merge SHA differs from tested source identity" PARENT_SCOPE)
    return()
  endif()

  # Require artifact identities before using their contents. For a fixture the
  # JSON is synthetic and only this offline control may admit it.
  foreach(platform IN LISTS NESTURBATOR_PHASE20_PLATFORMS)
    string(REPLACE "-" ";" parts "${platform}")
    list(GET parts 0 os)
    list(GET parts 1 arch)
    if(NOT EXISTS "${root}/artifacts/hashes-${platform}/hashes.txt")
      set(${out_reason} "hash artifact missing for platform ${platform}" PARENT_SCOPE)
      return()
    endif()
    foreach(file IN ITEMS protected-main/scoreboard.txt protected-main/metadata.txt LastTest.log)
      if(NOT EXISTS "${root}/artifacts/build-${platform}/${file}")
        set(${out_reason} "build artifact missing ${platform}/${file}" PARENT_SCOPE)
        return()
      endif()
    endforeach()
    phase20_read_properties("${root}/artifacts/build-${platform}/protected-main/metadata.txt"
      protected valid metadata_error)
    if(NOT metadata_error STREQUAL "" OR
       NOT protected_protected_revision STREQUAL identity_base_sha)
      set(${out_reason} "protected baseline for ${platform} is not bound to the tested PR base" PARENT_SCOPE)
      return()
    endif()
    file(SHA256 "${root}/artifacts/build-${platform}/protected-main/scoreboard.txt" lane_baseline_sha)
    if(NOT lane_baseline_sha STREQUAL protected_scoreboard_sha256)
      set(${out_reason} "protected baseline artifacts differ across platform identities" PARENT_SCOPE)
      return()
    endif()
  endforeach()

  execute_process(
    COMMAND "${CMAKE_COMMAND}" "-DROOT=${root}/artifacts"
      -P "${source_dir}/tests/cmake/hash_inventory.cmake"
    RESULT_VARIABLE hash_result OUTPUT_VARIABLE hash_stdout ERROR_VARIABLE hash_stderr)
  if(NOT "${hash_result}" STREQUAL "0")
    set(${out_reason} "hash inventory content validation failed: ${hash_stdout}${hash_stderr}" PARENT_SCOPE)
    return()
  endif()
  phase20_validate_scoreboard("${root}/artifacts/candidate-scoreboard.txt"
    "${root}/artifacts/build-linux-x64/protected-main/scoreboard.txt"
    "${root}/artifacts/build-linux-x64/protected-main/metadata.txt"
    "${identity_base_sha}" error)
  if(NOT error STREQUAL "")
    set(${out_reason} "${error}" PARENT_SCOPE)
    return()
  endif()
  phase20_validate_campaign("${root}" "${source_dir}" "${identity_tested_sha}" error)
  if(NOT error STREQUAL "")
    set(${out_reason} "${error}" PARENT_SCOPE)
    return()
  endif()
  file(SHA256 "${root}/artifacts/candidate-scoreboard.txt" captured_scoreboard_sha)
  file(SHA256 "${source_dir}/tests/accuracy/scoreboard.txt" source_scoreboard_sha)
  if(NOT captured_scoreboard_sha STREQUAL source_scoreboard_sha)
    set(${out_reason} "source identity: candidate scoreboard artifact differs from current effective source" PARENT_SCOPE)
    return()
  endif()
  phase20_validate_build_logs("${root}" error)
  if(NOT error STREQUAL "")
    set(${out_reason} "${error}" PARENT_SCOPE)
    return()
  endif()
  set(marker "${root}/artifacts/retroarch/marker-progression.txt")
  if(NOT EXISTS "${marker}")
    set(${out_reason} "RetroArch marker-progression artifact missing" PARENT_SCOPE)
    return()
  endif()
  file(READ "${marker}" marker_text)
  if(NOT marker_text MATCHES "progression boundaries=16 mode=complete verdict=VERDICT_OK")
    set(${out_reason} "RetroArch host marker progression did not produce VERDICT_OK" PARENT_SCOPE)
    return()
  endif()
  phase20_validate_perf("${root}" "${source_dir}" "${identity_ci_run_id}"
    "${identity_ci_run_attempt}" "${identity_candidate_head_sha}" "${identity_tested_sha}"
    "${identity_base_sha}" error)
  if(NOT error STREQUAL "")
    set(${out_reason} "${error}" PARENT_SCOPE)
    return()
  endif()
  phase20_validate_nightly("${root}" error)
  if(NOT error STREQUAL "")
    set(${out_reason} "${error}" PARENT_SCOPE)
    return()
  endif()
  if(identity_provenance_kind STREQUAL "hosted")
    if(NOT skip_file_hash)
      phase20_read_properties("${root}/manifest.txt" checked_manifest valid manifest_error)
      if(NOT manifest_error STREQUAL "" OR NOT checked_manifest_verdict STREQUAL "hosted-pass")
        set(${out_reason} "hosted evidence manifest is missing or invalid" PARENT_SCOPE)
        return()
      endif()
      phase20_verify_evidence_manifest("${root}" "${checked_manifest_evidence_files_sha256}" error)
      if(NOT error STREQUAL "")
        set(${out_reason} "${error}" PARENT_SCOPE)
        return()
      endif()
    endif()
    set(verdict "hosted-pass")
  else()
    set(verdict "fixture-pass")
  endif()
  set(${out_ok} TRUE PARENT_SCOPE)
  set(${out_reason} "${verdict}" PARENT_SCOPE)
endfunction()

function(phase20_gh_api repository endpoint output_path out_error)
  execute_process(
    COMMAND gh api --repo "${repository}" "${endpoint}"
    RESULT_VARIABLE api_result OUTPUT_FILE "${output_path}" ERROR_VARIABLE api_error)
  if(NOT "${api_result}" STREQUAL "0")
    file(REMOVE "${output_path}")
    if("${api_error}" MATCHES "(?i)authentication|not logged|401|403|token")
      set(${out_error} "read-only GitHub authentication is required (run gh auth login); token values were not printed" PARENT_SCOPE)
    else()
      set(${out_error} "read-only GitHub API request failed for ${endpoint}: ${api_error}" PARENT_SCOPE)
    endif()
    return()
  endif()
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(phase20_download_artifact repository artifact_id root relative_path out_error)
  set(zip "${root}/downloads/${artifact_id}.zip")
  set(destination "${root}/downloads/${artifact_id}")
  file(MAKE_DIRECTORY "${root}/downloads")
  execute_process(
    COMMAND gh api --repo "${repository}" "repos/${repository}/actions/artifacts/${artifact_id}/zip"
    RESULT_VARIABLE api_result OUTPUT_FILE "${zip}" ERROR_VARIABLE api_error)
  if(NOT "${api_result}" STREQUAL "0" OR NOT EXISTS "${zip}")
    set(${out_error} "artifact ${artifact_id} download failed: ${api_error}" PARENT_SCOPE)
    return()
  endif()
  file(SHA256 "${zip}" archive_sha)
  file(WRITE "${root}/provenance/artifact-${artifact_id}.sha256" "${archive_sha}\n")
  execute_process(
    COMMAND "${CMAKE_COMMAND}" -E tar tf "${zip}"
    RESULT_VARIABLE list_result OUTPUT_VARIABLE archive_paths ERROR_VARIABLE archive_error)
  if(NOT "${list_result}" STREQUAL "0")
    set(${out_error} "artifact ${artifact_id} is not a readable archive: ${archive_error}" PARENT_SCOPE)
    return()
  endif()
  string(REPLACE "\r\n" "\n" archive_paths "${archive_paths}")
  string(REPLACE "\n" ";" entries "${archive_paths}")
  foreach(entry IN LISTS entries)
    string(FIND "${entry}" "\\" backslash_position)
    if(entry MATCHES "^/" OR entry MATCHES "^[A-Za-z]:" OR
       entry MATCHES "(^|/)\\.\\.(/|$)" OR entry MATCHES "^\\./" OR
       NOT backslash_position EQUAL -1)
      set(${out_error} "artifact ${artifact_id} has an unsafe extraction path" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  file(REMOVE_RECURSE "${destination}")
  file(MAKE_DIRECTORY "${destination}")
  execute_process(
    COMMAND "${CMAKE_COMMAND}" -E tar xvf "${zip}"
    WORKING_DIRECTORY "${destination}"
    RESULT_VARIABLE extract_result OUTPUT_VARIABLE extract_output ERROR_VARIABLE extract_error)
  if(NOT "${extract_result}" STREQUAL "0")
    set(${out_error} "artifact ${artifact_id} extraction failed: ${extract_error}" PARENT_SCOPE)
    return()
  endif()
  file(GLOB_RECURSE extracted LIST_DIRECTORIES TRUE "${destination}/*")
  foreach(path IN LISTS extracted)
    if(IS_SYMLINK "${path}")
      set(${out_error} "artifact ${artifact_id} contains an unexpected symbolic link" PARENT_SCOPE)
      return()
    endif()
    file(REAL_PATH "${path}" real_path)
    string(FIND "${real_path}" "${destination}/" destination_position)
    if(NOT destination_position EQUAL 0)
      set(${out_error} "artifact ${artifact_id} extracted outside its scratch directory" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out_error} "" PARENT_SCOPE)
  set(${relative_path} "${destination}" PARENT_SCOPE)
endfunction()

function(phase20_copy_unique source_root pattern destination out_error)
  file(GLOB_RECURSE matches LIST_DIRECTORIES FALSE "${source_root}/${pattern}")
  list(LENGTH matches match_count)
  if(NOT match_count EQUAL 1)
    set(${out_error} "expected one artifact content matching ${pattern}, found ${match_count}" PARENT_SCOPE)
    return()
  endif()
  get_filename_component(parent "${destination}" DIRECTORY)
  file(MAKE_DIRECTORY "${parent}")
  configure_file("${matches}" "${destination}" COPYONLY)
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(nesturbator_phase20_collect_evidence root source_dir out_ok out_reason)
  set(delivery "${root}/delivery.json")
  if(NOT EXISTS "${delivery}" OR IS_DIRECTORY "${delivery}")
    set(${out_ok} FALSE PARENT_SCOPE)
    set(${out_reason} "pending_delivery: create ROOT/delivery.json with authorized CI/Nightly run IDs and attempts" PARENT_SCOPE)
    return()
  endif()
  file(READ "${delivery}" delivery_json)
  foreach(key IN ITEMS repository ci_run_id ci_run_attempt nightly_run_id nightly_run_attempt candidate_head_sha pr_number)
    phase20_json_get(value "${delivery_json}" "${key}")
    if(value STREQUAL "")
      set(${out_ok} FALSE PARENT_SCOPE)
      set(${out_reason} "pending_delivery: delivery.json is missing ${key}" PARENT_SCOPE)
      return()
    endif()
    set("delivery_${key}" "${value}")
  endforeach()
  phase20_is_lower_hex("${delivery_candidate_head_sha}" 40 valid_delivery_sha)
  if(NOT delivery_repository STREQUAL NESTURBATOR_PHASE20_REPOSITORY OR
     NOT delivery_ci_run_id MATCHES "^[0-9]+$" OR NOT delivery_ci_run_attempt MATCHES "^[0-9]+$" OR
     NOT delivery_nightly_run_id MATCHES "^[0-9]+$" OR NOT delivery_nightly_run_attempt MATCHES "^[0-9]+$" OR
     NOT delivery_pr_number MATCHES "^[0-9]+$" OR NOT valid_delivery_sha)
    set(${out_ok} FALSE PARENT_SCOPE)
    set(${out_reason} "pending_delivery: delivery.json repository/IDs/attempts/SHA are invalid" PARENT_SCOPE)
    return()
  endif()
  find_program(GH_EXECUTABLE gh)
  if(NOT GH_EXECUTABLE)
    set(${out_ok} FALSE PARENT_SCOPE)
    set(${out_reason} "pending_delivery: GitHub CLI (gh) is required for read-only collection" PARENT_SCOPE)
    return()
  endif()
  file(REMOVE_RECURSE "${root}/downloads" "${root}/artifacts" "${root}/provenance")
  file(MAKE_DIRECTORY "${root}/provenance" "${root}/artifacts")
  configure_file("${delivery}" "${root}/provenance/delivery.json" COPYONLY)
  set(repo "${delivery_repository}")
  foreach(spec IN ITEMS "ci|${delivery_ci_run_id}|${delivery_ci_run_attempt}"
      "nightly|${delivery_nightly_run_id}|${delivery_nightly_run_attempt}")
    string(REPLACE "|" ";" fields "${spec}")
    list(GET fields 0 prefix)
    list(GET fields 1 run_id)
    list(GET fields 2 attempt)
    foreach(request IN ITEMS "run|repos/${repo}/actions/runs/${run_id}/attempts/${attempt}"
        "jobs|repos/${repo}/actions/runs/${run_id}/attempts/${attempt}/jobs?per_page=100"
        "artifacts|repos/${repo}/actions/runs/${run_id}/artifacts?per_page=100")
      string(REPLACE "|" ";" parts "${request}")
      list(GET parts 0 kind)
      list(GET parts 1 endpoint)
      phase20_gh_api("${repo}" "${endpoint}" "${root}/provenance/${prefix}-${kind}.json" api_error)
      if(NOT api_error STREQUAL "")
        set(${out_ok} FALSE PARENT_SCOPE)
        set(${out_reason} "pending_delivery: ${api_error}" PARENT_SCOPE)
        return()
      endif()
    endforeach()
    execute_process(
      COMMAND gh run view "${run_id}" --repo "${repo}" --attempt "${attempt}" --log
      RESULT_VARIABLE log_result OUTPUT_FILE "${root}/provenance/${prefix}-logs.txt"
      ERROR_VARIABLE log_error)
    if(NOT "${log_result}" STREQUAL "0")
      set(${out_ok} FALSE PARENT_SCOPE)
      set(${out_reason} "pending_delivery: read-only gh run view --log failed: ${log_error}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  file(READ "${root}/provenance/ci-run.json" ci_run)
  phase20_json_get(run_head_sha "${ci_run}" head_sha)
  phase20_json_get(pr_base "${ci_run}" pull_requests 0 base sha)
  phase20_json_get(pr_head "${ci_run}" pull_requests 0 head sha)
  phase20_json_get(pr_number "${ci_run}" pull_requests 0 number)
  phase20_is_lower_hex("${pr_base}" 40 valid_pr_base)
  if(NOT pr_head STREQUAL delivery_candidate_head_sha OR NOT pr_number STREQUAL delivery_pr_number OR
     NOT valid_pr_base OR NOT run_head_sha STREQUAL delivery_candidate_head_sha)
    set(${out_ok} FALSE PARENT_SCOPE)
    set(${out_reason} "incomplete: CI run PR/base/head mapping differs from delivery.json" PARENT_SCOPE)
    return()
  endif()
  phase20_gh_api("${repo}" "repos/${repo}/pulls/${delivery_pr_number}"
    "${root}/provenance/pr.json" api_error)
  if(NOT api_error STREQUAL "")
    set(${out_ok} FALSE PARENT_SCOPE)
    set(${out_reason} "incomplete: ${api_error}" PARENT_SCOPE)
    return()
  endif()
  file(READ "${root}/provenance/pr.json" pr_snapshot)
  phase20_resolve_tested_sha("${ci_run}" "${pr_snapshot}" "${delivery_candidate_head_sha}"
    "${delivery_pr_number}" tested_sha source_error)
  if(NOT source_error STREQUAL "")
    set(${out_ok} FALSE PARENT_SCOPE)
    set(${out_reason} "incomplete: ${source_error}" PARENT_SCOPE)
    return()
  endif()
  set(base_sha "${pr_base}")
  foreach(spec IN ITEMS "ci|${tested_sha}" "candidate|${delivery_candidate_head_sha}"
      "nightly|${tested_sha}")
    string(REPLACE "|" ";" fields "${spec}")
    list(GET fields 0 prefix)
    list(GET fields 1 sha)
    phase20_gh_api("${repo}" "repos/${repo}/git/commits/${sha}"
      "${root}/provenance/${prefix}-commit.json" api_error)
    if(NOT api_error STREQUAL "")
      set(${out_ok} FALSE PARENT_SCOPE)
      set(${out_reason} "incomplete: ${api_error}" PARENT_SCOPE)
      return()
    endif()
    file(READ "${root}/provenance/${prefix}-commit.json" commit_json)
    phase20_json_get(tree_sha "${commit_json}" tree sha)
    phase20_is_lower_hex("${tree_sha}" 40 valid_tree_sha)
    if(NOT valid_tree_sha)
      set(${out_ok} FALSE PARENT_SCOPE)
      set(${out_reason} "incomplete: GitHub commit response has no tree SHA" PARENT_SCOPE)
      return()
    endif()
    phase20_gh_api("${repo}" "repos/${repo}/git/trees/${tree_sha}?recursive=1"
      "${root}/provenance/${prefix}-tree.json" api_error)
    if(NOT api_error STREQUAL "")
      set(${out_ok} FALSE PARENT_SCOPE)
      set(${out_reason} "incomplete: ${api_error}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  # Keep expected filenames stable for the shared validator.
  configure_file("${root}/provenance/ci-tree.json" "${root}/provenance/ci-tested-tree.json" COPYONLY)
  configure_file("${root}/provenance/candidate-tree.json" "${root}/provenance/ci-candidate-tree.json" COPYONLY)
  configure_file("${root}/provenance/nightly-tree.json" "${root}/provenance/nightly-tested-tree.json" COPYONLY)
  file(READ "${root}/provenance/ci-artifacts.json" ci_artifacts)
  file(READ "${root}/provenance/nightly-artifacts.json" nightly_artifacts)
  file(READ "${root}/provenance/ci-jobs.json" ci_jobs)
  file(READ "${root}/provenance/nightly-jobs.json" nightly_jobs)
  phase20_validate_run_json("${root}/provenance/ci-run.json" "${root}/provenance/ci-jobs.json"
    "${root}/provenance/ci-artifacts.json" ci "${delivery_ci_run_id}" "${delivery_ci_run_attempt}"
    "${delivery_candidate_head_sha}" "${tested_sha}" "${base_sha}" "${delivery_pr_number}" error)
  if(NOT error STREQUAL "")
    set(${out_ok} FALSE PARENT_SCOPE)
    set(${out_reason} "incomplete: CI provenance: ${error}" PARENT_SCOPE)
    return()
  endif()
  phase20_validate_run_json("${root}/provenance/nightly-run.json" "${root}/provenance/nightly-jobs.json"
    "${root}/provenance/nightly-artifacts.json" nightly "${delivery_nightly_run_id}"
    "${delivery_nightly_run_attempt}" "${delivery_candidate_head_sha}" "${tested_sha}" "${base_sha}" "${delivery_pr_number}" error)
  if(NOT error STREQUAL "")
    set(${out_ok} FALSE PARENT_SCOPE)
    set(${out_reason} "incomplete: Nightly provenance: ${error}" PARENT_SCOPE)
    return()
  endif()
  # Download each named artifact by its immutable artifact ID after the API
  # metadata has bound its ID to this run. No downloaded file is executed.
  foreach(platform IN LISTS NESTURBATOR_PHASE20_PLATFORMS)
    string(REPLACE "-" ";" parts "${platform}")
    list(GET parts 0 os)
    list(GET parts 1 arch)
    foreach(spec IN ITEMS "hashes-${os}-${arch}|hashes-${os}-${arch}"
        "accuracycoin-evidence-${os}-${arch}-${delivery_ci_run_id}-${delivery_ci_run_attempt}|build-${platform}")
      string(REPLACE "|" ";" fields "${spec}")
      list(GET fields 0 name)
      list(GET fields 1 dest)
      phase20_json_get(count "${ci_artifacts}" artifacts LENGTH)
      set(artifact_id "")
      if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE 0 ${last})
          phase20_json_get(candidate_name "${ci_artifacts}" artifacts ${index} name)
          if(candidate_name STREQUAL name)
            phase20_json_get(artifact_id "${ci_artifacts}" artifacts ${index} id)
          endif()
        endforeach()
      endif()
      phase20_download_artifact("${repo}" "${artifact_id}" "${root}" download_dir error)
      if(NOT error STREQUAL "")
        set(${out_ok} FALSE PARENT_SCOPE)
        set(${out_reason} "incomplete: ${error}" PARENT_SCOPE)
        return()
      endif()
      if(dest MATCHES "^hashes-")
        phase20_copy_unique("${download_dir}" "hashes.txt" "${root}/artifacts/${dest}/hashes.txt" error)
      else()
        foreach(pattern IN ITEMS "LastTest.log" "protected-main/scoreboard.txt"
            "protected-main/metadata.txt" "full/metadata.txt" "full/report.tsv" "full/inventory.tsv")
          if(platform STREQUAL "linux-x64" OR NOT pattern MATCHES "^full/")
            phase20_copy_unique("${download_dir}" "**/${pattern}" "${root}/artifacts/${dest}/${pattern}" error)
            if(NOT error STREQUAL "")
              set(${out_ok} FALSE PARENT_SCOPE)
              set(${out_reason} "incomplete: ${error}" PARENT_SCOPE)
              return()
            endif()
          endif()
        endforeach()
      endif()
    endforeach()
  endforeach()
  foreach(name IN ITEMS "phase20-perf-${delivery_ci_run_id}-${delivery_ci_run_attempt}" retroarch-marker-progression)
    phase20_json_get(count "${ci_artifacts}" artifacts LENGTH)
    set(artifact_id "")
    if(count GREATER 0)
      math(EXPR last "${count} - 1")
      foreach(index RANGE 0 ${last})
        phase20_json_get(candidate_name "${ci_artifacts}" artifacts ${index} name)
        if(candidate_name STREQUAL name)
          phase20_json_get(artifact_id "${ci_artifacts}" artifacts ${index} id)
        endif()
      endforeach()
    endif()
    phase20_download_artifact("${repo}" "${artifact_id}" "${root}" download_dir error)
    if(NOT error STREQUAL "")
      set(${out_ok} FALSE PARENT_SCOPE)
      set(${out_reason} "incomplete: ${error}" PARENT_SCOPE)
      return()
    endif()
    if(name MATCHES "^phase20-perf-")
      foreach(pattern IN ITEMS "summary.md" "identity.txt" "base_a_*.out" "base_b_*.out" "head_*.out")
        file(GLOB_RECURSE found LIST_DIRECTORIES FALSE "${download_dir}/${pattern}")
        foreach(item IN LISTS found)
          get_filename_component(filename "${item}" NAME)
          file(COPY_FILE "${item}" "${root}/artifacts/perf/${filename}")
        endforeach()
      endforeach()
    else()
      phase20_copy_unique("${download_dir}" "*marker-progression*" "${root}/artifacts/retroarch/marker-progression.txt" error)
      if(NOT error STREQUAL "")
        set(${out_ok} FALSE PARENT_SCOPE)
        set(${out_reason} "incomplete: ${error}" PARENT_SCOPE)
        return()
      endif()
    endif()
  endforeach()
  foreach(lane IN ITEMS vectors-full mmc3-oracle)
    set(name "${lane}-evidence-${delivery_nightly_run_id}")
    phase20_json_get(count "${nightly_artifacts}" artifacts LENGTH)
    set(artifact_id "")
    if(count GREATER 0)
      math(EXPR last "${count} - 1")
      foreach(index RANGE 0 ${last})
        phase20_json_get(candidate_name "${nightly_artifacts}" artifacts ${index} name)
        if(candidate_name STREQUAL name)
          phase20_json_get(artifact_id "${nightly_artifacts}" artifacts ${index} id)
        endif()
      endforeach()
    endif()
    phase20_download_artifact("${repo}" "${artifact_id}" "${root}" download_dir error)
    if(NOT error STREQUAL "")
      set(${out_ok} FALSE PARENT_SCOPE)
      set(${out_reason} "incomplete: ${error}" PARENT_SCOPE)
      return()
    endif()
    file(GLOB_RECURSE lane_files LIST_DIRECTORIES FALSE "${download_dir}/*")
    foreach(item IN LISTS lane_files)
      get_filename_component(filename "${item}" NAME)
      file(COPY_FILE "${item}" "${root}/artifacts/nightly/${lane}/${filename}")
    endforeach()
  endforeach()
  phase20_copy_unique("${source_dir}" "tests/accuracy/scoreboard.txt"
    "${root}/artifacts/candidate-scoreboard.txt" error)
  if(NOT error STREQUAL "")
    set(${out_ok} FALSE PARENT_SCOPE)
    set(${out_reason} "incomplete: ${error}" PARENT_SCOPE)
    return()
  endif()
  phase20_compute_effective_digest("${source_dir}" digest source_count source_manifest digest_error)
  if(NOT digest_error STREQUAL "")
    set(${out_ok} FALSE PARENT_SCOPE)
    set(${out_reason} "incomplete: ${digest_error}" PARENT_SCOPE)
    return()
  endif()
  file(WRITE "${root}/provenance/effective-inputs.tsv" "${source_manifest}")
  file(SHA256 "${root}/provenance/effective-inputs.tsv" inputs_file_sha)
  string(TIMESTAMP retrieved_at "%Y-%m-%dT%H:%M:%SZ" UTC)
  file(WRITE "${root}/provenance/source-identity.txt"
    "repository=${repo}\nci_run_id=${delivery_ci_run_id}\nci_run_attempt=${delivery_ci_run_attempt}\nnightly_run_id=${delivery_nightly_run_id}\nnightly_run_attempt=${delivery_nightly_run_attempt}\npr_number=${delivery_pr_number}\ncandidate_head_sha=${delivery_candidate_head_sha}\ntested_sha=${tested_sha}\nbase_sha=${base_sha}\nsource_digest=${digest}\nsource_count=${source_count}\neffective_inputs_sha256=${inputs_file_sha}\nprovenance_kind=hosted\nretrieved_at=${retrieved_at}\n")
  nesturbator_phase20_validate_evidence("${root}" "${source_dir}" valid reason FALSE TRUE)
  if(NOT valid)
    set(${out_ok} FALSE PARENT_SCOPE)
    set(${out_reason} "incomplete: ${reason}" PARENT_SCOPE)
    return()
  endif()
  phase20_compute_evidence_manifest("${root}" evidence_manifest evidence_files_sha evidence_error)
  if(NOT evidence_error STREQUAL "")
    set(${out_ok} FALSE PARENT_SCOPE)
    set(${out_reason} "incomplete: ${evidence_error}" PARENT_SCOPE)
    return()
  endif()
  file(WRITE "${root}/provenance/evidence-files.sha256" "${evidence_manifest}")
  file(SHA256 "${root}/provenance/ci-run.json" ci_run_sha)
  file(SHA256 "${root}/provenance/ci-jobs.json" ci_jobs_sha)
  file(SHA256 "${root}/provenance/ci-artifacts.json" ci_artifacts_sha)
  file(WRITE "${root}/manifest.txt"
    "verdict=hosted-pass\nrepository=${repo}\nci_run_id=${delivery_ci_run_id}\nci_run_attempt=${delivery_ci_run_attempt}\nnightly_run_id=${delivery_nightly_run_id}\nnightly_run_attempt=${delivery_nightly_run_attempt}\npr_number=${delivery_pr_number}\ncandidate_head_sha=${delivery_candidate_head_sha}\ntested_sha=${tested_sha}\nbase_sha=${base_sha}\nsource_digest=${digest}\nsource_count=${source_count}\nsource_inputs_sha256=${inputs_file_sha}\nevidence_files_sha256=${evidence_files_sha}\nci_run_metadata_sha256=${ci_run_sha}\nci_jobs_metadata_sha256=${ci_jobs_sha}\nci_artifacts_metadata_sha256=${ci_artifacts_sha}\nretrieved_at=${retrieved_at}\n")
  # The checksum list itself is not self-hashed, so run the same validator a
  # second time after the manifest can verify every artifact and raw file.
  nesturbator_phase20_validate_evidence("${root}" "${source_dir}" valid reason FALSE)
  if(NOT valid)
    file(REMOVE "${root}/manifest.txt")
    set(${out_ok} FALSE PARENT_SCOPE)
    set(${out_reason} "incomplete: ${reason}" PARENT_SCOPE)
    return()
  endif()
  set(${out_ok} TRUE PARENT_SCOPE)
  set(${out_reason} "hosted-pass" PARENT_SCOPE)
endfunction()

if(NESTURBATOR_PHASE20_EVIDENCE_LIBRARY_ONLY)
  return()
endif()
foreach(required MODE ROOT SOURCE_REF)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "phase20 hosted evidence requires ${required}")
  endif()
endforeach()
get_filename_component(root "${ROOT}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
if(NOT IS_DIRECTORY "${root}")
  file(MAKE_DIRECTORY "${root}")
endif()
file(REAL_PATH "${root}" root)
file(REAL_PATH "${SOURCE_REF}" source_real)
string(FIND "${root}" "${source_real}/build/" project_build_position)
string(FIND "${root}" "/private/tmp/" private_tmp_position)
string(FIND "${root}" "/tmp/" tmp_position)
if(NOT project_build_position EQUAL 0 AND NOT private_tmp_position EQUAL 0 AND NOT tmp_position EQUAL 0)
  message(FATAL_ERROR "phase20 evidence ROOT must be a project build scratch path or /tmp path")
endif()
if(MODE STREQUAL "collect")
  nesturbator_phase20_collect_evidence("${root}" "${SOURCE_REF}" ok reason)
  if(NOT ok)
    file(WRITE "${root}/verdict.txt" "verdict=pending_delivery\nreason=${reason}\n")
    message(FATAL_ERROR "${reason}")
  endif()
  file(WRITE "${root}/verdict.txt" "verdict=hosted-pass\n")
  message(STATUS "hosted phase20 evidence verified; see ${root}/manifest.txt")
else()
  nesturbator_phase20_validate_evidence("${root}" "${SOURCE_REF}" ok reason FALSE)
  if(NOT ok)
    message(FATAL_ERROR "${reason}")
  endif()
  if(NOT EXISTS "${root}/manifest.txt")
    message(FATAL_ERROR "hosted evidence manifest is missing")
  endif()
  phase20_read_properties("${root}/manifest.txt" manifest valid manifest_error)
  phase20_read_properties("${root}/provenance/source-identity.txt" identity valid identity_error)
  if(NOT manifest_error STREQUAL "" OR NOT identity_error STREQUAL "" OR
     NOT manifest_verdict STREQUAL "hosted-pass" OR
     NOT manifest_repository STREQUAL identity_repository OR
     NOT manifest_ci_run_id STREQUAL identity_ci_run_id OR
     NOT manifest_ci_run_attempt STREQUAL identity_ci_run_attempt OR
     NOT manifest_nightly_run_id STREQUAL identity_nightly_run_id OR
     NOT manifest_nightly_run_attempt STREQUAL identity_nightly_run_attempt OR
     NOT manifest_pr_number STREQUAL identity_pr_number OR
     NOT manifest_candidate_head_sha STREQUAL identity_candidate_head_sha OR
     NOT manifest_tested_sha STREQUAL identity_tested_sha OR
     NOT manifest_base_sha STREQUAL identity_base_sha OR
     NOT manifest_source_digest STREQUAL identity_source_digest OR
     NOT manifest_source_count STREQUAL identity_source_count)
    message(FATAL_ERROR "hosted manifest does not bind the verified source identity")
  endif()
  file(WRITE "${root}/verdict.txt" "verdict=hosted-pass\n")
  message(STATUS "hosted phase20 evidence revalidated; see ${root}/manifest.txt")
endif()
