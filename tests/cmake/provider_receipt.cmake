function(pr_d44_validate_paths changed_paths out_error)
  if(RESET_KIND STREQUAL "d51-receipt-v1")
    set(expected_paths README.md docs/releases.md docs/testing.md tests/cmake/provider_receipt.cmake)
    set(route_label D-51)
    set(expected_count 4)
  elseif(RESET_KIND STREQUAL "d46-observer-v1")
    set(expected_paths README.md docs/releases.md docs/testing.md tests/cmake/provider_receipt.cmake)
    set(route_label D-46)
    set(expected_count 4)
  elseif(RESET_KIND STREQUAL "d45-controls-v1")
    set(expected_paths README.md docs/releases.md docs/testing.md
      tests/cmake/accuracycoin_input_fingerprint_controls.cmake
      tests/cmake/provider_receipt.cmake)
    set(route_label D-45)
    set(expected_count 5)
  else()
    set(expected_paths
      README.md docs/releases.md docs/testing.md
      tests/accuracy/input-binding-v1.json
      tests/cmake/accuracycoin_activation.cmake
      tests/cmake/accuracycoin_input_fingerprint.cmake
      tests/cmake/accuracycoin_input_fingerprint_controls.cmake
      tests/cmake/provider_receipt.cmake)
    set(route_label D-44)
    set(expected_count eight)
  endif()
  set(raw_paths "${changed_paths}")
  list(LENGTH raw_paths raw_count)
  list(REMOVE_DUPLICATES raw_paths)
  list(LENGTH raw_paths unique_count)
  if(NOT raw_count EQUAL unique_count)
    set(${out_error} "reset-scope: ${route_label} allowlist contains a duplicate path" PARENT_SCOPE)
    return()
  endif()
  set(actual_paths "${raw_paths}")
  list(FILTER actual_paths EXCLUDE REGEX "^\\.planning/")
  list(FILTER actual_paths EXCLUDE REGEX "^$")
  list(SORT actual_paths)
  list(SORT expected_paths)
  if(NOT "${actual_paths}" STREQUAL "${expected_paths}")
    set(${out_error} "reset-scope: ${route_label} delta must be exactly the ${expected_count} reviewed paths" PARENT_SCOPE)
    return()
  endif()
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(pr_d44_validate_values base branch source_root output_root route_path acceptance acceptance_markdown out_error)
  set(${out_error} "" PARENT_SCOPE)
  if(RESET_KIND STREQUAL "d51-receipt-v1")
    set(route_label D-51)
  elseif(RESET_KIND STREQUAL "d46-observer-v1")
    set(route_label D-46)
  elseif(RESET_KIND STREQUAL "d45-controls-v1")
    set(route_label D-45)
  else()
    set(route_label D-44)
  endif()
  if(NOT "${base}" STREQUAL D44_BASE)
    set(${out_error} "reset-base: ${route_label} requires its exact frozen base" PARENT_SCOPE)
    return()
  endif()
  if(NOT "${branch}" STREQUAL D44_BRANCH)
    set(${out_error} "reset-checkout: ${route_label} requires its approved candidate branch" PARENT_SCOPE)
    return()
  endif()
  if(NOT IS_ABSOLUTE "${source_root}")
    set(${out_error} "reset-checkout: ${route_label} source root must be absolute" PARENT_SCOPE)
    return()
  endif()
  set(expected_output_root "${source_root}/${D44_OUTPUT_RELATIVE}")
  set(expected_route_path "${expected_output_root}/route.json")
  set(expected_acceptance "${source_root}/${D44_IDENTITY_RELATIVE}")
  set(expected_markdown "${source_root}/${D44_ACCEPTANCE_MARKDOWN_RELATIVE}")
  if(NOT "${output_root}" STREQUAL expected_output_root OR
     NOT "${route_path}" STREQUAL expected_route_path)
    set(${out_error} "reset-route: ${route_label} route and output root must stay under ${D44_OUTPUT_RELATIVE}" PARENT_SCOPE)
    return()
  endif()
  if(NOT "${acceptance}" STREQUAL expected_acceptance OR
     NOT "${acceptance_markdown}" STREQUAL expected_markdown)
    set(${out_error} "reset-evidence: ${route_label} identity and acceptance paths must use the selected workstream record" PARENT_SCOPE)
    return()
  endif()
endfunction()

function(pr_d44_validate_checkout source_dir base route_path acceptance acceptance_markdown out_error)
  get_filename_component(source_real "${source_dir}" REALPATH)
  execute_process(COMMAND git -C "${source_real}" rev-parse --show-toplevel
    RESULT_VARIABLE root_result OUTPUT_VARIABLE git_root ERROR_VARIABLE root_error TIMEOUT 10)
  execute_process(COMMAND git -C "${source_real}" branch --show-current
    RESULT_VARIABLE branch_result OUTPUT_VARIABLE branch ERROR_VARIABLE branch_error TIMEOUT 10)
  execute_process(COMMAND git -C "${source_real}" merge-base --is-ancestor "${D44_BASE}" HEAD
    RESULT_VARIABLE base_result OUTPUT_QUIET ERROR_VARIABLE base_error TIMEOUT 10)
  string(STRIP "${git_root}" git_root)
  string(STRIP "${branch}" branch)
  if(NOT "${source_dir}" STREQUAL source_real OR NOT root_result STREQUAL "0" OR
     NOT "${git_root}" STREQUAL source_real OR NOT branch_result STREQUAL "0" OR
     NOT base_result STREQUAL "0")
    set(${out_error} "reset-checkout: D-44 source root, branch, or frozen-base ancestry is invalid: ${root_error}${branch_error}${base_error}" PARENT_SCOPE)
    return()
  endif()
  set(output_root "${source_real}/${D44_OUTPUT_RELATIVE}")
  pr_d44_validate_values("${base}" "${branch}" "${source_real}" "${output_root}"
    "${route_path}" "${acceptance}" "${acceptance_markdown}" identity_error)
  if(identity_error)
    set(${out_error} "${identity_error}" PARENT_SCOPE)
    return()
  endif()
  if(IS_SYMLINK "${source_real}/build" OR IS_SYMLINK "${output_root}" OR
     IS_SYMLINK "${route_path}" OR IS_SYMLINK "${route_path}.lock")
    set(${out_error} "reset-route: D-44 source output root, ledger, and lock cannot be symlinks" PARENT_SCOPE)
    return()
  endif()
  file(SHA256 "${source_real}/tests/CMakeLists.txt" current_cmake_sha)
  if(NOT "${current_cmake_sha}" STREQUAL "a4179a215765f1b783e7a408f55d2eb9f9264c0cb315215c9da09e0336624ea2")
    set(${out_error} "reset-scope: D-44 current CMake registration bytes changed" PARENT_SCOPE)
    return()
  endif()
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(pr_d44_validate_route_fields route source_root branch output_root acceptance acceptance_markdown out_error)
  if(RESET_KIND STREQUAL "d51-receipt-v1")
    set(expected_reset_kind d51-receipt-v1)
    set(route_label D-51)
  elseif(RESET_KIND STREQUAL "d46-observer-v1")
    set(expected_reset_kind d46-observer-v1)
    set(route_label D-46)
  elseif(RESET_KIND STREQUAL "d45-controls-v1")
    set(expected_reset_kind d45-controls-v1)
    set(route_label D-45)
  else()
    set(expected_reset_kind d44-evidence-v1)
    set(route_label D-44)
  endif()
  set(expected_route_fields schema_version stages base source_root source_commit source_tree
    manifest_sha256 donor_commit profile_sha256 guide_sha256 notice_sha256 reset_kind
    source_branch output_root acceptance_path acceptance_markdown_path)
  list(LENGTH expected_route_fields expected_count)
  string(JSON route_type ERROR_VARIABLE route_error TYPE "${route}")
  string(JSON route_count ERROR_VARIABLE count_error LENGTH "${route}")
  if(route_error OR count_error OR NOT route_type STREQUAL "OBJECT" OR
     NOT route_count EQUAL expected_count)
    set(${out_error} "reset-route: D-44 ledger has missing, duplicate, unknown or malformed fields" PARENT_SCOPE)
    return()
  endif()
  string(JSON schema_type ERROR_VARIABLE schema_type_error TYPE "${route}" schema_version)
  string(JSON schema_value ERROR_VARIABLE schema_value_error GET "${route}" schema_version)
  if(schema_type_error OR schema_value_error OR NOT schema_type STREQUAL "NUMBER" OR
     NOT schema_value STREQUAL "1")
    set(${out_error} "reset-route: D-44 schema_version must be JSON NUMBER 1" PARENT_SCOPE)
    return()
  endif()
  string(JSON stages_type ERROR_VARIABLE stages_type_error TYPE "${route}" stages)
  if(stages_type_error OR NOT stages_type STREQUAL "OBJECT")
    set(${out_error} "reset-route: D-44 stages must be a JSON OBJECT" PARENT_SCOPE)
    return()
  endif()
  foreach(field IN ITEMS base source_root source_commit source_tree manifest_sha256
      donor_commit profile_sha256 guide_sha256 notice_sha256 reset_kind source_branch
      output_root acceptance_path acceptance_markdown_path)
    string(JSON field_type ERROR_VARIABLE field_type_error TYPE "${route}" "${field}")
    if(field_type_error OR NOT field_type STREQUAL "STRING")
      set(${out_error} "reset-route: D-44 ${field} must be a JSON STRING" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  foreach(field IN LISTS expected_route_fields)
    string(REGEX MATCHALL "\"${field}\"[ \t\r\n]*:" occurrences "${route}")
    list(LENGTH occurrences occurrence_count)
    if(NOT occurrence_count EQUAL 1)
      set(${out_error} "reset-route: D-44 ledger field ${field} is missing or duplicated" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  math(EXPR last_index "${route_count} - 1")
  foreach(index RANGE 0 ${last_index})
    string(JSON field ERROR_VARIABLE field_error MEMBER "${route}" ${index})
    if(field_error OR NOT field IN_LIST expected_route_fields)
      set(${out_error} "reset-route: D-44 ledger has an unsupported field" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  foreach(pair IN ITEMS
      "reset_kind|${expected_reset_kind}"
      "source_root|${source_root}"
      "source_branch|${branch}"
      "output_root|${output_root}"
      "acceptance_path|${acceptance}"
      "acceptance_markdown_path|${acceptance_markdown}")
    string(REPLACE "|" ";" fields "${pair}")
    list(GET fields 0 field)
    list(GET fields 1 expected)
    pr_expect("${route}" "${field}" "${expected}" reset-route identity_error)
    if(identity_error)
      set(${out_error} "${identity_error}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(pr_reset_artifacts route_path stage out_error)
  set(${out_error} "" PARENT_SCOPE)
  if(stage STREQUAL "freeze")
    set(suffixes .inputs.sha256 .local.stdout.txt .local.stderr.txt
      .candidate.stdout.txt .candidate.stderr.txt .main.stdout.txt .main.stderr.txt)
  else()
    set(suffixes ".${stage}.stdout.txt" ".${stage}.stderr.txt")
  endif()
  foreach(suffix IN LISTS suffixes)
    if(EXISTS "${route_path}${suffix}" OR IS_SYMLINK "${route_path}${suffix}")
      set(${out_error} "reset-artifact: existing or symlink sidecar is preserved" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  if(IS_SYMLINK "${route_path}.lock")
    set(${out_error} "reset-artifact: refusing symlink lock" PARENT_SCOPE)
  endif()
endfunction()

# D-42 admission records are local evidence, never published package inputs.
# A running/interrupted record is spent; no path silently recreates one.
function(pr_reset_scope source_dir base out_error)
  set(${out_error} "" PARENT_SCOPE)

  if(DEFINED RESET_KIND AND RESET_KIND MATCHES "^(d44-evidence-v1|d45-controls-v1|d46-observer-v1|d51-receipt-v1)$")
    if(NOT "${base}" STREQUAL D44_BASE)
      if(RESET_KIND STREQUAL "d45-controls-v1")
        set(route_label D-45)
      elseif(RESET_KIND STREQUAL "d46-observer-v1")
        set(route_label D-46)
      elseif(RESET_KIND STREQUAL "d51-receipt-v1")
        set(route_label D-51)
      else()
        set(route_label D-44)
      endif()
      set(${out_error} "reset-base: ${route_label} permits only its exact frozen base" PARENT_SCOPE)
      return()
    endif()
    execute_process(COMMAND git -C "${source_dir}" diff --name-only "${base}" HEAD
      RESULT_VARIABLE d44_result OUTPUT_VARIABLE d44_changed ERROR_VARIABLE d44_error TIMEOUT 10)
    if(NOT d44_result STREQUAL "0")
      set(${out_error} "reset-scope: cannot compare the exact D-44 base: ${d44_error}" PARENT_SCOPE)
      return()
    endif()
    string(REPLACE "\n" ";" d44_paths "${d44_changed}")
    list(FILTER d44_paths EXCLUDE REGEX "^$")
    pr_d44_validate_paths("${d44_paths}" d44_path_error)
    if(d44_path_error)
      set(${out_error} "${d44_path_error}" PARENT_SCOPE)
      return()
    endif()
    file(SHA256 "${source_dir}/tests/CMakeLists.txt" d44_cmake_sha)
    if(NOT "${d44_cmake_sha}" STREQUAL "a4179a215765f1b783e7a408f55d2eb9f9264c0cb315215c9da09e0336624ea2")
      set(${out_error} "reset-scope: D-44 current CMake registration bytes changed" PARENT_SCOPE)
      return()
    endif()
    set(${out_error} "" PARENT_SCOPE)
    return()
  endif()
  execute_process(COMMAND git -C "${source_dir}" diff --name-only "${base}" HEAD
    RESULT_VARIABLE result OUTPUT_VARIABLE changed ERROR_VARIABLE error TIMEOUT 10)
  if(NOT result STREQUAL "0")
    set(${out_error} "reset-scope: cannot compare the exact base: ${error}" PARENT_SCOPE)
    return()
  endif()
  set(allowed tests/consumer/main.c tests/consumer/CMakeLists.txt
    tests/cmake/qualified_consumer.cmake tests/cmake/provider_profile.cmake
    tests/cmake/provider_receipt.cmake tests/CMakeLists.txt
    tests/roms/licenses/DABG-ZLIB-LICENSE.txt THIRD-PARTY-NOTICES.md README.md
    docs/nrom-gameplay.md docs/provider-ntsc.json docs/provider-ntsc.md
    docs/api.md docs/testing.md docs/reproduction.md docs/releases.md)
  string(REPLACE "\n" ";" changed "${changed}")
  foreach(path IN LISTS changed)
    if(path STREQUAL "" OR path IN_LIST allowed OR
       path MATCHES "^\\.planning/workstreams/libfuturo-nes-gameplay-handoff/")
      continue()
    endif()
    set(${out_error} "reset-scope: protected or out-of-scope delta: ${path}" PARENT_SCOPE)
    return()
  endforeach()
  # Remove only the exact approved registration additions, then compare the
  # entire remaining file. Command-name filters cannot protect existing test
  # properties, nested CMake evaluation or flags passed through another API.
  execute_process(COMMAND git -C "${source_dir}" show "${base}:tests/CMakeLists.txt"
    RESULT_VARIABLE result OUTPUT_VARIABLE original ERROR_VARIABLE error TIMEOUT 10)
  if(NOT result STREQUAL "0")
    set(${out_error} "reset-scope: cannot read original test registrations: ${error}" PARENT_SCOPE)
    return()
  endif()
  file(READ "${source_dir}/tests/CMakeLists.txt" registrations)
  set(allowed_registration_1 [=[# A candidate gameplay scenario must be a real, moved-prefix public consumer.
# The integration driver owns its install tree and does not use install.stage.
add_test(NAME install.gameplay
  COMMAND ${CMAKE_COMMAND}
    "-DSOURCE_DIR=${PROJECT_SOURCE_DIR}"
    "-DBINARY_DIR=${PROJECT_BINARY_DIR}"
    "-DGENERATOR=${CMAKE_GENERATOR}"
    "-DC_COMPILER=${CMAKE_C_COMPILER}"
    "-DBUILD_TYPE=${CMAKE_BUILD_TYPE}"
    "-DC_FLAGS=${CMAKE_C_FLAGS}"
    "-DLINK_FLAGS=${CMAKE_EXE_LINKER_FLAGS}"
    "-DCONFIG=$<CONFIG>"
    -P "${CMAKE_CURRENT_SOURCE_DIR}/cmake/qualified_consumer.cmake")
set_tests_properties(install.gameplay PROPERTIES TIMEOUT 60)


]=])
  set(allowed_registration_2 [=[# Provider-side NTSC API/profile facts and offline drift controls.
add_test(NAME provider.profile
  COMMAND ${CMAKE_COMMAND}
    "-DSOURCE_DIR=${PROJECT_SOURCE_DIR}"
    -DMODE=contract
    -P ${CMAKE_CURRENT_SOURCE_DIR}/cmake/provider_profile.cmake)
add_test(NAME provider.profile.controls
  COMMAND ${CMAKE_COMMAND}
    "-DSOURCE_DIR=${PROJECT_SOURCE_DIR}"
    "-DBUILD_DIR=${PROJECT_BINARY_DIR}"
    -DMODE=selftest
    "-DWORK=${CMAKE_CURRENT_BINARY_DIR}/provider/profile-controls"
    -P ${CMAKE_CURRENT_SOURCE_DIR}/cmake/provider_profile.cmake)
set_tests_properties(provider.profile provider.profile.controls PROPERTIES TIMEOUT 15)

]=])
  set(allowed_registration_3 [=[# Offline receipt controls use owned scratch and synthetic records only.
add_test(NAME provider.receipt.controls
  COMMAND ${CMAKE_COMMAND}
    "-DSOURCE_DIR=${PROJECT_SOURCE_DIR}"
    "-DBUILD_DIR=${PROJECT_BINARY_DIR}"
    -DMODE=selftest
    "-DWORK=${CMAKE_CURRENT_BINARY_DIR}"
    -P ${CMAKE_CURRENT_SOURCE_DIR}/cmake/provider_receipt.cmake)
set_tests_properties(provider.receipt.controls PROPERTIES TIMEOUT 15)
]=])
  foreach(block_name IN ITEMS allowed_registration_1 allowed_registration_2 allowed_registration_3)
    string(REPLACE "${${block_name}}" "" registrations "${registrations}")
  endforeach()
  string(STRIP "${original}" original)
  string(STRIP "${registrations}" registrations)
  if(NOT registrations STREQUAL original)
    set(${out_error} "reset-scope: changed existing test registration or build configuration" PARENT_SCOPE)
    return()
  endif()
endfunction()

function(pr_reset_load out_route)
  foreach(required IN ITEMS RESET_BASE RESET_ROUTE)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
      message(FATAL_ERROR "reset identity requires ${required}")
    endif()
  endforeach()
  if(DEFINED RESET_KIND AND RESET_KIND MATCHES "^(d44-evidence-v1|d45-controls-v1|d46-observer-v1|d51-receipt-v1)$")
    foreach(required IN ITEMS ACCEPTANCE ACCEPTANCE_MARKDOWN)
      if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "D-44 reset identity requires ${required}")
      endif()
    endforeach()
    pr_d44_validate_checkout("${SOURCE_DIR}" "${RESET_BASE}" "${RESET_ROUTE}"
      "${ACCEPTANCE}" "${ACCEPTANCE_MARKDOWN}" identity_error)
    if(identity_error)
      message(FATAL_ERROR "${identity_error}")
    endif()
  elseif(NOT RESET_BASE STREQUAL "b25146c6efaac41c58f60555f59f0fe79a90ca68")
    message(FATAL_ERROR "reset-base: D-42 permits only its exact base")
  endif()
  get_filename_component(route_path "${RESET_ROUTE}" ABSOLUTE BASE_DIR "${SOURCE_DIR}")
  set(build_root "${SOURCE_DIR}/build")
  cmake_path(IS_PREFIX build_root "${route_path}" NORMALIZE inside_build)
  if(NOT inside_build OR IS_SYMLINK "${build_root}" OR IS_SYMLINK "${route_path}" OR
     IS_SYMLINK "${route_path}.lock" OR NOT EXISTS "${route_path}")
    message(FATAL_ERROR "reset-route: missing, symlink or outside owned build directory")
  endif()
  get_filename_component(route_parent "${route_path}" DIRECTORY)
  file(REAL_PATH "${route_parent}" route_parent_real)
  file(REAL_PATH "${build_root}" build_real)
  cmake_path(IS_PREFIX build_real "${route_parent_real}" NORMALIZE real_inside)
  if(NOT real_inside)
    message(FATAL_ERROR "reset-route: parent escapes owned build directory")
  endif()
  file(READ "${route_path}" route)
  if(DEFINED RESET_KIND AND RESET_KIND MATCHES "^(d44-evidence-v1|d45-controls-v1|d46-observer-v1|d51-receipt-v1)$")
    set(output_root "${SOURCE_DIR}/${D44_OUTPUT_RELATIVE}")
    pr_d44_validate_route_fields("${route}" "${SOURCE_DIR}" "${D44_BRANCH}"
      "${output_root}" "${ACCEPTANCE}" "${ACCEPTANCE_MARKDOWN}" error)
    if(error)
      message(FATAL_ERROR "${error}")
    endif()
    pr_expect("${route}" base "${RESET_BASE}" reset-base error)
    if(error)
      message(FATAL_ERROR "${error}")
    endif()
  else()
    pr_expect("${route}" base "${RESET_BASE}" reset-base error)
    if(error)
      message(FATAL_ERROR "${error}")
    endif()
    pr_expect("${route}" source_root "${SOURCE_DIR}" reset-checkout error)
    if(error)
      message(FATAL_ERROR "${error}")
    endif()
  endif()
  pr_reset_scope("${SOURCE_DIR}" "${RESET_BASE}" scope_error)
  if(scope_error)
    message(FATAL_ERROR "reset-scope: ${scope_error}")
  endif()
  pr_local_manifest("${SOURCE_DIR}" paths manifest manifest_sha error)
  set(required_error "")
  if(DEFINED RESET_KIND AND RESET_KIND MATCHES "^(d44-evidence-v1|d45-controls-v1|d46-observer-v1|d51-receipt-v1)$")
    pr_d44_require_manifest_inputs("${paths}" required_error)
  endif()
  pr_local_status("${SOURCE_DIR}" "${paths}" status dirty status_error)
  if(error OR status_error OR dirty OR required_error)
    message(FATAL_ERROR "reset-inputs: dirty or missing implementation: ${error}${status_error}${dirty}${required_error}")
  endif()
  pr_expect("${route}" manifest_sha256 "${manifest_sha}" reset-manifest error)
  if(error)
    message(FATAL_ERROR "${error}")
  endif()
  string(JSON frozen ERROR_VARIABLE read_error GET "${route}" source_commit)
  execute_process(COMMAND git -C "${SOURCE_DIR}" merge-base --is-ancestor "${frozen}" HEAD
    RESULT_VARIABLE ancestor_result OUTPUT_QUIET ERROR_VARIABLE ancestor_error TIMEOUT 10)
  if(read_error OR NOT ancestor_result STREQUAL "0")
    message(FATAL_ERROR "reset-source: frozen source ancestry changed: ${read_error}${ancestor_error}")
  endif()
  set(${out_route} "${route}" PARENT_SCOPE)
endfunction()

function(pr_reset_preflight)
  foreach(required IN ITEMS RESET_BASE RESET_ROUTE)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
      message(FATAL_ERROR "reset preflight requires ${required}")
    endif()
  endforeach()
  if(DEFINED RESET_KIND AND RESET_KIND MATCHES "^(d44-evidence-v1|d45-controls-v1|d46-observer-v1|d51-receipt-v1)$")
    if(NOT DEFINED ACCEPTANCE OR "${ACCEPTANCE}" STREQUAL "")
      set(ACCEPTANCE "${SOURCE_DIR}/${D44_IDENTITY_RELATIVE}")
    endif()
    if(NOT DEFINED ACCEPTANCE_MARKDOWN OR "${ACCEPTANCE_MARKDOWN}" STREQUAL "")
      set(ACCEPTANCE_MARKDOWN "${SOURCE_DIR}/${D44_ACCEPTANCE_MARKDOWN_RELATIVE}")
    endif()
    pr_d44_validate_checkout("${SOURCE_DIR}" "${RESET_BASE}" "${RESET_ROUTE}"
      "${ACCEPTANCE}" "${ACCEPTANCE_MARKDOWN}" identity_error)
    if(identity_error)
      message(FATAL_ERROR "${identity_error}")
    endif()
    if(EXISTS "${ACCEPTANCE}" OR IS_SYMLINK "${ACCEPTANCE}" OR
       EXISTS "${ACCEPTANCE_MARKDOWN}" OR IS_SYMLINK "${ACCEPTANCE_MARKDOWN}")
      message(FATAL_ERROR "reset-evidence: preserving existing D-44 identity or acceptance narrative")
    endif()
  else()
    if(NOT RESET_BASE STREQUAL "b25146c6efaac41c58f60555f59f0fe79a90ca68")
      message(FATAL_ERROR "reset-base: D-42 permits only its exact base")
    endif()
    execute_process(COMMAND git -C "${SOURCE_DIR}" merge-base --is-ancestor "${RESET_BASE}" HEAD
      RESULT_VARIABLE ancestor_result OUTPUT_QUIET ERROR_VARIABLE error TIMEOUT 10)
    if(NOT ancestor_result STREQUAL "0")
      message(FATAL_ERROR "reset-base: checkout does not descend from the approved base: ${error}")
    endif()
  endif()
  pr_reset_scope("${SOURCE_DIR}" "${RESET_BASE}" scope_error)
  pr_local_manifest("${SOURCE_DIR}" paths manifest manifest_sha error)
  set(required_error "")
  if(DEFINED RESET_KIND AND RESET_KIND MATCHES "^(d44-evidence-v1|d45-controls-v1|d46-observer-v1|d51-receipt-v1)$")
    pr_d44_require_manifest_inputs("${paths}" required_error)
  endif()
  pr_local_status("${SOURCE_DIR}" "${paths}" status dirty status_error)
  if(scope_error OR error OR status_error OR dirty OR required_error)
    message(FATAL_ERROR "reset-preflight: ${scope_error}${error}${status_error}${dirty}${required_error}")
  endif()
  file(READ "${SOURCE_DIR}/tests/CMakeLists.txt" registrations)
  foreach(test IN ITEMS install.gameplay provider.profile provider.profile.controls provider.receipt.controls)
    string(FIND "${registrations}" "add_test(NAME ${test}" test_index)
    if(test_index LESS 0)
      message(FATAL_ERROR "reset-preflight: missing required test ${test}")
    endif()
  endforeach()
  get_filename_component(route_path "${RESET_ROUTE}" ABSOLUTE BASE_DIR "${SOURCE_DIR}")
  set(build_root "${SOURCE_DIR}/build")
  cmake_path(IS_PREFIX build_root "${route_path}" NORMALIZE inside_build)
  if(NOT inside_build OR IS_SYMLINK "${build_root}" OR IS_SYMLINK "${route_path}")
    message(FATAL_ERROR "reset-route: record must be below the owned build directory")
  endif()
  get_filename_component(route_parent "${route_path}" DIRECTORY)
  file(MAKE_DIRECTORY "${route_parent}")
  file(REAL_PATH "${route_parent}" route_parent_real)
  file(REAL_PATH "${build_root}" build_real)
  cmake_path(IS_PREFIX build_real "${route_parent_real}" NORMALIZE real_inside)
  if(NOT real_inside)
    message(FATAL_ERROR "reset-route: symlink parent escapes owned build directory")
  endif()
  pr_reset_artifacts("${route_path}" freeze artifact_error)
  if(artifact_error)
    message(FATAL_ERROR "${artifact_error}")
  endif()
  file(LOCK "${route_path}.lock" GUARD FUNCTION TIMEOUT 0 RESULT_VARIABLE lock_result)
  if(NOT lock_result STREQUAL "0" OR EXISTS "${route_path}")
    message(FATAL_ERROR "reset-route: existing/busy record is preserved; no second candidate")
  endif()
  execute_process(COMMAND git -C "${SOURCE_DIR}" rev-parse HEAD
    RESULT_VARIABLE result OUTPUT_VARIABLE source ERROR_VARIABLE error TIMEOUT 10)
  execute_process(COMMAND git -C "${SOURCE_DIR}" rev-parse "HEAD^{tree}"
    RESULT_VARIABLE tree_result OUTPUT_VARIABLE tree ERROR_VARIABLE tree_error TIMEOUT 10)
  if(NOT result STREQUAL "0" OR NOT tree_result STREQUAL "0")
    message(FATAL_ERROR "reset-source: cannot freeze source/tree: ${error}${tree_error}")
  endif()
  string(STRIP "${source}" source)
  string(STRIP "${tree}" tree)
  set(route "{\"schema_version\":1,\"stages\":{}}")
  foreach(pair IN ITEMS "base;${RESET_BASE}" "source_root;${SOURCE_DIR}"
      "source_commit;${source}" "source_tree;${tree}" "manifest_sha256;${manifest_sha}"
      "donor_commit;7a004f2a4f8833a23b820fbb834f295911561636")
    list(GET pair 0 key)
    list(GET pair 1 value)
    pr_json_quote("${value}" quoted)
    pr_json_set("${route}" "${key}" "${quoted}" route)
  endforeach()
  foreach(pair IN ITEMS "profile;docs/provider-ntsc.json" "guide;docs/nrom-gameplay.md"
      "notice;${DABG_NOTICE_PATH}")
    list(GET pair 0 key)
    list(GET pair 1 path)
    file(SHA256 "${SOURCE_DIR}/${path}" digest)
    pr_json_set("${route}" "${key}_sha256" "\"${digest}\"" route)
  endforeach()

  if(DEFINED RESET_KIND AND RESET_KIND MATCHES "^(d44-evidence-v1|d45-controls-v1|d46-observer-v1|d51-receipt-v1)$")
    set(output_root "${SOURCE_DIR}/${D44_OUTPUT_RELATIVE}")
    foreach(pair IN ITEMS "reset_kind;${RESET_KIND}"
        "source_branch;${D44_BRANCH}" "output_root;${output_root}"
        "acceptance_path;${ACCEPTANCE}"
        "acceptance_markdown_path;${ACCEPTANCE_MARKDOWN}")
      list(GET pair 0 key)
      list(GET pair 1 value)
      pr_json_quote("${value}" quoted)
      pr_json_set("${route}" "${key}" "${quoted}" route)
    endforeach()
  endif()
  file(WRITE "${route_path}.inputs.sha256" "${manifest}")
  file(WRITE "${route_path}" "${route}\n")
  message(STATUS "reset source frozen once: ${source}; no acceptance attempt launched")
endfunction()

function(pr_reset_reserve route_path stage out_error)
  set(${out_error} "" PARENT_SCOPE)
  file(LOCK "${route_path}.lock" GUARD FUNCTION TIMEOUT 0 RESULT_VARIABLE lock_result)
  if(NOT lock_result STREQUAL "0")
    set(${out_error} "reset-stage: record busy" PARENT_SCOPE)
    return()
  endif()
  file(READ "${route_path}" route)
  string(JSON existing ERROR_VARIABLE missing TYPE "${route}" stages "${stage}")
  if(NOT missing)
    set(${out_error} "reset-stage: duplicate or interrupted ${stage} attempt is spent" PARENT_SCOPE)
    return()
  endif()
  if(stage STREQUAL "candidate")
    set(previous local)
  elseif(stage STREQUAL "main")
    set(previous candidate)
  elseif(NOT stage STREQUAL "local")
    set(${out_error} "reset-stage: unknown stage" PARENT_SCOPE)
    return()
  endif()
  if(DEFINED previous)
    string(JSON prior ERROR_VARIABLE prior_error GET "${route}" stages "${previous}" status)
    if(prior_error OR NOT prior STREQUAL "passed")
      set(${out_error} "reset-stage: ${previous} has not passed" PARENT_SCOPE)
      return()
    endif()
  endif()
  string(TIMESTAMP started "%Y-%m-%dT%H:%M:%SZ" UTC)
  string(JSON route SET "${route}" stages "${stage}"
    "{\"status\":\"running\",\"started\":\"${started}\",\"attempt\":1}")
  file(WRITE "${route_path}" "${route}\n")
endfunction()

function(pr_reset_finish route_path stage state result record)
  file(LOCK "${route_path}.lock" GUARD FUNCTION TIMEOUT 0 RESULT_VARIABLE lock_result)
  if(NOT lock_result STREQUAL "0")
    message(FATAL_ERROR "reset-stage: cannot finalize locked record; running attempt remains spent")
  endif()
  file(READ "${route_path}" route)
  string(JSON prior ERROR_VARIABLE error GET "${route}" stages "${stage}" status)
  if(error OR NOT prior STREQUAL "running")
    message(FATAL_ERROR "reset-stage: cannot finalize a missing or terminal attempt")
  endif()
  string(JSON route SET "${route}" stages "${stage}" status "\"${state}\"")
  pr_json_quote("${result}" quoted)
  string(JSON route SET "${route}" stages "${stage}" result "${quoted}")
  if(NOT record STREQUAL "")
    string(JSON route SET "${route}" stages "${stage}" run "${record}")
  endif()
  file(WRITE "${route_path}" "${route}\n")
endfunction()

function(pr_reset_main_binding route evidence live_pr out_intent out_error)
  set(${out_error} "" PARENT_SCOPE)
  set(expected_main "b25146c6efaac41c58f60555f59f0fe79a90ca68")
  if(RESET_KIND STREQUAL "d51-receipt-v1")
    set(expected_main "${D51_EXPECTED_MAIN}")
  endif()
  foreach(pair IN ITEMS "head_sha;head_sha" "tested_checkout_sha;tested_checkout_sha" "pr_number;pr_number")
    list(GET pair 0 field)
    string(JSON verified_${field} ERROR_VARIABLE error GET "${route}" stages candidate run "${field}")
    if(error)
      set(${out_error} "reset-main: missing accepted candidate ${field}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  string(JSON evidence_head ERROR_VARIABLE head_error GET "${evidence}" candidate head_sha)
  string(JSON evidence_pr ERROR_VARIABLE pr_error GET "${evidence}" candidate pr_number)
  string(JSON evidence_merge ERROR_VARIABLE merge_error GET "${evidence}" candidate tested_merge_sha)
  string(JSON state ERROR_VARIABLE state_error GET "${live_pr}" state)
  string(JSON merged ERROR_VARIABLE merged_error GET "${live_pr}" merged)
  string(JSON live_head ERROR_VARIABLE live_head_error GET "${live_pr}" head sha)
  string(JSON live_base ERROR_VARIABLE live_base_error GET "${live_pr}" base sha)
  string(JSON live_merge ERROR_VARIABLE live_merge_error GET "${live_pr}" merge_commit_sha)
  string(JSON live_number ERROR_VARIABLE live_number_error GET "${live_pr}" number)
  if(head_error OR pr_error OR merge_error OR state_error OR merged_error OR live_head_error OR
     live_base_error OR live_merge_error OR live_number_error OR NOT state STREQUAL "open" OR merged OR
     NOT evidence_head STREQUAL verified_head_sha OR NOT live_head STREQUAL verified_head_sha OR
     NOT evidence_pr STREQUAL verified_pr_number OR NOT live_number STREQUAL verified_pr_number OR
     NOT evidence_merge STREQUAL verified_tested_checkout_sha OR NOT live_merge STREQUAL verified_tested_checkout_sha OR
     NOT live_base STREQUAL expected_main)
    set(${out_error} "reset-main: PR/head/base/tested-merge changed after candidate qualification" PARENT_SCOPE)
    return()
  endif()
  set(intent "{}")
  pr_json_set("${intent}" pr_number "${verified_pr_number}" intent)
  pr_json_set("${intent}" head_sha "\"${verified_head_sha}\"" intent)
  pr_json_set("${intent}" tested_checkout_sha "\"${verified_tested_checkout_sha}\"" intent)
  pr_json_set("${intent}" expected_base "\"${live_base}\"" intent)
  pr_json_set("${intent}" merge_method "\"squash\"" intent)
  set(${out_intent} "${intent}" PARENT_SCOPE)
endfunction()

function(pr_reset_admit)
  if(NOT STAGE MATCHES "^(candidate|main)$" OR NOT DEFINED ACCEPTANCE OR NOT EXISTS "${ACCEPTANCE}")
    message(FATAL_ERROR "reset admission requires STAGE=candidate|main and local ACCEPTANCE")
  endif()
  pr_reset_load(route)
  file(READ "${ACCEPTANCE}" accepted)
  string(JSON frozen GET "${route}" source_commit)
  pr_expect("${accepted}" candidate_source_commit "${frozen}" reset-source error)
  if(error)
    message(FATAL_ERROR "${error}")
  endif()
  string(JSON local_status ERROR_VARIABLE status_error GET "${accepted}" local_acceptance status)
  if(status_error OR NOT local_status STREQUAL "passed")
    message(FATAL_ERROR "reset admission requires successful source-bound local acceptance")
  endif()
  # Bind the known branch head before a PR number or resulting merge exists.
  execute_process(COMMAND git -C "${SOURCE_DIR}" rev-parse HEAD
    RESULT_VARIABLE head_result OUTPUT_VARIABLE intent_head ERROR_VARIABLE head_error TIMEOUT 10)
  string(STRIP "${intent_head}" intent_head)
  if(NOT head_result STREQUAL "0")
    message(FATAL_ERROR "reset-stage: cannot record admitted head; attempt remains spent")
  endif()
  if(STAGE STREQUAL "main")
    # Task evidence can be committed locally without pushing a new PR head.
    # The merge intent must stay bound to the candidate actually verified.
    string(JSON verified_head ERROR_VARIABLE verified_error GET "${route}" stages candidate run head_sha)
    string(JSON verified_pr ERROR_VARIABLE verified_pr_error GET "${route}" stages candidate run pr_number)
    if(verified_error OR verified_pr_error OR NOT DEFINED RELEASE_EVIDENCE OR NOT EXISTS "${RELEASE_EVIDENCE}")
      message(FATAL_ERROR "reset-main: missing accepted candidate evidence")
    endif()
    file(READ "${RELEASE_EVIDENCE}" evidence)
    pr_live_pull_request("${verified_pr}" live_pr live_error)
    if(live_error)
      message(FATAL_ERROR "${live_error}")
    endif()
    pr_reset_main_binding("${route}" "${evidence}" "${live_pr}" main_intent binding_error)
    pr_live_check_context("${verified_head}" "CI required" required_error)
    execute_process(COMMAND git -C "${SOURCE_DIR}" merge-base --is-ancestor "${verified_head}" HEAD
      RESULT_VARIABLE candidate_ancestor OUTPUT_QUIET ERROR_VARIABLE candidate_error TIMEOUT 10)
    if(binding_error OR required_error OR NOT candidate_ancestor STREQUAL "0")
      message(FATAL_ERROR "reset-main: ${binding_error}${required_error}${candidate_error}")
    endif()
    # This repository currently permits only squash; preserve that operation
    # explicitly rather than treating a method change as harmless bookkeeping.
    pr_gh_api("repos/${REPOSITORY}" repository repository_error)
    string(JSON squash_allowed ERROR_VARIABLE squash_error GET "${repository}" allow_squash_merge)
    if(repository_error OR squash_error OR NOT squash_allowed)
      message(FATAL_ERROR "reset-main: configured squash merge is unavailable")
    endif()
    set(intent_head "${verified_head}")
  endif()
  pr_reset_reserve("${RESET_ROUTE}" "${STAGE}" reserve_error)
  if(reserve_error)
    message(FATAL_ERROR "${reserve_error}")
  endif()
  file(READ "${RESET_ROUTE}" admitted)
  string(JSON admitted SET "${admitted}" stages "${STAGE}" intent_head "\"${intent_head}\"")
  if(STAGE STREQUAL "main")
    string(JSON admitted SET "${admitted}" stages main merge_intent "${main_intent}")
  endif()
  file(WRITE "${RESET_ROUTE}" "${admitted}\n")
  message(STATUS "reset ${STAGE} admitted once before its remote trigger")
endfunction()

function(pr_reset_observe)
  if(MODE STREQUAL "local" AND (NOT DEFINED ACCEPTANCE OR ACCEPTANCE STREQUAL ""))
    message(FATAL_ERROR "provider_receipt MODE=local requires ACCEPTANCE")
  endif()
  pr_reset_load(route)
  if(MODE STREQUAL "local")
    set(stage local)
    pr_reset_reserve("${RESET_ROUTE}" local reserve_error)
    if(reserve_error)
      message(FATAL_ERROR "${reserve_error}")
    endif()
  else()
    set(stage "${STAGE}")
    string(JSON stage_status ERROR_VARIABLE status_error GET "${route}" stages "${stage}" status)
    if(NOT status_error AND stage_status STREQUAL "passed")
      file(READ "${RELEASE_EVIDENCE}" evidence)
      if(stage STREQUAL "candidate")
        set(kind exact_candidate)
      else()
        set(kind main)
      endif()
      string(JSON observed ERROR_VARIABLE observed_error GET "${evidence}" linked_ci "${kind}")
      string(JSON recorded ERROR_VARIABLE recorded_error GET "${route}" stages "${stage}" run)
      if(observed_error OR recorded_error OR NOT observed STREQUAL recorded)
        message(FATAL_ERROR "reset-stage: read-only observation differs from the accepted run")
      endif()
      message(STATUS "reset ${stage}: same recorded run observed read-only; no new attempt")
      return()
    elseif(status_error OR NOT stage_status STREQUAL "running")
      message(FATAL_ERROR "reset-stage: hosted observation requires its admitted running intent")
    endif()
    string(JSON observed ERROR_VARIABLE not_started TYPE "${route}" stages "${stage}" verification_started)
    if(NOT not_started)
      message(FATAL_ERROR "reset-stage: interrupted verification cannot be retried")
    endif()
    file(READ "${RESET_ROUTE}" route)
    string(JSON route SET "${route}" stages "${stage}" verification_started true)
    file(WRITE "${RESET_ROUTE}" "${route}\n")
  endif()
  pr_reset_artifacts("${RESET_ROUTE}" "${stage}" artifact_error)
  if(artifact_error)
    pr_reset_finish("${RESET_ROUTE}" "${stage}" failed "${artifact_error}" "")
    message(FATAL_ERROR "${artifact_error}; attempt remains spent without launching its child")
  endif()
  set(child "${CMAKE_COMMAND}" "-DSOURCE_DIR=${SOURCE_DIR}" "-DMODE=${MODE}"
    -DRESET_OBSERVE_CHILD=ON "-DRESET_BASE=${RESET_BASE}" "-DRESET_ROUTE=${RESET_ROUTE}")
  foreach(variable IN ITEMS ACCEPTANCE ACCEPTANCE_MARKDOWN BINARY_DIR WORK STAGE RELEASE_EVIDENCE RESET_KIND)
    if(DEFINED ${variable})
      list(APPEND child "-D${variable}=${${variable}}")
    endif()
  endforeach()
  list(APPEND child -P "${CMAKE_CURRENT_FUNCTION_LIST_FILE}")
  execute_process(COMMAND ${child} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 1700)
  file(WRITE "${RESET_ROUTE}.${stage}.stdout.txt" "${output}")
  file(WRITE "${RESET_ROUTE}.${stage}.stderr.txt" "${error}")
  set(record "")
  if(result STREQUAL "0" AND NOT stage STREQUAL "local")
    file(READ "${RELEASE_EVIDENCE}" evidence)
    if(stage STREQUAL "candidate")
      set(kind exact_candidate)
    else()
      set(kind main)
    endif()
    string(JSON record ERROR_VARIABLE record_error GET "${evidence}" linked_ci "${kind}")
    string(JSON attempt ERROR_VARIABLE attempt_error GET "${record}" run_attempt)
    string(JSON intent GET "${route}" stages "${stage}" intent_head)
    if(stage STREQUAL "candidate")
      string(JSON observed_head ERROR_VARIABLE head_error GET "${record}" head_sha)
    else()
      string(JSON observed_head ERROR_VARIABLE head_error GET "${evidence}" candidate head_sha)
    endif()
    if(record_error OR attempt_error OR NOT attempt EQUAL 1 OR head_error OR NOT observed_head STREQUAL intent)
      set(result "reset hosted run/attempt or admitted candidate head mismatch")
    endif()
  endif()
  if(result STREQUAL "0")
    pr_reset_finish("${RESET_ROUTE}" "${stage}" passed "0" "${record}")
    message(STATUS "${output}")
  else()
    pr_reset_finish("${RESET_ROUTE}" "${stage}" failed "${result}" "")
    message(FATAL_ERROR "reset ${stage} failed terminally (${result}): ${output}${error}")
  endif()
endfunction()

if(MODE STREQUAL "reset-preflight")
  pr_reset_preflight()
  return()
elseif(MODE STREQUAL "reset-admit")
  pr_reset_admit()
  return()
elseif((MODE STREQUAL "local" OR (MODE STREQUAL "hosted" AND STAGE MATCHES "^(candidate|main)$"))
    AND NOT RESET_OBSERVE_CHILD)
  pr_reset_observe()
  return()
endif()

if(MODE STREQUAL "title")
  pr_title_mode()
  return()
elseif(MODE STREQUAL "selftest")
  foreach(required IN ITEMS BUILD_DIR WORK)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
      message(FATAL_ERROR "provider_receipt selftest requires ${required}")
    endif()
  endforeach()
  pr_selftest_scratch_create("${BUILD_DIR}" "${WORK}" selftest_work selftest_token work_error)
  if(work_error)
    message(FATAL_ERROR "provider_receipt: ${work_error}")
  endif()
  pr_receipt_controls("${selftest_work}")
  pr_selftest_scratch_remove("${BUILD_DIR}" "${WORK}" "${selftest_work}"
    "${selftest_token}" work_error)
  if(work_error)
    message(FATAL_ERROR "provider_receipt selftest cleanup: ${work_error}")
  endif()
  message(STATUS "provider receipt controls passed; synthetic records were structural only")
  return()
elseif(MODE STREQUAL "local")
  pr_local_acceptance()
  return()
elseif(MODE STREQUAL "handoff")
  pr_handoff_acceptance()
  return()
elseif(MODE STREQUAL "rights")
  if(NOT DEFINED WORK OR "${WORK}" STREQUAL "")
    message(FATAL_ERROR "provider_receipt MODE=rights requires WORK")
  endif()
  pr_rights_check()
  return()
elseif(MODE STREQUAL "selector")
  if(NOT DEFINED SOURCE_DIR OR "${SOURCE_DIR}" STREQUAL "")
    message(FATAL_ERROR "provider_receipt MODE=selector requires SOURCE_DIR")
  endif()
  pr_local_manifest("${SOURCE_DIR}" selected_paths selected_manifest selected_sha selector_error)
  if(selector_error)
    message(FATAL_ERROR "provider receipt selector failed: ${selector_error}")
  endif()
  foreach(path IN LISTS selected_paths)
    message("D30_SELECTOR:${path}")
  endforeach()
  return()
elseif(MODE STREQUAL "hosted")
  if(NOT DEFINED STAGE OR STAGE STREQUAL "")
    message(FATAL_ERROR "provider_receipt MODE=hosted requires STAGE=candidate, main or release")
  endif()
  pr_hosted_stage("${STAGE}")
  return()
elseif(MODE STREQUAL "verify-published")
  pr_title_requirement(require_title_proof)
  foreach(required IN ITEMS ACCEPTANCE RELEASE_EVIDENCE TAG)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
      message(FATAL_ERROR "provider_receipt MODE=verify-published requires ${required}")
    endif()
  endforeach()
  get_filename_component(ACCEPTANCE "${ACCEPTANCE}" ABSOLUTE BASE_DIR "${SOURCE_DIR}")
  get_filename_component(RELEASE_EVIDENCE "${RELEASE_EVIDENCE}" ABSOLUTE BASE_DIR "${SOURCE_DIR}")
  if(NOT EXISTS "${OUTPUT_RECEIPT}")
    message(FATAL_ERROR "published receipt missing: ${OUTPUT_RECEIPT}")
  endif()
  if(NOT EXISTS "${ACCEPTANCE}" OR NOT EXISTS "${RELEASE_EVIDENCE}")
    message(FATAL_ERROR "published verification evidence is missing: acceptance or hosted release evidence")
  endif()
  file(READ "${OUTPUT_RECEIPT}" receipt)
  file(READ "${ACCEPTANCE}" acceptance)
  file(READ "${SOURCE_DIR}/docs/provider-ntsc.json" profile)
  file(SHA256 "${SOURCE_DIR}/docs/provider-ntsc.json" profile_sha)
  file(SHA256 "${SOURCE_DIR}/docs/nrom-gameplay.md" guide_sha)
  string(JSON scenario_sha ERROR_VARIABLE scenario_error GET "${profile}" scenario rom_sha256)
  string(JSON abi ERROR_VARIABLE abi_error GET "${profile}" compatibility abi)
  string(JSON behaviour ERROR_VARIABLE behaviour_error GET "${profile}" compatibility behaviour_revision)
  string(JSON state_format ERROR_VARIABLE state_error GET "${profile}" compatibility state_format)
  string(JSON source_sha ERROR_VARIABLE source_error GET "${receipt}" release source_commit)
  string(JSON version ERROR_VARIABLE version_error GET "${receipt}" release version)
  string(JSON candidate_sha ERROR_VARIABLE candidate_error GET "${acceptance}" candidate_source_commit)
  if(require_title_proof)
    string(JSON receipt_candidate_pr ERROR_VARIABLE receipt_candidate_pr_error GET "${receipt}" release candidate_pr_number)
    string(JSON receipt_candidate_head ERROR_VARIABLE receipt_candidate_head_error GET "${receipt}" release candidate_pr_head_sha)
    string(JSON receipt_release_pr ERROR_VARIABLE receipt_release_pr_error GET "${receipt}" release release_pr_number)
    string(JSON receipt_release_head ERROR_VARIABLE receipt_release_head_error GET "${receipt}" release release_pr_head_sha)
    if(receipt_candidate_pr_error OR receipt_candidate_head_error OR
       receipt_release_pr_error OR receipt_release_head_error)
      message(FATAL_ERROR "pr-title-evidence-missing: published receipt lacks candidate/release PR identities")
    endif()
    pr_validate_title_proof_pair("${receipt}" "${receipt_candidate_pr}" "${receipt_candidate_head}"
      "${receipt_release_pr}" "${receipt_release_head}"
      receipt_candidate_title receipt_release_title receipt_title_error)
    if(receipt_title_error)
      message(FATAL_ERROR "published receipt title proof verification failed: ${receipt_title_error}")
    endif()
  endif()
  foreach(error IN ITEMS "${scenario_error}" "${abi_error}" "${behaviour_error}" "${state_error}"
      "${source_error}" "${version_error}" "${candidate_error}")
    if(error)
      message(FATAL_ERROR "published receipt verification evidence is malformed: ${error}")
    endif()
  endforeach()
  pr_validate_structure("${receipt}" "${TAG}" "${source_sha}" "${version}"
    "${profile_sha}" "${guide_sha}" "${scenario_sha}" "${abi}" "${behaviour}"
    "${state_format}" "${candidate_sha}" TRUE verify_error)
  if(verify_error)
    message(FATAL_ERROR "published receipt verification failed: ${verify_error}")
  endif()
  pr_validate_rights("${receipt}" "${SOURCE_DIR}/${DABG_NOTICE_PATH}" rights_error)
  if(rights_error)
    message(FATAL_ERROR "published receipt rights verification failed: ${rights_error}")
  endif()
  pr_verify_published_notice("${SOURCE_DIR}/${DABG_NOTICE_PATH}" upstream_notice_error)
  if(upstream_notice_error)
    message(FATAL_ERROR "published receipt pinned upstream notice verification failed: ${upstream_notice_error}")
  endif()
  pr_hosted_stage("release")
  file(READ "${RELEASE_EVIDENCE}" evidence)
  string(JSON evidence_source ERROR_VARIABLE evidence_source_error GET "${evidence}" release source_commit)
  string(JSON evidence_tag ERROR_VARIABLE evidence_tag_error GET "${evidence}" release tag)
  if(evidence_source_error OR evidence_tag_error OR NOT evidence_source STREQUAL source_sha OR NOT evidence_tag STREQUAL TAG)
    message(FATAL_ERROR "published receipt does not match current hosted release identities: ${evidence_source_error}${evidence_tag_error}")
  endif()
  if(require_title_proof)
    string(JSON evidence_candidate_title ERROR_VARIABLE evidence_candidate_title_error GET "${evidence}" linked_title candidate)
    string(JSON evidence_release_title ERROR_VARIABLE evidence_release_title_error GET "${evidence}" linked_title release_pr)
    if(evidence_candidate_title_error OR evidence_release_title_error OR
       NOT receipt_candidate_title STREQUAL evidence_candidate_title OR
       NOT receipt_release_title STREQUAL evidence_release_title)
      message(FATAL_ERROR "pr-title-evidence-mismatch: hosted release evidence does not preserve the published receipt's at-merge title proofs")
    endif()
  endif()
  message(STATUS "existing published receipt passed structural and live hosted identity checks; receipt was preserved and native replay was not repeated")
  return()
elseif(NOT MODE STREQUAL "published")
  message(FATAL_ERROR "provider_receipt MODE must be selftest, local, handoff, rights, hosted, title, published or verify-published")
endif()

pr_title_requirement(require_title_proof)

foreach(required IN ITEMS ACCEPTANCE TAG WORK)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "provider_receipt MODE=published requires ${required}")
  endif()
endforeach()
if(NOT EXISTS "${ACCEPTANCE}" OR NOT EXISTS "${PROFILE}" OR
   NOT EXISTS "${SOURCE_DIR}/docs/nrom-gameplay.md" OR
   NOT EXISTS "${SOURCE_DIR}/tests/roms/manifest.txt")
  message(FATAL_ERROR "published receipt missing: acceptance, profile, guide or ROM manifest is absent")
endif()
if(EXISTS "${OUTPUT_RECEIPT}")
  message(FATAL_ERROR "published receipt already exists; preserve and review it instead of overwriting ${OUTPUT_RECEIPT}")
endif()
if(NOT TAG MATCHES "^v[0-9]+\\.[0-9]+\\.[0-9]+$")
  message(FATAL_ERROR "TAG must be the observed vMAJOR.MINOR.PATCH Release Please tag")
endif()
pr_owned_work("${WORK}" FALSE work_error)
if(work_error)
  message(FATAL_ERROR "provider_receipt: ${work_error}")
endif()
if(NOT EXISTS "${SOURCE_DIR}/.git")
  message(FATAL_ERROR "published receipt requires SOURCE_DIR to be the exact release-source checkout")
endif()

execute_process(COMMAND git -C "${SOURCE_DIR}" rev-parse HEAD
  RESULT_VARIABLE local_head_result OUTPUT_VARIABLE local_head ERROR_VARIABLE local_head_error
  TIMEOUT 10)
string(STRIP "${local_head}" local_head)
if(NOT local_head_result STREQUAL "0")
  message(FATAL_ERROR "cannot identify SOURCE_DIR git HEAD: ${local_head_error}")
endif()
execute_process(COMMAND git -C "${SOURCE_DIR}" status --porcelain
  RESULT_VARIABLE status_result OUTPUT_VARIABLE source_status ERROR_VARIABLE status_error TIMEOUT 10)
if(NOT status_result STREQUAL "0" OR NOT source_status STREQUAL "")
  message(FATAL_ERROR "published receipt requires a clean exact source checkout: ${status_error}${source_status}")
endif()
pr_compare_pinned_notice("${SOURCE_DIR}/${DABG_NOTICE_PATH}" "${DABG_LICENSE_URL}"
  "${WORK}/diagnostics" published_notice_error)
if(published_notice_error)
  message(FATAL_ERROR "published receipt pinned upstream rights verification failed before release inspection: ${published_notice_error}")
endif()
if(NOT DEFINED RELEASE_EVIDENCE OR RELEASE_EVIDENCE STREQUAL "")
  message(FATAL_ERROR "provider_receipt MODE=published requires RELEASE_EVIDENCE")
endif()
get_filename_component(RELEASE_EVIDENCE "${RELEASE_EVIDENCE}" ABSOLUTE BASE_DIR "${SOURCE_DIR}")
if(NOT EXISTS "${RELEASE_EVIDENCE}")
  message(FATAL_ERROR "published receipt requires hosted RELEASE_EVIDENCE: ${RELEASE_EVIDENCE}")
endif()

set(diag "${WORK}/diagnostics")
set(gh_env "${CMAKE_COMMAND}" -E env GH_PROMPT_DISABLED=1 GH_NO_UPDATE_NOTIFIER=1)
execute_process(COMMAND ${gh_env} gh release view "${TAG}" --repo "${REPOSITORY}"
    --json tagName,isDraft,url,publishedAt,assets
  RESULT_VARIABLE release_result OUTPUT_VARIABLE release_json ERROR_VARIABLE release_error
  TIMEOUT 60)
file(WRITE "${diag}/release-view.stdout.json" "${release_json}")
file(WRITE "${diag}/release-view.stderr.txt" "${release_error}")
if(NOT release_result STREQUAL "0")
  message(FATAL_ERROR "published release missing or unavailable for ${TAG}: ${release_error}")
endif()
string(JSON tag_type ERROR_VARIABLE json_error TYPE "${release_json}" tagName)
if(json_error OR NOT tag_type STREQUAL "STRING")
  message(FATAL_ERROR "release tag must be a JSON STRING: ${json_error}${tag_type}")
endif()
string(JSON observed_tag ERROR_VARIABLE json_error GET "${release_json}" tagName)
if(json_error OR NOT observed_tag STREQUAL TAG)
  message(FATAL_ERROR "release tag mismatch for requested ${TAG}: ${json_error}${observed_tag}")
endif()
string(JSON draft_type ERROR_VARIABLE json_error TYPE "${release_json}" isDraft)
if(json_error OR NOT draft_type STREQUAL "BOOLEAN")
  message(FATAL_ERROR "draft-release: release isDraft must be a JSON BOOLEAN: ${json_error}${draft_type}")
endif()
string(JSON is_draft ERROR_VARIABLE json_error GET "${release_json}" isDraft)
if(json_error OR is_draft)
  message(FATAL_ERROR "draft-release: ${TAG} is still a draft")
endif()
string(JSON release_url_type ERROR_VARIABLE json_error TYPE "${release_json}" url)
if(json_error OR NOT release_url_type STREQUAL "STRING")
  message(FATAL_ERROR "release metadata URL must be a JSON STRING: ${json_error}${release_url_type}")
endif()
string(JSON release_url ERROR_VARIABLE json_error GET "${release_json}" url)
if(json_error)
  message(FATAL_ERROR "release metadata lacks a URL: ${json_error}")
endif()
string(JSON published_at ERROR_VARIABLE published_at_error GET "${release_json}" publishedAt)
if(published_at_error)
  message(FATAL_ERROR "release-publication-missing: live release lacks publishedAt: ${published_at_error}")
endif()

execute_process(COMMAND ${gh_env} gh api "repos/${REPOSITORY}/git/ref/tags/${TAG}"
  RESULT_VARIABLE tag_result OUTPUT_VARIABLE ref_json ERROR_VARIABLE tag_error TIMEOUT 60)
file(WRITE "${diag}/tag-ref.stdout.json" "${ref_json}")
file(WRITE "${diag}/tag-ref.stderr.txt" "${tag_error}")
if(NOT tag_result STREQUAL "0")
  message(FATAL_ERROR "cannot resolve release tag ${TAG}: ${tag_error}")
endif()
string(JSON ref_type ERROR_VARIABLE json_error GET "${ref_json}" object type)
string(JSON source_sha ERROR_VARIABLE json_error GET "${ref_json}" object sha)
if(json_error)
  message(FATAL_ERROR "release tag reference is malformed: ${json_error}")
endif()
if(ref_type STREQUAL "tag")
  execute_process(COMMAND ${gh_env} gh api "repos/${REPOSITORY}/git/tags/${source_sha}"
    RESULT_VARIABLE tag_object_result OUTPUT_VARIABLE tag_object_json ERROR_VARIABLE tag_object_error
    TIMEOUT 60)
  file(WRITE "${diag}/tag-object.stdout.json" "${tag_object_json}")
  file(WRITE "${diag}/tag-object.stderr.txt" "${tag_object_error}")
  if(NOT tag_object_result STREQUAL "0")
    message(FATAL_ERROR "cannot dereference annotated release tag: ${tag_object_error}")
  endif()
  string(JSON resolved_type ERROR_VARIABLE json_error GET "${tag_object_json}" object type)
  string(JSON source_sha ERROR_VARIABLE json_error GET "${tag_object_json}" object sha)
  if(json_error OR NOT resolved_type STREQUAL "commit")
    message(FATAL_ERROR "release tag does not resolve directly to a commit: ${json_error}")
  endif()
elseif(NOT ref_type STREQUAL "commit")
  message(FATAL_ERROR "release tag resolves to unsupported object type ${ref_type}")
endif()
string(LENGTH "${source_sha}" source_sha_length)
if(NOT source_sha_length EQUAL 40 OR NOT source_sha MATCHES "^[0-9a-f]+$")
  message(FATAL_ERROR "resolved release source is not a full Git commit ID: ${source_sha}")
endif()
if(NOT local_head STREQUAL source_sha)
  message(FATAL_ERROR "SOURCE_DIR HEAD ${local_head} is not the release source ${source_sha}")
endif()

string(REGEX REPLACE "^v" "" release_version "${TAG}")
file(STRINGS "${SOURCE_DIR}/version.txt" source_version LIMIT_COUNT 1)
if(NOT source_version STREQUAL release_version)
  message(FATAL_ERROR "metadata-mismatch: release tag is ${release_version}, exact source says ${source_version}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE_DIR=${SOURCE_DIR}"
    -P "${SOURCE_DIR}/tests/cmake/version_consistency.cmake"
  RESULT_VARIABLE version_result OUTPUT_VARIABLE version_out ERROR_VARIABLE version_error TIMEOUT 20)
file(WRITE "${diag}/version-check.stdout.txt" "${version_out}")
file(WRITE "${diag}/version-check.stderr.txt" "${version_error}")
if(NOT version_result STREQUAL "0")
  message(FATAL_ERROR "release source metadata is inconsistent: ${version_out}${version_error}")
endif()

file(READ "${PROFILE}" profile)
file(READ "${ACCEPTANCE}" acceptance)
file(SHA256 "${PROFILE}" profile_sha)
file(SHA256 "${SOURCE_DIR}/docs/nrom-gameplay.md" guide_sha)
string(JSON scenario_rom_sha ERROR_VARIABLE json_error GET "${profile}" scenario rom_sha256)
if(json_error)
  message(FATAL_ERROR "provider profile lacks scenario ROM digest: ${json_error}")
endif()
string(JSON abi ERROR_VARIABLE json_error GET "${profile}" compatibility abi)
string(JSON behaviour ERROR_VARIABLE json_error GET "${profile}" compatibility behaviour_revision)
string(JSON state_format ERROR_VARIABLE json_error GET "${profile}" compatibility state_format)
if(json_error)
  message(FATAL_ERROR "provider profile compatibility metadata is incomplete: ${json_error}")
endif()
pr_expect("${profile}" "qualification.status" "candidate-only" source-profile-status status_error)
if(status_error)
  message(FATAL_ERROR "published source must contain the unreleased candidate provider profile: ${status_error}")
endif()

# Acceptance fields are deliberately explicit. The candidate identity may be
# nested under `inputs`, `contract`, or `scenario`; accept these documented
# aliases while rejecting identities that carry no provider/game binding.
set(accepted_profile "")
foreach(path IN ITEMS "profile_sha256" "inputs.profile_sha256" "contract.profile_sha256")
  string(REPLACE "." ";" parts "${path}")
  string(JSON value ERROR_VARIABLE read_error GET "${acceptance}" ${parts})
  if(NOT read_error)
    set(accepted_profile "${value}")
    break()
  endif()
endforeach()
set(accepted_guide "")
foreach(path IN ITEMS "guide_sha256" "scenario_guide_sha256" "inputs.guide_sha256" "scenario.guide_sha256")
  string(REPLACE "." ";" parts "${path}")
  string(JSON value ERROR_VARIABLE read_error GET "${acceptance}" ${parts})
  if(NOT read_error)
    set(accepted_guide "${value}")
    break()
  endif()
endforeach()
set(accepted_rom "")
foreach(path IN ITEMS "rom_sha256" "scenario_rom_sha256" "inputs.rom_sha256" "scenario.rom_sha256")
  string(REPLACE "." ";" parts "${path}")
  string(JSON value ERROR_VARIABLE read_error GET "${acceptance}" ${parts})
  if(NOT read_error)
    set(accepted_rom "${value}")
    break()
  endif()
endforeach()
if(NOT accepted_profile STREQUAL profile_sha OR NOT accepted_guide STREQUAL guide_sha OR
   NOT accepted_rom STREQUAL scenario_rom_sha)
  message(FATAL_ERROR "source/profile/scenario mismatch: acceptance identity does not bind the exact release source inputs")
endif()
set(candidate_sha "")
foreach(path IN ITEMS "candidate_source_commit" "candidate_commit" "candidate.source_commit"
    "candidate.commit" "source_commit" "source.commit" "source.sha")
  string(REPLACE "." ";" parts "${path}")
  string(JSON value ERROR_VARIABLE read_error GET "${acceptance}" ${parts})
  if(NOT read_error)
    set(candidate_sha "${value}")
    break()
  endif()
endforeach()
pr_commit_valid("${candidate_sha}" candidate_sha_valid)
if(NOT candidate_sha_valid)
  message(FATAL_ERROR "candidate-CI identity is absent from the accepted source record")
endif()
file(READ "${RELEASE_EVIDENCE}" release_evidence)
pr_json_get_required("${release_evidence}" "local_candidate.commit" local_candidate_commit evidence_error "hosted-evidence-missing")
pr_json_get_required("${release_evidence}" "local_candidate.input_manifest_sha256" local_candidate_manifest evidence_error "hosted-evidence-missing")
pr_json_get_required("${release_evidence}" "candidate.pr_number" evidence_candidate_pr evidence_error "hosted-evidence-missing")
pr_json_get_required("${release_evidence}" "candidate.head_sha" evidence_candidate_head evidence_error "hosted-evidence-missing")
pr_json_get_required("${release_evidence}" "candidate.tested_merge_sha" evidence_tested_merge evidence_error "hosted-evidence-missing")
pr_json_get_required("${release_evidence}" "main.head_sha" implementation_main evidence_error "hosted-evidence-missing")
pr_json_get_required("${release_evidence}" "release.source_commit" evidence_release_source evidence_error "hosted-evidence-missing")
pr_json_get_required("${release_evidence}" "release.tag" evidence_tag evidence_error "hosted-evidence-missing")
pr_json_get_required("${release_evidence}" "release.version" evidence_version evidence_error "hosted-evidence-missing")
pr_json_get_required("${release_evidence}" "release.release_pr_number" evidence_release_pr evidence_error "hosted-evidence-missing")
pr_json_get_required("${release_evidence}" "release.release_pr_head_sha" evidence_release_pr_head evidence_error "hosted-evidence-missing")
pr_json_get_required("${release_evidence}" "release.release_pr_tested_merge_sha" evidence_release_pr_merge evidence_error "hosted-evidence-missing")
string(JSON evidence_version_delta_type ERROR_VARIABLE evidence_version_delta_error TYPE "${release_evidence}" release version_delta_files)
string(JSON evidence_version_delta_count ERROR_VARIABLE evidence_version_delta_count_error LENGTH "${release_evidence}" release version_delta_files)
if(evidence_error)
  message(FATAL_ERROR "${evidence_error}")
endif()
if(evidence_version_delta_error OR evidence_version_delta_count_error OR
   NOT evidence_version_delta_type STREQUAL "ARRAY" OR evidence_version_delta_count LESS 1)
  message(FATAL_ERROR "hosted-evidence-missing: release version-only delta file list is absent or malformed")
endif()
