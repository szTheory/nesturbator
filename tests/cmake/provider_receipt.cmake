function(pr_validate_title_record proof expected_pr expected_head expected_title_sha out_error)
  set(${out_error} "" PARENT_SCOPE)
  foreach(pair IN ITEMS
      "schema_version;NUMBER" "pr_number;NUMBER" "run_id;NUMBER" "run_attempt;NUMBER"
      "check_suite_id;NUMBER" "check_run_id;NUMBER" "job_id;NUMBER"
      "title_valid;BOOLEAN" "repository;STRING" "head_sha;STRING" "title_sha256;STRING"
      "workflow_name;STRING" "workflow_path;STRING" "event;STRING" "event_action;STRING"
      "event_sha;STRING" "created_at;STRING" "status;STRING" "conclusion;STRING"
      "check_context;STRING" "check_status;STRING" "check_conclusion;STRING"
      "job_name;STRING" "job_status;STRING" "job_conclusion;STRING"
      "log_sha256;STRING" "evidence_log;STRING")
    list(GET pair 0 field)
    list(GET pair 1 expected_type)
    string(JSON field_type ERROR_VARIABLE type_error TYPE "${proof}" "${field}")
    if(type_error OR NOT field_type STREQUAL expected_type)
      set(${out_error} "pr-title-evidence-missing: ${field} must be JSON ${expected_type}" PARENT_SCOPE)
      return()
    endif()
    string(JSON ${field} ERROR_VARIABLE read_error GET "${proof}" "${field}")
    if(read_error)
      set(${out_error} "pr-title-evidence-missing: cannot read ${field}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  pr_commit_valid("${head_sha}" head_valid)
  pr_commit_valid("${event_sha}" event_valid)
  pr_digest_valid("${title_sha256}" title_digest_valid)
  pr_digest_valid("${log_sha256}" log_digest_valid)
  if(NOT schema_version EQUAL 1 OR NOT repository STREQUAL REPOSITORY OR
     NOT pr_number STREQUAL expected_pr OR NOT head_sha STREQUAL expected_head OR
     NOT title_sha256 STREQUAL expected_title_sha OR NOT title_valid OR
     NOT workflow_name STREQUAL "PR title" OR
     NOT workflow_path STREQUAL ".github/workflows/pr-title.yml" OR
     NOT event STREQUAL "pull_request" OR
     NOT event_action MATCHES "^(opened|synchronize|reopened|edited)$" OR
     NOT event_valid OR NOT run_id MATCHES "^[1-9][0-9]*$" OR
     NOT run_attempt MATCHES "^[1-9][0-9]*$" OR
     NOT created_at MATCHES "^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]([.][0-9]+)?Z$" OR
     NOT status STREQUAL "completed" OR NOT conclusion STREQUAL "success" OR
     NOT check_context STREQUAL "PR title" OR NOT check_status STREQUAL "completed" OR
     NOT check_conclusion STREQUAL "success" OR NOT job_name STREQUAL "PR title" OR
     NOT job_status STREQUAL "completed" OR NOT job_conclusion STREQUAL "success" OR
     NOT check_suite_id MATCHES "^[1-9][0-9]*$" OR
     NOT check_run_id MATCHES "^[1-9][0-9]*$" OR NOT job_id MATCHES "^[1-9][0-9]*$" OR
     NOT log_digest_valid OR evidence_log STREQUAL "" OR
     evidence_log MATCHES "(^/|(^|/)\\.\\.(/|$))")
    set(${out_error} "pr-title-identity-mismatch: title proof is malformed or differs from its PR/head" PARENT_SCOPE)
    return()
  endif()
endfunction()

function(pr_validate_title_log_file proof expected_pr expected_head expected_title_sha out_error)
  pr_validate_title_record("${proof}" "${expected_pr}" "${expected_head}"
    "${expected_title_sha}" proof_error)
  if(proof_error)
    set(${out_error} "${proof_error}" PARENT_SCOPE)
    return()
  endif()
  string(JSON relative_log GET "${proof}" evidence_log)
  string(JSON expected_log_sha GET "${proof}" log_sha256)
  if(NOT relative_log MATCHES "^build/phase28-normal/title-logs/")
    set(${out_error} "pr-title-evidence-path: title log is outside the normal qualification output" PARENT_SCOPE)
    return()
  endif()
  set(log_path "${SOURCE_DIR}/${relative_log}")
  if(IS_SYMLINK "${log_path}" OR NOT EXISTS "${log_path}")
    set(${out_error} "pr-title-evidence-missing: retained raw title job log is absent or symlinked" PARENT_SCOPE)
    return()
  endif()
  file(SHA256 "${log_path}" actual_log_sha)
  if(NOT actual_log_sha STREQUAL expected_log_sha)
    set(${out_error} "pr-title-evidence-digest: retained title job log changed" PARENT_SCOPE)
    return()
  endif()
  file(READ "${log_path}" title_log)
  string(JSON expected_run GET "${proof}" run_id)
  string(JSON expected_attempt GET "${proof}" run_attempt)
  pr_parse_title_log("${title_log}" "${expected_pr}" "${expected_head}"
    "${expected_title_sha}" "${expected_run}" "${expected_attempt}" parsed_log parse_error)
  if(parse_error)
    set(${out_error} "${parse_error}" PARENT_SCOPE)
  else()
    set(${out_error} "" PARENT_SCOPE)
  endif()
endfunction()

