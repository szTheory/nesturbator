function(pr_json_set json path value out_json)
  string(REPLACE "." ";" path_parts "${path}")
  string(JSON updated SET "${json}" ${path_parts} "${value}")
  set(${out_json} "${updated}" PARENT_SCOPE)
endfunction()

function(pr_expect json field expected reason out_error)
  string(REPLACE "." ";" path "${field}")
  if(field MATCHES "^compatibility\\.(abi|behaviour_revision|state_format)$")
    set(expected_type NUMBER)
  else()
    set(expected_type STRING)
  endif()
  string(JSON actual_type ERROR_VARIABLE type_error TYPE "${json}" ${path})
  if(type_error)
    set(${out_error} "${reason}: ${field}: ${type_error}" PARENT_SCOPE)
    return()
  elseif(NOT actual_type STREQUAL expected_type)
    set(${out_error} "${reason}: ${field}: expected JSON type ${expected_type}, found ${actual_type}" PARENT_SCOPE)
    return()
  endif()
  string(JSON actual ERROR_VARIABLE read_error GET "${json}" ${path})
  if(read_error)
    set(${out_error} "${reason}: ${field}: ${read_error}" PARENT_SCOPE)
  elseif(NOT "${actual}" STREQUAL "${expected}")
    set(${out_error} "${reason}: ${field}: expected ${expected}, found ${actual}" PARENT_SCOPE)
  else()
    set(${out_error} "" PARENT_SCOPE)
  endif()
endfunction()

function(pr_expect_boolean json field expected reason out_error)
  string(REPLACE "." ";" path "${field}")
  string(JSON actual_type ERROR_VARIABLE type_error TYPE "${json}" ${path})
  if(type_error)
    set(${out_error} "${reason}: ${field}: ${type_error}" PARENT_SCOPE)
    return()
  elseif(NOT actual_type STREQUAL "BOOLEAN")
    set(${out_error} "${reason}: ${field}: expected JSON type BOOLEAN, found ${actual_type}" PARENT_SCOPE)
    return()
  endif()
  string(JSON actual ERROR_VARIABLE read_error GET "${json}" ${path})
  if(read_error)
    set(${out_error} "${reason}: ${field}: ${read_error}" PARENT_SCOPE)
  elseif(actual AND expected STREQUAL "true")
    set(${out_error} "" PARENT_SCOPE)
  elseif(NOT actual AND expected STREQUAL "false")
    set(${out_error} "" PARENT_SCOPE)
  else()
    set(${out_error} "${reason}: ${field}: expected ${expected}" PARENT_SCOPE)
  endif()
endfunction()

function(pr_digest_valid digest out_valid)
  string(LENGTH "${digest}" length)
  if(length EQUAL 64 AND digest MATCHES "^[0-9a-f]+$")
    set(${out_valid} TRUE PARENT_SCOPE)
  else()
    set(${out_valid} FALSE PARENT_SCOPE)
  endif()
endfunction()

function(pr_expect_string_array json field expected_values reason out_error)
  string(REPLACE "." ";" path "${field}")
  string(JSON actual_type ERROR_VARIABLE type_error TYPE "${json}" ${path})
  if(type_error)
    set(${out_error} "${reason}: ${field} is absent or malformed: ${type_error}" PARENT_SCOPE)
    return()
  elseif(NOT actual_type STREQUAL "ARRAY")
    set(${out_error} "${reason}: ${field} must be JSON ARRAY, found ${actual_type}" PARENT_SCOPE)
    return()
  endif()
  string(JSON actual_count ERROR_VARIABLE count_error LENGTH "${json}" ${path})
  list(LENGTH expected_values expected_count)
  if(count_error OR NOT actual_count EQUAL expected_count)
    set(${out_error} "${reason}: ${field} must contain exactly ${expected_count} values" PARENT_SCOPE)
    return()
  endif()
  set(actual_values)
  if(actual_count GREATER 0)
    math(EXPR last_index "${actual_count} - 1")
    foreach(index RANGE 0 ${last_index})
      string(JSON item_type ERROR_VARIABLE item_type_error TYPE "${json}" ${path} ${index})
      if(item_type_error OR NOT item_type STREQUAL "STRING")
        set(${out_error} "${reason}: ${field}[${index}] must be JSON STRING" PARENT_SCOPE)
        return()
      endif()
      string(JSON item GET "${json}" ${path} ${index})
      if(NOT item IN_LIST expected_values)
        set(${out_error} "${reason}: ${field} contains unsupported value '${item}'" PARENT_SCOPE)
        return()
      endif()
      list(APPEND actual_values "${item}")
    endforeach()
  endif()
  if(NOT "${actual_values}" STREQUAL "${expected_values}")
    set(${out_error} "${reason}: ${field} values or order differ from the pinned contract" PARENT_SCOPE)
  else()
    set(${out_error} "" PARENT_SCOPE)
  endif()
endfunction()

function(pr_validate_rights_structure json expected_rom out_error)
  set(${out_error} "" PARENT_SCOPE)
  if(NOT expected_rom STREQUAL DABG_ROM_SHA256)
    set(${out_error} "rights-scenario-mismatch: expected DABG ROM digest is not the pinned image" PARENT_SCOPE)
    return()
  endif()
  foreach(pair IN ITEMS
      "scenario.source_url;${DABG_SOURCE_URL}"
      "scenario.source_commit;${DABG_SOURCE_COMMIT}"
      "scenario.rom_sha256;${DABG_ROM_SHA256}"
      "scenario.rights.spdx_id;Zlib"
      "scenario.rights.license_url;${DABG_LICENSE_URL}"
      "scenario.rights.license_source_commit;${DABG_SOURCE_COMMIT}"
      "scenario.rights.license_text_sha256;${DABG_LICENSE_TEXT_SHA256}"
      "scenario.rights.required_notice.path;${DABG_NOTICE_PATH}"
      "scenario.rights.required_notice.sha256;${DABG_LICENSE_TEXT_SHA256}"
      "distribution.receipt_delivery;source-evidence-overlay")
    list(GET pair 0 field)
    list(GET pair 1 expected)
    if(field STREQUAL "scenario.source_url" OR field STREQUAL "scenario.source_commit")
      set(reason rights-source-mismatch)
    elseif(field STREQUAL "scenario.rom_sha256")
      set(reason rights-scenario-mismatch)
    elseif(field STREQUAL "distribution.receipt_delivery")
      set(reason rights-distribution-mismatch)
    elseif(field MATCHES "license|spdx")
      set(reason rights-license-mismatch)
    else()
      set(reason rights-notice-mismatch)
    endif()
    pr_expect("${json}" "${field}" "${expected}" "${reason}" field_error)
    if(field_error)
      set(${out_error} "${field_error}" PARENT_SCOPE)
      return()
    endif()
  endforeach()

  pr_expect_boolean("${json}" "distribution.rom_in_component_archives" "false"
    rights-distribution-mismatch field_error)
  if(field_error)
    set(${out_error} "${field_error}" PARENT_SCOPE)
    return()
  endif()
  pr_expect_string_array("${json}" "scenario.rights.permitted_uses"
    "${DABG_PERMITTED_USES}" rights-permitted-uses field_error)
  if(field_error)
    set(${out_error} "${field_error}" PARENT_SCOPE)
    return()
  endif()
  pr_expect_string_array("${json}" "scenario.rights.restrictions"
    "${DABG_RESTRICTIONS}" rights-restrictions field_error)
  if(field_error)
    set(${out_error} "${field_error}" PARENT_SCOPE)
    return()
  endif()
endfunction()

function(pr_add_rights_contract json out_json)
  string(JSON updated SET "${json}" scenario "{}")
  string(JSON updated SET "${updated}" scenario rights "{}")
  string(JSON updated SET "${updated}" scenario rights required_notice "{}")
  string(JSON updated SET "${updated}" distribution "{}")
  pr_json_set("${updated}" scenario.source_url "\"${DABG_SOURCE_URL}\"" updated)
  pr_json_set("${updated}" scenario.source_commit "\"${DABG_SOURCE_COMMIT}\"" updated)
  pr_json_set("${updated}" scenario.rom_sha256 "\"${DABG_ROM_SHA256}\"" updated)
  pr_json_set("${updated}" scenario.rights.spdx_id "\"Zlib\"" updated)
  pr_json_set("${updated}" scenario.rights.license_url "\"${DABG_LICENSE_URL}\"" updated)
  pr_json_set("${updated}" scenario.rights.license_source_commit "\"${DABG_SOURCE_COMMIT}\"" updated)
  pr_json_set("${updated}" scenario.rights.license_text_sha256 "\"${DABG_LICENSE_TEXT_SHA256}\"" updated)
  pr_json_set("${updated}" scenario.rights.required_notice.path "\"${DABG_NOTICE_PATH}\"" updated)
  pr_json_set("${updated}" scenario.rights.required_notice.sha256 "\"${DABG_LICENSE_TEXT_SHA256}\"" updated)
  list(JOIN DABG_PERMITTED_USES "\",\"" permitted_json_values)
  list(JOIN DABG_RESTRICTIONS "\",\"" restriction_json_values)
  pr_json_set("${updated}" scenario.rights.permitted_uses "[\"${permitted_json_values}\"]" updated)
  pr_json_set("${updated}" scenario.rights.restrictions "[\"${restriction_json_values}\"]" updated)
  pr_json_set("${updated}" distribution.rom_in_component_archives false updated)
  pr_json_set("${updated}" distribution.receipt_delivery "\"source-evidence-overlay\"" updated)
  set(${out_json} "${updated}" PARENT_SCOPE)
endfunction()

function(pr_validate_notice_file notice_file out_error)
  if(NOT EXISTS "${notice_file}" OR IS_DIRECTORY "${notice_file}" OR IS_SYMLINK "${notice_file}")
    set(${out_error} "rights-notice-content-mismatch: required notice file is missing or not a regular file" PARENT_SCOPE)
    return()
  endif()
  file(SHA256 "${notice_file}" actual_notice_sha)
  if(NOT actual_notice_sha STREQUAL DABG_LICENSE_TEXT_SHA256)
    set(${out_error} "rights-notice-content-mismatch: actual notice digest ${actual_notice_sha} differs from the pinned text" PARENT_SCOPE)
    return()
  endif()
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(pr_compare_pinned_notice notice_file source_url diagnostics_dir out_error)
  pr_validate_notice_file("${notice_file}" notice_error)
  if(notice_error)
    set(${out_error} "${notice_error}" PARENT_SCOPE)
    return()
  endif()
  if(NOT IS_DIRECTORY "${diagnostics_dir}" OR IS_SYMLINK "${diagnostics_dir}")
    set(${out_error} "rights-upstream-work-invalid: diagnostics directory is missing or not a real directory" PARENT_SCOPE)
    return()
  endif()

  string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef fetch_nonce)
  set(fetched_notice "${diagnostics_dir}/upstream-license-${fetch_nonce}.txt")
  if(EXISTS "${fetched_notice}" OR IS_SYMLINK "${fetched_notice}")
    set(${out_error} "rights-upstream-work-collision: preserving existing license artifact ${fetched_notice}" PARENT_SCOPE)
    return()
  endif()
  file(DOWNLOAD "${source_url}" "${fetched_notice}"
    STATUS download_status TIMEOUT 60 TLS_VERIFY ON)
  list(GET download_status 0 download_code)
  list(GET download_status 1 download_message)
  if(NOT download_code STREQUAL "0")
    set(${out_error} "rights-upstream-fetch-failed: ${download_message}" PARENT_SCOPE)
    return()
  endif()

  execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${fetched_notice}" "${notice_file}"
    RESULT_VARIABLE compare_result OUTPUT_VARIABLE compare_output ERROR_VARIABLE compare_error TIMEOUT 10)
  if(NOT compare_result STREQUAL "0")
    set(${out_error} "rights-upstream-notice-mismatch: pinned upstream bytes differ from the tracked notice: ${compare_output}${compare_error}" PARENT_SCOPE)
    return()
  endif()
  file(SHA256 "${fetched_notice}" fetched_sha)
  if(NOT fetched_sha STREQUAL DABG_LICENSE_TEXT_SHA256)
    set(${out_error} "rights-upstream-digest-mismatch: retrieved text digest ${fetched_sha} differs from the observed pinned text" PARENT_SCOPE)
    return()
  endif()
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(pr_validate_rights json notice_file out_error)
  pr_validate_rights_structure("${json}" "${DABG_ROM_SHA256}" structure_error)
  if(structure_error)
    set(${out_error} "${structure_error}" PARENT_SCOPE)
    return()
  endif()
  pr_validate_notice_file("${notice_file}" notice_error)
  if(notice_error)
    set(${out_error} "${notice_error}" PARENT_SCOPE)
    return()
  endif()
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(pr_rights_check)
  if(NOT DEFINED WORK OR "${WORK}" STREQUAL "")
    message(FATAL_ERROR "provider_receipt MODE=rights requires WORK under SOURCE_DIR/build")
  endif()
  if(IS_SYMLINK "${WORK}")
    message(FATAL_ERROR "rights verification refuses symlink WORK ${WORK}")
  endif()
  if(IS_SYMLINK "${SOURCE_DIR}/build")
    message(FATAL_ERROR "rights verification refuses symlink SOURCE_DIR/build")
  endif()
  file(MAKE_DIRECTORY "${SOURCE_DIR}/build")
  if(NOT IS_DIRECTORY "${SOURCE_DIR}/build")
    message(FATAL_ERROR "rights verification could not create SOURCE_DIR/build")
  endif()
  file(REAL_PATH "${SOURCE_DIR}/build" build_real)
  get_filename_component(work_absolute "${WORK}" ABSOLUTE BASE_DIR "${SOURCE_DIR}")
  get_filename_component(work_parent "${work_absolute}" DIRECTORY)
  if(NOT IS_DIRECTORY "${work_parent}")
    message(FATAL_ERROR "rights verification WORK parent must already exist: ${work_parent}")
  endif()
  file(REAL_PATH "${work_parent}" work_parent_real)
  cmake_path(IS_PREFIX build_real "${work_parent_real}" NORMALIZE work_inside_build)
  if(NOT work_inside_build)
    message(FATAL_ERROR "rights verification WORK must be a child of SOURCE_DIR/build: ${WORK}")
  endif()
  pr_owned_work("${work_absolute}" FALSE work_error)
  if(work_error)
    message(FATAL_ERROR "provider_receipt MODE=rights: ${work_error}")
  endif()

  set(tracked_paths
    "${DABG_NOTICE_PATH}"
    tests/roms/manifest.txt
    THIRD-PARTY-NOTICES.md
    tests/cmake/provider_receipt.cmake
    docs/releases.md
    docs/provider-ntsc.json
    docs/nrom-gameplay.md)
  execute_process(COMMAND git -C "${SOURCE_DIR}" ls-files --error-unmatch -- ${tracked_paths}
    RESULT_VARIABLE tracked_result OUTPUT_VARIABLE tracked_output ERROR_VARIABLE tracked_error TIMEOUT 10)
  if(NOT tracked_result STREQUAL "0")
    message(FATAL_ERROR "rights source inputs must be tracked: ${tracked_error}${tracked_output}")
  endif()
  foreach(path IN LISTS tracked_paths)
    if(NOT EXISTS "${SOURCE_DIR}/${path}" OR IS_DIRECTORY "${SOURCE_DIR}/${path}" OR IS_SYMLINK "${SOURCE_DIR}/${path}")
      message(FATAL_ERROR "rights source input is missing or not a regular file: ${path}")
    endif()
  endforeach()

  string(ASCII 9 tab)
  set(expected_manifest_row
    "tests/roms/dabg.nes${tab}${DABG_SOURCE_URL}/tree/${DABG_SOURCE_COMMIT}${tab}${DABG_SOURCE_COMMIT}${tab}Zlib${tab}${DABG_ROM_SHA256}")
  file(STRINGS "${SOURCE_DIR}/tests/roms/manifest.txt" manifest_rows
    REGEX "^tests/roms/dabg\\.nes")
  list(LENGTH manifest_rows manifest_row_count)
  if(NOT manifest_row_count EQUAL 1)
    message(FATAL_ERROR "rights manifest must contain exactly one DABG source row")
  endif()
  list(GET manifest_rows 0 manifest_row)
  if(NOT manifest_row STREQUAL expected_manifest_row)
    message(FATAL_ERROR "rights manifest source/commit/license/ROM row differs from the pinned contract")
  endif()

  file(READ "${SOURCE_DIR}/THIRD-PARTY-NOTICES.md" notice_index)
  foreach(required_text IN ITEMS
      "${DABG_SOURCE_URL}"
      "${DABG_SOURCE_COMMIT}"
      "${DABG_ROM_SHA256}"
      "https://github.com/NovaSquirrel/DABG/blob/${DABG_SOURCE_COMMIT}/LICENSE.txt"
      "${DABG_NOTICE_PATH}"
      "${DABG_LICENSE_TEXT_SHA256}"
      "any purpose"
      "commercial use"
      "alteration"
      "redistribution"
      "origin"
      "altered source"
      "same notice")
    string(FIND "${notice_index}" "${required_text}" required_index)
    if(required_index LESS 0)
      message(FATAL_ERROR "rights notice index omits required pinned source, text digest or license term: ${required_text}")
    endif()
  endforeach()
  file(READ "${SOURCE_DIR}/docs/provider-ntsc.json" profile)
  string(JSON profile_game ERROR_VARIABLE profile_game_error GET "${profile}" scenario game)
  string(JSON profile_rom ERROR_VARIABLE profile_rom_error GET "${profile}" scenario rom)
  string(JSON profile_rom_sha ERROR_VARIABLE profile_rom_sha_error GET "${profile}" scenario rom_sha256)
  if(profile_game_error OR profile_rom_error OR profile_rom_sha_error OR
     NOT profile_game STREQUAL "DABG" OR NOT profile_rom STREQUAL "tests/roms/dabg.nes" OR
     NOT profile_rom_sha STREQUAL DABG_ROM_SHA256)
    message(FATAL_ERROR "rights profile does not bind the pinned DABG image: ${profile_game_error}${profile_rom_error}${profile_rom_sha_error}")
  endif()
  file(READ "${SOURCE_DIR}/docs/nrom-gameplay.md" gameplay_guide)
  foreach(required_guide_text IN ITEMS "${DABG_SOURCE_COMMIT}" "${DABG_ROM_SHA256}")
    string(FIND "${gameplay_guide}" "${required_guide_text}" guide_index)
    if(guide_index LESS 0)
      message(FATAL_ERROR "rights gameplay guide omits pinned DABG identity ${required_guide_text}")
    endif()
  endforeach()
  pr_compare_pinned_notice("${SOURCE_DIR}/${DABG_NOTICE_PATH}" "${DABG_LICENSE_URL}"
    "${work_absolute}/diagnostics" upstream_notice_error)
  if(upstream_notice_error)
    message(FATAL_ERROR "rights pinned upstream verification failed without retry: ${upstream_notice_error}")
  endif()
  message(STATUS "pinned DABG source, manifest, notice index and exact upstream Zlib bytes passed rights verification")
endfunction()

function(pr_json_array_as_numeric_object json out_json)
  cmake_parse_arguments(ARG "" "" "PATH" ${ARGN})
  string(JSON collection_type ERROR_VARIABLE type_error TYPE "${json}" ${ARG_PATH})
  if(type_error OR NOT collection_type STREQUAL "ARRAY")
    message(FATAL_ERROR "provider receipt test helper requires an ARRAY, found ${collection_type}${type_error}")
  endif()
  string(JSON item_count LENGTH "${json}" ${ARG_PATH})
  set(object "{}")
  if(item_count GREATER 0)
    math(EXPR last_index "${item_count} - 1")
    foreach(index RANGE 0 ${last_index})
      string(JSON item GET "${json}" ${ARG_PATH} ${index})
      string(JSON object SET "${object}" "${index}" "${item}")
    endforeach()
  endif()
  string(JSON changed SET "${json}" ${ARG_PATH} "${object}")
  set(${out_json} "${changed}" PARENT_SCOPE)
endfunction()

function(pr_untracked_source_control work)
  string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
  set(control "${work}/untracked-source-${run_id}")
  if(EXISTS "${control}" OR IS_SYMLINK "${control}")
    message(FATAL_ERROR "untracked source control scratch already exists: ${control}")
  endif()
  file(MAKE_DIRECTORY "${control}")
  set(marker "${control}/.provider-untracked-control-owned")
  file(WRITE "${marker}" "Nesturbator provider untracked source control v1\n")
  set(repo "${control}/repo")
  file(MAKE_DIRECTORY "${repo}/docs" "${repo}/tests/roms")
  file(WRITE "${repo}/docs/provider-ntsc.json" "{}\n")
  file(WRITE "${repo}/docs/nrom-gameplay.md" "temporary source control\n")
  file(WRITE "${repo}/tests/roms/manifest.txt" "temporary manifest\n")
  file(WRITE "${repo}/acceptance.json" "{}\n")
  execute_process(COMMAND git -C "${repo}" init --quiet
    RESULT_VARIABLE init_result OUTPUT_VARIABLE init_output ERROR_VARIABLE init_error TIMEOUT 10)
  if(NOT init_result STREQUAL "0")
    message(FATAL_ERROR "cannot initialize isolated source cleanliness control: ${init_output}${init_error}")
  endif()
  execute_process(COMMAND git -C "${repo}" add docs/provider-ntsc.json docs/nrom-gameplay.md
      tests/roms/manifest.txt acceptance.json
    RESULT_VARIABLE add_result OUTPUT_VARIABLE add_output ERROR_VARIABLE add_error TIMEOUT 10)
  if(NOT add_result STREQUAL "0")
    message(FATAL_ERROR "cannot stage isolated source cleanliness fixture: ${add_output}${add_error}")
  endif()
  execute_process(COMMAND git -C "${repo}" -c "user.name=Nesturbator Tests"
      -c "user.email=0+nesturbator-tests@users.noreply.github.com" commit --quiet -m "control fixture"
    RESULT_VARIABLE commit_result OUTPUT_VARIABLE commit_output ERROR_VARIABLE commit_error TIMEOUT 10)
  if(NOT commit_result STREQUAL "0")
    message(FATAL_ERROR "cannot commit isolated source cleanliness fixture: ${commit_output}${commit_error}")
  endif()
  file(WRITE "${repo}/untracked-source-control.txt" "must be rejected\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE_DIR=${repo}" -DMODE=published
      "-DACCEPTANCE=${repo}/acceptance.json" -DTAG=v0.0.0
      "-DWORK=${control}/evidence" -P "${CMAKE_CURRENT_FUNCTION_LIST_FILE}"
    RESULT_VARIABLE check_result OUTPUT_VARIABLE check_output ERROR_VARIABLE check_error TIMEOUT 15)
  set(check_text "${check_output}${check_error}")
  string(REGEX REPLACE "[ \t\r\n]+" " " check_text_flat "${check_text}")
  if(check_result STREQUAL "0" OR
     NOT check_text_flat MATCHES "published receipt requires a clean exact source checkout" OR
     NOT check_text_flat MATCHES "untracked-source-control.txt")
    message(FATAL_ERROR "untracked source cleanliness control failed for the wrong reason: ${check_text}")
  endif()
  if(IS_SYMLINK "${control}")
    message(FATAL_ERROR "untracked source control scratch became a symlink: ${control}")
  endif()
  file(REAL_PATH "${work}" work_real)
  file(REAL_PATH "${control}" control_real)
  cmake_path(IS_PREFIX work_real "${control_real}" NORMALIZE control_inside_work)
  if(NOT control_inside_work OR NOT EXISTS "${marker}")
    message(FATAL_ERROR "untracked source control scratch lost its ownership marker or escaped WORK")
  endif()
  file(READ "${marker}" marker_text)
  if(NOT marker_text STREQUAL "Nesturbator provider untracked source control v1\n")
    message(FATAL_ERROR "untracked source control ownership marker changed")
  endif()
  file(REMOVE_RECURSE "${control_real}")
endfunction()

function(pr_commit_valid commit out_valid)
  string(LENGTH "${commit}" length)
  if(length EQUAL 40 AND commit MATCHES "^[0-9a-f]+$")
    set(${out_valid} TRUE PARENT_SCOPE)
  else()
    set(${out_valid} FALSE PARENT_SCOPE)
  endif()
endfunction()

function(pr_candidate_source_ancestry repo candidate_sha source_sha out_error)
  pr_commit_valid("${candidate_sha}" candidate_valid)
  pr_commit_valid("${source_sha}" source_valid)
  if(NOT candidate_valid OR NOT source_valid)
    set(${out_error}
      "candidate-source-mismatch: candidate or tagged source is not a full Git commit ID" PARENT_SCOPE)
    return()
  endif()
  execute_process(COMMAND git -C "${repo}" merge-base --is-ancestor
      "${candidate_sha}" "${source_sha}"
    RESULT_VARIABLE ancestry_result OUTPUT_VARIABLE ancestry_output
    ERROR_VARIABLE ancestry_error TIMEOUT 10)
  if(NOT ancestry_result STREQUAL "0")
    set(${out_error}
      "candidate-source-mismatch: accepted candidate ${candidate_sha} is not a proven ancestor of exact tagged source ${source_sha}: ${ancestry_error}${ancestry_output}"
      PARENT_SCOPE)
    return()
  endif()
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(pr_control_git repo out_result out_output out_error)
  execute_process(COMMAND git -C "${repo}" ${ARGN}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
  set(${out_result} "${result}" PARENT_SCOPE)
  set(${out_output} "${output}" PARENT_SCOPE)
  set(${out_error} "${error}" PARENT_SCOPE)
endfunction()

function(pr_find_successful_run runs expected_sha workflow expected_event out_json out_error)
  set(${out_json} "" PARENT_SCOPE)
  string(JSON runs_type ERROR_VARIABLE json_error TYPE "${runs}")
  if(json_error OR NOT runs_type STREQUAL "ARRAY")
    set(${out_error} "invalid workflow-run response: expected JSON ARRAY, found ${runs_type}${json_error}" PARENT_SCOPE)
    return()
  endif()
  string(JSON run_count ERROR_VARIABLE json_error LENGTH "${runs}")
  if(json_error)
    set(${out_error} "invalid workflow-run response: ${json_error}" PARENT_SCOPE)
    return()
  endif()
  if(run_count LESS 1)
    set(${out_error} "no ${workflow} workflow runs were returned for ${expected_sha}" PARENT_SCOPE)
    return()
  endif()
  math(EXPR last_run "${run_count} - 1")
  foreach(index RANGE 0 ${last_run})
    string(JSON run_type ERROR_VARIABLE element_error TYPE "${runs}" ${index})
    if(element_error OR NOT run_type STREQUAL "OBJECT")
      set(${out_error} "invalid workflow-run response: entry ${index} must be JSON OBJECT, found ${run_type}${element_error}" PARENT_SCOPE)
      return()
    endif()
    string(JSON head_sha ERROR_VARIABLE field_error GET "${runs}" ${index} headSha)
    string(JSON name GET "${runs}" ${index} workflowName)
    string(JSON event GET "${runs}" ${index} event)
    string(JSON conclusion GET "${runs}" ${index} conclusion)
    string(JSON url GET "${runs}" ${index} url)
    string(JSON run_id GET "${runs}" ${index} databaseId)
    if(NOT field_error AND head_sha STREQUAL expected_sha AND name STREQUAL workflow AND
       event STREQUAL expected_event AND conclusion STREQUAL "success" AND
       url MATCHES "^https://github\\.com/" AND run_id MATCHES "^[0-9]+$")
      set(record "{\"run_id\":${run_id},\"url\":\"${url}\",\"head_sha\":\"${head_sha}\",\"workflow\":\"${name}\",\"event\":\"${event}\",\"conclusion\":\"${conclusion}\"}")
      set(${out_json} "${record}" PARENT_SCOPE)
      set(${out_error} "" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out_error} "no successful ${workflow} ${expected_event} run is bound to head ${expected_sha}" PARENT_SCOPE)
endfunction()

function(pr_validate_run_evidence json role expected_head expected_workflow expected_path
    expected_event expected_pr out_error)
  set(${out_error} "" PARENT_SCOPE)
  foreach(pair IN ITEMS
      "run_id;NUMBER" "run_attempt;NUMBER" "url;STRING" "head_sha;STRING"
      "tested_checkout_sha;STRING" "workflow_name;STRING" "workflow_path;STRING"
      "event;STRING" "status;STRING" "conclusion;STRING"
      "required_check_names;ARRAY" "jobs;ARRAY")
    string(REPLACE ";" ";" parts "${pair}")
    list(GET parts 0 field)
    list(GET parts 1 expected_type)
    string(JSON actual_type ERROR_VARIABLE type_error TYPE "${json}" "${field}")
    if(type_error OR NOT actual_type STREQUAL expected_type)
      set(${out_error} "ci-evidence-missing: ${role} run requires ${field} as JSON ${expected_type}" PARENT_SCOPE)
      return()
    endif()
  endforeach()

  foreach(field IN ITEMS run_id run_attempt url head_sha tested_checkout_sha
      workflow_name workflow_path event status conclusion)
    string(JSON ${field} ERROR_VARIABLE field_error GET "${json}" "${field}")
    if(field_error)
      set(${out_error} "ci-evidence-missing: ${role} run lacks ${field}: ${field_error}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  pr_commit_valid("${head_sha}" head_valid)
  pr_commit_valid("${tested_checkout_sha}" checkout_valid)
  if(NOT head_valid OR NOT checkout_valid OR NOT run_id MATCHES "^[0-9]+$" OR
     NOT run_attempt MATCHES "^[0-9]+$" OR NOT url MATCHES "^https://github\\.com/")
    set(${out_error} "ci-evidence-missing: ${role} run has malformed commit, run, attempt or URL identity" PARENT_SCOPE)
    return()
  endif()
  if(NOT head_sha STREQUAL expected_head OR NOT workflow_name STREQUAL expected_workflow OR
     NOT workflow_path STREQUAL expected_path OR NOT event STREQUAL expected_event)
    set(${out_error} "run-identity-mismatch: ${role} run differs from the expected head/workflow/path/event" PARENT_SCOPE)
    return()
  endif()
  if(NOT status STREQUAL "completed" OR NOT conclusion STREQUAL "success")
    set(${out_error} "ci-evidence-incomplete: ${role} workflow run is ${status}/${conclusion}" PARENT_SCOPE)
    return()
  endif()
  if(role STREQUAL "candidate" OR role STREQUAL "release_pr")
    string(JSON pr_type ERROR_VARIABLE pr_error TYPE "${json}" pr_number)
    if(pr_error OR NOT pr_type STREQUAL "NUMBER")
      set(${out_error} "ci-evidence-missing: ${role} run lacks numeric pull-request identity" PARENT_SCOPE)
      return()
    endif()
    string(JSON pr_number GET "${json}" pr_number)
    if(NOT pr_number STREQUAL expected_pr)
      set(${out_error} "run-identity-mismatch: ${role} run belongs to PR ${pr_number}, expected ${expected_pr}" PARENT_SCOPE)
      return()
    endif()
  endif()

  if(event STREQUAL "pull_request")
    string(JSON checkout_evidence ERROR_VARIABLE checkout_error GET "${json}" checkout_evidence)
    string(JSON log_digest ERROR_VARIABLE log_error GET "${checkout_evidence}" log_sha256)
    string(JSON source ERROR_VARIABLE source_error GET "${checkout_evidence}" checkout_sha)
    string(JSON job_type ERROR_VARIABLE job_error TYPE "${checkout_evidence}" job_id)
    pr_digest_valid("${log_digest}" digest_valid)
    if(checkout_error OR log_error OR source_error OR job_error OR NOT digest_valid OR
       NOT job_type STREQUAL "NUMBER")
      set(${out_error} "ci-evidence-missing: ${role} lacks run-bound checkout log identity" PARENT_SCOPE)
      return()
    elseif(NOT source STREQUAL tested_checkout_sha)
      set(${out_error} "run-identity-mismatch: ${role} checkout log differs from tested merge" PARENT_SCOPE)
      return()
    endif()
  endif()

  string(JSON required_check_count LENGTH "${json}" required_check_names)
  if(required_check_count LESS 1)
    set(${out_error} "required-check-missing: ${role} run records no live required check names" PARENT_SCOPE)
    return()
  endif()
  set(has_required_rollup FALSE)
  math(EXPR last_required_check "${required_check_count} - 1")
  foreach(index RANGE 0 ${last_required_check})
    string(JSON check_name GET "${json}" required_check_names ${index})
    if(check_name STREQUAL "CI required")
      set(has_required_rollup TRUE)
    endif()
  endforeach()
  if(NOT has_required_rollup)
    set(${out_error} "required-check-missing: ${role} run omits CI required" PARENT_SCOPE)
    return()
  endif()
  if(role STREQUAL "release_source")
    set(expected_rollup "ci / CI required")
  else()
    set(expected_rollup "CI required")
  endif()

  set(ci_jobs
    hygiene vector-inventory
    "session-controls (ubuntu-24.04)" "session-controls (macos-15)"
    "build (ubuntu-24.04, ci, ci-build, linux, x64)"
    "build (ubuntu-24.04-arm, ci, ci-build, linux, arm64)"
    "build (macos-15, ci, ci-build, macos, arm64)"
    "build (macos-15-intel, ci, ci-build, macos, x64)"
    "build (windows-2025, ci-msvc, windows, x64)"
    "build (windows-11-arm, ci-msvc, windows, arm64)"
    asan "nofp (ubuntu-24.04)" "nofp (ubuntu-24.04-arm)"
    hash-equality retroarch-e2e perf "CI required")
  if(role STREQUAL "release_source")
    set(prefixed_jobs)
    foreach(job IN LISTS ci_jobs)
      list(APPEND prefixed_jobs "ci / ${job}")
    endforeach()
    set(ci_jobs release-please ${prefixed_jobs} publish)
  endif()
  string(JSON job_count LENGTH "${json}" jobs)
  if(job_count LESS 1)
    set(${out_error} "required-job-missing: ${role} run contains no job evidence" PARENT_SCOPE)
    return()
  endif()
  set(found_jobs)
  math(EXPR last_job "${job_count} - 1")
  foreach(index RANGE 0 ${last_job})
    string(JSON job_type ERROR_VARIABLE job_error TYPE "${json}" jobs ${index})
    if(job_error OR NOT job_type STREQUAL "OBJECT")
      set(${out_error} "ci-evidence-missing: ${role} job ${index} is not a JSON object" PARENT_SCOPE)
      return()
    endif()
    foreach(field IN ITEMS id name status conclusion)
      string(JSON job_${field} ERROR_VARIABLE job_field_error GET "${json}" jobs ${index} "${field}")
      if(job_field_error)
        set(${out_error} "ci-evidence-missing: ${role} job ${index} lacks ${field}" PARENT_SCOPE)
        return()
      endif()
    endforeach()
    list(APPEND found_jobs "${job_name}")
    set(allowed_skip FALSE)
    if(job_name STREQUAL "perf" OR job_name STREQUAL "ci / perf")
      if(expected_event STREQUAL "push" AND job_status STREQUAL "completed" AND
         job_conclusion STREQUAL "skipped")
        set(allowed_skip TRUE)
      endif()
    endif()
    if(NOT allowed_skip AND (NOT job_status STREQUAL "completed" OR NOT job_conclusion STREQUAL "success"))
      set(${out_error} "required-job-incomplete: ${role} job ${job_name} is ${job_status}/${job_conclusion}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  foreach(expected_job IN LISTS ci_jobs)
    list(FIND found_jobs "${expected_job}" job_index)
    if(job_index LESS 0)
      set(${out_error} "required-job-missing: ${role} run lacks ${expected_job}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  list(FIND found_jobs "${expected_rollup}" rollup_index)
  if(rollup_index LESS 0)
    set(${out_error} "required-job-missing: ${role} run lacks ${expected_rollup}" PARENT_SCOPE)
    return()
  endif()
endfunction()

function(pr_validate_publication_metadata json expected_tag expected_source expected_version
    resolved_source source_version out_error)
  set(${out_error} "" PARENT_SCOPE)
  string(JSON object_type ERROR_VARIABLE object_error TYPE "${json}")
  if(object_error OR NOT object_type STREQUAL "OBJECT")
    set(${out_error} "release-publication-missing: release metadata is absent or malformed" PARENT_SCOPE)
    return()
  endif()
  foreach(field IN ITEMS tagName isDraft publishedAt url)
    string(JSON field_type ERROR_VARIABLE field_error TYPE "${json}" "${field}")
    if(field_error)
      set(${out_error} "release-publication-missing: release metadata lacks ${field}" PARENT_SCOPE)
      return()
    endif()
    if(field STREQUAL "isDraft")
      set(expected_type "BOOLEAN")
    else()
      set(expected_type "STRING")
    endif()
    if(NOT field_type STREQUAL expected_type)
      set(${out_error} "release-publication-metadata: ${field} must be JSON ${expected_type}" PARENT_SCOPE)
      return()
    endif()
    string(JSON ${field} GET "${json}" "${field}")
  endforeach()
  if(isDraft)
    set(${out_error} "draft-release: ${tagName} is still a draft" PARENT_SCOPE)
    return()
  endif()
  if(NOT url MATCHES "^https://github\\.com/[^/]+/[^/]+/releases/tag/")
    set(${out_error} "release-publication-metadata: release URL is malformed" PARENT_SCOPE)
    return()
  endif()
  if(NOT publishedAt MATCHES "^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]([.][0-9]+)?(Z|[+-][0-9][0-9]:[0-9][0-9])$")
    set(${out_error} "release-publication-metadata: publishedAt is not a timestamp" PARENT_SCOPE)
    return()
  endif()
  if(NOT tagName STREQUAL expected_tag)
    set(${out_error} "release-tag-mismatch: live tag ${tagName} differs from ${expected_tag}" PARENT_SCOPE)
    return()
  endif()
  pr_commit_valid("${expected_source}" expected_source_valid)
  pr_commit_valid("${resolved_source}" resolved_source_valid)
  if(NOT expected_source_valid OR NOT resolved_source_valid OR NOT resolved_source STREQUAL expected_source)
    set(${out_error} "release-source-mismatch: tag resolves to ${resolved_source}, expected ${expected_source}" PARENT_SCOPE)
    return()
  endif()
  string(REGEX REPLACE "^v" "" tag_version "${tagName}")
  if(NOT tag_version STREQUAL expected_version OR NOT source_version STREQUAL expected_version)
    set(${out_error} "metadata-mismatch: tag/source version ${tag_version}/${source_version} differs from ${expected_version}" PARENT_SCOPE)
    return()
  endif()
endfunction()

function(pr_gh_api endpoint out_json out_error)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env GH_PROMPT_DISABLED=1
      GH_NO_UPDATE_NOTIFIER=1 gh api "${endpoint}"
    RESULT_VARIABLE api_result OUTPUT_VARIABLE api_json ERROR_VARIABLE api_stderr
    TIMEOUT 60)
  string(STRIP "${api_json}" api_json)
  if(NOT api_result STREQUAL "0")
    set(${out_json} "" PARENT_SCOPE)
    set(${out_error} "GitHub API ${endpoint} failed (${api_result}): ${api_stderr}${api_json}" PARENT_SCOPE)
  else()
    set(${out_json} "${api_json}" PARENT_SCOPE)
    set(${out_error} "" PARENT_SCOPE)
  endif()
endfunction()

function(pr_gh_api_raw endpoint out_content out_error)
  set(raw_options)
  if(endpoint MATCHES "/actions/jobs/[0-9]+/logs$")
    # Current gh protects terminals from log escape bytes. Capture them only
    # as immutable file data for hashing/parsing; never render the raw log.
    list(APPEND raw_options --allow-escape-sequences)
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env GH_PROMPT_DISABLED=1
      GH_NO_UPDATE_NOTIFIER=1 gh api "${endpoint}" --header "Accept: application/vnd.github.raw" ${raw_options}
    RESULT_VARIABLE api_result OUTPUT_VARIABLE api_content ERROR_VARIABLE api_stderr
    TIMEOUT 60)
  if(NOT api_result STREQUAL "0")
    set(${out_content} "" PARENT_SCOPE)
    set(${out_error} "GitHub raw API ${endpoint} failed (${api_result}): ${api_stderr}${api_content}" PARENT_SCOPE)
  else()
    string(STRIP "${api_content}" api_content)
    set(${out_content} "${api_content}" PARENT_SCOPE)
    set(${out_error} "" PARENT_SCOPE)
  endif()
endfunction()

function(pr_live_required_contexts out_json out_error)
  pr_gh_api("repos/${REPOSITORY}/rulesets?includes_parents=true" rulesets api_error)
  if(api_error)
    set(${out_error} "required-check-missing: cannot read the live main ruleset: ${api_error}" PARENT_SCOPE)
    return()
  endif()
  string(JSON ruleset_count ERROR_VARIABLE json_error LENGTH "${rulesets}")
  if(json_error)
    set(${out_error} "required-check-missing: live rulesets response is malformed: ${json_error}" PARENT_SCOPE)
    return()
  endif()
  set(contexts "[]")
  set(main_rule_found FALSE)
  if(ruleset_count GREATER 0)
    math(EXPR last_ruleset "${ruleset_count} - 1")
    foreach(index RANGE 0 ${last_ruleset})
      string(JSON rule_id ERROR_VARIABLE id_error GET "${rulesets}" ${index} id)
      string(JSON rule_name ERROR_VARIABLE name_error GET "${rulesets}" ${index} name)
      string(JSON rule_state ERROR_VARIABLE state_error GET "${rulesets}" ${index} enforcement)
      if(name_error OR state_error OR NOT rule_name STREQUAL "main" OR NOT rule_state STREQUAL "active")
        continue()
      endif()
      if(id_error)
        continue()
      endif()
      pr_gh_api("repos/${REPOSITORY}/rulesets/${rule_id}" rule_detail detail_error)
      if(detail_error)
        continue()
      endif()
      string(JSON include_count ERROR_VARIABLE include_error LENGTH "${rule_detail}" conditions ref_name include)
      if(include_error OR include_count LESS 1)
        continue()
      endif()
      set(main_rule_applies FALSE)
      math(EXPR last_include "${include_count} - 1")
      foreach(include_index RANGE 0 ${last_include})
        string(JSON include_pattern GET "${rule_detail}" conditions ref_name include ${include_index})
        if(include_pattern STREQUAL "refs/heads/main" OR include_pattern STREQUAL "~ALL" OR include_pattern STREQUAL "~DEFAULT_BRANCH")
          set(main_rule_applies TRUE)
        endif()
      endforeach()
      if(NOT main_rule_applies)
        continue()
      endif()
      string(JSON required_count ERROR_VARIABLE required_error LENGTH "${rule_detail}" rules)
      if(required_error)
        continue()
      endif()
      math(EXPR last_required "${required_count} - 1")
      foreach(required_index RANGE 0 ${last_required})
        string(JSON rule_type ERROR_VARIABLE type_error GET "${rule_detail}" rules ${required_index} type)
        if(type_error OR NOT rule_type STREQUAL "required_status_checks")
          continue()
        endif()
        string(JSON check_count ERROR_VARIABLE check_error LENGTH "${rule_detail}" rules ${required_index} parameters required_status_checks)
        if(check_error OR check_count LESS 1)
          continue()
        endif()
        set(main_rule_found TRUE)
        math(EXPR last_check "${check_count} - 1")
        foreach(check_index RANGE 0 ${last_check})
          string(JSON check_name ERROR_VARIABLE check_name_error GET "${rule_detail}" rules ${required_index} parameters required_status_checks ${check_index} context)
          if(NOT check_name_error)
            string(JSON count LENGTH "${contexts}")
            string(JSON contexts SET "${contexts}" ${count} "\"${check_name}\"")
          endif()
        endforeach()
      endforeach()
    endforeach()
  endif()
  if(NOT main_rule_found)
    set(${out_error} "required-check-missing: no active main ruleset with required status checks applies to refs/heads/main" PARENT_SCOPE)
    return()
  endif()
  string(JSON context_count LENGTH "${contexts}")
  set(has_ci_required FALSE)
  if(context_count GREATER 0)
    math(EXPR last_context "${context_count} - 1")
    foreach(index RANGE 0 ${last_context})
      string(JSON context_name GET "${contexts}" ${index})
      if(context_name STREQUAL "CI required")
        set(has_ci_required TRUE)
      endif()
    endforeach()
  endif()
  if(NOT has_ci_required)
    set(${out_error} "required-check-missing: active main ruleset does not require CI required" PARENT_SCOPE)
    return()
  endif()
  set(${out_json} "${contexts}" PARENT_SCOPE)
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(pr_live_check_context sha context out_error)
  pr_gh_api("repos/${REPOSITORY}/commits/${sha}/check-runs?per_page=100" checks api_error)
  if(api_error)
    set(${out_error} "required-check-missing: cannot read checks for ${sha}: ${api_error}" PARENT_SCOPE)
    return()
  endif()
  string(JSON check_count ERROR_VARIABLE json_error LENGTH "${checks}" check_runs)
  if(json_error)
    set(${out_error} "required-check-missing: check-runs response is malformed: ${json_error}" PARENT_SCOPE)
    return()
  endif()
  set(found FALSE)
  if(check_count GREATER 0)
    math(EXPR last_check "${check_count} - 1")
    foreach(index RANGE 0 ${last_check})
      string(JSON name ERROR_VARIABLE name_error GET "${checks}" check_runs ${index} name)
      string(JSON head_sha ERROR_VARIABLE head_error GET "${checks}" check_runs ${index} head_sha)
      string(JSON status ERROR_VARIABLE status_error GET "${checks}" check_runs ${index} status)
      string(JSON conclusion ERROR_VARIABLE conclusion_error GET "${checks}" check_runs ${index} conclusion)
      if(NOT name_error AND NOT head_error AND name STREQUAL context AND head_sha STREQUAL sha)
        set(found TRUE)
        if(status_error OR conclusion_error OR NOT status STREQUAL "completed" OR NOT conclusion STREQUAL "success")
          set(${out_error} "required-check-incomplete: ${context} on ${sha} is ${status}/${conclusion}" PARENT_SCOPE)
          return()
        endif()
      endif()
    endforeach()
  endif()
  if(NOT found)
    set(${out_error} "required-check-missing: ${context} has no check run on exact head ${sha}" PARENT_SCOPE)
  else()
    set(${out_error} "" PARENT_SCOPE)
  endif()
endfunction()

function(pr_checkout_from_log log expected out_sha out_error)
  # actions/checkout's own final command precedes user build/test output.
  string(REGEX MATCH "git log -1 --format=%H[^\n]*\n[^\n]* ([0-9a-f]+)(\r?\n|$)" checkout "${log}")
  set(actual "${CMAKE_MATCH_1}")
  pr_commit_valid("${actual}" valid)
  if(checkout STREQUAL "" OR NOT valid)
    set(${out_error} "checkout-source-missing: checkout log has no complete source SHA" PARENT_SCOPE)
  elseif(NOT actual STREQUAL expected)
    set(${out_error} "checkout-source-mismatch: actual CI checkout ${actual} differs from ${expected}" PARENT_SCOPE)
  else()
    set(${out_error} "" PARENT_SCOPE)
    set(${out_sha} "${actual}" PARENT_SCOPE)
  endif()
endfunction()

function(pr_live_checkout_evidence jobs expected out_record out_error)
  string(JSON count ERROR_VARIABLE error LENGTH "${jobs}" jobs)
  if(error OR count LESS 1)
    set(${out_error} "checkout-source-missing: workflow has no job evidence" PARENT_SCOPE)
    return()
  endif()
  set(job_id "")
  math(EXPR last "${count} - 1")
  foreach(index RANGE 0 ${last})
    string(JSON name GET "${jobs}" jobs ${index} name)
    if(name STREQUAL "build (ubuntu-24.04, ci, ci-build, linux, x64)")
      string(JSON job_id GET "${jobs}" jobs ${index} id)
      break()
    endif()
  endforeach()
  if(job_id STREQUAL "")
    set(${out_error} "checkout-source-missing: required Linux-x64 source job absent" PARENT_SCOPE)
    return()
  endif()
  pr_gh_api_raw("repos/${REPOSITORY}/actions/jobs/${job_id}/logs" log log_error)
  if(log_error)
    set(${out_error} "checkout-source-missing: ${log_error}" PARENT_SCOPE)
    return()
  endif()
  pr_checkout_from_log("${log}" "${expected}" actual checkout_error)
  if(checkout_error)
    set(${out_error} "${checkout_error}" PARENT_SCOPE)
    return()
  endif()
  string(SHA256 digest "${log}")
  set(relative_log "build/provider-ci-checkouts/job-${job_id}.log")
  file(MAKE_DIRECTORY "${SOURCE_DIR}/build/provider-ci-checkouts")
  if(EXISTS "${SOURCE_DIR}/${relative_log}")
    file(SHA256 "${SOURCE_DIR}/${relative_log}" prior_digest)
    if(NOT prior_digest STREQUAL digest)
      set(${out_error} "checkout-source-mismatch: stored immutable job log changed" PARENT_SCOPE)
      return()
    endif()
  else()
    file(WRITE "${SOURCE_DIR}/${relative_log}" "${log}")
  endif()
  set(record "{}")
  pr_json_set("${record}" job_id "${job_id}" record)
  pr_json_set("${record}" checkout_sha "\"${actual}\"" record)
  pr_json_set("${record}" log_sha256 "\"${digest}\"" record)
  pr_json_set("${record}" evidence_log "\"${relative_log}\"" record)
  set(${out_record} "${record}" PARENT_SCOPE)
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(pr_live_unique_run_index response workflow_file workflow_name event head_sha pr_number out_index out_error)
  set(${out_index} "-1" PARENT_SCOPE)
  string(JSON run_count ERROR_VARIABLE json_error LENGTH "${response}" workflow_runs)
  if(json_error)
    set(${out_error} "ci-evidence-missing: ${workflow_name} run list is malformed: ${json_error}" PARENT_SCOPE)
    return()
  endif()
  string(JSON total_type ERROR_VARIABLE total_type_error TYPE "${response}" total_count)
  string(JSON total_count ERROR_VARIABLE total_count_error GET "${response}" total_count)
  if(total_type_error OR total_count_error OR NOT total_type STREQUAL "NUMBER" OR
     NOT total_count EQUAL run_count)
    set(${out_error} "ci-evidence-missing: ${workflow_name} run list count is malformed or incomplete" PARENT_SCOPE)
    return()
  endif()
  if(run_count LESS 1)
    set(${out_error} "ci-evidence-missing: no ${workflow_name}/${event} workflow run exists on ${head_sha}" PARENT_SCOPE)
    return()
  endif()
  set(matches "")
  set(association_malformed FALSE)
  math(EXPR last_run "${run_count} - 1")
  foreach(index RANGE 0 ${last_run})
    string(JSON run_head ERROR_VARIABLE head_error GET "${response}" workflow_runs ${index} head_sha)
    string(JSON run_path ERROR_VARIABLE path_error GET "${response}" workflow_runs ${index} path)
    string(JSON run_name ERROR_VARIABLE name_error GET "${response}" workflow_runs ${index} name)
    string(JSON run_event ERROR_VARIABLE event_error GET "${response}" workflow_runs ${index} event)
    if(NOT head_error AND NOT path_error AND NOT name_error AND NOT event_error AND
       run_head STREQUAL head_sha AND run_name STREQUAL workflow_name AND run_event STREQUAL event AND
       run_path STREQUAL workflow_file)
      if(pr_number STREQUAL "")
        list(APPEND matches "${index}")
      else()
        string(JSON associations_type ERROR_VARIABLE associations_type_error TYPE "${response}" workflow_runs ${index} pull_requests)
        string(JSON associated_count ERROR_VARIABLE association_error LENGTH "${response}" workflow_runs ${index} pull_requests)
        if(associations_type_error OR association_error OR NOT associations_type STREQUAL "ARRAY")
          set(association_malformed TRUE)
        elseif(associated_count GREATER 0)
          set(pr_association FALSE)
          math(EXPR last_associated "${associated_count} - 1")
          foreach(pr_index RANGE 0 ${last_associated})
            string(JSON associated_number ERROR_VARIABLE number_error GET "${response}" workflow_runs ${index} pull_requests ${pr_index} number)
            if(number_error)
              set(association_malformed TRUE)
            elseif(associated_number STREQUAL pr_number)
              set(pr_association TRUE)
            endif()
          endforeach()
          if(pr_association)
            list(APPEND matches "${index}")
          endif()
        endif()
      endif()
    endif()
  endforeach()
  if(association_malformed)
    set(${out_error} "run-identity-mismatch: exact ${workflow_name} run has a malformed pull-request association" PARENT_SCOPE)
    return()
  endif()
  list(LENGTH matches match_count)
  if(match_count LESS 1)
    if(pr_number STREQUAL "")
      set(${out_error} "run-identity-mismatch: no ${workflow_name} run has the exact workflow path, event and head ${head_sha}" PARENT_SCOPE)
    else()
      set(${out_error} "run-identity-mismatch: no ${workflow_name} run has the exact workflow path, event, head ${head_sha} and PR ${pr_number}" PARENT_SCOPE)
    endif()
    return()
  endif()
  if(match_count GREATER 1)
    set(${out_error} "ci-evidence-duplicate: expected exactly one ${workflow_name}/${event} run with path ${workflow_file}, head ${head_sha} and PR ${pr_number}; found ${match_count}" PARENT_SCOPE)
    return()
  endif()
  list(GET matches 0 selected)
  set(${out_index} "${selected}" PARENT_SCOPE)
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(pr_live_run_record workflow_file workflow_name event head_sha tested_checkout pr_number
    required_contexts out_record out_error)
  get_filename_component(workflow_id "${workflow_file}" NAME)
  pr_gh_api("repos/${REPOSITORY}/actions/workflows/${workflow_id}/runs?head_sha=${head_sha}&event=${event}&per_page=100" response api_error)
  if(api_error)
    set(${out_error} "ci-evidence-missing: cannot query ${workflow_name}/${event} on ${head_sha}: ${api_error}" PARENT_SCOPE)
    return()
  endif()
  pr_live_unique_run_index("${response}" "${workflow_file}" "${workflow_name}"
    "${event}" "${head_sha}" "${pr_number}" selected selection_error)
  if(selection_error)
    set(${out_error} "${selection_error}" PARENT_SCOPE)
    return()
  endif()
  string(JSON run_id GET "${response}" workflow_runs ${selected} id)
  string(JSON attempt GET "${response}" workflow_runs ${selected} run_attempt)
  string(JSON run_url GET "${response}" workflow_runs ${selected} html_url)
  string(JSON run_status GET "${response}" workflow_runs ${selected} status)
  string(JSON run_conclusion ERROR_VARIABLE conclusion_error GET "${response}" workflow_runs ${selected} conclusion)
  if(conclusion_error)
    set(run_conclusion "null")
  endif()
  if(NOT run_status STREQUAL "completed" OR NOT run_conclusion STREQUAL "success")
    set(${out_error} "ci-evidence-incomplete: latest ${workflow_name} run ${run_id} on ${head_sha} is ${run_status}/${run_conclusion}" PARENT_SCOPE)
    return()
  endif()
  set(pr_association "")
  string(JSON associated_count ERROR_VARIABLE association_error LENGTH "${response}" workflow_runs ${selected} pull_requests)
  if(NOT association_error AND associated_count GREATER 0)
    math(EXPR last_associated "${associated_count} - 1")
    foreach(index RANGE 0 ${last_associated})
      string(JSON associated_number ERROR_VARIABLE number_error GET "${response}" workflow_runs ${selected} pull_requests ${index} number)
      if(NOT number_error AND NOT pr_number STREQUAL "" AND associated_number STREQUAL pr_number)
        set(pr_association "${associated_number}")
      endif()
    endforeach()
  endif()
  if(NOT pr_number STREQUAL "" AND NOT pr_association STREQUAL pr_number)
    set(${out_error} "run-identity-mismatch: ${workflow_name} run ${run_id} is not associated with PR ${pr_number}" PARENT_SCOPE)
    return()
  endif()

  pr_gh_api("repos/${REPOSITORY}/actions/runs/${run_id}/jobs?per_page=100" job_response jobs_error)
  if(jobs_error)
    set(${out_error} "required-job-missing: cannot read jobs for run ${run_id}: ${jobs_error}" PARENT_SCOPE)
    return()
  endif()
  string(JSON job_count ERROR_VARIABLE jobs_json_error LENGTH "${job_response}" jobs)
  if(jobs_json_error OR job_count LESS 1)
    set(${out_error} "required-job-missing: run ${run_id} contains no live job evidence" PARENT_SCOPE)
    return()
  endif()
  if(event STREQUAL "pull_request")
    pr_live_checkout_evidence("${job_response}" "${tested_checkout}" checkout_evidence checkout_error)
    if(checkout_error)
      set(${out_error} "${checkout_error}" PARENT_SCOPE)
      return()
    endif()
  endif()
  set(jobs "[]")
  math(EXPR last_job "${job_count} - 1")
  foreach(index RANGE 0 ${last_job})
    set(job "{}")
    foreach(field IN ITEMS id name status conclusion)
      string(JSON value ERROR_VARIABLE value_error GET "${job_response}" jobs ${index} "${field}")
      if(value_error)
        set(${out_error} "ci-evidence-missing: run ${run_id} job ${index} lacks ${field}" PARENT_SCOPE)
        return()
      endif()
      if(field STREQUAL "id")
        string(JSON job SET "${job}" id "${value}")
      else()
        string(JSON job SET "${job}" "${field}" "\"${value}\"")
      endif()
    endforeach()
    string(JSON job_array_count LENGTH "${jobs}")
    string(JSON jobs SET "${jobs}" ${job_array_count} "${job}")
  endforeach()
  set(record "{}")
  string(JSON record SET "${record}" run_id "${run_id}")
  string(JSON record SET "${record}" run_attempt "${attempt}")
  if(event STREQUAL "pull_request")
    string(JSON record SET "${record}" checkout_evidence "${checkout_evidence}")
  endif()
  foreach(pair IN ITEMS "url;${run_url}" "head_sha;${head_sha}"
      "tested_checkout_sha;${tested_checkout}" "workflow_name;${workflow_name}"
      "workflow_path;${workflow_file}" "event;${event}" "status;${run_status}"
      "conclusion;${run_conclusion}")
    list(GET pair 0 key)
    list(GET pair 1 value)
    string(JSON record SET "${record}" "${key}" "\"${value}\"")
  endforeach()
  if(NOT pr_number STREQUAL "")
    string(JSON record SET "${record}" pr_number "${pr_number}")
  endif()
  string(JSON record SET "${record}" required_check_names "${required_contexts}")
  string(JSON record SET "${record}" jobs "${jobs}")
  set(${out_record} "${record}" PARENT_SCOPE)
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(pr_live_pull_request number out_json out_error)
  pr_gh_api("repos/${REPOSITORY}/pulls/${number}" pr_json api_error)
  if(api_error)
    set(${out_error} "pull-request-missing: cannot read PR ${number}: ${api_error}" PARENT_SCOPE)
  else()
    set(${out_json} "${pr_json}" PARENT_SCOPE)
    set(${out_error} "" PARENT_SCOPE)
  endif()
endfunction()

function(pr_title_api_live endpoint out_json out_error)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env GH_PROMPT_DISABLED=1
      GH_NO_UPDATE_NOTIFIER=1 gh api "${endpoint}"
    RESULT_VARIABLE api_result OUTPUT_VARIABLE api_json ERROR_VARIABLE api_stderr
    TIMEOUT 15)
  string(STRIP "${api_json}" api_json)
  if(NOT api_result STREQUAL "0")
    set(${out_json} "" PARENT_SCOPE)
    set(${out_error} "PR title GitHub API ${endpoint} failed (${api_result}): ${api_stderr}${api_json}" PARENT_SCOPE)
  else()
    set(${out_json} "${api_json}" PARENT_SCOPE)
    set(${out_error} "" PARENT_SCOPE)
  endif()
endfunction()

function(pr_title_api_raw_live endpoint out_text out_error)
  set(raw_options)
  if(endpoint MATCHES "/actions/jobs/[0-9]+/logs$")
    list(APPEND raw_options --allow-escape-sequences)
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env GH_PROMPT_DISABLED=1
      GH_NO_UPDATE_NOTIFIER=1 gh api "${endpoint}"
      --header "Accept: application/vnd.github.raw" ${raw_options}
    RESULT_VARIABLE api_result OUTPUT_VARIABLE api_text ERROR_VARIABLE api_stderr
    TIMEOUT 15)
  if(NOT api_result STREQUAL "0")
    set(${out_text} "" PARENT_SCOPE)
    set(${out_error} "PR title raw GitHub API ${endpoint} failed (${api_result}): ${api_stderr}${api_text}" PARENT_SCOPE)
  else()
    set(${out_text} "${api_text}" PARENT_SCOPE)
    set(${out_error} "" PARENT_SCOPE)
  endif()
endfunction()

# Keep the actual network implementation separate from the selftest seam.
# Only pr_title_pipeline_controls replaces these facades, in MODE=selftest;
# it restores them before returning. Ordinary title/hosted modes use live API.
function(pr_title_use_live_transport)
  function(pr_title_api endpoint out_json out_error)
    pr_title_api_live("${endpoint}" response error)
    set(${out_json} "${response}" PARENT_SCOPE)
    set(${out_error} "${error}" PARENT_SCOPE)
  endfunction()
  function(pr_title_api_raw endpoint out_text out_error)
    pr_title_api_raw_live("${endpoint}" response error)
    set(${out_text} "${response}" PARENT_SCOPE)
    set(${out_error} "${error}" PARENT_SCOPE)
  endfunction()
endfunction()
pr_title_use_live_transport()

function(pr_title_is_conventional title out_valid)
  string(REGEX MATCH "^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\\([a-z0-9._-]+\\))?!?: .+"
    matched_title "${title}")
  if(matched_title STREQUAL title)
    set(${out_valid} TRUE PARENT_SCOPE)
  else()
    set(${out_valid} FALSE PARENT_SCOPE)
  endif()
endfunction()

function(pr_parse_title_log log expected_pr expected_head expected_title_sha expected_run expected_attempt
    out_log_record out_error)
  string(REGEX MATCH "(^|\r?\n)([0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]([.][0-9]+)?Z[ \t]+)?PR_TITLE_EVIDENCE=[{][^\r\n]*[}]"
    evidence_line "${log}")
  if(evidence_line STREQUAL "")
    set(${out_error} "pr-title-evidence-missing: job log has no title evidence line" PARENT_SCOPE)
    return()
  endif()
  string(FIND "${log}" "${evidence_line}" evidence_index)
  string(LENGTH "${evidence_line}" evidence_length)
  math(EXPR remaining_index "${evidence_index} + ${evidence_length}")
  string(LENGTH "${log}" log_length)
  math(EXPR remaining_length "${log_length} - ${remaining_index}")
  string(SUBSTRING "${log}" ${remaining_index} ${remaining_length} remaining_log)
  if(remaining_log MATCHES "(^|\r?\n)([0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]([.][0-9]+)?Z[ \t]+)?PR_TITLE_EVIDENCE=[{]")
    set(${out_error} "pr-title-evidence-ambiguous: job log has multiple title evidence lines" PARENT_SCOPE)
    return()
  endif()
  string(REGEX REPLACE "^(\r?\n)?([0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]([.][0-9]+)?Z[ \t]+)?PR_TITLE_EVIDENCE=" ""
    log_record "${evidence_line}")
  string(JSON record_type ERROR_VARIABLE json_error TYPE "${log_record}")
  if(json_error OR NOT record_type STREQUAL "OBJECT")
    set(${out_error} "pr-title-evidence-malformed: evidence line is not a JSON object" PARENT_SCOPE)
    return()
  endif()
  foreach(pair IN ITEMS
      "schema_version;NUMBER" "context;STRING" "workflow_name;STRING"
      "workflow_path;STRING" "check_context;STRING" "job_name;STRING"
      "repository;STRING" "pr_number;NUMBER" "head_sha;STRING"
      "title;STRING" "title_sha256;STRING" "title_valid;BOOLEAN"
      "event;STRING" "event_action;STRING" "event_sha;STRING"
      "run_id;NUMBER" "run_attempt;NUMBER")
    list(GET pair 0 field)
    list(GET pair 1 expected_type)
    string(JSON field_type ERROR_VARIABLE field_error TYPE "${log_record}" "${field}")
    if(field_error OR NOT field_type STREQUAL expected_type)
      set(${out_error} "pr-title-evidence-malformed: ${field} must be JSON ${expected_type}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  foreach(field IN ITEMS schema_version context workflow_name workflow_path check_context job_name repository
      pr_number head_sha title title_sha256 title_valid event event_action event_sha run_id run_attempt)
    string(JSON ${field} ERROR_VARIABLE field_error GET "${log_record}" "${field}")
    if(field_error)
      set(${out_error} "pr-title-evidence-malformed: cannot read ${field}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  string(SHA256 actual_title_sha "${title}")
  pr_title_is_conventional("${title}" title_conventional)
  pr_commit_valid("${head_sha}" title_head_valid)
  pr_commit_valid("${event_sha}" event_sha_valid)
  pr_digest_valid("${title_sha256}" title_digest_valid)
  if(NOT schema_version EQUAL 1 OR NOT context STREQUAL "PR title" OR
     NOT workflow_name STREQUAL "PR title" OR
     NOT workflow_path STREQUAL ".github/workflows/pr-title.yml" OR
     NOT check_context STREQUAL "PR title" OR NOT job_name STREQUAL "PR title" OR
     NOT repository STREQUAL REPOSITORY OR NOT pr_number STREQUAL expected_pr OR
     NOT head_sha STREQUAL expected_head OR
     NOT event STREQUAL "pull_request" OR
     NOT event_action MATCHES "^(opened|synchronize|reopened|edited)$" OR
     NOT event_sha_valid OR NOT title_head_valid OR
     NOT run_id MATCHES "^[1-9][0-9]*$" OR NOT run_id STREQUAL expected_run OR
     NOT run_attempt MATCHES "^[1-9][0-9]*$" OR NOT run_attempt STREQUAL expected_attempt)
    set(${out_error} "pr-title-identity-mismatch: job log does not prove the current valid PR title/head/run" PARENT_SCOPE)
    return()
  endif()
  if(NOT title_digest_valid OR NOT title_sha256 STREQUAL actual_title_sha)
    set(${out_error} "pr-title-stale: job log records a different live title" PARENT_SCOPE)
    return()
  endif()
  if(NOT title_sha256 STREQUAL expected_title_sha)
    set(${out_error} "pr-title-stale: job log records a prior title digest" PARENT_SCOPE)
    return()
  endif()
  if(NOT title_conventional OR NOT title_valid)
    set(${out_error} "pr-title-invalid: job log does not record a valid Conventional Commit title" PARENT_SCOPE)
    return()
  endif()
  set(${out_log_record} "${log_record}" PARENT_SCOPE)
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(pr_title_set_string json field value out_json)
  pr_json_quote("${value}" quoted)
  pr_json_set("${json}" "${field}" "${quoted}" updated)
  set(${out_json} "${updated}" PARENT_SCOPE)
endfunction()

function(pr_title_compact_fixture_json json out_json)
  # CMake serializes string(JSON SET) with physical formatting newlines; the
  # workflow's json.dumps output is one physical log line. Remove only those
  # formatting CR/LF bytes, leaving escaped string content unchanged.
  string(REPLACE "\r" "" compact "${json}")
  string(REPLACE "\n" "" compact "${compact}")
  set(${out_json} "${compact}" PARENT_SCOPE)
endfunction()

function(pr_title_context_required contexts out_error)
  string(JSON context_count ERROR_VARIABLE json_error LENGTH "${contexts}")
  if(json_error OR context_count LESS 1)
    set(${out_error} "required-check-missing: live main ruleset has no required contexts" PARENT_SCOPE)
    return()
  endif()
  set(found_title FALSE)
  math(EXPR last_context "${context_count} - 1")
  foreach(index RANGE 0 ${last_context})
    string(JSON context ERROR_VARIABLE context_error GET "${contexts}" ${index})
    if(NOT context_error AND context STREQUAL "PR title")
      set(found_title TRUE)
    endif()
  endforeach()
  if(NOT found_title)
    set(${out_error} "required-check-missing: live main ruleset does not require PR title" PARENT_SCOPE)
  else()
    set(${out_error} "" PARENT_SCOPE)
  endif()
endfunction()

