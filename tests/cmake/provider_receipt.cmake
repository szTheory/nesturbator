string(JSON release_asset_count ERROR_VARIABLE json_error LENGTH "${release_json}" assets)
if(json_error OR NOT release_asset_count EQUAL 19)
  message(FATAL_ERROR "asset-inventory-mismatch: published release must have exactly 18 archives and SHA256SUMS")
endif()
set(release_asset_names)
math(EXPR last_release_asset "${release_asset_count} - 1")
foreach(index RANGE 0 ${last_release_asset})
  string(JSON release_asset_type ERROR_VARIABLE element_type_error TYPE "${release_json}" assets ${index})
  if(element_type_error OR NOT release_asset_type STREQUAL "OBJECT")
    message(FATAL_ERROR "asset-inventory-mismatch: release asset ${index} must be a JSON OBJECT: ${element_type_error}${release_asset_type}")
  endif()
  string(JSON asset_name_type ERROR_VARIABLE name_type_error TYPE "${release_json}" assets ${index} name)
  string(JSON asset_size_type ERROR_VARIABLE size_type_error TYPE "${release_json}" assets ${index} size)
  if(name_type_error OR size_type_error OR NOT asset_name_type STREQUAL "STRING" OR
     NOT asset_size_type STREQUAL "NUMBER")
    message(FATAL_ERROR "asset-inventory-mismatch: release asset name and size must be JSON STRING and NUMBER")
  endif()
  string(JSON asset_name ERROR_VARIABLE json_error GET "${release_json}" assets ${index} name)
  string(JSON asset_size ERROR_VARIABLE size_error GET "${release_json}" assets ${index} size)
  if(json_error OR size_error OR asset_size LESS 1)
    message(FATAL_ERROR "asset-inventory-mismatch: release has a missing or empty asset")
  endif()
  list(APPEND release_asset_names "${asset_name}")
endforeach()
set(expected_assets ${expected_names} SHA256SUMS)
list(SORT release_asset_names)
list(SORT expected_assets)
if(NOT "${release_asset_names}" STREQUAL "${expected_assets}")
  message(FATAL_ERROR "asset-inventory-mismatch: release names differ from the exact 18-archive set")
endif()

set(download_dir "${WORK}/release-assets")
file(MAKE_DIRECTORY "${download_dir}")
execute_process(COMMAND ${gh_env} gh release download "${TAG}" --repo "${REPOSITORY}" --dir "${download_dir}"
  RESULT_VARIABLE download_result OUTPUT_VARIABLE download_out ERROR_VARIABLE download_error TIMEOUT 180)
file(WRITE "${diag}/release-download.stdout.txt" "${download_out}")
file(WRITE "${diag}/release-download.stderr.txt" "${download_error}")
if(NOT download_result STREQUAL "0")
  message(FATAL_ERROR "release asset download failed: ${download_out}${download_error}")
endif()
file(GLOB downloaded_files LIST_DIRECTORIES false "${download_dir}/*")
set(downloaded_names)
foreach(path IN LISTS downloaded_files)
  get_filename_component(name "${path}" NAME)
  list(APPEND downloaded_names "${name}")
endforeach()
list(SORT downloaded_names)
if(NOT "${downloaded_names}" STREQUAL "${expected_assets}")
  message(FATAL_ERROR "asset-inventory-mismatch: downloaded bytes do not match the release asset names")
endif()

set(sums "${download_dir}/SHA256SUMS")
if(NOT EXISTS "${sums}")
  message(FATAL_ERROR "checksum-missing: release download lacks SHA256SUMS")
endif()
file(SHA256 "${sums}" sums_sha)
file(STRINGS "${sums}" checksum_lines)
list(LENGTH checksum_lines checksum_line_count)
if(NOT checksum_line_count EQUAL 18)
  message(FATAL_ERROR "checksum-inventory-mismatch: SHA256SUMS must have exactly 18 entries")
endif()
set(checksum_names)
set(checksum_digests)
foreach(line IN LISTS checksum_lines)
  if(NOT line MATCHES "^([0-9a-f]+)[ \t][ \t]([^ \t]+)$")
    message(FATAL_ERROR "checksum-format: malformed SHA256SUMS line")
  endif()
  set(digest "${CMAKE_MATCH_1}")
  set(name "${CMAKE_MATCH_2}")
  pr_digest_valid("${digest}" digest_ok)
  if(NOT digest_ok)
    message(FATAL_ERROR "bad-digest: malformed checksum for ${name}")
  endif()
  list(APPEND checksum_names "${name}")
  list(APPEND checksum_digests "${digest}")
endforeach()
set(unique_checksum_names ${checksum_names})
list(REMOVE_DUPLICATES unique_checksum_names)
list(SORT unique_checksum_names)
if(NOT "${unique_checksum_names}" STREQUAL "${expected_names}")
  message(FATAL_ERROR "checksum-inventory-mismatch: SHA256SUMS names do not match the release archives")
endif()

set(archive_records "")
foreach(name IN LISTS expected_names)
  set(zip "${download_dir}/${name}")
  if(NOT EXISTS "${zip}")
    message(FATAL_ERROR "asset-inventory-mismatch: downloaded archive ${name} is missing")
  endif()
  file(SIZE "${zip}" zip_size)
  if(zip_size LESS 1)
    message(FATAL_ERROR "asset-inventory-mismatch: downloaded archive ${name} is empty")
  endif()
  set(release_size "")
  foreach(asset_index RANGE 0 ${last_release_asset})
    string(JSON asset_name GET "${release_json}" assets ${asset_index} name)
    if(asset_name STREQUAL name)
      string(JSON release_size GET "${release_json}" assets ${asset_index} size)
      break()
    endif()
  endforeach()
  if(release_size STREQUAL "" OR NOT release_size EQUAL zip_size)
    message(FATAL_ERROR "asset-size-mismatch: downloaded size for ${name} differs from release metadata")
  endif()
  file(SHA256 "${zip}" actual_sha)
  list(FIND checksum_names "${name}" checksum_index)
  if(checksum_index LESS 0)
    message(FATAL_ERROR "checksum-missing: ${name} has no checksum")
  endif()
  list(GET checksum_digests ${checksum_index} listed_sha)
  if(NOT actual_sha STREQUAL listed_sha)
    message(FATAL_ERROR "checksum-disagreement: downloaded bytes do not match SHA256SUMS for ${name}")
  endif()
  string(RANDOM LENGTH 10 ALPHABET 0123456789abcdef attest_nonce)
  set(attestation_file "${diag}/attestation-${attest_nonce}.json")
  execute_process(COMMAND ${gh_env} gh attestation verify "${zip}" --repo "${REPOSITORY}"
      --source-digest "${source_sha}" --format json
    RESULT_VARIABLE attest_result OUTPUT_VARIABLE attest_json ERROR_VARIABLE attest_error TIMEOUT 45)
  file(WRITE "${attestation_file}" "${attest_json}")
  file(WRITE "${attestation_file}.stderr.txt" "${attest_error}")
  if(NOT attest_result STREQUAL "0")
    message(FATAL_ERROR "attestation-unverified: ${name}: ${attest_error}")
  endif()
  string(JSON attest_type ERROR_VARIABLE attest_json_error TYPE "${attest_json}")
  if(attest_json_error OR NOT attest_type STREQUAL "ARRAY")
    message(FATAL_ERROR "attestation-missing: ${name} verification response must be a JSON ARRAY: ${attest_json_error}${attest_type}")
  endif()
  string(JSON result_count ERROR_VARIABLE attest_json_error LENGTH "${attest_json}")
  if(attest_json_error OR result_count LESS 1)
    message(FATAL_ERROR "attestation-missing: ${name} produced no structured verification result")
  endif()
  set(subject_verified FALSE)
  math(EXPR attest_last "${result_count} - 1")
  foreach(result_index RANGE 0 ${attest_last})
    string(JSON result_type ERROR_VARIABLE result_type_error TYPE "${attest_json}" ${result_index})
    if(result_type_error OR NOT result_type STREQUAL "OBJECT")
      message(FATAL_ERROR "attestation-missing: ${name} verification result ${result_index} must be a JSON OBJECT: ${result_type_error}${result_type}")
    endif()
    string(JSON subject_type ERROR_VARIABLE subject_type_error TYPE "${attest_json}" ${result_index} verificationResult statement subject)
    if(subject_type_error OR NOT subject_type STREQUAL "ARRAY")
      continue()
    endif()
    string(JSON subject_count ERROR_VARIABLE subject_error LENGTH "${attest_json}" ${result_index} verificationResult statement subject)
    if(subject_error)
      continue()
    endif()
    if(subject_count LESS 1)
      continue()
    endif()
    math(EXPR subject_last "${subject_count} - 1")
    foreach(subject_index RANGE 0 ${subject_last})
      string(JSON subject_entry_type ERROR_VARIABLE subject_entry_error TYPE "${attest_json}" ${result_index} verificationResult statement subject ${subject_index})
      if(subject_entry_error OR NOT subject_entry_type STREQUAL "OBJECT")
        continue()
      endif()
      string(JSON subject_hash_type ERROR_VARIABLE subject_hash_type_error TYPE "${attest_json}" ${result_index} verificationResult statement subject ${subject_index} digest sha256)
      if(subject_hash_type_error OR NOT subject_hash_type STREQUAL "STRING")
        continue()
      endif()
      string(JSON subject_sha ERROR_VARIABLE subject_hash_error GET "${attest_json}" ${result_index} verificationResult statement subject ${subject_index} digest sha256)
      if(NOT subject_hash_error AND subject_sha STREQUAL actual_sha)
        set(subject_verified TRUE)
      endif()
    endforeach()
  endforeach()
  if(NOT subject_verified)
    message(FATAL_ERROR "attestation-subject-mismatch: verified statement does not bind ${name} bytes")
  endif()
  file(SHA256 "${attestation_file}" attest_result_sha)
  if(NOT archive_records STREQUAL "")
    string(APPEND archive_records ",")
  endif()
  string(APPEND archive_records "{\"name\":\"${name}\",\"size\":${zip_size},\"sha256\":\"${actual_sha}\",\"attestation\":{\"state\":\"verified\",\"source_digest\":\"${source_sha}\",\"subject_sha256\":\"${actual_sha}\",\"result_sha256\":\"${attest_result_sha}\"}}")
endforeach()

