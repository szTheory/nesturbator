      set(name "nesturbator-${release_version}-${component}-${os}-${arch}.zip")
      file(COPY_FILE "${download_dir}/${name}" "${group}/${name}")
    endforeach()
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DPACKAGES=${group}" "-DVERSION=${release_version}"
        -P "${SOURCE_DIR}/tests/cmake/check_archives.cmake"
