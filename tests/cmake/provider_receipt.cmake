  set(pr "{\"number\":67,\"state\":\"open\",\"merged\":false,\"draft\":false,\"head\":{\"sha\":\"${head}\"},\"base\":{\"ref\":\"main\",\"repo\":{\"full_name\":\"${REPOSITORY}\"}}}")
