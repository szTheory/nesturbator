  set(duplicate "{\"total_count\":2,\"check_runs\":[${check_new},${check_new}]}")
  pr_select_title_check("${duplicate}" "${head}" 2003 selected error)
  if(NOT error MATCHES "^required-check-ambiguous:")
    message(FATAL_ERROR "Title duplicate current-suite check was accepted")
  endif()
