pr_json_set("${receipt}" native.runner_probe "${runner_probe_json}" receipt)
pr_json_set("${receipt}" linked_ci.exact_candidate "${candidate_ci}" receipt)
pr_json_set("${receipt}" linked_ci.main "${main_ci}" receipt)
pr_json_set("${receipt}" linked_ci.release_pr "${release_pr_ci}" receipt)
pr_json_set("${receipt}" linked_ci.release_source "${release_ci}" receipt)
if(require_title_proof)
  pr_json_set("${receipt}" linked_title.candidate "${evidence_candidate_title}" receipt)
  pr_json_set("${receipt}" linked_title.release_pr "${evidence_release_title}" receipt)
  pr_validate_title_proof_pair("${receipt}" "${evidence_candidate_pr}" "${evidence_candidate_head}"
    "${evidence_release_pr}" "${evidence_release_pr_head}"
    assembled_candidate_title assembled_release_title assembled_title_error)
  if(assembled_title_error OR
     NOT assembled_candidate_title STREQUAL evidence_candidate_title OR
     NOT assembled_release_title STREQUAL evidence_release_title)
    message(FATAL_ERROR "completed published receipt failed retained title proof validation: ${assembled_title_error}")
  endif()
endif()
pr_add_rights_contract("${receipt}" receipt)
pr_validate_structure("${receipt}" "${TAG}" "${source_sha}" "${release_version}"
  "${profile_sha}" "${guide_sha}" "${scenario_rom_sha}" "${abi}" "${behaviour}"
  "${state_format}" "${candidate_sha}" TRUE final_error)
if(final_error)
  message(FATAL_ERROR "completed published receipt failed final structural validation: ${final_error}")
endif()
pr_validate_rights("${receipt}" "${SOURCE_DIR}/${DABG_NOTICE_PATH}" final_rights_error)
if(final_rights_error)
  message(FATAL_ERROR "completed published receipt failed final rights validation: ${final_rights_error}")
endif()
file(WRITE "${OUTPUT_RECEIPT}" "${receipt}\n")
message(STATUS "published NTSC provider receipt passed for ${TAG} at ${source_sha}; wrote ${OUTPUT_RECEIPT}")
