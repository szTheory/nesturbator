  set(log_record "{\"schema_version\":1,\"pr_number\":67,\"run_id\":8001,\"run_attempt\":1,\"title_valid\":true}")
  foreach(pair IN ITEMS "context;PR title" "workflow_name;PR title"
      "workflow_path;.github/workflows/pr-title.yml" "check_context;PR title"
      "job_name;PR title" "repository;${REPOSITORY}" "head_sha;${head}"
      "title_sha256;${title_sha}" "event;pull_request" "event_action;edited"
      "event_sha;bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")
    list(GET pair 0 key)
