function(pr_synthetic_run_job_conclusion record_json job_name conclusion out_json)
  string(JSON job_count LENGTH "${record_json}" jobs)
  set(mutated "${record_json}")
  math(EXPR last_job "${job_count} - 1")
  foreach(index RANGE 0 ${last_job})
    string(JSON current_name GET "${mutated}" jobs ${index} name)
    if(current_name STREQUAL job_name)
      pr_json_set("${mutated}" "jobs.${index}.conclusion" "\"${conclusion}\"" mutated)
      set(${out_json} "${mutated}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  message(FATAL_ERROR "synthetic workflow job was not found: ${job_name}")
endfunction()

