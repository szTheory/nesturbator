    file(WRITE "${diag}/inventory-${os}-${arch}.stdout.txt" "${inventory_out}")
    file(WRITE "${diag}/inventory-${os}-${arch}.stderr.txt" "${inventory_error}")
    if(NOT inventory_result STREQUAL "0")
