# A workflow-local run_number increments for each new run, including metadata
# events in the same second; opaque run IDs and API row order are not chronology.
# https://docs.github.com/en/actions/reference/workflows-and-actions/variables
function(pr_select_title_run runs_json expected_pr expected_head out_index out_error)
  set(${out_index} "" PARENT_SCOPE)
  set(${out_error} "" PARENT_SCOPE)
  string(JSON count ERROR_VARIABLE count_error LENGTH "${runs_json}" workflow_runs)
  string(JSON total_type ERROR_VARIABLE type_error TYPE "${runs_json}" total_count)
  string(JSON total ERROR_VARIABLE total_error GET "${runs_json}" total_count)
  if(count_error OR type_error OR total_error OR NOT total_type STREQUAL "NUMBER" OR
     NOT total MATCHES "^[0-9]+$" OR NOT total EQUAL count OR count LESS 1)
    set(${out_error} "ci-evidence-missing: title run list is empty, malformed or truncated" PARENT_SCOPE)
    return()
  endif()
  set(selected "")
  set(max_number 0)
  set(workflow_identity "")
  set(seen_numbers)
  set(seen_ids)
  set(seen_suites)
  math(EXPR last "${count} - 1")
  foreach(index RANGE 0 ${last})
    foreach(field IN ITEMS name path event head_sha)
      string(JSON value_type ERROR_VARIABLE type_error TYPE "${runs_json}" workflow_runs ${index} ${field})
      if(type_error OR NOT value_type STREQUAL "STRING")
        set(${out_error} "ci-evidence-missing: title run identity field ${field} is absent or mistyped" PARENT_SCOPE)
        return()
      endif()
      string(JSON run_${field} GET "${runs_json}" workflow_runs ${index} ${field})
    endforeach()
    if(NOT run_name STREQUAL "PR title" OR NOT run_path STREQUAL ".github/workflows/pr-title.yml" OR
       NOT run_event STREQUAL "pull_request" OR NOT run_head_sha STREQUAL expected_head)
      continue()
    endif()
    string(JSON association_type ERROR_VARIABLE type_error TYPE "${runs_json}" workflow_runs ${index} pull_requests)
    string(JSON association_count ERROR_VARIABLE count_error LENGTH "${runs_json}" workflow_runs ${index} pull_requests)
    if(type_error OR count_error OR NOT association_type STREQUAL "ARRAY" OR association_count LESS 1)
      set(${out_error} "run-identity-mismatch: exact title run has malformed PR associations" PARENT_SCOPE)
      return()
    endif()
    set(associated FALSE)
    if(association_count GREATER 0)
      math(EXPR last_association "${association_count} - 1")
      foreach(pr_index RANGE 0 ${last_association})
        string(JSON number_type ERROR_VARIABLE type_error TYPE "${runs_json}" workflow_runs ${index} pull_requests ${pr_index} number)
        string(JSON number ERROR_VARIABLE number_error GET "${runs_json}" workflow_runs ${index} pull_requests ${pr_index} number)
        if(type_error OR number_error OR NOT number_type STREQUAL "NUMBER" OR NOT number MATCHES "^[1-9][0-9]*$")
          set(${out_error} "run-identity-mismatch: exact title run has malformed PR number" PARENT_SCOPE)
          return()
        endif()
        if(number STREQUAL expected_pr)
          set(associated TRUE)
        endif()
      endforeach()
    endif()
    if(NOT associated)
      continue()
    endif()
    foreach(field IN ITEMS id workflow_id run_number run_attempt check_suite_id)
      string(JSON value_type ERROR_VARIABLE type_error TYPE "${runs_json}" workflow_runs ${index} ${field})
      string(JSON run_${field} ERROR_VARIABLE value_error GET "${runs_json}" workflow_runs ${index} ${field})
      if(type_error OR value_error OR NOT value_type STREQUAL "NUMBER" OR NOT run_${field} MATCHES "^[1-9][0-9]*$")
        set(${out_error} "ci-evidence-missing: exact title run ${field} is absent, mistyped or invalid" PARENT_SCOPE)
        return()
      endif()
    endforeach()
    if(workflow_identity STREQUAL "")
      set(workflow_identity "${run_workflow_id}")
    elseif(NOT workflow_identity STREQUAL run_workflow_id)
      set(${out_error} "ci-evidence-ambiguous: title run numbers belong to different workflow identities" PARENT_SCOPE)
      return()
    endif()
    if(run_run_number IN_LIST seen_numbers OR run_id IN_LIST seen_ids OR run_check_suite_id IN_LIST seen_suites)
      set(${out_error} "ci-evidence-ambiguous: title run number, ID or suite is duplicated" PARENT_SCOPE)
      return()
    endif()
    list(APPEND seen_numbers "${run_run_number}")
    list(APPEND seen_ids "${run_id}")
    list(APPEND seen_suites "${run_check_suite_id}")
    if(run_run_number GREATER max_number)
      set(max_number "${run_run_number}")
      set(selected "${index}")
    endif()
  endforeach()
  if(selected STREQUAL "")
    set(${out_error} "ci-evidence-missing: no exact PR/head/workflow title run exists" PARENT_SCOPE)
    return()
  endif()
  # Select before inspecting success: pending/failed latest runs never fall back.
  string(JSON status_type ERROR_VARIABLE type_error TYPE "${runs_json}" workflow_runs ${selected} status)
  string(JSON status ERROR_VARIABLE status_error GET "${runs_json}" workflow_runs ${selected} status)
  string(JSON conclusion_type ERROR_VARIABLE conclusion_error TYPE "${runs_json}" workflow_runs ${selected} conclusion)
  if(type_error OR status_error OR conclusion_error OR NOT status_type STREQUAL "STRING" OR
     NOT status STREQUAL "completed" OR NOT conclusion_type STREQUAL "STRING")
    set(${out_error} "ci-evidence-incomplete: current title workflow run is not completed successfully" PARENT_SCOPE)
    return()
  endif()
  string(JSON conclusion GET "${runs_json}" workflow_runs ${selected} conclusion)
  if(NOT conclusion STREQUAL "success")
    set(${out_error} "ci-evidence-incomplete: current title workflow run did not succeed" PARENT_SCOPE)
    return()
  endif()
  set(${out_index} "${selected}" PARENT_SCOPE)
endfunction()

function(pr_select_title_check checks_json expected_head expected_suite out_index out_error)
  set(${out_index} "" PARENT_SCOPE)
  set(${out_error} "" PARENT_SCOPE)
  string(JSON count ERROR_VARIABLE count_error LENGTH "${checks_json}" check_runs)
  string(JSON total_type ERROR_VARIABLE type_error TYPE "${checks_json}" total_count)
  string(JSON total ERROR_VARIABLE total_error GET "${checks_json}" total_count)
  if(count_error OR type_error OR total_error OR NOT total_type STREQUAL "NUMBER" OR
     NOT total MATCHES "^[0-9]+$" OR NOT total EQUAL count OR count LESS 1)
    set(${out_error} "required-check-missing: title check list is empty, malformed or truncated" PARENT_SCOPE)
    return()
  endif()
  set(selected "")
  math(EXPR last "${count} - 1")
  foreach(index RANGE 0 ${last})
    foreach(pair IN ITEMS "name;STRING" "head_sha;STRING" "app.id;NUMBER" "check_suite.id;NUMBER" "id;NUMBER")
      list(GET pair 0 field)
      list(GET pair 1 expected_type)
      string(REPLACE "." ";" json_path "${field}")
      string(JSON value_type ERROR_VARIABLE type_error TYPE "${checks_json}" check_runs ${index} ${json_path})
      string(JSON value ERROR_VARIABLE value_error GET "${checks_json}" check_runs ${index} ${json_path})
      if(type_error OR value_error OR NOT value_type STREQUAL expected_type)
        set(${out_error} "required-check-missing: title check ${field} is absent or mistyped" PARENT_SCOPE)
        return()
      endif()
      string(REPLACE "." "_" variable "${field}")
      set(check_${variable} "${value}")
    endforeach()
    if(NOT check_name STREQUAL "PR title" OR NOT check_head_sha STREQUAL expected_head OR
       NOT check_app_id STREQUAL "15368" OR NOT check_id MATCHES "^[1-9][0-9]*$" OR
       NOT check_check_suite_id MATCHES "^[1-9][0-9]*$")
      set(${out_error} "required-check-missing: title context has an unexpected name/app/head/identity" PARENT_SCOPE)
      return()
    endif()
    if(check_check_suite_id STREQUAL expected_suite)
      if(NOT selected STREQUAL "")
        set(${out_error} "required-check-ambiguous: current title suite has multiple title checks" PARENT_SCOPE)
        return()
      endif()
      set(selected "${index}")
    endif()
  endforeach()
  if(selected STREQUAL "")
    set(${out_error} "required-check-missing: current title workflow suite has no matching check" PARENT_SCOPE)
    return()
  endif()
  set(${out_index} "${selected}" PARENT_SCOPE)
endfunction()

function(pr_live_title_required_context number expected_head out_check_run out_suite out_error)
  pr_title_api("repos/${REPOSITORY}/actions/workflows/pr-title.yml/runs?head_sha=${expected_head}&event=pull_request&per_page=100"
    title_runs title_runs_error)
  if(title_runs_error)
    set(${out_error} "${title_runs_error}" PARENT_SCOPE)
    return()
  endif()
  pr_select_title_run("${title_runs}" "${number}" "${expected_head}" selected_run selection_error)
  if(selection_error)
    set(${out_error} "${selection_error}" PARENT_SCOPE)
    return()
  endif()
  string(JSON selected_suite GET "${title_runs}" workflow_runs ${selected_run} check_suite_id)
  pr_title_api("repos/${REPOSITORY}/commits/${expected_head}/check-runs?filter=all&check_name=PR%20title&app_id=15368&per_page=100"
    checks_json checks_error)
  if(checks_error)
    set(${out_error} "${checks_error}" PARENT_SCOPE)
    return()
  endif()
  pr_select_title_check("${checks_json}" "${expected_head}" "${selected_suite}" selected_check selection_error)
  if(selection_error)
    set(${out_error} "${selection_error}" PARENT_SCOPE)
    return()
  endif()
  string(JSON check_name ERROR_VARIABLE name_error GET "${checks_json}" check_runs ${selected_check} name)
  string(JSON check_head ERROR_VARIABLE head_error GET "${checks_json}" check_runs ${selected_check} head_sha)
  string(JSON app_id ERROR_VARIABLE app_error GET "${checks_json}" check_runs ${selected_check} app id)
  string(JSON check_id_type ERROR_VARIABLE id_type_error TYPE "${checks_json}" check_runs ${selected_check} id)
  string(JSON check_id ERROR_VARIABLE id_error GET "${checks_json}" check_runs ${selected_check} id)
  string(JSON check_status ERROR_VARIABLE status_error GET "${checks_json}" check_runs ${selected_check} status)
  string(JSON check_conclusion_type ERROR_VARIABLE conclusion_type_error TYPE "${checks_json}" check_runs ${selected_check} conclusion)
  string(JSON check_suite ERROR_VARIABLE suite_error GET "${checks_json}" check_runs ${selected_check} check_suite id)
  if(name_error OR head_error OR app_error OR id_type_error OR id_error OR status_error OR
     conclusion_type_error OR suite_error OR NOT check_id_type STREQUAL "NUMBER" OR
     NOT check_name STREQUAL "PR title" OR NOT check_head STREQUAL expected_head OR
     NOT app_id STREQUAL "15368" OR NOT check_id MATCHES "^[1-9][0-9]*$" OR
     NOT check_suite MATCHES "^[1-9][0-9]*$")
    set(${out_error} "required-check-missing: latest PR title context lacks exact name/app/head/check/suite identity" PARENT_SCOPE)
    return()
  endif()
  if(check_conclusion_type STREQUAL "STRING")
    string(JSON check_conclusion GET "${checks_json}" check_runs ${selected_check} conclusion)
  elseif(check_conclusion_type STREQUAL "NULL")
    set(check_conclusion "")
  else()
    set(${out_error} "required-check-missing: current PR title conclusion has an invalid JSON type" PARENT_SCOPE)
    return()
  endif()
  if(NOT check_status STREQUAL "completed" OR NOT check_conclusion STREQUAL "success")
    set(${out_error} "required-check-incomplete: current PR title context is ${check_status}/${check_conclusion}" PARENT_SCOPE)
    return()
  endif()
  set(${out_check_run} "${check_id}" PARENT_SCOPE)
  set(${out_suite} "${check_suite}" PARENT_SCOPE)
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(pr_live_title_proof number expected_head require_open out_proof out_error)
  set(${out_proof} "" PARENT_SCOPE)
  pr_title_api("repos/${REPOSITORY}/pulls/${number}" pr_json pr_error)
  if(pr_error)
    set(${out_error} "${pr_error}" PARENT_SCOPE)
    return()
  endif()
  foreach(pair IN ITEMS
      "number;live_number;NUMBER" "base.ref;base_ref;STRING" "base.repo.full_name;base_repo;STRING"
      "head.sha;live_head;STRING" "title;live_title;STRING" "state;pr_state;STRING"
      "merged;pr_merged;BOOLEAN" "draft;pr_draft;BOOLEAN")
    list(GET pair 0 path)
    list(GET pair 1 value_name)
    list(GET pair 2 expected_type)
    string(REPLACE "." ";" json_path "${path}")
    string(JSON value_type ERROR_VARIABLE type_error TYPE "${pr_json}" ${json_path})
    if(type_error OR NOT value_type STREQUAL expected_type)
      set(${out_error} "pr-title-identity-mismatch: live PR ${path} is absent or mistyped" PARENT_SCOPE)
      return()
    endif()
    string(JSON ${value_name} ERROR_VARIABLE value_error GET "${pr_json}" ${json_path})
    if(value_error)
      set(${out_error} "pr-title-identity-mismatch: live PR ${path} cannot be read" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  if(expected_head STREQUAL "")
    set(expected_head "${live_head}")
  endif()
  if(NOT number MATCHES "^[1-9][0-9]*$" OR NOT live_number STREQUAL number OR
     NOT base_ref STREQUAL "main" OR NOT base_repo STREQUAL REPOSITORY OR
     NOT live_head STREQUAL expected_head)
    set(${out_error} "pr-title-identity-mismatch: live PR repository, number, base or head changed" PARENT_SCOPE)
    return()
  endif()
  pr_commit_valid("${live_head}" live_head_valid)
  pr_title_is_conventional("${live_title}" live_title_valid)
  if(NOT live_head_valid OR NOT live_title_valid)
    set(${out_error} "pr-title-invalid: live PR title is not a valid Conventional Commit for its exact head" PARENT_SCOPE)
    return()
  endif()
  if(require_open)
    if(NOT pr_state STREQUAL "open" OR pr_merged OR pr_draft)
      set(${out_error} "pr-title-merge-state: premerge title proof requires an open, non-draft PR" PARENT_SCOPE)
      return()
    endif()
  elseif(NOT pr_state STREQUAL "closed" OR NOT pr_merged)
    set(${out_error} "pr-title-merge-state: postmerge title proof requires the merged PR to remain closed" PARENT_SCOPE)
    return()
  endif()
  string(SHA256 live_title_sha "${live_title}")
  pr_live_title_required_context("${number}" "${expected_head}" required_title_check required_title_suite
    title_context_error)
  if(title_context_error)
    set(${out_error} "${title_context_error}" PARENT_SCOPE)
    return()
  endif()

  pr_title_api("repos/${REPOSITORY}/actions/workflows/pr-title.yml/runs?head_sha=${expected_head}&event=pull_request&per_page=100"
    runs_json runs_error)
  if(runs_error)
    set(${out_error} "${runs_error}" PARENT_SCOPE)
    return()
  endif()
  string(JSON run_count ERROR_VARIABLE run_error LENGTH "${runs_json}" workflow_runs)
  string(JSON total_type ERROR_VARIABLE total_type_error TYPE "${runs_json}" total_count)
  string(JSON total_count ERROR_VARIABLE total_error GET "${runs_json}" total_count)
  if(run_error OR total_type_error OR total_error OR NOT total_type STREQUAL "NUMBER" OR
     NOT total_count MATCHES "^[0-9]+$" OR NOT total_count EQUAL run_count)
    set(${out_error} "ci-evidence-missing: PR title workflow-run response is malformed or truncated" PARENT_SCOPE)
    return()
  endif()
  if(run_count LESS 1)
    set(${out_error} "ci-evidence-missing: no PR title workflow run exists for exact head ${expected_head}" PARENT_SCOPE)
    return()
  endif()

  set(candidates)
  math(EXPR last_run "${run_count} - 1")
  foreach(index RANGE 0 ${last_run})
    foreach(pair IN ITEMS "name;run_name;STRING" "path;run_path;STRING"
        "event;run_event;STRING" "head_sha;run_head;STRING")
      list(GET pair 0 field)
      list(GET pair 1 value_name)
      list(GET pair 2 expected_type)
      string(JSON field_type ERROR_VARIABLE field_error TYPE "${runs_json}" workflow_runs ${index} "${field}")
      if(field_error OR NOT field_type STREQUAL expected_type)
        set(${out_error} "ci-evidence-missing: PR title workflow run ${index} lacks ${field}" PARENT_SCOPE)
        return()
      endif()
      string(JSON ${value_name} GET "${runs_json}" workflow_runs ${index} "${field}")
    endforeach()
    if(NOT run_name STREQUAL "PR title" OR NOT run_path STREQUAL ".github/workflows/pr-title.yml" OR
       NOT run_event STREQUAL "pull_request" OR NOT run_head STREQUAL expected_head)
      continue()
    endif()
    string(JSON associations_type ERROR_VARIABLE associations_error TYPE "${runs_json}" workflow_runs ${index} pull_requests)
    string(JSON association_count ERROR_VARIABLE association_count_error LENGTH "${runs_json}" workflow_runs ${index} pull_requests)
    if(associations_error OR association_count_error OR NOT associations_type STREQUAL "ARRAY")
      set(${out_error} "run-identity-mismatch: exact PR title run has malformed pull-request association" PARENT_SCOPE)
      return()
    endif()
    set(associated FALSE)
    if(association_count GREATER 0)
      math(EXPR last_association "${association_count} - 1")
      foreach(pr_index RANGE 0 ${last_association})
        string(JSON associated_number ERROR_VARIABLE number_error GET "${runs_json}" workflow_runs ${index} pull_requests ${pr_index} number)
        if(number_error OR NOT associated_number MATCHES "^[1-9][0-9]*$")
          set(${out_error} "run-identity-mismatch: exact PR title run has malformed PR number" PARENT_SCOPE)
          return()
        endif()
        if(associated_number STREQUAL number)
          set(associated TRUE)
        endif()
      endforeach()
    endif()
    if(NOT associated)
      continue()
    endif()
    string(JSON check_suite_id ERROR_VARIABLE suite_error GET "${runs_json}" workflow_runs ${index} check_suite_id)
    if(suite_error OR NOT check_suite_id MATCHES "^[1-9][0-9]*$")
      set(${out_error} "ci-evidence-missing: exact PR title run has malformed check-suite identity" PARENT_SCOPE)
      return()
    endif()
    if(NOT check_suite_id STREQUAL required_title_suite)
      continue()
    endif()
    foreach(pair IN ITEMS "id;run_id;NUMBER" "run_attempt;run_attempt;NUMBER"
        "created_at;created_at;STRING" "status;run_status;STRING")
      list(GET pair 0 field)
      list(GET pair 1 value_name)
      list(GET pair 2 expected_type)
      string(JSON field_type ERROR_VARIABLE field_error TYPE "${runs_json}" workflow_runs ${index} "${field}")
      if(field_error OR NOT field_type STREQUAL expected_type)
        set(${out_error} "ci-evidence-missing: exact PR title run lacks ${field}" PARENT_SCOPE)
        return()
      endif()
      string(JSON ${value_name} GET "${runs_json}" workflow_runs ${index} "${field}")
    endforeach()
    string(JSON run_conclusion_type ERROR_VARIABLE run_conclusion_error TYPE
      "${runs_json}" workflow_runs ${index} conclusion)
    if(run_conclusion_error OR
       (NOT run_conclusion_type STREQUAL "STRING" AND NOT run_conclusion_type STREQUAL "NULL"))
      set(${out_error} "ci-evidence-missing: exact PR title run has malformed conclusion" PARENT_SCOPE)
      return()
    elseif(run_conclusion_type STREQUAL "STRING")
      string(JSON run_conclusion GET "${runs_json}" workflow_runs ${index} conclusion)
    else()
      set(run_conclusion "")
    endif()
    if(NOT run_id MATCHES "^[1-9][0-9]*$" OR NOT run_attempt MATCHES "^[1-9][0-9]*$" OR
       NOT check_suite_id MATCHES "^[1-9][0-9]*$" OR
       NOT created_at MATCHES "^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]([.][0-9]+)?Z$")
      set(${out_error} "ci-evidence-missing: exact PR title run has malformed run/attempt/time identity" PARENT_SCOPE)
      return()
    endif()
    list(APPEND candidates "${index}")
  endforeach()
  list(LENGTH candidates candidate_count)
  if(candidate_count EQUAL 0)
    set(${out_error} "ci-evidence-missing: current required PR title check-suite has no linked workflow run" PARENT_SCOPE)
    return()
  endif()
  if(NOT candidate_count EQUAL 1)
    set(${out_error} "ci-evidence-ambiguous: current required PR title check-suite maps to ${candidate_count} workflow runs" PARENT_SCOPE)
    return()
  endif()
  list(GET candidates 0 latest_index)
  string(JSON latest_status GET "${runs_json}" workflow_runs ${latest_index} status)
  string(JSON latest_conclusion_type TYPE "${runs_json}" workflow_runs ${latest_index} conclusion)
  set(latest_conclusion "")
  if(latest_conclusion_type STREQUAL "STRING")
    string(JSON latest_conclusion GET "${runs_json}" workflow_runs ${latest_index} conclusion)
  endif()
  if(NOT latest_status STREQUAL "completed" OR NOT latest_conclusion STREQUAL "success")
    set(${out_error} "ci-evidence-incomplete: workflow run linked to the current required title check is ${latest_status}/${latest_conclusion}" PARENT_SCOPE)
    return()
  endif()
  set(log_root "${SOURCE_DIR}/build/phase28-normal/title-logs")
  get_filename_component(log_root "${log_root}" ABSOLUTE)
  file(RELATIVE_PATH log_root_under_build "${SOURCE_DIR}/build" "${log_root}")
  if(IS_ABSOLUTE "${log_root_under_build}" OR log_root_under_build MATCHES "^\\.\\.")
    set(${out_error} "pr-title-evidence-path: title log output must stay under SOURCE_DIR/build" PARENT_SCOPE)
    return()
  endif()
  if(IS_SYMLINK "${SOURCE_DIR}/build" OR IS_SYMLINK "${log_root}")
    set(${out_error} "pr-title-evidence-path: refusing a symlinked build/title-log directory" PARENT_SCOPE)
    return()
  endif()
  file(MAKE_DIRECTORY "${log_root}")

  set(index "${latest_index}")
    string(JSON run_id GET "${runs_json}" workflow_runs ${index} id)
    string(JSON run_attempt GET "${runs_json}" workflow_runs ${index} run_attempt)
    string(JSON check_suite_id GET "${runs_json}" workflow_runs ${index} check_suite_id)
    string(JSON created_at GET "${runs_json}" workflow_runs ${index} created_at)

    pr_title_api("repos/${REPOSITORY}/actions/runs/${run_id}/jobs?per_page=100" jobs_json jobs_error)
    if(jobs_error)
      set(${out_error} "${jobs_error}" PARENT_SCOPE)
      return()
    endif()
    string(JSON job_count ERROR_VARIABLE job_error LENGTH "${jobs_json}" jobs)
    string(JSON jobs_total_type ERROR_VARIABLE jobs_total_type_error TYPE "${jobs_json}" total_count)
    string(JSON jobs_total ERROR_VARIABLE jobs_total_error GET "${jobs_json}" total_count)
    if(job_error OR jobs_total_type_error OR jobs_total_error OR NOT jobs_total_type STREQUAL "NUMBER" OR
       NOT jobs_total MATCHES "^[0-9]+$" OR NOT jobs_total EQUAL job_count OR job_count LESS 1)
      set(${out_error} "ci-evidence-missing: PR title jobs response is malformed or truncated" PARENT_SCOPE)
      return()
    endif()
    set(title_job_index "")
    math(EXPR last_job "${job_count} - 1")
    foreach(job_index RANGE 0 ${last_job})
      string(JSON job_name ERROR_VARIABLE job_name_error GET "${jobs_json}" jobs ${job_index} name)
      if(job_name_error)
        set(${out_error} "ci-evidence-missing: PR title job ${job_index} lacks a name" PARENT_SCOPE)
        return()
      endif()
      if(job_name STREQUAL "PR title")
        if(NOT title_job_index STREQUAL "")
          set(${out_error} "ci-evidence-duplicate: PR title workflow run has multiple title jobs" PARENT_SCOPE)
          return()
        endif()
        set(title_job_index "${job_index}")
      endif()
    endforeach()
    if(title_job_index STREQUAL "")
      set(${out_error} "required-job-missing: PR title workflow run lacks its PR title job" PARENT_SCOPE)
      return()
    endif()
    string(JSON job_id_type ERROR_VARIABLE job_id_error TYPE "${jobs_json}" jobs ${title_job_index} id)
    string(JSON job_attempt_type ERROR_VARIABLE job_attempt_error TYPE "${jobs_json}" jobs ${title_job_index} run_attempt)
    string(JSON job_status_type ERROR_VARIABLE job_status_error TYPE "${jobs_json}" jobs ${title_job_index} status)
    string(JSON job_conclusion_type ERROR_VARIABLE job_conclusion_error TYPE "${jobs_json}" jobs ${title_job_index} conclusion)
    string(JSON check_run_url_type ERROR_VARIABLE check_url_error TYPE "${jobs_json}" jobs ${title_job_index} check_run_url)
    if(job_id_error OR job_attempt_error OR job_status_error OR job_conclusion_error OR check_url_error OR
       NOT job_id_type STREQUAL "NUMBER" OR NOT job_status_type STREQUAL "STRING" OR
       NOT job_attempt_type STREQUAL "NUMBER" OR
       NOT job_conclusion_type STREQUAL "STRING" OR NOT check_run_url_type STREQUAL "STRING")
      set(${out_error} "ci-evidence-missing: PR title job lacks its ID/attempt/status/check-run URL" PARENT_SCOPE)
      return()
    endif()
    string(JSON job_id GET "${jobs_json}" jobs ${title_job_index} id)
    string(JSON job_attempt GET "${jobs_json}" jobs ${title_job_index} run_attempt)
    string(JSON job_name GET "${jobs_json}" jobs ${title_job_index} name)
    string(JSON job_status GET "${jobs_json}" jobs ${title_job_index} status)
    string(JSON job_conclusion GET "${jobs_json}" jobs ${title_job_index} conclusion)
    string(JSON check_run_url GET "${jobs_json}" jobs ${title_job_index} check_run_url)
    if(NOT job_id MATCHES "^[1-9][0-9]*$" OR NOT job_attempt STREQUAL run_attempt OR
       NOT job_status STREQUAL "completed" OR
       NOT job_conclusion STREQUAL "success")
      set(${out_error} "ci-evidence-incomplete: selected PR title job did not pass on the selected workflow attempt" PARENT_SCOPE)
      return()
    endif()
    if(NOT check_run_url MATCHES "^https://api\\.github\\.com/repos/${REPOSITORY}/check-runs/[1-9][0-9]*$")
      set(${out_error} "ci-evidence-missing: PR title job check-run URL is malformed" PARENT_SCOPE)
      return()
    endif()
    string(REGEX REPLACE ".*/" "" check_run_id "${check_run_url}")
    pr_title_api("repos/${REPOSITORY}/check-runs/${check_run_id}" check_json check_error)
    if(check_error)
      set(${out_error} "${check_error}" PARENT_SCOPE)
      return()
    endif()
    foreach(pair IN ITEMS "name;check_name;STRING" "head_sha;check_head;STRING"
        "status;check_status;STRING" "conclusion;check_conclusion;STRING")
      list(GET pair 0 field)
      list(GET pair 1 value_name)
      list(GET pair 2 expected_type)
      string(JSON field_type ERROR_VARIABLE field_error TYPE "${check_json}" "${field}")
      if(field_error OR NOT field_type STREQUAL expected_type)
        set(${out_error} "ci-evidence-missing: PR title check run lacks ${field}" PARENT_SCOPE)
        return()
      endif()
      string(JSON ${value_name} GET "${check_json}" "${field}")
    endforeach()
    string(JSON check_run_id_type ERROR_VARIABLE check_id_error TYPE "${check_json}" id)
    string(JSON actual_check_suite ERROR_VARIABLE suite_error GET "${check_json}" check_suite id)
    if(check_id_error OR suite_error OR NOT check_run_id_type STREQUAL "NUMBER" OR
       NOT check_name STREQUAL "PR title" OR NOT check_head STREQUAL expected_head OR
       NOT actual_check_suite STREQUAL check_suite_id OR
       NOT check_status STREQUAL "completed" OR NOT check_conclusion STREQUAL "success")
      set(${out_error} "required-check-incomplete: selected PR title check is not successful on its exact workflow suite/head" PARENT_SCOPE)
      return()
    endif()
    string(JSON actual_check_run_id GET "${check_json}" id)
    if(NOT actual_check_run_id STREQUAL check_run_id OR
       NOT actual_check_run_id STREQUAL required_title_check)
      set(${out_error} "ci-evidence-missing: PR title job and current required check-run identities differ" PARENT_SCOPE)
      return()
    endif()

    pr_title_api_raw("repos/${REPOSITORY}/actions/jobs/${job_id}/logs" title_log log_error)
    if(log_error)
      set(${out_error} "pr-title-evidence-missing: ${log_error}" PARENT_SCOPE)
      return()
    endif()
    pr_parse_title_log("${title_log}" "${number}" "${expected_head}" "${live_title_sha}"
      "${run_id}" "${run_attempt}" parsed_log log_error)
    if(log_error)
      set(${out_error} "${log_error}" PARENT_SCOPE)
      return()
    endif()
    string(SHA256 log_sha "${title_log}")
    set(relative_log "build/phase28-normal/title-logs/run-${run_id}-attempt-${run_attempt}-job-${job_id}.log")
    set(log_path "${SOURCE_DIR}/${relative_log}")
    if(IS_SYMLINK "${log_path}")
      set(${out_error} "pr-title-evidence-path: refusing symlinked raw job log" PARENT_SCOPE)
      return()
    elseif(EXISTS "${log_path}")
      file(SHA256 "${log_path}" prior_log_sha)
      if(NOT prior_log_sha STREQUAL "${log_sha}")
        set(${out_error} "pr-title-evidence-digest: existing job log differs from the live run" PARENT_SCOPE)
        return()
      endif()
    else()
      file(WRITE "${log_path}" "${title_log}")
    endif()
    file(SHA256 "${log_path}" saved_log_sha)
    if(NOT saved_log_sha STREQUAL log_sha)
      set(${out_error} "pr-title-evidence-digest: saved raw job log differs from fetched bytes" PARENT_SCOPE)
      return()
    endif()

    set(proof "{}")
    string(JSON proof SET "${proof}" schema_version 1)
    string(JSON proof SET "${proof}" pr_number "${number}")
    string(JSON proof SET "${proof}" run_id "${run_id}")
    string(JSON proof SET "${proof}" run_attempt "${run_attempt}")
    string(JSON proof SET "${proof}" check_suite_id "${check_suite_id}")
    string(JSON proof SET "${proof}" check_run_id "${check_run_id}")
    string(JSON proof SET "${proof}" job_id "${job_id}")
    string(JSON proof SET "${proof}" title_valid true)
    foreach(pair IN ITEMS
        "repository;${REPOSITORY}" "head_sha;${expected_head}"
        "title_sha256;${live_title_sha}" "workflow_name;PR title"
        "workflow_path;.github/workflows/pr-title.yml" "event;pull_request"
        "created_at;${created_at}" "status;completed" "conclusion;success"
        "check_context;PR title" "check_status;${check_status}"
        "check_conclusion;${check_conclusion}" "job_name;${job_name}"
        "job_status;${job_status}" "job_conclusion;${job_conclusion}"
        "log_sha256;${log_sha}" "evidence_log;${relative_log}")
      list(GET pair 0 field)
      list(GET pair 1 value)
      pr_title_set_string("${proof}" "${field}" "${value}" proof)
    endforeach()
    foreach(field IN ITEMS event_action event_sha)
      string(JSON value GET "${parsed_log}" "${field}")
      pr_title_set_string("${proof}" "${field}" "${value}" proof)
    endforeach()
    pr_validate_title_record("${proof}" "${number}" "${expected_head}"
      "${live_title_sha}" proof_error)
    if(proof_error)
      set(${out_error} "${proof_error}" PARENT_SCOPE)
      return()
    endif()
    pr_title_api("repos/${REPOSITORY}/pulls/${number}" final_pr_json final_pr_error)
    if(final_pr_error)
      set(${out_error} "${final_pr_error}" PARENT_SCOPE)
      return()
    endif()
    string(JSON final_pr_number ERROR_VARIABLE final_number_error GET "${final_pr_json}" number)
    string(JSON final_head ERROR_VARIABLE final_head_error GET "${final_pr_json}" head sha)
    string(JSON final_title ERROR_VARIABLE final_title_error GET "${final_pr_json}" title)
    string(JSON final_state ERROR_VARIABLE final_state_error GET "${final_pr_json}" state)
    string(JSON final_merged ERROR_VARIABLE final_merged_error GET "${final_pr_json}" merged)
    string(JSON final_draft ERROR_VARIABLE final_draft_error GET "${final_pr_json}" draft)
    string(SHA256 final_title_sha "${final_title}")
    if(final_number_error OR final_head_error OR final_title_error OR final_state_error OR
       final_merged_error OR final_draft_error OR NOT final_pr_number STREQUAL number OR
       NOT final_head STREQUAL expected_head OR NOT final_title_sha STREQUAL live_title_sha OR
       NOT final_state STREQUAL "open" OR final_merged OR final_draft)
      set(${out_error} "pr-title-stale: live PR title, head or open state changed while capturing proof" PARENT_SCOPE)
      return()
    endif()
    pr_live_title_required_context("${number}" "${expected_head}" latest_title_check latest_title_suite
      title_context_error)
    if(title_context_error OR NOT latest_title_check STREQUAL check_run_id OR
       NOT latest_title_suite STREQUAL check_suite_id)
      if(NOT title_context_error)
        set(title_context_error "required-check-stale: selected title run is no longer the current required PR title context")
      endif()
      set(${out_error} "${title_context_error}" PARENT_SCOPE)
      return()
    endif()
    set(${out_proof} "${proof}" PARENT_SCOPE)
    set(${out_error} "" PARENT_SCOPE)
    return()
  set(${out_error} "ci-evidence-missing: no successful PR title proof matches the current live title and head" PARENT_SCOPE)
endfunction()

function(pr_validate_title_binding proof pr_json expected_pr expected_head require_open out_error)
  foreach(pair IN ITEMS
      "number;live_number;NUMBER" "base.ref;base_ref;STRING" "base.repo.full_name;base_repo;STRING"
      "head.sha;live_head;STRING" "title;live_title;STRING" "state;pr_state;STRING"
      "merged;pr_merged;BOOLEAN" "draft;pr_draft;BOOLEAN")
    list(GET pair 0 path)
    list(GET pair 1 value_name)
    list(GET pair 2 expected_type)
    string(REPLACE "." ";" json_path "${path}")
    string(JSON value_type ERROR_VARIABLE type_error TYPE "${pr_json}" ${json_path})
    if(type_error OR NOT value_type STREQUAL expected_type)
      set(${out_error} "pr-title-evidence-missing: live PR ${path} is absent or mistyped" PARENT_SCOPE)
      return()
    endif()
    string(JSON ${value_name} ERROR_VARIABLE value_error GET "${pr_json}" ${json_path})
    if(value_error)
      set(${out_error} "pr-title-evidence-missing: live PR ${path} cannot be read" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  if(NOT live_number STREQUAL expected_pr OR NOT base_ref STREQUAL "main" OR
     NOT base_repo STREQUAL REPOSITORY OR NOT live_head STREQUAL expected_head)
    set(${out_error} "pr-title-evidence-mismatch: current PR repository, number, base or head differs" PARENT_SCOPE)
    return()
  endif()
  if(require_open)
    if(NOT pr_state STREQUAL "open" OR pr_merged OR pr_draft)
      set(${out_error} "pr-title-merge-state: premerge proof requires an open, non-draft PR" PARENT_SCOPE)
      return()
    endif()
  elseif(NOT pr_state STREQUAL "closed" OR NOT pr_merged)
    set(${out_error} "pr-title-merge-state: retained title proof requires its exact merged PR" PARENT_SCOPE)
    return()
  endif()
  if(require_open)
    pr_title_is_conventional("${live_title}" live_title_valid)
    string(SHA256 live_title_sha "${live_title}")
    if(NOT live_title_valid)
      set(${out_error} "pr-title-invalid: current live PR title is invalid" PARENT_SCOPE)
      return()
    endif()
  else()
    # The saved title log is the immutable at-merge proof. A later metadata
    # edit to the closed PR must not replace or invalidate that evidence.
    string(JSON live_title_sha ERROR_VARIABLE title_digest_error GET "${proof}" title_sha256)
    if(title_digest_error)
      set(${out_error} "pr-title-evidence-missing: retained proof lacks its title digest" PARENT_SCOPE)
      return()
    endif()
  endif()
  pr_validate_title_log_file("${proof}" "${expected_pr}" "${expected_head}"
    "${live_title_sha}" proof_error)
  set(${out_error} "${proof_error}" PARENT_SCOPE)
endfunction()

function(pr_validate_title_proof_pair json candidate_pr candidate_head release_pr release_head
    out_candidate out_release out_error)
  string(JSON title_parent_type ERROR_VARIABLE title_parent_error TYPE "${json}" linked_title)
  string(JSON candidate_proof ERROR_VARIABLE candidate_error GET "${json}" linked_title candidate)
  string(JSON release_proof ERROR_VARIABLE release_error GET "${json}" linked_title release_pr)
  if(title_parent_error OR NOT title_parent_type STREQUAL "OBJECT" OR candidate_error OR release_error)
    set(${out_error} "pr-title-evidence-missing: linked_title candidate and release_pr objects are required" PARENT_SCOPE)
    return()
  endif()
  pr_live_pull_request("${candidate_pr}" candidate_pr_json candidate_pr_error)
  if(candidate_pr_error)
    set(${out_error} "${candidate_pr_error}" PARENT_SCOPE)
    return()
  endif()
  pr_validate_title_binding("${candidate_proof}" "${candidate_pr_json}" "${candidate_pr}"
    "${candidate_head}" FALSE candidate_title_error)
  if(candidate_title_error)
    set(${out_error} "${candidate_title_error}" PARENT_SCOPE)
    return()
  endif()
  pr_live_pull_request("${release_pr}" release_pr_json release_pr_error)
  if(release_pr_error)
    set(${out_error} "${release_pr_error}" PARENT_SCOPE)
    return()
  endif()
  pr_validate_title_binding("${release_proof}" "${release_pr_json}" "${release_pr}"
    "${release_head}" FALSE release_title_error)
  if(release_title_error)
    set(${out_error} "${release_title_error}" PARENT_SCOPE)
    return()
  endif()
  set(${out_candidate} "${candidate_proof}" PARENT_SCOPE)
  set(${out_release} "${release_proof}" PARENT_SCOPE)
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(pr_title_requirement out_required)
  if(NOT DEFINED REQUIRE_TITLE_PROOF OR "${REQUIRE_TITLE_PROOF}" STREQUAL "" OR
     "${REQUIRE_TITLE_PROOF}" STREQUAL "OFF")
    set(${out_required} FALSE PARENT_SCOPE)
  elseif("${REQUIRE_TITLE_PROOF}" STREQUAL "ON")
    set(${out_required} TRUE PARENT_SCOPE)
  else()
    message(FATAL_ERROR "REQUIRE_TITLE_PROOF must be ON or OFF")
  endif()
endfunction()

function(pr_title_mode)
  foreach(required IN ITEMS PR_NUMBER OUT)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
      message(FATAL_ERROR "provider_receipt MODE=title requires ${required}")
    endif()
  endforeach()
  foreach(reset_variable IN ITEMS RESET_KIND RESET_BASE RESET_ROUTE RESET_OBSERVE_CHILD)
    if(DEFINED ${reset_variable} AND NOT "${${reset_variable}}" STREQUAL "")
      message(FATAL_ERROR "provider_receipt MODE=title is an ordinary source-bound premerge check and rejects ${reset_variable}")
    endif()
  endforeach()
  if(NOT PR_NUMBER MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "provider_receipt MODE=title requires a positive numeric PR_NUMBER")
  endif()
  get_filename_component(output "${OUT}" ABSOLUTE BASE_DIR "${SOURCE_DIR}")
  set(normal_root "${SOURCE_DIR}/build/phase28-normal")
  file(RELATIVE_PATH output_relative "${normal_root}" "${output}")
  if(IS_ABSOLUTE "${output_relative}" OR output_relative MATCHES "^\\.\\." OR output_relative STREQUAL "")
    message(FATAL_ERROR "provider_receipt MODE=title OUT must be a fresh file under build/phase28-normal")
  endif()
  get_filename_component(output_dir "${output}" DIRECTORY)
  if(IS_SYMLINK "${SOURCE_DIR}/build" OR IS_SYMLINK "${normal_root}" OR IS_SYMLINK "${output_dir}" OR
     EXISTS "${output}" OR IS_SYMLINK "${output}")
    message(FATAL_ERROR "provider_receipt MODE=title refuses a symlinked or existing evidence path")
  endif()
  pr_live_title_proof("${PR_NUMBER}" "" TRUE proof proof_error)
  if(proof_error)
    message(FATAL_ERROR "${proof_error}")
  endif()
  file(MAKE_DIRECTORY "${output_dir}")
  file(WRITE "${output}" "${proof}\n")
  message(STATUS "current PR title proof written to ${output}")
endfunction()

function(pr_json_get_required json path out_value out_error reason)
  string(REPLACE "." ";" parts "${path}")
  string(JSON value ERROR_VARIABLE json_error GET "${json}" ${parts})
  if(json_error)
    set(${out_error} "${reason}: ${path} is absent or malformed: ${json_error}" PARENT_SCOPE)
  else()
    set(${out_value} "${value}" PARENT_SCOPE)
    set(${out_error} "" PARENT_SCOPE)
  endif()
endfunction()

function(pr_open_release_pr_list_entry prs_json index expected_base out_match out_pr out_head out_tested_merge out_error)
  set(${out_match} FALSE PARENT_SCOPE)
  set(${out_pr} "" PARENT_SCOPE)
  set(${out_head} "" PARENT_SCOPE)
  set(${out_tested_merge} "" PARENT_SCOPE)
  set(${out_error} "" PARENT_SCOPE)
  string(JSON title_type ERROR_VARIABLE title_type_error TYPE "${prs_json}" ${index} title)
  if(title_type_error OR NOT title_type STREQUAL "STRING")
    return()
  endif()
  string(JSON title GET "${prs_json}" ${index} title)
  if(NOT title MATCHES "^chore[(]main[)]: release ")
    return()
  endif()

  string(JSON ref_type ERROR_VARIABLE ref_type_error TYPE "${prs_json}" ${index} head ref)
  string(JSON base_type ERROR_VARIABLE base_type_error TYPE "${prs_json}" ${index} base sha)
  if(ref_type_error OR NOT ref_type STREQUAL "STRING" OR
     base_type_error OR NOT base_type STREQUAL "STRING")
    set(${out_error} "release-pr-tested-merge-missing: matching release PR lacks a typed head ref or base SHA" PARENT_SCOPE)
    return()
  endif()
  string(JSON head_ref GET "${prs_json}" ${index} head ref)
  string(JSON base_sha GET "${prs_json}" ${index} base sha)
  if(NOT head_ref STREQUAL "release-please--branches--main" OR NOT base_sha STREQUAL expected_base)
    return()
  endif()

  foreach(pair IN ITEMS
      "number;pr_number;NUMBER" "state;pr_state;STRING"
      "head.sha;pr_head;STRING" "merge_commit_sha;pr_tested_merge;STRING")
    list(GET pair 0 path)
    list(GET pair 1 value_name)
    list(GET pair 2 expected_type)
    string(REPLACE "." ";" json_path "${path}")
    string(JSON value_type ERROR_VARIABLE type_error TYPE "${prs_json}" ${index} ${json_path})
    if(type_error OR NOT value_type STREQUAL expected_type)
      set(${out_error} "release-pr-tested-merge-missing: matching release PR field ${path} is absent or mistyped" PARENT_SCOPE)
      return()
    endif()
    string(JSON ${value_name} ERROR_VARIABLE value_error GET "${prs_json}" ${index} ${json_path})
    if(value_error)
      set(${out_error} "release-pr-tested-merge-missing: matching release PR field ${path} cannot be read" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  string(JSON merged_at_type ERROR_VARIABLE merged_at_error TYPE "${prs_json}" ${index} merged_at)
  if(merged_at_error OR NOT merged_at_type STREQUAL "NULL")
    set(${out_error} "release-pr-tested-merge-missing: matching release PR must have JSON NULL merged_at" PARENT_SCOPE)
    return()
  endif()
  if(NOT pr_number MATCHES "^[1-9][0-9]*$" OR NOT pr_state STREQUAL "open")
    set(${out_error} "release-pr-tested-merge-missing: matching release PR is not open" PARENT_SCOPE)
    return()
  endif()
  pr_commit_valid("${pr_head}" head_valid)
  pr_commit_valid("${pr_tested_merge}" tested_merge_valid)
  if(NOT head_valid OR NOT tested_merge_valid)
    set(${out_error} "release-pr-tested-merge-missing: matching release PR head or tested merge SHA is malformed" PARENT_SCOPE)
    return()
  endif()
  set(${out_match} TRUE PARENT_SCOPE)
  set(${out_pr} "${pr_number}" PARENT_SCOPE)
  set(${out_head} "${pr_head}" PARENT_SCOPE)
  set(${out_tested_merge} "${pr_tested_merge}" PARENT_SCOPE)
endfunction()

function(pr_expect_release_pr_list_rejected label prs_json expected_base)
  pr_open_release_pr_list_entry("${prs_json}" 0 "${expected_base}" matched number head tested_merge error)
  if(NOT error MATCHES "^release-pr-tested-merge-missing:")
    message(FATAL_ERROR "Release Please list control ${label} was not rejected correctly: ${error}/${matched}")
  endif()
endfunction()

function(pr_release_pr_list_controls)
  set(expected_base "49e0065f73768cf8a3969d6430fad30beb62121b")
  set(head "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
  set(tested_merge "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")
  set(valid "[{\"number\":67,\"title\":\"chore(main): release 0.1.13\",\"state\":\"open\",\"merged_at\":null,\"head\":{\"ref\":\"release-please--branches--main\",\"sha\":\"${head}\"},\"base\":{\"sha\":\"${expected_base}\"},\"merge_commit_sha\":\"${tested_merge}\"}]")
  pr_open_release_pr_list_entry("${valid}" 0 "${expected_base}" matched number parsed_head parsed_merge error)
  if(error OR NOT matched OR NOT number STREQUAL "67" OR
     NOT parsed_head STREQUAL head OR NOT parsed_merge STREQUAL tested_merge)
    message(FATAL_ERROR "Release Please list positive control failed: ${error}/${matched}/${number}")
  endif()

  string(JSON missing_merged_at REMOVE "${valid}" 0 merged_at)
  pr_expect_release_pr_list_rejected("missing merged_at" "${missing_merged_at}" "${expected_base}")
  string(JSON typed_merged_at SET "${valid}" 0 merged_at "\"2026-11-11T22:00:00Z\"")
  pr_expect_release_pr_list_rejected("string merged_at" "${typed_merged_at}" "${expected_base}")
  string(JSON closed SET "${valid}" 0 state "\"closed\"")
  pr_expect_release_pr_list_rejected("closed PR" "${closed}" "${expected_base}")
  string(JSON missing_head REMOVE "${valid}" 0 head sha)
  pr_expect_release_pr_list_rejected("missing head SHA" "${missing_head}" "${expected_base}")
  string(JSON missing_tested_merge REMOVE "${valid}" 0 merge_commit_sha)
  pr_expect_release_pr_list_rejected("missing tested merge SHA" "${missing_tested_merge}" "${expected_base}")
endfunction()

function(pr_hosted_stage stage)
  if(DEFINED RESET_KIND AND RESET_KIND MATCHES "^(d44-evidence-v1|d45-controls-v1|d46-observer-v1|d51-receipt-v1)$" AND
     stage MATCHES "^(candidate|main)$")
    foreach(required IN ITEMS RESET_BASE RESET_ROUTE ACCEPTANCE ACCEPTANCE_MARKDOWN)
      if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "D-44 hosted validation requires ${required}")
      endif()
    endforeach()
    pr_reset_load(route)
    string(JSON admitted_stage ERROR_VARIABLE admitted_stage_error GET "${route}" stages "${stage}" status)
    if(admitted_stage_error OR NOT admitted_stage STREQUAL "running")
      message(FATAL_ERROR "reset-stage: D-44 hosted validation requires the admitted running intent")
    endif()
  endif()
  if(NOT DEFINED RELEASE_EVIDENCE OR RELEASE_EVIDENCE STREQUAL "")
    message(FATAL_ERROR "provider_receipt MODE=hosted requires RELEASE_EVIDENCE")
  endif()
  get_filename_component(RELEASE_EVIDENCE "${RELEASE_EVIDENCE}" ABSOLUTE BASE_DIR "${SOURCE_DIR}")
  if(NOT EXISTS "${RELEASE_EVIDENCE}")
    message(FATAL_ERROR "hosted release evidence file is missing: ${RELEASE_EVIDENCE}")
  endif()
  file(READ "${RELEASE_EVIDENCE}" evidence)
  string(JSON schema ERROR_VARIABLE schema_error GET "${evidence}" schema_version)
  if(schema_error OR NOT schema EQUAL 1)
    message(FATAL_ERROR "hosted release evidence schema_version must be 1: ${schema_error}")
  endif()
  pr_live_required_contexts(required_contexts ruleset_error)
  if(ruleset_error)
    message(FATAL_ERROR "${ruleset_error}")
  endif()
  set(normal_title_path FALSE)
  if((NOT DEFINED RESET_KIND OR RESET_KIND STREQUAL "") AND
     (RESET_OBSERVE_CHILD OR REQUIRE_TITLE_PROOF))
    set(normal_title_path TRUE)
    pr_title_context_required("${required_contexts}" title_context_error)
    if(title_context_error)
      message(FATAL_ERROR "${title_context_error}")
    endif()
  endif()

  if(stage STREQUAL "candidate")
    pr_json_get_required("${evidence}" "local_candidate.commit" local_commit evidence_error "local-candidate-missing")
    pr_json_get_required("${evidence}" "local_candidate.tree_sha" local_tree evidence_error "local-candidate-missing")
    pr_json_get_required("${evidence}" "local_candidate.input_manifest_sha256" accepted_manifest evidence_error "local-candidate-missing")
    pr_json_get_required("${evidence}" "candidate.pr_number" pr_number evidence_error "candidate-identity-missing")
    pr_json_get_required("${evidence}" "candidate.head_sha" expected_head evidence_error "candidate-identity-missing")
    if(evidence_error)
      message(FATAL_ERROR "${evidence_error}")
    endif()
    pr_commit_valid("${local_commit}" local_commit_valid)
    pr_commit_valid("${local_tree}" local_tree_valid)
    pr_commit_valid("${expected_head}" candidate_head_valid)
    pr_digest_valid("${accepted_manifest}" accepted_manifest_valid)
    if(NOT local_commit_valid OR NOT candidate_head_valid OR NOT accepted_manifest_valid OR
       NOT local_tree_valid)
      message(FATAL_ERROR "local-candidate-mismatch: local source/tree/input-manifest identity is malformed")
    endif()
    execute_process(COMMAND git -C "${SOURCE_DIR}" rev-parse "${local_commit}^{tree}"
      RESULT_VARIABLE local_tree_result OUTPUT_VARIABLE actual_local_tree ERROR_VARIABLE local_tree_error TIMEOUT 10)
    string(STRIP "${actual_local_tree}" actual_local_tree)
    execute_process(COMMAND git -C "${SOURCE_DIR}" rev-parse HEAD
      RESULT_VARIABLE candidate_head_result OUTPUT_VARIABLE checkout_head ERROR_VARIABLE checkout_head_error TIMEOUT 10)
    string(STRIP "${checkout_head}" checkout_head)
    pr_local_manifest("${SOURCE_DIR}" current_paths current_manifest current_manifest_sha manifest_error)
    if(NOT local_tree_result STREQUAL "0" OR NOT candidate_head_result STREQUAL "0" OR manifest_error OR
       NOT actual_local_tree STREQUAL local_tree OR NOT checkout_head STREQUAL expected_head OR
       NOT current_manifest_sha STREQUAL accepted_manifest)
      message(FATAL_ERROR "local-candidate-mismatch: exact PR checkout, accepted source tree or frozen input manifest differs: ${local_tree_error}${checkout_head_error}${manifest_error}")
    endif()
    pr_live_pull_request("${pr_number}" pr_json pr_error)
    if(pr_error)
      message(FATAL_ERROR "${pr_error}")
    endif()
    pr_json_get_required("${pr_json}" "base.ref" base_ref pr_error "pull-request-missing")
    pr_json_get_required("${pr_json}" "head.sha" live_head pr_error "pull-request-missing")
    pr_json_get_required("${pr_json}" "state" pr_state pr_error "pull-request-missing")
    pr_json_get_required("${pr_json}" "draft" is_draft pr_error "pull-request-missing")
    pr_json_get_required("${pr_json}" "merge_commit_sha" tested_merge pr_error "pull-request-missing")
    if(pr_error OR NOT base_ref STREQUAL "main" OR NOT pr_state STREQUAL "open" OR is_draft)
      message(FATAL_ERROR "candidate PR is missing, closed, draft, or not targeting main: ${pr_error}${base_ref}/${pr_state}/${is_draft}")
    endif()
    if(NOT live_head STREQUAL expected_head)
      message(FATAL_ERROR "candidate-head-mismatch: PR ${pr_number} is ${live_head}, evidence expects ${expected_head}")
    endif()
    pr_commit_valid("${tested_merge}" tested_merge_valid)
    if(NOT tested_merge_valid)
      message(FATAL_ERROR "candidate-tested-merge-missing: PR ${pr_number} has no current tested merge SHA")
    endif()
    pr_live_check_context("${expected_head}" "CI required" required_error)
    if(required_error)
      message(FATAL_ERROR "${required_error}")
    endif()
    pr_live_run_record(".github/workflows/ci.yml" "CI" "pull_request" "${expected_head}"
      "${tested_merge}" "${pr_number}" "${required_contexts}" run_record run_error)
    if(run_error)
      message(FATAL_ERROR "${run_error}")
    endif()
    pr_validate_run_evidence("${run_record}" candidate "${expected_head}" "CI"
      ".github/workflows/ci.yml" "pull_request" "${pr_number}" run_error)
    if(run_error)
      message(FATAL_ERROR "${run_error}")
    endif()
    if(normal_title_path)
      pr_live_title_proof("${pr_number}" "${expected_head}" TRUE candidate_title_proof title_error)
      if(title_error)
        message(FATAL_ERROR "${title_error}")
      endif()
      string(JSON title_parent_type ERROR_VARIABLE title_parent_error TYPE "${evidence}" linked_title)
      if(title_parent_error OR NOT title_parent_type STREQUAL "OBJECT")
        message(FATAL_ERROR "hosted title evidence requires the preinitialized linked_title object")
      endif()
      pr_json_set("${evidence}" "linked_title.candidate" "${candidate_title_proof}" evidence)
    endif()
    pr_json_set("${evidence}" "candidate.tested_merge_sha" "\"${tested_merge}\"" evidence)
    pr_json_set("${evidence}" "linked_ci.exact_candidate" "${run_record}" evidence)
  elseif(stage STREQUAL "main")
    pr_json_get_required("${evidence}" "candidate.pr_number" pr_number evidence_error "candidate-evidence-missing")
    pr_json_get_required("${evidence}" "candidate.head_sha" expected_candidate_head evidence_error "candidate-evidence-missing")
    pr_json_get_required("${evidence}" "candidate.tested_merge_sha" recorded_merge evidence_error "candidate-evidence-missing")
    if(evidence_error)
      message(FATAL_ERROR "${evidence_error}")
    endif()
    pr_live_pull_request("${pr_number}" pr_json pr_error)
    if(pr_error)
      message(FATAL_ERROR "${pr_error}")
    endif()
    pr_json_get_required("${pr_json}" "state" pr_state pr_error "candidate-merge-missing")
    pr_json_get_required("${pr_json}" "merged" merged pr_error "candidate-merge-missing")
    pr_json_get_required("${pr_json}" "head.sha" actual_head pr_error "candidate-merge-missing")
    pr_json_get_required("${pr_json}" "merge_commit_sha" main_sha pr_error "candidate-merge-missing")
    if(pr_error OR NOT merged OR NOT actual_head STREQUAL expected_candidate_head)
      message(FATAL_ERROR "candidate-merge-missing: PR ${pr_number} is not merged with recorded head ${expected_candidate_head}: ${pr_error}")
    endif()
    if(normal_title_path)
      string(JSON candidate_title_proof ERROR_VARIABLE title_proof_error GET "${evidence}" linked_title candidate)
      if(title_proof_error)
        message(FATAL_ERROR "pr-title-evidence-missing: candidate proof was not captured before its merge")
      endif()
      pr_validate_title_binding("${candidate_title_proof}" "${pr_json}" "${pr_number}"
        "${expected_candidate_head}" FALSE title_binding_error)
      if(title_binding_error)
        message(FATAL_ERROR "${title_binding_error}")
      endif()
    endif()
    pr_commit_valid("${main_sha}" main_sha_valid)
    if(NOT main_sha_valid)
      message(FATAL_ERROR "implementation-main-identity-mismatch: merged PR has no full resulting-main commit")
    endif()

    # Capture the Release Please PR while it is still open, so its synthetic
    # tested merge remains distinct from the final release-source merge commit.
    pr_gh_api("repos/${REPOSITORY}/pulls?state=all&base=main&per_page=100" prs_json prs_error)
    if(prs_error)
      message(FATAL_ERROR "release-pr-missing: ${prs_error}")
    endif()
    string(JSON pr_count ERROR_VARIABLE pr_count_error LENGTH "${prs_json}")
    if(NOT pr_count_error AND pr_count GREATER 0)
      math(EXPR last_pr "${pr_count} - 1")
      foreach(index RANGE 0 ${last_pr})
        pr_open_release_pr_list_entry("${prs_json}" "${index}" "${main_sha}"
          release_pr_match early_release_pr early_release_head early_release_merge release_pr_error)
        if(release_pr_error)
          message(FATAL_ERROR "${release_pr_error}")
        endif()
        if(release_pr_match)
          if(normal_title_path)
            pr_live_title_proof("${early_release_pr}" "${early_release_head}" TRUE
              release_pr_title_proof title_error)
            if(title_error)
              message(FATAL_ERROR "${title_error}")
            endif()
            string(JSON title_parent_type ERROR_VARIABLE title_parent_error TYPE "${evidence}" linked_title)
            if(title_parent_error OR NOT title_parent_type STREQUAL "OBJECT")
              message(FATAL_ERROR "hosted title evidence requires the preinitialized linked_title object")
            endif()
            pr_json_set("${evidence}" "linked_title.release_pr" "${release_pr_title_proof}" evidence)
          endif()
          pr_json_set("${evidence}" "release.release_pr_number" "${early_release_pr}" evidence)
          pr_json_set("${evidence}" "release.release_pr_head_sha" "\"${early_release_head}\"" evidence)
          pr_json_set("${evidence}" "release.release_pr_tested_merge_sha" "\"${early_release_merge}\"" evidence)
          file(WRITE "${RELEASE_EVIDENCE}" "${evidence}\n")
          break()
        endif()
      endforeach()
    endif()
    if(normal_title_path)
      string(JSON release_title_proof ERROR_VARIABLE title_proof_error GET "${evidence}" linked_title release_pr)
      if(title_proof_error)
        message(FATAL_ERROR "release-pr-missing: no exact live Release Please PR title proof was captured before merge")
      endif()
    endif()
    pr_live_check_context("${main_sha}" "CI required" required_error)
    if(required_error)
      message(FATAL_ERROR "${required_error}")
    endif()
    pr_live_run_record(".github/workflows/ci.yml" "CI" "push" "${main_sha}"
      "${main_sha}" "" "${required_contexts}" run_record run_error)
    if(run_error)
      message(FATAL_ERROR "${run_error}")
    endif()
    pr_validate_run_evidence("${run_record}" main "${main_sha}" "CI"
      ".github/workflows/ci.yml" "push" "" run_error)
    if(run_error)
      message(FATAL_ERROR "${run_error}")
    endif()
    pr_json_set("${evidence}" "main.head_sha" "\"${main_sha}\"" evidence)
    pr_json_set("${evidence}" "linked_ci.main" "${run_record}" evidence)
  elseif(stage STREQUAL "release")
    pr_json_get_required("${evidence}" "main.head_sha" implementation_main evidence_error "main-evidence-missing")
    pr_json_get_required("${evidence}" "release.release_pr_number" release_pr_number evidence_error "release-pr-tested-merge-missing")
    pr_json_get_required("${evidence}" "release.release_pr_head_sha" release_pr_head evidence_error "release-pr-tested-merge-missing")
    pr_json_get_required("${evidence}" "release.release_pr_tested_merge_sha" release_pr_merge evidence_error "release-pr-tested-merge-missing")
    if(evidence_error)
      message(FATAL_ERROR "${evidence_error}")
    endif()
    pr_live_pull_request("${release_pr_number}" release_pr_json pr_error)
    if(pr_error)
      message(FATAL_ERROR "${pr_error}")
    endif()
    pr_json_get_required("${release_pr_json}" "state" release_pr_state pr_error "release-pr-missing")
    pr_json_get_required("${release_pr_json}" "merged" release_pr_merged pr_error "release-pr-missing")
    pr_json_get_required("${release_pr_json}" "draft" release_pr_draft pr_error "release-pr-missing")
    pr_json_get_required("${release_pr_json}" "head.sha" actual_release_pr_head pr_error "release-pr-missing")
    pr_json_get_required("${release_pr_json}" "merge_commit_sha" release_source pr_error "release-pr-missing")
    if(pr_error OR NOT release_pr_state STREQUAL "closed" OR NOT release_pr_merged OR release_pr_draft OR
       NOT actual_release_pr_head STREQUAL release_pr_head)
      message(FATAL_ERROR "release-pr-missing: configured Release Please PR is not merged at the recorded exact head: ${pr_error}")
    endif()
    pr_commit_valid("${release_pr_merge}" release_pr_tested_merge_valid)
    pr_commit_valid("${release_source}" release_source_valid)
    if(NOT release_pr_tested_merge_valid OR NOT release_source_valid)
      message(FATAL_ERROR "release-source-missing: tested merge or resulting release source is malformed")
    endif()
    if(normal_title_path)
      string(JSON candidate_pr_number ERROR_VARIABLE candidate_number_error GET "${evidence}" candidate pr_number)
      string(JSON candidate_pr_head ERROR_VARIABLE candidate_head_error GET "${evidence}" candidate head_sha)
      string(JSON candidate_title_proof ERROR_VARIABLE candidate_title_error GET "${evidence}" linked_title candidate)
      string(JSON release_title_proof ERROR_VARIABLE release_title_error GET "${evidence}" linked_title release_pr)
      if(candidate_number_error OR candidate_head_error OR candidate_title_error OR release_title_error)
        message(FATAL_ERROR "pr-title-evidence-missing: retained premerge title proof is absent")
      endif()
      pr_live_pull_request("${candidate_pr_number}" candidate_pr_json candidate_pr_error)
      if(candidate_pr_error)
        message(FATAL_ERROR "${candidate_pr_error}")
      endif()
      pr_validate_title_binding("${candidate_title_proof}" "${candidate_pr_json}"
        "${candidate_pr_number}" "${candidate_pr_head}" FALSE title_binding_error)
      if(title_binding_error)
        message(FATAL_ERROR "${title_binding_error}")
      endif()
      pr_validate_title_binding("${release_title_proof}" "${release_pr_json}"
        "${release_pr_number}" "${release_pr_head}" FALSE title_binding_error)
      if(title_binding_error)
        message(FATAL_ERROR "${title_binding_error}")
      endif()
    endif()
    pr_live_check_context("${release_pr_head}" "CI required" required_error)
    if(required_error)
      message(FATAL_ERROR "${required_error}")
    endif()
    pr_live_run_record(".github/workflows/ci.yml" "CI" "pull_request" "${release_pr_head}"
      "${release_pr_merge}" "${release_pr_number}" "${required_contexts}" release_pr_run release_pr_error)
    if(release_pr_error)
      message(FATAL_ERROR "${release_pr_error}")
    endif()
    pr_validate_run_evidence("${release_pr_run}" release_pr "${release_pr_head}" "CI"
      ".github/workflows/ci.yml" "pull_request" "${release_pr_number}" release_pr_error)
    if(release_pr_error)
      message(FATAL_ERROR "${release_pr_error}")
    endif()
    pr_live_check_context("${release_source}" "ci / CI required" release_context_error)
    if(release_context_error)
      message(FATAL_ERROR "${release_context_error}")
    endif()
    pr_live_run_record(".github/workflows/release.yml" "Release" "push" "${release_source}"
      "${release_source}" "" "${required_contexts}" release_run release_run_error)
    if(release_run_error)
      message(FATAL_ERROR "${release_run_error}")
    endif()
    pr_validate_run_evidence("${release_run}" release_source "${release_source}" "Release"
      ".github/workflows/release.yml" "push" "" release_run_error)
    if(release_run_error)
      message(FATAL_ERROR "${release_run_error}")
    endif()
    # Find the actual published release by dereferencing its tag to the observed
    # Release Please merge commit. Do not predict or select the next version.
    pr_gh_api("repos/${REPOSITORY}/releases?per_page=100" releases_json releases_error)
    if(releases_error)
      message(FATAL_ERROR "release-publication-missing: ${releases_error}")
    endif()
    string(JSON release_count ERROR_VARIABLE release_count_error LENGTH "${releases_json}")
    if(release_count_error)
      message(FATAL_ERROR "release-publication-missing: malformed releases response: ${release_count_error}")
    endif()
    set(observed_tag "")
    set(release_json "")
    if(release_count GREATER 0)
      math(EXPR last_release "${release_count} - 1")
      foreach(index RANGE 0 ${last_release})
        string(JSON candidate_tag ERROR_VARIABLE candidate_tag_error GET "${releases_json}" ${index} tag_name)
        string(JSON candidate_draft ERROR_VARIABLE candidate_draft_error GET "${releases_json}" ${index} draft)
        if(candidate_tag_error OR candidate_draft_error OR candidate_draft)
          continue()
        endif()
        pr_gh_api("repos/${REPOSITORY}/git/ref/tags/${candidate_tag}" candidate_ref ref_error)
        if(ref_error)
          continue()
        endif()
        string(JSON candidate_type ERROR_VARIABLE candidate_type_error GET "${candidate_ref}" object type)
        string(JSON candidate_sha ERROR_VARIABLE candidate_sha_error GET "${candidate_ref}" object sha)
        if(candidate_type_error OR candidate_sha_error)
          continue()
        endif()
        if(candidate_type STREQUAL "tag")
          pr_gh_api("repos/${REPOSITORY}/git/tags/${candidate_sha}" candidate_tag_object tag_object_error)
          if(tag_object_error)
            continue()
          endif()
          string(JSON candidate_type ERROR_VARIABLE candidate_type_error GET "${candidate_tag_object}" object type)
          string(JSON candidate_sha ERROR_VARIABLE candidate_sha_error GET "${candidate_tag_object}" object sha)
        endif()
        if(NOT candidate_type_error AND NOT candidate_sha_error AND candidate_type STREQUAL "commit" AND candidate_sha STREQUAL release_source)
          set(observed_tag "${candidate_tag}")
          string(JSON release_json GET "${releases_json}" ${index})
          set(release_source "${candidate_sha}")
          break()
        endif()
      endforeach()
    endif()
    if(observed_tag STREQUAL "")
      message(FATAL_ERROR "release-publication-missing: no non-draft published tag resolves to release source ${release_source}")
    endif()
    pr_gh_api("repos/${REPOSITORY}/compare/${implementation_main}...${release_source}" version_delta version_delta_error)
    if(version_delta_error)
      message(FATAL_ERROR "release-source-mismatch: cannot compare implementation-main with release source: ${version_delta_error}")
    endif()
    string(JSON compare_status ERROR_VARIABLE compare_status_error GET "${version_delta}" status)
    string(JSON changed_count ERROR_VARIABLE changed_count_error LENGTH "${version_delta}" files)
    if(compare_status_error OR changed_count_error OR NOT compare_status STREQUAL "ahead")
      message(FATAL_ERROR "release-source-mismatch: release source is not a clean forward version-only delta from implementation-main")
    endif()
    set(version_delta_names "[]")
    set(allowed_version_files
      CHANGELOG.md .release-please-manifest.json README.md version.txt
      include/nesturbator.h libretro/nesturbator_libretro.info)
    if(changed_count GREATER 0)
      math(EXPR last_changed "${changed_count} - 1")
      foreach(index RANGE 0 ${last_changed})
        string(JSON changed_path ERROR_VARIABLE changed_path_error GET "${version_delta}" files ${index} filename)
        if(changed_path_error)
          message(FATAL_ERROR "release-source-mismatch: release diff has a malformed filename")
        endif()
        list(FIND allowed_version_files "${changed_path}" allowed_index)
        if(allowed_index LESS 0)
          message(FATAL_ERROR "release-source-mismatch: release PR changed non-version file ${changed_path}; requalify that substantive delta")
        endif()
        string(JSON name_count LENGTH "${version_delta_names}")
        string(JSON version_delta_names SET "${version_delta_names}" ${name_count} "\"${changed_path}\"")
      endforeach()
    else()
      message(FATAL_ERROR "release-source-mismatch: Release Please source has no version or changelog delta")
    endif()
    pr_gh_api_raw("repos/${REPOSITORY}/contents/version.txt?ref=${release_source}" source_version_content version_file_error)
    if(version_file_error)
      message(FATAL_ERROR "metadata-mismatch: cannot read release-source version.txt: ${version_file_error}")
    endif()
    string(JSON tag_name GET "${release_json}" tag_name)
    string(JSON draft GET "${release_json}" draft)
    string(JSON published_at ERROR_VARIABLE published_error GET "${release_json}" published_at)
    string(JSON html_url GET "${release_json}" html_url)
    set(publication "{}")
    string(JSON publication SET "${publication}" tagName "\"${tag_name}\"")
    string(JSON publication SET "${publication}" isDraft "${draft}")
    string(JSON publication SET "${publication}" publishedAt "\"${published_at}\"")
    string(JSON publication SET "${publication}" url "\"${html_url}\"")
    string(REGEX REPLACE "^v" "" observed_version "${observed_tag}")
    if(NOT source_version_content STREQUAL observed_version)
      message(FATAL_ERROR "metadata-mismatch: published tag ${observed_tag} differs from release-source version.txt ${source_version_content}")
    endif()
    pr_validate_publication_metadata("${publication}" "${observed_tag}" "${release_source}"
      "${observed_version}" "${release_source}" "${observed_version}" publication_error)
    if(publication_error)
      message(FATAL_ERROR "${publication_error}")
    endif()
    pr_json_set("${evidence}" "release.implementation_main_commit" "\"${implementation_main}\"" evidence)
    pr_json_set("${evidence}" "release.release_pr_number" "${release_pr_number}" evidence)
    pr_json_set("${evidence}" "release.release_pr_head_sha" "\"${release_pr_head}\"" evidence)
    pr_json_set("${evidence}" "release.release_pr_tested_merge_sha" "\"${release_pr_merge}\"" evidence)
    pr_json_set("${evidence}" "release.source_commit" "\"${release_source}\"" evidence)
    pr_json_set("${evidence}" "release.tag" "\"${observed_tag}\"" evidence)
    pr_json_set("${evidence}" "release.version" "\"${observed_version}\"" evidence)
    pr_json_set("${evidence}" "release.url" "\"${html_url}\"" evidence)
    pr_json_set("${evidence}" "release.published_at" "\"${published_at}\"" evidence)
    pr_json_set("${evidence}" "release.is_draft" "false" evidence)
    pr_json_set("${evidence}" "release.version_delta_files" "${version_delta_names}" evidence)
    pr_json_set("${evidence}" "linked_ci.release_pr" "${release_pr_run}" evidence)
    pr_json_set("${evidence}" "linked_ci.release_source" "${release_run}" evidence)
  else()
    message(FATAL_ERROR "STAGE must be candidate, main or release")
  endif()
  file(WRITE "${RELEASE_EVIDENCE}" "${evidence}\n")
  message(STATUS "hosted ${stage} evidence passed; updated ${RELEASE_EVIDENCE}")
endfunction()

function(pr_expected_archives version out_names)
  set(names)
  foreach(component IN ITEMS library runner libretro)
    foreach(os IN ITEMS linux macos windows)
      foreach(arch IN ITEMS x64 arm64)
        list(APPEND names "nesturbator-${version}-${component}-${os}-${arch}.zip")
      endforeach()
    endforeach()
  endforeach()
  list(SORT names)
  set(${out_names} "${names}" PARENT_SCOPE)
endfunction()

function(pr_map_host_arch processor out_arch out_error)
  if(processor MATCHES "^(arm64|aarch64|ARM64)$")
    set(${out_arch} arm64 PARENT_SCOPE)
    set(${out_error} "" PARENT_SCOPE)
  elseif(processor MATCHES "^(x86_64|AMD64|x64)$")
    set(${out_arch} x64 PARENT_SCOPE)
    set(${out_error} "" PARENT_SCOPE)
  else()
    set(${out_arch} "" PARENT_SCOPE)
    set(${out_error} "native published-package replay has no mapped architecture for ${processor}" PARENT_SCOPE)
  endif()
endfunction()

function(pr_validate_structure json expected_tag expected_source expected_version
    expected_profile expected_guide expected_scenario expected_abi expected_behaviour
    expected_state expected_candidate require_verified out_error)
  set(${out_error} "" PARENT_SCOPE)
  string(JSON schema_type ERROR_VARIABLE schema_error TYPE "${json}" schema_version)
  if(schema_error)
    set(${out_error} "receipt-missing: ${schema_error}" PARENT_SCOPE)
    return()
  endif()
  if(NOT schema_type STREQUAL "NUMBER")
    set(${out_error} "receipt-schema: expected JSON type NUMBER for schema_version, found ${schema_type}" PARENT_SCOPE)
    return()
  endif()
  string(JSON schema ERROR_VARIABLE schema_error GET "${json}" schema_version)
  if(schema_error)
    set(${out_error} "receipt-missing: ${schema_error}" PARENT_SCOPE)
    return()
  endif()
  if(NOT schema STREQUAL "2")
    set(${out_error} "receipt-schema: expected 2, found ${schema}" PARENT_SCOPE)
    return()
  endif()
  pr_expect("${json}" "receipt_kind" "published-package" receipt-kind mismatch)
  if(mismatch)
    set(${out_error} "${mismatch}" PARENT_SCOPE)
    return()
  endif()
  string(JSON fixture_type ERROR_VARIABLE fixture_error TYPE "${json}" fixture_kind)
  if(NOT fixture_error)
    if(NOT fixture_type STREQUAL "STRING")
      set(${out_error} "receipt-type: expected JSON type STRING for fixture_kind, found ${fixture_type}" PARENT_SCOPE)
      return()
    endif()
    string(JSON fixture_kind GET "${json}" fixture_kind)
    if(require_verified AND NOT fixture_kind STREQUAL "")
      set(${out_error} "synthetic-fixture: fixture receipts cannot qualify a published package" PARENT_SCOPE)
      return()
    endif()
  endif()
  pr_expect("${json}" "release.tag" "${expected_tag}" tag-mismatch mismatch)
  if(mismatch)
    set(${out_error} "${mismatch}" PARENT_SCOPE)
    return()
  endif()
  pr_expect_boolean("${json}" "release.is_draft" "false" draft-release mismatch)
  if(mismatch)
    set(${out_error} "${mismatch}" PARENT_SCOPE)
    return()
  endif()
  pr_expect("${json}" "release.source_commit" "${expected_source}" source-mismatch mismatch)
  if(mismatch)
    set(${out_error} "${mismatch}" PARENT_SCOPE)
    return()
  endif()
  pr_expect("${json}" "release.version" "${expected_version}" metadata-mismatch mismatch)
  if(mismatch)
    set(${out_error} "${mismatch}" PARENT_SCOPE)
    return()
  endif()
  pr_expect("${json}" "inputs.profile_sha256" "${expected_profile}" profile-mismatch mismatch)
  if(mismatch)
    set(${out_error} "${mismatch}" PARENT_SCOPE)
    return()
  endif()
  pr_expect("${json}" "inputs.guide_sha256" "${expected_guide}" scenario-mismatch mismatch)
  if(mismatch)
    set(${out_error} "${mismatch}" PARENT_SCOPE)
    return()
  endif()
  pr_expect("${json}" "inputs.rom_sha256" "${expected_scenario}" scenario-mismatch mismatch)
  if(mismatch)
    set(${out_error} "${mismatch}" PARENT_SCOPE)
    return()
  endif()
  pr_validate_rights_structure("${json}" "${expected_scenario}" rights_error)
  if(rights_error)
    set(${out_error} "${rights_error}" PARENT_SCOPE)
    return()
  endif()
  foreach(pair IN ITEMS
      "compatibility.abi;${expected_abi}"
      "compatibility.behaviour_revision;${expected_behaviour}"
      "compatibility.state_format;${expected_state}")
    list(GET pair 0 field)
    list(GET pair 1 expected)
    pr_expect("${json}" "${field}" "${expected}" metadata-mismatch mismatch)
    if(mismatch)
      set(${out_error} "${mismatch}" PARENT_SCOPE)
      return()
    endif()
  endforeach()

  pr_expected_archives("${expected_version}" expected_names)
  string(JSON assets_type ERROR_VARIABLE type_error TYPE "${json}" release assets)
  if(type_error OR NOT assets_type STREQUAL "ARRAY")
    set(${out_error} "collection-type: release.assets must be JSON ARRAY, found ${assets_type}${type_error}" PARENT_SCOPE)
    return()
  endif()
  string(JSON asset_count ERROR_VARIABLE read_error LENGTH "${json}" release assets)
  if(read_error OR NOT asset_count EQUAL 19)
    set(${out_error} "asset-inventory-mismatch: expected 18 archives and SHA256SUMS" PARENT_SCOPE)
    return()
  endif()
  # Read collection subtrees once; per-entry checks need no unrelated CI data.
  string(JSON receipt_assets GET "${json}" release assets)
  set(actual_assets)
  set(sum_size 0)
  math(EXPR last_asset "${asset_count} - 1")
  foreach(index RANGE 0 ${last_asset})
    string(JSON asset_type ERROR_VARIABLE element_type_error TYPE "${receipt_assets}" ${index})
    if(element_type_error OR NOT asset_type STREQUAL "OBJECT")
      set(${out_error} "collection-element-type: release.assets[${index}] must be JSON OBJECT, found ${asset_type}${element_type_error}" PARENT_SCOPE)
      return()
    endif()
    string(JSON name_type ERROR_VARIABLE name_type_error TYPE "${receipt_assets}" ${index} name)
    string(JSON size_type ERROR_VARIABLE size_type_error TYPE "${receipt_assets}" ${index} size)
    if(name_type_error OR size_type_error)
      set(${out_error} "asset-inventory-mismatch: missing asset name or size" PARENT_SCOPE)
      return()
    elseif(NOT name_type STREQUAL "STRING" OR NOT size_type STREQUAL "NUMBER")
      set(${out_error} "asset-inventory-mismatch: asset name and size must be JSON STRING and NUMBER" PARENT_SCOPE)
      return()
    endif()
    string(JSON name ERROR_VARIABLE read_error GET "${receipt_assets}" ${index} name)
    string(JSON size ERROR_VARIABLE size_error GET "${receipt_assets}" ${index} size)
    if(read_error OR size_error OR size LESS 1)
      set(${out_error} "asset-inventory-mismatch: missing asset name or nonempty size" PARENT_SCOPE)
      return()
    endif()
    list(APPEND actual_assets "${name}")
    if(name STREQUAL "SHA256SUMS")
      set(sum_size "${size}")
    endif()
  endforeach()
  list(REMOVE_DUPLICATES actual_assets)
  list(LENGTH actual_assets unique_asset_count)
  if(NOT unique_asset_count EQUAL 19)
    set(${out_error} "asset-inventory-mismatch: duplicate release assets" PARENT_SCOPE)
    return()
  endif()
  set(expected_assets ${expected_names} SHA256SUMS)
  list(SORT expected_assets)
  list(SORT actual_assets)
  if(NOT "${actual_assets}" STREQUAL "${expected_assets}" OR sum_size LESS 1)
    set(${out_error} "asset-inventory-mismatch: release asset names do not match the exact 18-package set" PARENT_SCOPE)
    return()
  endif()

  string(JSON checksum_sha ERROR_VARIABLE read_error GET "${json}" checksums sha256sums_sha256)
  if(read_error)
    set(${out_error} "checksum-missing: SHA256SUMS digest is absent" PARENT_SCOPE)
    return()
  endif()
  pr_digest_valid("${checksum_sha}" digest_ok)
  if(NOT digest_ok)
    set(${out_error} "bad-digest: SHA256SUMS digest must be 64 lowercase hexadecimal characters" PARENT_SCOPE)
    return()
  endif()
  string(JSON checksums_type ERROR_VARIABLE type_error TYPE "${json}" checksums entries)
  if(type_error OR NOT checksums_type STREQUAL "ARRAY")
    set(${out_error} "collection-type: checksums.entries must be JSON ARRAY, found ${checksums_type}${type_error}" PARENT_SCOPE)
    return()
  endif()
  string(JSON archives_type ERROR_VARIABLE type_error TYPE "${json}" archives)
  if(type_error OR NOT archives_type STREQUAL "ARRAY")
    set(${out_error} "collection-type: archives must be JSON ARRAY, found ${archives_type}${type_error}" PARENT_SCOPE)
    return()
  endif()
  string(JSON checksum_count ERROR_VARIABLE read_error LENGTH "${json}" checksums entries)
  string(JSON archive_count ERROR_VARIABLE archive_error LENGTH "${json}" archives)
  if(read_error OR archive_error OR NOT checksum_count EQUAL 18 OR NOT archive_count EQUAL 18)
    set(${out_error} "asset-inventory-mismatch: expected 18 checksum and attestation records" PARENT_SCOPE)
    return()
  endif()

  string(JSON receipt_checksums GET "${json}" checksums entries)
  string(JSON receipt_archives GET "${json}" archives)
  set(checksum_lookup_keys)
  set(checksum_digests)
  set(checksum_names)
  math(EXPR last_checksum "${checksum_count} - 1")
  foreach(index RANGE 0 ${last_checksum})
    string(JSON checksum_type ERROR_VARIABLE element_type_error TYPE "${receipt_checksums}" ${index})
    if(element_type_error OR NOT checksum_type STREQUAL "OBJECT")
      set(${out_error} "collection-element-type: checksums.entries[${index}] must be JSON OBJECT, found ${checksum_type}${element_type_error}" PARENT_SCOPE)
      return()
    endif()
    string(JSON name_type ERROR_VARIABLE name_type_error TYPE "${receipt_checksums}" ${index} name)
    string(JSON digest_type ERROR_VARIABLE digest_type_error TYPE "${receipt_checksums}" ${index} sha256)
    if(name_type_error OR digest_type_error OR NOT name_type STREQUAL "STRING" OR NOT digest_type STREQUAL "STRING")
      set(${out_error} "collection-field-type: checksums.entries[${index}] name and sha256 must be JSON STRING" PARENT_SCOPE)
      return()
    endif()
    string(JSON name ERROR_VARIABLE read_error GET "${receipt_checksums}" ${index} name)
    string(JSON digest ERROR_VARIABLE digest_error GET "${receipt_checksums}" ${index} sha256)
    if(read_error OR digest_error)
      set(${out_error} "checksum-missing: malformed checksum entry" PARENT_SCOPE)
      return()
    endif()
    pr_digest_valid("${digest}" digest_ok)
    if(NOT digest_ok)
      set(${out_error} "bad-digest: checksum for ${name} is malformed" PARENT_SCOPE)
      return()
    endif()
    list(APPEND checksum_names "${name}")
    # Encode the lookup key so a name's list delimiters cannot split its pair.
    # Prefix the hexadecimal bytes to keep even an empty name a nonempty key.
    string(HEX "${name}" checksum_key)
    list(APPEND checksum_lookup_keys "n${checksum_key}")
    list(APPEND checksum_digests "${digest}")
  endforeach()
  list(REMOVE_DUPLICATES checksum_names)
  list(LENGTH checksum_names unique_checksum_count)
  if(NOT unique_checksum_count EQUAL 18)
    set(${out_error} "checksum-inventory-mismatch: duplicate archive checksum" PARENT_SCOPE)
    return()
  endif()
  list(SORT checksum_names)
  if(NOT "${checksum_names}" STREQUAL "${expected_names}")
    set(${out_error} "checksum-inventory-mismatch: checksum names do not match the exact archive set" PARENT_SCOPE)
    return()
  endif()

  set(archive_names)
  math(EXPR last_archive "${archive_count} - 1")
  foreach(index RANGE 0 ${last_archive})
    string(JSON archive_type ERROR_VARIABLE element_type_error TYPE "${receipt_archives}" ${index})
    if(element_type_error OR NOT archive_type STREQUAL "OBJECT")
      set(${out_error} "collection-element-type: archives[${index}] must be JSON OBJECT, found ${archive_type}${element_type_error}" PARENT_SCOPE)
      return()
    endif()
    string(JSON name_type ERROR_VARIABLE name_type_error TYPE "${receipt_archives}" ${index} name)
    string(JSON digest_type ERROR_VARIABLE digest_type_error TYPE "${receipt_archives}" ${index} sha256)
    string(JSON attestation_type ERROR_VARIABLE attestation_type_error TYPE "${receipt_archives}" ${index} attestation)
    if(name_type_error OR digest_type_error OR
       NOT name_type STREQUAL "STRING" OR NOT digest_type STREQUAL "STRING")
      set(${out_error} "collection-field-type: archives[${index}] name and sha256 must be JSON STRING" PARENT_SCOPE)
      return()
    endif()
    string(JSON name ERROR_VARIABLE name_read_error GET "${receipt_archives}" ${index} name)
    if(name_read_error)
      set(${out_error} "collection-field-type: archives[${index}].name could not be read as a JSON STRING" PARENT_SCOPE)
      return()
    elseif(attestation_type_error OR attestation_type STREQUAL "NULL")
      set(${out_error} "attestation-missing: ${name} has no recorded attestation result" PARENT_SCOPE)
      return()
    elseif(NOT attestation_type STREQUAL "OBJECT")
      set(${out_error} "collection-field-type: archives[${index}].attestation must be JSON OBJECT, found ${attestation_type}" PARENT_SCOPE)
      return()
    endif()
    string(JSON digest ERROR_VARIABLE digest_error GET "${receipt_archives}" ${index} sha256)
    if(digest_error)
      set(${out_error} "attestation-missing: malformed archive record" PARENT_SCOPE)
      return()
    endif()
    list(APPEND archive_names "${name}")
    pr_digest_valid("${digest}" digest_ok)
    if(NOT digest_ok)
      set(${out_error} "bad-digest: archive ${name} digest is malformed" PARENT_SCOPE)
      return()
    endif()
    string(HEX "${name}" checksum_key)
    list(FIND checksum_lookup_keys "n${checksum_key}" checksum_index)
    if(checksum_index EQUAL -1)
      set(found_checksum FALSE)
    else()
      list(GET checksum_digests ${checksum_index} checksum_digest)
      set(found_checksum TRUE)
    endif()
    if(NOT found_checksum)
      set(${out_error} "checksum-missing: no checksum for ${name}" PARENT_SCOPE)
      return()
    elseif(NOT checksum_digest STREQUAL digest)
      set(${out_error} "checksum-disagreement: archive and SHA256SUMS differ for ${name}" PARENT_SCOPE)
      return()
    endif()
    string(JSON state_type ERROR_VARIABLE state_type_error TYPE "${receipt_archives}" ${index} attestation state)
    string(JSON source_type ERROR_VARIABLE source_type_error TYPE "${receipt_archives}" ${index} attestation source_digest)
    string(JSON subject_type ERROR_VARIABLE subject_type_error TYPE "${receipt_archives}" ${index} attestation subject_sha256)
    if(state_type_error OR source_type_error OR subject_type_error)
      set(${out_error} "attestation-missing: ${name} has no recorded attestation result" PARENT_SCOPE)
      return()
    elseif(NOT state_type STREQUAL "STRING" OR NOT source_type STREQUAL "STRING" OR NOT subject_type STREQUAL "STRING")
      set(${out_error} "collection-field-type: archives[${index}].attestation state, source_digest and subject_sha256 must be JSON STRING" PARENT_SCOPE)
      return()
    endif()
    string(JSON attestation_state ERROR_VARIABLE attestation_error GET "${receipt_archives}" ${index} attestation state)
    string(JSON attestation_source ERROR_VARIABLE source_error GET "${receipt_archives}" ${index} attestation source_digest)
    string(JSON attestation_subject ERROR_VARIABLE subject_error GET "${receipt_archives}" ${index} attestation subject_sha256)
    if(attestation_error OR source_error OR subject_error)
      set(${out_error} "attestation-missing: ${name} has no recorded attestation result" PARENT_SCOPE)
      return()
    endif()
    if(require_verified)
      if(NOT attestation_state STREQUAL "verified")
        set(${out_error} "attestation-unverified: ${name} did not pass GitHub verification" PARENT_SCOPE)
        return()
      elseif(NOT attestation_source STREQUAL expected_source OR NOT attestation_subject STREQUAL digest)
        set(${out_error} "attestation-identity-mismatch: ${name} source or subject differs" PARENT_SCOPE)
        return()
      endif()
    elseif(NOT attestation_state STREQUAL "not-run" AND NOT attestation_state STREQUAL "verified")
      set(${out_error} "attestation-state: unsupported value for ${name}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  list(REMOVE_DUPLICATES archive_names)
  list(LENGTH archive_names unique_archive_count)
  list(SORT archive_names)
  if(NOT unique_archive_count EQUAL 18 OR NOT "${archive_names}" STREQUAL "${expected_names}")
    set(${out_error} "asset-inventory-mismatch: attestation names do not match the exact archive set" PARENT_SCOPE)
    return()
  endif()
  if(require_verified)
    foreach(field IN ITEMS implementation_main_commit candidate_pr_head_sha
        candidate_pr_number tested_merge_sha release_pr_head_sha
        release_pr_tested_merge_sha release_pr_number published_at)
      string(JSON field_type ERROR_VARIABLE field_error TYPE "${json}" release "${field}")
      if(field_error)
        set(${out_error} "ci-evidence-missing: release.${field} is absent" PARENT_SCOPE)
        return()
      endif()
      if(field STREQUAL "candidate_pr_number" OR field STREQUAL "release_pr_number")
        set(expected_type NUMBER)
      else()
        set(expected_type STRING)
      endif()
      if(NOT field_type STREQUAL expected_type)
        set(${out_error} "ci-evidence-missing: release.${field} must be JSON ${expected_type}" PARENT_SCOPE)
        return()
      endif()
    endforeach()
    string(JSON implementation_main GET "${json}" release implementation_main_commit)
    string(JSON candidate_pr_head GET "${json}" release candidate_pr_head_sha)
    string(JSON candidate_pr_number GET "${json}" release candidate_pr_number)
    string(JSON tested_merge_sha GET "${json}" release tested_merge_sha)
    string(JSON release_pr_head GET "${json}" release release_pr_head_sha)
    string(JSON release_pr_number GET "${json}" release release_pr_number)
    string(JSON release_pr_tested_merge GET "${json}" release release_pr_tested_merge_sha)
    foreach(commit IN ITEMS "${implementation_main}" "${candidate_pr_head}" "${tested_merge_sha}"
        "${release_pr_head}" "${release_pr_tested_merge}" "${expected_source}")
      pr_commit_valid("${commit}" commit_valid)
      if(NOT commit_valid)
        set(${out_error} "ci-evidence-missing: release source chain contains a malformed commit ID" PARENT_SCOPE)
        return()
      endif()
    endforeach()
    string(JSON published_at GET "${json}" release published_at)
    if(NOT published_at MATCHES "^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]([.][0-9]+)?(Z|[+-][0-9][0-9]:[0-9][0-9])$")
      set(${out_error} "release-publication-metadata: published_at is not a timestamp" PARENT_SCOPE)
      return()
    endif()
    string(JSON delta_type ERROR_VARIABLE delta_error TYPE "${json}" release version_delta_files)
    string(JSON delta_count ERROR_VARIABLE delta_count_error LENGTH "${json}" release version_delta_files)
    if(delta_error OR delta_count_error OR NOT delta_type STREQUAL "ARRAY" OR delta_count LESS 1)
      set(${out_error} "release-source-mismatch: verified receipt lacks version-only Release Please delta evidence" PARENT_SCOPE)
      return()
    endif()
    set(allowed_version_files CHANGELOG.md .release-please-manifest.json README.md version.txt
      include/nesturbator.h libretro/nesturbator_libretro.info)
    math(EXPR last_delta "${delta_count} - 1")
    foreach(index RANGE 0 ${last_delta})
      string(JSON delta_file ERROR_VARIABLE delta_file_error GET "${json}" release version_delta_files ${index})
      list(FIND allowed_version_files "${delta_file}" delta_file_index)
      if(delta_file_error OR delta_file_index LESS 0)
        set(${out_error} "release-source-mismatch: receipt records non-version Release Please file ${delta_file}" PARENT_SCOPE)
        return()
      endif()
    endforeach()
    foreach(kind IN ITEMS exact_candidate main release_pr release_source)
      if(kind STREQUAL "exact_candidate")
        set(role candidate)
        set(expected_head "${candidate_pr_head}")
        set(expected_workflow "CI")
        set(expected_path ".github/workflows/ci.yml")
        set(expected_event "pull_request")
        set(expected_pr "${candidate_pr_number}")
        set(expected_checkout "${tested_merge_sha}")
      elseif(kind STREQUAL "main")
        set(role main)
        set(expected_head "${implementation_main}")
        set(expected_workflow "CI")
        set(expected_path ".github/workflows/ci.yml")
        set(expected_event "push")
        set(expected_pr "")
        set(expected_checkout "${implementation_main}")
      elseif(kind STREQUAL "release_pr")
        set(role release_pr)
        set(expected_head "${release_pr_head}")
        set(expected_workflow "CI")
        set(expected_path ".github/workflows/ci.yml")
        set(expected_event "pull_request")
        set(expected_pr "${release_pr_number}")
        set(expected_checkout "${release_pr_tested_merge}")
      else()
        set(role release_source)
        set(expected_head "${expected_source}")
        set(expected_workflow "Release")
        set(expected_path ".github/workflows/release.yml")
        set(expected_event "push")
        set(expected_pr "")
        set(expected_checkout "${expected_source}")
      endif()
      string(JSON run_record ERROR_VARIABLE run_error GET "${json}" linked_ci "${kind}")
      if(run_error)
        set(${out_error} "ci-evidence-missing: missing linked ${kind} run record" PARENT_SCOPE)
        return()
      endif()
      pr_validate_run_evidence("${run_record}" "${role}" "${expected_head}"
        "${expected_workflow}" "${expected_path}" "${expected_event}"
        "${expected_pr}" run_error)
      if(run_error)
        set(${out_error} "${run_error}" PARENT_SCOPE)
        return()
      endif()
      string(JSON actual_checkout GET "${run_record}" tested_checkout_sha)
      if(NOT actual_checkout STREQUAL expected_checkout)
        set(${out_error} "ci-identity-mismatch: ${kind} tested checkout differs from its recorded merge/source identity" PARENT_SCOPE)
        return()
      endif()
    endforeach()
  endif()
endfunction()

function(pr_owned_work work allow_replace out_error)
  if(work STREQUAL "")
    set(${out_error} "WORK is required and must name owned build scratch" PARENT_SCOPE)
    return()
  endif()
  get_filename_component(work "${work}" ABSOLUTE)
  if(IS_SYMLINK "${work}")
    set(${out_error} "refusing symlink work directory ${work}" PARENT_SCOPE)
    return()
  endif()
  set(marker "${work}/.provider-receipt-owned")
  if(EXISTS "${work}")
    if(NOT EXISTS "${marker}")
      set(${out_error} "refusing to replace unmarked work directory ${work}" PARENT_SCOPE)
      return()
    endif()
    file(READ "${marker}" marker_text)
    if(NOT marker_text STREQUAL "Nesturbator provider receipt scratch v1\n")
      set(${out_error} "refusing work directory with an unrecognized marker ${work}" PARENT_SCOPE)
      return()
    endif()
    if(NOT allow_replace)
      set(${out_error} "preserving prior published-run diagnostics; use a new WORK directory" PARENT_SCOPE)
      return()
    endif()
    file(REMOVE_RECURSE "${work}")
  endif()
  file(MAKE_DIRECTORY "${work}/diagnostics")
  file(WRITE "${marker}" "Nesturbator provider receipt scratch v1\n")
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(pr_verify_published_notice notice_file out_error)
  if(IS_SYMLINK "${SOURCE_DIR}/build")
    set(${out_error} "rights-upstream-work-invalid: refusing symlink SOURCE_DIR/build" PARENT_SCOPE)
    return()
  endif()
  file(MAKE_DIRECTORY "${SOURCE_DIR}/build")
  string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef verify_nonce)
  set(verify_work "${SOURCE_DIR}/build/phase28-verify-published-rights-${verify_nonce}")
  pr_owned_work("${verify_work}" FALSE work_error)
  if(work_error)
    set(${out_error} "${work_error}" PARENT_SCOPE)
    return()
  endif()
  pr_compare_pinned_notice("${notice_file}" "${DABG_LICENSE_URL}"
    "${verify_work}/diagnostics" upstream_notice_error)
  set(${out_error} "${upstream_notice_error}" PARENT_SCOPE)
endfunction()

function(pr_selftest_work_root build_dir work_root out_build_real out_work_real out_error)
  if(NOT IS_DIRECTORY "${build_dir}" OR IS_SYMLINK "${build_dir}" OR
     NOT EXISTS "${build_dir}/CMakeCache.txt")
    set(${out_error} "selftest WORK must be beneath an existing configured build directory" PARENT_SCOPE)
    return()
  endif()
  get_filename_component(build_real "${build_dir}" REALPATH)
  file(STRINGS "${build_real}/CMakeCache.txt" source_line
    REGEX "^CMAKE_HOME_DIRECTORY:INTERNAL=")
  if(NOT source_line)
    set(${out_error} "selftest build directory does not identify its source checkout" PARENT_SCOPE)
    return()
  endif()
  string(REGEX REPLACE "^CMAKE_HOME_DIRECTORY:INTERNAL=" "" configured_source "${source_line}")
  get_filename_component(configured_source "${configured_source}" REALPATH)
  if(NOT configured_source STREQUAL SOURCE_DIR)
    set(${out_error} "selftest build directory belongs to a different source checkout" PARENT_SCOPE)
    return()
  endif()
  if(NOT IS_DIRECTORY "${work_root}" OR IS_SYMLINK "${work_root}")
    set(${out_error} "selftest WORK must be an existing non-symlink build scratch directory" PARENT_SCOPE)
    return()
  endif()
  get_filename_component(work_real "${work_root}" REALPATH)
  cmake_path(IS_PREFIX build_real "${work_real}" NORMALIZE work_inside_build)
  if(NOT work_inside_build)
    set(${out_error} "selftest WORK must resolve beneath the configured build directory" PARENT_SCOPE)
    return()
  endif()
  set(${out_build_real} "${build_real}" PARENT_SCOPE)
  set(${out_work_real} "${work_real}" PARENT_SCOPE)
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(pr_selftest_scratch_create build_dir work_root out_scratch out_token out_error)
  pr_selftest_work_root("${build_dir}" "${work_root}" build_real work_real root_error)
  if(root_error)
    set(${out_error} "${root_error}" PARENT_SCOPE)
    return()
  endif()
  string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef run_id)
  set(scratch "${work_real}/provider-receipt-selftest-${run_id}")
  if(EXISTS "${scratch}" OR IS_SYMLINK "${scratch}")
    set(${out_error} "selftest scratch child already exists: ${scratch}" PARENT_SCOPE)
    return()
  endif()
  file(MAKE_DIRECTORY "${scratch}")
  if(IS_SYMLINK "${scratch}" OR NOT IS_DIRECTORY "${scratch}")
    set(${out_error} "selftest scratch child was not created as a directory" PARENT_SCOPE)
    return()
  endif()
  get_filename_component(scratch_real "${scratch}" REALPATH)
  get_filename_component(scratch_parent "${scratch_real}" DIRECTORY)
  cmake_path(IS_PREFIX build_real "${scratch_real}" NORMALIZE scratch_inside_build)
  if(NOT scratch_inside_build OR NOT scratch_parent STREQUAL work_real)
    set(${out_error} "selftest scratch child escaped its canonical WORK root" PARENT_SCOPE)
    return()
  endif()
  set(token "Nesturbator provider receipt selftest scratch v1 ${run_id}\n")
  file(WRITE "${scratch_real}/.provider-receipt-selftest-owned" "${token}")
  set(${out_scratch} "${scratch_real}" PARENT_SCOPE)
  set(${out_token} "${token}" PARENT_SCOPE)
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(pr_selftest_scratch_remove build_dir work_root scratch token out_error)
  pr_selftest_work_root("${build_dir}" "${work_root}" build_real work_real root_error)
  if(root_error)
    set(${out_error} "${root_error}" PARENT_SCOPE)
    return()
  endif()
  if(IS_SYMLINK "${scratch}" OR NOT IS_DIRECTORY "${scratch}")
    set(${out_error} "refusing to remove missing or symlinked selftest scratch child ${scratch}" PARENT_SCOPE)
    return()
  endif()
  get_filename_component(scratch_real "${scratch}" REALPATH)
  get_filename_component(scratch_parent "${scratch_real}" DIRECTORY)
  get_filename_component(scratch_name "${scratch_real}" NAME)
  cmake_path(IS_PREFIX build_real "${scratch_real}" NORMALIZE scratch_inside_build)
  set(marker "${scratch_real}/.provider-receipt-selftest-owned")
  if(NOT scratch_inside_build OR NOT scratch_parent STREQUAL work_real OR
     NOT scratch_name MATCHES "^provider-receipt-selftest-[0-9a-f]+$" OR
     IS_SYMLINK "${marker}" OR NOT EXISTS "${marker}")
    set(${out_error} "refusing to remove selftest scratch without canonical child path and ownership marker checks" PARENT_SCOPE)
    return()
  endif()
  file(READ "${marker}" marker_text)
  if(NOT marker_text STREQUAL token)
    set(${out_error} "refusing to remove selftest scratch with a mismatched ownership marker" PARENT_SCOPE)
    return()
  endif()
  file(REMOVE_RECURSE "${scratch_real}")
  if(EXISTS "${scratch_real}" OR IS_SYMLINK "${scratch_real}")
    set(${out_error} "selftest scratch child remains after cleanup: ${scratch_real}" PARENT_SCOPE)
    return()
  endif()
  set(${out_error} "" PARENT_SCOPE)
endfunction()

