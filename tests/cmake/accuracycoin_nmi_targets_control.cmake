cmake_minimum_required(VERSION 3.25)

foreach(required IN ITEMS SCOREBOARD GATE WORK)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "AccuracyCoin NMI target control needs ${required}")
  endif()
endforeach()
if(NOT EXISTS "${SCOREBOARD}" OR NOT EXISTS "${GATE}")
  message(FATAL_ERROR "AccuracyCoin NMI target control input is missing")
endif()

execute_process(COMMAND "${CMAKE_COMMAND}" "-DSCOREBOARD=${SCOREBOARD}" -P "${GATE}"
  RESULT_VARIABLE baseline_result OUTPUT_VARIABLE baseline_out ERROR_VARIABLE baseline_err)
if(NOT "${baseline_result}" STREQUAL "0")
  message(FATAL_ERROR "candidate scoreboard failed the NMI target gate: ${baseline_err}${baseline_out}")
endif()

string(ASCII 9 TAB)
function(write_mutation name target)
  file(STRINGS "${SCOREBOARD}" scoreboard_lines)
  set(output "")
  set(found FALSE)
  foreach(line IN LISTS scoreboard_lines)
    string(REPLACE "${TAB}" ";" fields "${line}")
    list(GET fields 0 key)
    if(key STREQUAL target)
      set(found TRUE)
      if(name STREQUAL "status")
        string(REPLACE "${TAB}pass${TAB}" "${TAB}fail${TAB}" changed_line "${line}")
        if(changed_line STREQUAL line)
          message(FATAL_ERROR "NMI target control requires a measured passing target: ${target}")
        endif()
        string(APPEND output "${changed_line}\n")
      elseif(name STREQUAL "missing")
        continue()
      elseif(name STREQUAL "duplicate")
        string(APPEND output "${line}\n${line}\n")
      elseif(name STREQUAL "wrong-key")
        string(REPLACE "${target}" "${target} typo" changed_line "${line}")
        string(APPEND output "${changed_line}\n")
      else()
        message(FATAL_ERROR "unknown NMI target mutation: ${name}")
      endif()
    else()
      string(APPEND output "${line}\n")
    endif()
  endforeach()
  if(NOT found)
    message(FATAL_ERROR "NMI target control could not locate ${target}")
  endif()
  file(WRITE "${WORK}/${name}.txt" "${output}")
  set(MUTATED_SCOREBOARD "${WORK}/${name}.txt" PARENT_SCOPE)
endfunction()

function(expect_gate_rejection name expected_diagnostic)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DSCOREBOARD=${MUTATED_SCOREBOARD}" -P "${GATE}"
    RESULT_VARIABLE gate_result OUTPUT_VARIABLE gate_out ERROR_VARIABLE gate_err)
  set(gate_log "${gate_err}${gate_out}")
  if("${gate_result}" STREQUAL "0")
    message(FATAL_ERROR "${name} control was accepted by the NMI target gate")
  endif()
  string(FIND "${gate_log}" "${expected_diagnostic}" diagnostic_index)
  if(diagnostic_index EQUAL -1)
    message(FATAL_ERROR
      "${name} control failed without the intended target diagnostic '${expected_diagnostic}': ${gate_log}")
  endif()
endfunction()

file(MAKE_DIRECTORY "${WORK}")
set(target "accuracycoin/NMI Timing")
write_mutation(status "${target}")
expect_gate_rejection("changed-target" "AccuracyCoin NMI target must pass: ${target}")
write_mutation(missing "${target}")
expect_gate_rejection("missing-target" "AccuracyCoin NMI target is missing: ${target}")
write_mutation(duplicate "${target}")
expect_gate_rejection("duplicate-target" "AccuracyCoin NMI target appears more than once: ${target}")
write_mutation(wrong-key "${target}")
expect_gate_rejection("wrong-target" "AccuracyCoin NMI target is missing: ${target}")

message(STATUS "AccuracyCoin NMI target controls passed")
