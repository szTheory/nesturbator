cmake_minimum_required(VERSION 3.25)

# D-22: every option `nesturbator-run --help` prints has a bullet in the README section
# "The runner", and every option bullet there is printed by --help. Inputs:
#   -DSOURCE_DIR=<repo>  -DRUNNER=<nesturbator-run>
foreach(var SOURCE_DIR RUNNER)
  if(NOT DEFINED ${var})
    message(FATAL_ERROR "${var} is required")
  endif()
endforeach()

execute_process(COMMAND "${RUNNER}" --help
  RESULT_VARIABLE rc OUTPUT_VARIABLE help_text ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "--help exited ${rc}, expected 0")
endif()
if(NOT err STREQUAL "")
  message(FATAL_ERROR "--help wrote to standard error: ${err}")
endif()
string(REPLACE "\r" "" help_text "${help_text}")
string(REPLACE "\n" ";" help_lines "${help_text}")

set(help_opts "")
foreach(line IN LISTS help_lines)
  if(line MATCHES "^  (--[a-z][a-z0-9-]*)")
    list(APPEND help_opts "${CMAKE_MATCH_1}")
  endif()
endforeach()

file(READ "${SOURCE_DIR}/README.md" readme)
string(REPLACE "\r" "" readme "${readme}")
string(FIND "${readme}" "\n## The runner\n" start)
string(FIND "${readme}" "\n## The libretro core\n" stop)
if(start EQUAL -1 OR stop EQUAL -1 OR NOT stop GREATER start)
  message(FATAL_ERROR "README lacks the 'The runner' and 'The libretro core' headings")
endif()
math(EXPR len "${stop} - ${start}")
string(SUBSTRING "${readme}" ${start} ${len} section)
string(REPLACE "\n" ";" readme_lines "${section}")

set(readme_opts "")
foreach(line IN LISTS readme_lines)
  if(line MATCHES "^- `(--[a-z][a-z0-9-]*)")
    list(APPEND readme_opts "${CMAKE_MATCH_1}")
  endif()
endforeach()

list(SORT help_opts)
list(REMOVE_DUPLICATES help_opts)
list(SORT readme_opts)
list(REMOVE_DUPLICATES readme_opts)
if(help_opts STREQUAL "" OR readme_opts STREQUAL "")
  message(FATAL_ERROR "found no options in --help or in the README runner section")
endif()

set(failed FALSE)
foreach(opt IN LISTS help_opts)
  if(NOT opt IN_LIST readme_opts)
    message(SEND_ERROR "option ${opt} is in --help but has no README bullet in \"The runner\"")
    set(failed TRUE)
  endif()
endforeach()
foreach(opt IN LISTS readme_opts)
  if(NOT opt IN_LIST help_opts)
    message(SEND_ERROR "option ${opt} has a README bullet but is not in --help")
    set(failed TRUE)
  endif()
endforeach()
if(failed)
  message(FATAL_ERROR "--help and the README runner section disagree")
endif()
list(LENGTH help_opts n)
message(STATUS "${n} runner options agree between --help and the README")
