cmake_minimum_required(VERSION 3.25)

set(release_pr_guard
  "    if: >-\n      github.event_name != 'pull_request' ||\n      github.event.pull_request.user.login != 'nesturbator-release[bot]' ||\n      !startsWith(github.event.pull_request.title, 'chore(main): release ')")

function(check_nightly_policy workflow out_error)
  # Ignore YAML and shell comments so documentation cannot satisfy a policy.
  string(REPLACE "\r\n" "\n" workflow "${workflow}")
  string(REPLACE "\n" ";" lines "${workflow}")
  set(active)
  foreach(line IN LISTS lines)
    string(STRIP "${line}" trimmed)
    if(trimmed MATCHES "^#" OR trimmed STREQUAL "")
      continue()
    endif()
    string(FIND "${line}" "#" comment_start)
    if(comment_start GREATER_EQUAL 0)
      string(SUBSTRING "${line}" 0 ${comment_start} line)
    endif()
    list(APPEND active "${line}")
  endforeach()
  string(JOIN "\n" code ${active})
  # Each lane is checked on its own text: from its two-space job header to the
  # next two-space job header, so a step in one lane cannot satisfy another.
  set(lanes vectors-full mmc3-oracle)
  set(nightly_jobs vectors-full mmc3-oracle rom-loader-fuzz state-fuzz execution-fuzz suite-flake session-controls)
  set(report_job "")
  foreach(job IN LISTS nightly_jobs ITEMS report)
    set(job_text "")
    set(in_job FALSE)
    foreach(line IN LISTS active)
      if(line MATCHES "^  [A-Za-z0-9_-]+:")
        if(line STREQUAL "  ${job}:")
          set(in_job TRUE)
        else()
          set(in_job FALSE)
        endif()
      endif()
      if(in_job)
        string(APPEND job_text "${line}\n")
      endif()
    endforeach()
    set(job_text_${job} "${job_text}")
    if(job STREQUAL "report")
      set(report_job "${job_text}")
    else()
      string(FIND "${job_text}" "${release_pr_guard}" release_guard_index)
      if(release_guard_index LESS 0)
        set(${out_error} ".github/workflows/nightly.yml: release-pr-skip: ${job} must skip only generated Release Please PRs" PARENT_SCOPE)
        return()
      endif()
    endif()
  endforeach()
  foreach(job IN LISTS nightly_jobs ITEMS report)
    set(in_job FALSE)
    set(in_permissions FALSE)
    set(job_permissions)
    foreach(line IN LISTS lines)
      if(line STREQUAL "  ${job}:")
        set(in_job TRUE)
        continue()
      endif()
      if(in_job AND line MATCHES "^  [A-Za-z0-9_-]+:")
        set(in_job FALSE)
        set(in_permissions FALSE)
      endif()
      if(in_job AND line STREQUAL "    permissions:")
        set(in_permissions TRUE)
        continue()
      endif()
      if(in_permissions AND line MATCHES "^    [^ ]")
        set(in_permissions FALSE)
      endif()
      if(in_permissions AND line MATCHES "^      [^ ]+:")
        list(APPEND job_permissions "${line}")
      endif()
    endforeach()
    if(job STREQUAL "report")
      set(expected_permissions "      issues: write")
    else()
      set(expected_permissions "      contents: read")
    endif()
    if(NOT job_permissions STREQUAL expected_permissions)
      set(${out_error} ".github/workflows/nightly.yml: ${job}-permissions: job permissions must be exactly ${expected_permissions}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  string(FIND "${code}" "workflow_dispatch:\n    inputs:\n      execution_mode:" dispatch_input_index)
  string(FIND "${code}" "        type: choice" mode_type_index)
  string(FIND "${code}" "        options: [pilot, campaign]" mode_options_index)
  string(FIND "${code}" "        default: campaign" mode_default_index)
  if(dispatch_input_index LESS 0 OR mode_type_index LESS dispatch_input_index OR
     mode_options_index LESS mode_type_index OR mode_default_index LESS mode_options_index)
    set(${out_error} ".github/workflows/nightly.yml: execution-mode: workflow_dispatch must expose only the pilot and campaign choices" PARENT_SCOPE)
    return()
  endif()
  set(execution_job "${job_text_execution-fuzz}")
  if(NOT execution_job MATCHES "runs-on: ubuntu-24[.]04" OR
     NOT execution_job MATCHES "timeout-minutes: 5" OR
     NOT execution_job MATCHES "inputs[.]execution_mode == 'pilot'" OR
     NOT execution_job MATCHES "MODE:.*github[.]event_name")
    set(${out_error} ".github/workflows/nightly.yml: execution-mode: campaign mode must be selected by the bounded dispatch choice on Linux" PARENT_SCOPE)
    return()
  endif()
  foreach(required IN ITEMS
      "-DBUDGET_FILE=tests/fuzz/execution-budgets.txt"
      "-DOUTPUT_DIR=\"$GITHUB_WORKSPACE/build/execution-fuzz-evidence/$GITHUB_RUN_ID\""
      "execution_measure.cmake"
      "execution_campaign.cmake"
      "timeout 180s cmake"
      "-DMODE=\"$MODE\" -P \"$DRIVER\"")
    string(FIND "${execution_job}" "${required}" required_index)
    if(required_index LESS 0)
      set(${out_error} ".github/workflows/nightly.yml: execution-command: execution-fuzz is missing ${required}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  foreach(required IN ITEMS
      "-DOUTPUT_DIR=\"\$GITHUB_WORKSPACE/build/execution-fuzz-evidence/\$GITHUB_RUN_ID/self-test\""
      "-DMODE=self-test -P tests/cmake/execution_campaign.cmake"
      "self-test/reproducers/rom-loader/crash-synthetic-control"
      "self-test/reproducers/rom-loader/timeout-synthetic-control")
    string(FIND "${execution_job}" "${required}" control_index)
    if(control_index LESS 0)
      set(${out_error} ".github/workflows/nightly.yml: execution-controls: deliberate exact-input controls must run and be checked in the evidence directory" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  string(FIND "${execution_job}" "actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9" execution_upload_index)
  if(execution_upload_index LESS 0)
    set(${out_error} ".github/workflows/nightly.yml: execution-upload: a pinned artifact upload is required" PARENT_SCOPE)
    return()
  endif()
  string(SUBSTRING "${execution_job}" ${execution_upload_index} -1 execution_upload)
  string(FIND "${execution_upload}" "if: always()" execution_upload_always)
  string(FIND "${execution_upload}" "name: execution-fuzz-evidence-\${{ github.run_id }}" execution_upload_name)
  string(FIND "${execution_upload}" "path: build/execution-fuzz-evidence/\${{ github.run_id }}/" execution_upload_path)
  string(FIND "${execution_upload}" "if-no-files-found: error" execution_upload_missing)
  if(execution_upload_always LESS 0 OR execution_upload_name LESS 0 OR
     execution_upload_path LESS 0 OR execution_upload_missing LESS 0)
    set(${out_error} ".github/workflows/nightly.yml: execution-upload: exact-source artifacts must upload on failures with a fail-closed per-run path" PARENT_SCOPE)
    return()
  endif()
  # Check dependency membership, allowing an additional nightly lane without
  # weakening any existing dependency or requiring one exact list spelling.
  set(report_execution_needs 0)
  foreach(required vectors-full mmc3-oracle rom-loader-fuzz state-fuzz execution-fuzz suite-flake)
    if(NOT report_job MATCHES "needs:[^\n]*[\\[ ,]${required}[],]")
      set(report_execution_needs -1)
    endif()
  endforeach()
  string(FIND "${report_job}" "needs.execution-fuzz.result == 'success'" report_execution_result)
  string(FIND "${report_job}" "EXECUTION_FUZZ: \${{ needs.execution-fuzz.outputs.outcome }}" report_execution_output)
  string(FIND "${report_job}" "Execution fuzz outcome: %s" report_execution_message)
  if(report_execution_needs LESS 0 OR report_execution_result LESS 0 OR
     report_execution_output LESS 0 OR report_execution_message LESS 0)
    set(${out_error} ".github/workflows/nightly.yml: execution-report: the rolling report must include the execution lane outcome" PARENT_SCOPE)
    return()
  endif()
  foreach(lane IN LISTS lanes)
    set(lane_job "${job_text_${lane}}")
    if(NOT lane_job MATCHES "run: cmake --workflow --preset ${lane}\n")
      set(${out_error} ".github/workflows/nightly.yml: run-preset: ${lane} workflow command is required" PARENT_SCOPE)
      return()
    endif()
    string(FIND "${lane_job}" "cmake --preset ${lane}\n" configure_index)
    string(FIND "${lane_job}" "ctest --test-dir build/${lane} --show-only=json-v1" inventory_index)
    string(FIND "${lane_job}" "cmake --workflow --preset ${lane}" workflow_index)
    set(registration_index ${inventory_index})
    if(lane STREQUAL "vectors-full")
      string(FIND "${lane_job}" "FULL_ONLY=ON" registration_index)
      if(registration_index LESS 0)
        set(registration_index -1)
      endif()
    endif()
    if(configure_index LESS 0 OR inventory_index LESS configure_index OR
       registration_index LESS inventory_index OR workflow_index LESS registration_index)
      set(${out_error} ".github/workflows/nightly.yml: inventory-order: ${lane} saved inventory must pass before its full workflow runs" PARENT_SCOPE)
      return()
    endif()
    string(FIND "${lane_job}" "actions/checkout@" lane_checkout)
    string(FIND "${lane_job}" "persist-credentials: false" lane_persist)
    if(lane_checkout LESS 0 OR lane_persist LESS lane_checkout)
      set(${out_error} ".github/workflows/nightly.yml: checkout-credentials: ${lane} checkout must disable credential persistence" PARENT_SCOPE)
      return()
    endif()
    string(FIND "${lane_job}" "actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9" upload_index)
    string(FIND "${lane_job}" "name: Verify run evidence" evidence_index)
    string(FIND "${lane_job}" "test -s build/${lane}/registered-tests.json" inventory_evidence)
    string(FIND "${lane_job}" "test -s build/${lane}/${lane}.junit.xml" junit_evidence)
    if(upload_index LESS 0 OR evidence_index LESS 0 OR inventory_evidence LESS 0 OR
       junit_evidence LESS 0 OR NOT lane_job MATCHES "if-no-files-found: error")
      set(${out_error} ".github/workflows/nightly.yml: run-evidence: ${lane} needs a pinned artifact upload and fail-closed evidence checks" PARENT_SCOPE)
      return()
    endif()
    string(SUBSTRING "${lane_job}" ${evidence_index} 180 evidence_step)
    string(SUBSTRING "${lane_job}" ${upload_index} 180 upload_step)
    if(NOT evidence_step MATCHES "if: always\\(\\)" OR NOT upload_step MATCHES "if: always\\(\\)")
      set(${out_error} ".github/workflows/nightly.yml: run-evidence: ${lane} evidence checks and artifact upload must run after success or failure" PARENT_SCOPE)
      return()
    endif()
    if(NOT report_job MATCHES "needs:[^\n]*[\\[ ,]${lane}[],]")
      set(${out_error} ".github/workflows/nightly.yml: report-needs: report must need ${lane}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  string(FIND "${code}" "push:\n    branches: [main]" main_push)
  if(main_push LESS 0)
    set(${out_error} ".github/workflows/nightly.yml: main-push: an unfiltered push to main is required" PARENT_SCOPE)
    return()
  endif()
  if(NOT code MATCHES "permissions: \\{\\}")
    set(${out_error} ".github/workflows/nightly.yml: root-permissions: root permissions must be empty" PARENT_SCOPE)
    return()
  endif()
  if(NOT report_job MATCHES "      issues: write")
    set(${out_error} ".github/workflows/nightly.yml: report-permissions: issue writes must be limited to report" PARENT_SCOPE)
    return()
  endif()
  if(report_job MATCHES "actions/checkout@")
    set(${out_error} ".github/workflows/nightly.yml: report-checkout: issue reporter must not check out code" PARENT_SCOPE)
    return()
  endif()
  string(REGEX MATCHALL "issues: write" issue_permissions "${code}")
  list(LENGTH issue_permissions issue_permission_count)
  if(NOT issue_permission_count EQUAL 1)
    set(${out_error} ".github/workflows/nightly.yml: report-permissions: issues: write must appear only once" PARENT_SCOPE)
    return()
  endif()
  if(code MATCHES "(^|\n)[ \t]+(contents|actions|checks|pull-requests|statuses|id-token|deployments): write")
    set(${out_error} ".github/workflows/nightly.yml: least-privilege: unexpected write permission" PARENT_SCOPE)
    return()
  endif()
  if(code MATCHES "actions/cache|restore-keys:|cache-hit|(^|\n)[ \t]+cache:")
    set(${out_error} ".github/workflows/nightly.yml: no-cache: cache and restore steps are forbidden" PARENT_SCOPE)
    return()
  endif()
  if(code MATCHES "SKIP_RETURN_CODE|RETURN_CODE[ \t]+77|EXIT[ \t]+77|exit[ \t]+77|continue-on-error:[ \t]*true|\\|\\|[ \t]*true")
    set(${out_error} ".github/workflows/nightly.yml: no-skip: skipped or failure-suppressing results are forbidden" PARENT_SCOPE)
    return()
  endif()
  if(code MATCHES "secrets\\.|\\$\\{\\{[ \t]*secrets")
    set(${out_error} ".github/workflows/nightly.yml: no-secrets: secrets are forbidden" PARENT_SCOPE)
    return()
  endif()
  if(code MATCHES "(^|[ /])(git[ \t]+commit|git[ \t]+push|gh[ \t]+repo[ \t]+sync)([ \t]|$)")
    set(${out_error} ".github/workflows/nightly.yml: no-writeback: commits and pushes are forbidden" PARENT_SCOPE)
    return()
  endif()
  if(code MATCHES "pull_request_target:|workflow_run:")
    set(${out_error} ".github/workflows/nightly.yml: trusted-triggers: privileged triggers are forbidden" PARENT_SCOPE)
    return()
  endif()
  set(${out_error} "" PARENT_SCOPE)
endfunction()

# One lane's minimal clean job text: inventory before the workflow command,
# then the evidence step and the pinned upload.
function(lane_fixture lane registration out_text)
  set(text "  ${lane}:\n${release_pr_guard}\n    permissions:\n      contents: read\n    steps:\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1\n        with:\n          persist-credentials: false\n      - run: cmake --preset ${lane}\n      - run: ctest --test-dir build/${lane} --show-only=json-v1\n${registration}      - run: cmake --workflow --preset ${lane}\n      - name: Verify run evidence\n        if: always()\n        run: |\n          test -s build/${lane}/registered-tests.json\n          test -s build/${lane}/${lane}.junit.xml\n      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9\n        if: always()\n        with:\n          if-no-files-found: error\n")
  set(${out_text} "${text}" PARENT_SCOPE)
endfunction()

function(clean_fixture out_text)
  set(text "# cache: actions/cache is only a comment.\nname: Nightly\non:\n  schedule:\n    - cron: \"17 4 * * *\"\n  workflow_dispatch:\n    inputs:\n      execution_mode:\n        description: Select bounded Linux run mode\n        required: true\n        type: choice\n        options: [pilot, campaign]\n        default: pilot\n  push:\n    branches: [main]\npermissions: {}\njobs:\n")
  lane_fixture(vectors-full "      - run: cmake -DFULL_ONLY=ON -P tests/cmake/vector_registration_policy.cmake\n" vectors)
  lane_fixture(mmc3-oracle "" mmc3)
  set(execution_fixture "  execution-fuzz:\n${release_pr_guard}\n    runs-on: ubuntu-24.04\n    permissions:\n      contents: read\n    steps:\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1\n        with:\n          persist-credentials: false\n      - name: Run bounded execution campaign\n        env:\n          MODE: \${{ github.event_name == 'workflow_dispatch' && inputs.execution_mode == 'pilot' && 'pilot' || 'campaign' }}\n        run: |\n          if [ \"$MODE\" = pilot ]; then\n            DRIVER=tests/cmake/execution_measure.cmake\n          else\n            DRIVER=tests/cmake/execution_campaign.cmake\n          fi\n          timeout 300s cmake -DOUTPUT_DIR=\"$GITHUB_WORKSPACE/build/execution-fuzz-evidence/$GITHUB_RUN_ID\" -DBUDGET_FILE=tests/fuzz/execution-budgets.txt -DMODE=\"$MODE\" -P \"$DRIVER\"\n      - name: Verify deliberate artifact controls\n        if: always()\n        run: |\n          cmake -DOUTPUT_DIR=\"$GITHUB_WORKSPACE/build/execution-fuzz-evidence/$GITHUB_RUN_ID\" -DMODE=self-test -P tests/cmake/execution_campaign.cmake\n          test -s build/execution-fuzz-evidence/$GITHUB_RUN_ID/fixtures/crash-expected\n          test -s build/execution-fuzz-evidence/$GITHUB_RUN_ID/fixtures/timeout-expected\n      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9\n        if: always()\n        with:\n          name: execution-fuzz-evidence-\${{ github.run_id }}\n          path: build/execution-fuzz-evidence/\${{ github.run_id }}/\n          if-no-files-found: error\n")
  set(simple_jobs "")
  foreach(job IN ITEMS rom-loader-fuzz state-fuzz suite-flake session-controls)
    string(APPEND simple_jobs "  ${job}:\n${release_pr_guard}\n    permissions:\n      contents: read\n    runs-on: ubuntu-24.04\n    steps:\n      - run: true\n")
  endforeach()
  string(APPEND text "${vectors}${mmc3}${execution_fixture}${simple_jobs}  report:\n    needs: [vectors-full, mmc3-oracle, rom-loader-fuzz, state-fuzz, execution-fuzz, suite-flake]\n    permissions:\n      issues: write\n    run: echo 'Execution fuzz outcome: %s'\n    env:\n      RESULT: \${{ needs.execution-fuzz.result == 'success' && 'success' || 'failure' }}\n      EXECUTION_FUZZ: \${{ needs.execution-fuzz.outputs.outcome }}\n")
  string(REPLACE
    [[cmake -DOUTPUT_DIR="$GITHUB_WORKSPACE/build/execution-fuzz-evidence/$GITHUB_RUN_ID" -DMODE=self-test -P tests/cmake/execution_campaign.cmake]]
    [[cmake -DOUTPUT_DIR="$GITHUB_WORKSPACE/build/execution-fuzz-evidence/$GITHUB_RUN_ID/self-test" -DMODE=self-test -P tests/cmake/execution_campaign.cmake]]
    text "${text}")
  string(REPLACE
    [[test -s build/execution-fuzz-evidence/$GITHUB_RUN_ID/fixtures/crash-expected]]
    [[test -s build/execution-fuzz-evidence/$GITHUB_RUN_ID/self-test/reproducers/rom-loader/crash-synthetic-control]]
    text "${text}")
  string(REPLACE
    [[test -s build/execution-fuzz-evidence/$GITHUB_RUN_ID/fixtures/timeout-expected]]
    [[test -s build/execution-fuzz-evidence/$GITHUB_RUN_ID/self-test/reproducers/rom-loader/timeout-synthetic-control]]
    text "${text}")
  string(REPLACE "default: pilot" "default: campaign" text "${text}")
  string(REPLACE "  execution-fuzz:\n${release_pr_guard}\n    runs-on: ubuntu-24.04\n    permissions:"
    "  execution-fuzz:\n${release_pr_guard}\n    runs-on: ubuntu-24.04\n    timeout-minutes: 5\n    permissions:" text "${text}")
  string(REPLACE "timeout 300s cmake" "timeout 180s cmake" text "${text}")
  set(${out_text} "${text}" PARENT_SCOPE)
endfunction()

# Applies a REPLACE only from the mmc3-oracle job header onward, so a mutation
# lands on that lane alone and the policy must catch it there.
function(mutate_mmc3 text from to out_text)
  string(FIND "${text}" "  mmc3-oracle:\n" start)
  string(SUBSTRING "${text}" 0 ${start} head)
  string(SUBSTRING "${text}" ${start} -1 tail)
  string(REPLACE "${from}" "${to}" tail "${tail}")
  set(${out_text} "${head}${tail}" PARENT_SCOPE)
endfunction()

function(mutate_execution text from to out_text)
  string(FIND "${text}" "  execution-fuzz:\n" start)
  string(SUBSTRING "${text}" 0 ${start} head)
  string(FIND "${text}" "  report:\n" report_start)
  string(SUBSTRING "${text}" ${start} ${report_start} execution)
  string(SUBSTRING "${text}" ${report_start} -1 report)
  string(REPLACE "${from}" "${to}" execution "${execution}")
  set(${out_text} "${head}${execution}${report}" PARENT_SCOPE)
endfunction()

if(SELFTEST)
  clean_fixture(clean)
  check_nightly_policy("${clean}" error)
  if(error)
    message(FATAL_ERROR "clean workflow fixture failed: ${error}")
  endif()
  set(evidence_step "      - name: Verify run evidence\n        if: always()\n        run: |\n          test -s build/mmc3-oracle/registered-tests.json\n          test -s build/mmc3-oracle/mmc3-oracle.junit.xml\n")
  set(workflow_step "      - run: cmake --workflow --preset mmc3-oracle\n")
  foreach(mutation cache skip permission privileged release-pr-guard
      mmc3-evidence mmc3-write mmc3-skip mmc3-needs mmc3-order)
    set(mutated "${clean}")
    if(mutation STREQUAL cache)
      string(APPEND mutated "      - uses: actions/cache@0123456789012345678901234567890123456789\n")
    elseif(mutation STREQUAL skip)
      string(APPEND mutated "      - run: ctest --preset vectors-full --output-on-failure\n        env:\n          SKIP_RETURN_CODE: 77\n")
    elseif(mutation STREQUAL permission)
      string(REPLACE "      contents: read" "      contents: write" mutated "${mutated}")
    elseif(mutation STREQUAL privileged)
      string(APPEND mutated "  pull_request_target:\n")
    elseif(mutation STREQUAL release-pr-guard)
      mutate_mmc3("${mutated}" "${release_pr_guard}\n" "" mutated)
    elseif(mutation STREQUAL mmc3-evidence)
      mutate_mmc3("${mutated}" "${evidence_step}" "" mutated)
    elseif(mutation STREQUAL mmc3-write)
      mutate_mmc3("${mutated}" "      contents: read" "      contents: write" mutated)
    elseif(mutation STREQUAL mmc3-skip)
      mutate_mmc3("${mutated}" "${workflow_step}" "${workflow_step}        env:\n          SKIP_RETURN_CODE: 77\n" mutated)
    elseif(mutation STREQUAL mmc3-needs)
      string(REPLACE "needs: [vectors-full, mmc3-oracle, rom-loader-fuzz, state-fuzz, execution-fuzz, suite-flake]"
        "needs: [vectors-full, rom-loader-fuzz, state-fuzz, execution-fuzz, suite-flake]" mutated "${mutated}")
    elseif(mutation STREQUAL mmc3-order)
      mutate_mmc3("${mutated}" "      - run: cmake --preset mmc3-oracle\n" "${workflow_step}      - run: cmake --preset mmc3-oracle\n" mutated)
    endif()
    if(mutated STREQUAL clean)
      message(FATAL_ERROR "nightly policy self-test mutation ${mutation} changed nothing")
    endif()
    check_nightly_policy("${mutated}" error)
    if(NOT error)
      message(FATAL_ERROR "nightly policy self-test did not detect ${mutation}")
    endif()
  endforeach()
  foreach(mutation execution-mode execution-default execution-timeout execution-command execution-budget
      execution-controls execution-artifact execution-upload execution-permissions
      execution-report-needs execution-report-outcome)
    set(mutated "${clean}")
    if(mutation STREQUAL execution-mode)
      string(REPLACE "options: [pilot, campaign]" "options: [campaign]" mutated "${mutated}")
    elseif(mutation STREQUAL execution-default)
      string(REPLACE "default: campaign" "default: pilot" mutated "${mutated}")
    elseif(mutation STREQUAL execution-timeout)
      mutate_execution("${mutated}" "timeout-minutes: 5" "timeout-minutes: 4" mutated)
    elseif(mutation STREQUAL execution-report-needs)
      string(REPLACE "execution-fuzz, suite-flake]" "suite-flake]" mutated "${mutated}")
    elseif(mutation STREQUAL execution-report-outcome)
      string(REPLACE "needs.execution-fuzz.result == 'success' && " "" mutated "${mutated}")
    elseif(mutation STREQUAL execution-command)
      mutate_execution("${mutated}" "timeout 180s cmake" "cmake" mutated)
    elseif(mutation STREQUAL execution-budget)
      mutate_execution("${mutated}" "-DBUDGET_FILE=tests/fuzz/execution-budgets.txt" "-DBUDGET_FILE=missing.txt" mutated)
    elseif(mutation STREQUAL execution-controls)
      mutate_execution("${mutated}" "fixtures/timeout-expected" "fixtures/missing-timeout-expected" mutated)
    elseif(mutation STREQUAL execution-artifact)
      mutate_execution("${mutated}" "path: build/execution-fuzz-evidence/\${{ github.run_id }}/" "path: build/wrong/" mutated)
    elseif(mutation STREQUAL execution-upload)
      mutate_execution("${mutated}" "if: always()\n        with:\n          name: execution-fuzz-evidence-" "if: failure()\n        with:\n          name: execution-fuzz-evidence-" mutated)
    elseif(mutation STREQUAL execution-permissions)
      mutate_execution("${mutated}" "      contents: read" "      contents: write" mutated)
    endif()
    if(mutated STREQUAL clean)
      message(FATAL_ERROR "nightly policy self-test mutation ${mutation} changed nothing")
    endif()
    check_nightly_policy("${mutated}" error)
    if(NOT error)
      message(FATAL_ERROR "nightly policy self-test did not detect ${mutation}")
    endif()
  endforeach()
  message(STATUS "nightly workflow policy self-test passed")
elseif(DEFINED WORKFLOW)
  file(READ "${WORKFLOW}" workflow)
  check_nightly_policy("${workflow}" error)
  if(error)
    message(FATAL_ERROR "${error}")
  endif()
  if(DEFINED ROOT)
    file(READ "${ROOT}/tests/cmake/execution_campaign.cmake" execution_driver)
    string(FIND "${execution_driver}" "file(COPY \"\${source_dir}/\" DESTINATION \"\${working_dir}\")" writable_copy_index)
    string(FIND "${execution_driver}" "before_run_manifest" corpus_before_index)
    string(FIND "${execution_driver}" "after_run_manifest" corpus_after_index)
    if(writable_copy_index LESS 0 OR corpus_before_index LESS 0 OR corpus_after_index LESS corpus_before_index)
      message(FATAL_ERROR "tests/cmake/execution_campaign.cmake: mutation must use a writable corpus copy and verify source corpus integrity")
    endif()
    set(control_output "${ROOT}/build/execution-fuzz-evidence/policy-selftest")
    execute_process(COMMAND "${CMAKE_COMMAND}"
        "-DSOURCE_DIR=${ROOT}" "-DBUILD_DIR=${ROOT}/build/execution-fuzz-build"
        "-DOUTPUT_DIR=${control_output}"
        "-DBUDGET_FILE=${ROOT}/tests/fuzz/execution-budgets.txt"
        "-DREPLAY_BINARY=${REPLAY_BINARY}"
        -DMODE=self-test -P "${ROOT}/tests/cmake/execution_campaign.cmake"
      RESULT_VARIABLE controls_result OUTPUT_VARIABLE controls_out ERROR_VARIABLE controls_err)
    if(NOT controls_result EQUAL 0)
      message(FATAL_ERROR "execution evidence controls did not produce the selected upload-path fixtures: ${controls_err}${controls_out}")
    endif()
    foreach(fixture IN ITEMS crash-synthetic-control timeout-synthetic-control)
      set(uploaded_fixture "${control_output}/reproducers/rom-loader/${fixture}")
      if(NOT EXISTS "${uploaded_fixture}")
        message(FATAL_ERROR "execution evidence control did not retain ${fixture} in the upload path")
      endif()
      file(SIZE "${uploaded_fixture}" fixture_size)
      if(fixture_size EQUAL 0)
        message(FATAL_ERROR "execution evidence control emitted an empty ${fixture}")
      endif()
    endforeach()
    file(READ "${ROOT}/CMakePresets.json" presets)
    string(JSON preset_count LENGTH "${presets}" testPresets)
    foreach(lane IN ITEMS vectors-full mmc3-oracle)
      set(junit_path "")
      set(no_tests_action "")
      set(lane_label "")
      if(preset_count GREATER 0)
        math(EXPR preset_last "${preset_count} - 1")
        foreach(index RANGE 0 ${preset_last})
          string(JSON preset_name GET "${presets}" testPresets ${index} name)
          if(preset_name STREQUAL "${lane}")
            string(JSON junit_path GET "${presets}" testPresets ${index} output outputJUnitFile)
            string(JSON no_tests_action GET "${presets}" testPresets ${index} execution noTestsAction)
            string(JSON lane_label GET "${presets}" testPresets ${index} filter include label)
          endif()
        endforeach()
      endif()
      set(expected_junit "\${sourceDir}/build/${lane}/${lane}.junit.xml")
      if(NOT junit_path STREQUAL expected_junit)
        message(FATAL_ERROR "CMakePresets.json: junit-output: ${lane} needs a stable JUnit path in build/${lane}")
      endif()
      if(NOT no_tests_action STREQUAL "error" OR NOT lane_label STREQUAL "${lane}")
        message(FATAL_ERROR "CMakePresets.json: full-filter: ${lane} must select its own label and fail on an empty inventory")
      endif()
    endforeach()
    foreach(relative IN ITEMS
        CMakePresets.json
        tests/cmake/fetch_vectors.cmake
        tests/cmake/vectors_full_run.cmake
        tests/cmake/vectors_sample_match.cmake
        tests/cmake/fetch_blargg_mmc3.cmake
        tests/cmake/mmc3_oracle_run.cmake)
      file(READ "${ROOT}/${relative}" source)
      string(REGEX REPLACE "(^|\n)[ \t]*#[^\n]*" "" source "${source}")
      string(REGEX REPLACE "#[^\n]*" "" source "${source}")
      if(source MATCHES "SKIP_RETURN_CODE|RETURN_CODE[ \t]+77|EXIT[ \t]+77|exit[ \t]+77")
        message(FATAL_ERROR "${relative}: no-skip: skip code 77 is forbidden in the nightly lanes")
      endif()
    endforeach()
  endif()
  message(STATUS "nightly workflow policy passed")
else()
  message(FATAL_ERROR "WORKFLOW is required")
endif()
