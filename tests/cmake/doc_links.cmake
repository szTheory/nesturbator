cmake_minimum_required(VERSION 3.25)

# Check README inline links to docs/*.md files. Fragments use ordinary ATX
# headings: lowercase ASCII, remove punctuation, turn whitespace runs into
# hyphens, collapse repeated hyphens, and suffix duplicate anchors with -1,
# -2, etc. Setext headings, HTML anchors, and encoded fragments are outside
# this check's syntax.

function(nesturbator_doc_visible_text path out_text)
  file(STRINGS "${path}" lines)
  set(visible "")
  set(in_fence FALSE)
  set(fence_char "")
  set(fence_width 0)
  foreach(line IN LISTS lines)
    string(STRIP "${line}" stripped)
    string(LENGTH "${stripped}" line_length)
    if(in_fence)
      set(run_length 0)
      while(run_length LESS line_length)
        string(SUBSTRING "${stripped}" ${run_length} 1 current_char)
        if(NOT current_char STREQUAL fence_char)
          break()
        endif()
        math(EXPR run_length "${run_length} + 1")
      endwhile()
      if(run_length GREATER_EQUAL fence_width)
        string(SUBSTRING "${stripped}" ${run_length} -1 tail)
        if(tail MATCHES "^[ \t]*$")
          set(in_fence FALSE)
          set(fence_char "")
          set(fence_width 0)
        endif()
      endif()
      string(APPEND visible "\n")
      continue()
    endif()

    set(open_char "")
    if(stripped MATCHES "^```")
      set(open_char "`")
    elseif(stripped MATCHES "^~~~")
      set(open_char "~")
    endif()
    if(NOT open_char STREQUAL "")
      set(run_length 0)
      while(run_length LESS line_length)
        string(SUBSTRING "${stripped}" ${run_length} 1 current_char)
        if(NOT current_char STREQUAL open_char)
          break()
        endif()
        math(EXPR run_length "${run_length} + 1")
      endwhile()
      if(run_length GREATER_EQUAL 3)
        set(in_fence TRUE)
        set(fence_char "${open_char}")
        set(fence_width "${run_length}")
        string(APPEND visible "\n")
        continue()
      endif()
    endif()

    string(APPEND visible "${line}\n")
  endforeach()
  set(${out_text} "${visible}" PARENT_SCOPE)
endfunction()

function(nesturbator_doc_anchors path out_anchors)
  file(STRINGS "${path}" lines)
  set(anchors "")
  set(in_fence FALSE)
  set(fence_char "")
  set(fence_width 0)
  foreach(line IN LISTS lines)
    string(STRIP "${line}" stripped)
    string(LENGTH "${stripped}" line_length)
    if(in_fence)
      set(run_length 0)
      while(run_length LESS line_length)
        string(SUBSTRING "${stripped}" ${run_length} 1 current_char)
        if(NOT current_char STREQUAL fence_char)
          break()
        endif()
        math(EXPR run_length "${run_length} + 1")
      endwhile()
      if(run_length GREATER_EQUAL fence_width)
        string(SUBSTRING "${stripped}" ${run_length} -1 tail)
        if(tail MATCHES "^[ \t]*$")
          set(in_fence FALSE)
          set(fence_char "")
          set(fence_width 0)
        endif()
      endif()
      continue()
    endif()

    set(open_char "")
    if(stripped MATCHES "^```")
      set(open_char "`")
    elseif(stripped MATCHES "^~~~")
      set(open_char "~")
    endif()
    if(NOT open_char STREQUAL "")
      set(run_length 0)
      while(run_length LESS line_length)
        string(SUBSTRING "${stripped}" ${run_length} 1 current_char)
        if(NOT current_char STREQUAL open_char)
          break()
        endif()
        math(EXPR run_length "${run_length} + 1")
      endwhile()
      if(run_length GREATER_EQUAL 3)
        set(in_fence TRUE)
        set(fence_char "${open_char}")
        set(fence_width "${run_length}")
        continue()
      endif()
    endif()

    if(NOT stripped MATCHES "^#+[ \t]+")
      continue()
    endif()
    string(REGEX MATCH "^#+[ \t]+" heading_marker "${stripped}")
    string(REGEX REPLACE "[ \t]+$" "" heading_marker "${heading_marker}")
    string(LENGTH "${heading_marker}" heading_level)
    if(heading_level GREATER 6)
      continue()
    endif()
    string(REGEX REPLACE "^#+[ \t]+" "" heading "${stripped}")
    string(REGEX REPLACE "[ \t]+#+[ \t]*$" "" heading "${heading}")
    string(TOLOWER "${heading}" anchor)
    string(REGEX REPLACE "[^a-z0-9 _-]" "" anchor "${anchor}")
    string(REGEX REPLACE "[ \t]+" "-" anchor "${anchor}")
    string(REGEX REPLACE "-+" "-" anchor "${anchor}")
    string(REGEX REPLACE "^-+" "" anchor "${anchor}")
    string(REGEX REPLACE "-+$" "" anchor "${anchor}")
    if(anchor STREQUAL "")
      set(anchor "section")
    endif()
    set(base_anchor "${anchor}")
    set(suffix 0)
    while(anchor IN_LIST anchors)
      math(EXPR suffix "${suffix} + 1")
      set(anchor "${base_anchor}-${suffix}")
    endwhile()
    list(APPEND anchors "${anchor}")
  endforeach()
  set(${out_anchors} "${anchors}" PARENT_SCOPE)
endfunction()

function(nesturbator_check_doc_links readme out_error)
  set(${out_error} "" PARENT_SCOPE)
  if(NOT EXISTS "${readme}")
    set(${out_error} "README does not exist: ${readme}" PARENT_SCOPE)
    return()
  endif()
  get_filename_component(readme_dir "${readme}" DIRECTORY)
  get_filename_component(readme_dir "${readme_dir}" ABSOLUTE)
  set(docs_root "${readme_dir}/docs")
  nesturbator_doc_visible_text("${readme}" visible)
  string(REGEX MATCHALL "\\]\\([^)]*\\)" markdown_links "${visible}")
  foreach(markdown_link IN LISTS markdown_links)
    string(REGEX REPLACE "^.*\\]\\(" "" target_text "${markdown_link}")
    string(REGEX REPLACE "\\)$" "" target_text "${target_text}")
    string(STRIP "${target_text}" target_text)
    if(target_text MATCHES "^<([^>]+)>")
      set(target "${CMAKE_MATCH_1}")
    else()
      string(REGEX MATCH "^[^ \t]+" target "${target_text}")
    endif()
    if(NOT target MATCHES "^docs/.+\\.md(#.*)?$")
      continue()
    endif()

    string(FIND "${target}" "#" fragment_pos)
    if(fragment_pos EQUAL -1)
      set(target_path "${target}")
      set(fragment "")
    else()
      string(SUBSTRING "${target}" 0 ${fragment_pos} target_path)
      math(EXPR fragment_start "${fragment_pos} + 1")
      string(SUBSTRING "${target}" ${fragment_start} -1 fragment)
    endif()
    cmake_path(ABSOLUTE_PATH target_path BASE_DIRECTORY "${readme_dir}" NORMALIZE
      OUTPUT_VARIABLE absolute_target)
    cmake_path(IS_PREFIX docs_root "${absolute_target}" NORMALIZE within_docs)
    if(NOT within_docs)
      set(${out_error} "README docs link escapes docs/: ${target}" PARENT_SCOPE)
      return()
    endif()
    if(NOT EXISTS "${absolute_target}" OR IS_DIRECTORY "${absolute_target}")
      set(${out_error} "README docs link target does not exist: ${target_path}" PARENT_SCOPE)
      return()
    endif()
    if(NOT fragment STREQUAL "")
      nesturbator_doc_anchors("${absolute_target}" anchors)
      if(NOT fragment IN_LIST anchors)
        set(${out_error}
          "README docs link fragment '#${fragment}' does not exist in ${target_path}"
          PARENT_SCOPE)
        return()
      endif()
    elseif(target MATCHES "#$")
      set(${out_error} "README docs link has an empty fragment: ${target_path}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
endfunction()

function(nesturbator_doc_links_child readme out_result out_text)
  execute_process(
    COMMAND "${CMAKE_COMMAND}" "-DREADME=${readme}" -P "${CMAKE_CURRENT_LIST_FILE}"
    WORKING_DIRECTORY "${WORK}"
    RESULT_VARIABLE result
    OUTPUT_VARIABLE output
    ERROR_VARIABLE error)
  set(${out_result} "${result}" PARENT_SCOPE)
  set(${out_text} "${output}\n${error}" PARENT_SCOPE)
endfunction()

if(SELFTEST)
  if(NOT DEFINED WORK)
    message(FATAL_ERROR "WORK is required for docs.links.self_test")
  endif()
  string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
  set(fixture "${WORK}/docs_links_${nonce}")
  file(MAKE_DIRECTORY "${fixture}/docs")
  file(WRITE "${fixture}/docs/api.md"
    "# API\n\n## Save states: with rewinds!\n")
  file(WRITE "${fixture}/README.md"
    "[API](docs/api.md#save-states-with-rewinds)\n\n```md\n[ignored](docs/missing.md#missing)\n```\n")
  nesturbator_doc_links_child("${fixture}/README.md" result output)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "docs.links self-test: rejected valid normalized fragment or scanned a fence: ${output}")
  endif()

  file(WRITE "${fixture}/README.md" "[Missing](docs/missing.md#missing)\n")
  nesturbator_doc_links_child("${fixture}/README.md" result output)
  if(result EQUAL 0 OR NOT output MATCHES "README docs link target does not exist")
    message(FATAL_ERROR "docs.links self-test: missing target failed for the wrong reason: ${output}")
  endif()

  file(WRITE "${fixture}/README.md" "[Bad fragment](docs/api.md#not-a-heading)\n")
  nesturbator_doc_links_child("${fixture}/README.md" result output)
  if(result EQUAL 0 OR NOT output MATCHES "README docs link fragment '#not-a-heading' does not exist")
    message(FATAL_ERROR "docs.links self-test: bad fragment failed for the wrong reason: ${output}")
  endif()
  message(STATUS "docs.links self-test: valid links, fences, missing files and fragments passed")
  return()
endif()

if(NOT DEFINED README)
  message(FATAL_ERROR "README is required")
endif()
nesturbator_check_doc_links("${README}" error)
if(error)
  message(FATAL_ERROR "${error}")
endif()
message(STATUS "README local docs Markdown targets and fragments resolve")
