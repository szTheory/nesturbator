cmake_minimum_required(VERSION 3.25)

foreach(required IN ITEMS SOURCE_DIR WORK)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "Phase 21 identity controls require ${required}")
  endif()
endforeach()
set(script "${SOURCE_DIR}/tests/cmake/phase21_source_identity.cmake")
set(root "${WORK}/repo")
set(manifest "${WORK}/inventory.tsv")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${root}")

function(fixture_git)
  execute_process(COMMAND git ${ARGN} WORKING_DIRECTORY "${root}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "identity fixture Git failed: ${output}${error}")
  endif()
endfunction()

function(identity mode expected)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DMODE=${mode}" "-DROOT=${root}"
    "-DMANIFEST=${manifest}" -P "${script}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(expected STREQUAL "pass")
    if(NOT "${result}" STREQUAL "0")
      message(FATAL_ERROR "identity ${mode} rejected positive sibling: ${output}${error}")
    endif()
  elseif("${result}" STREQUAL "0" OR NOT "${output}${error}" MATCHES "${expected}")
    message(FATAL_ERROR "identity ${mode} failed at wrong stage: ${output}${error}")
  endif()
endfunction()

function(expect_row path committed_mode index_mode work_matches_index)
  file(STRINGS "${manifest}" rows)
  set(found FALSE)
  string(ASCII 9 tab)
  foreach(row IN LISTS rows)
    if(row MATCHES "${tab}${path}$")
      string(REPLACE "${tab}" ";" fields "${row}")
      list(GET fields 0 actual_committed_mode)
      list(GET fields 1 committed_blob)
      list(GET fields 2 actual_index_mode)
      list(GET fields 3 index_blob)
      list(GET fields 4 work_blob)
      if(NOT actual_committed_mode STREQUAL committed_mode OR
         NOT actual_index_mode STREQUAL index_mode)
        message(FATAL_ERROR "identity mode fields differ for ${path}: ${row}")
      endif()
      if(work_matches_index AND NOT work_blob STREQUAL index_blob)
        message(FATAL_ERROR "identity lost equal work/index content at ${path}")
      elseif(NOT work_matches_index AND work_blob STREQUAL index_blob)
        message(FATAL_ERROR "identity collapsed distinct work/index content at ${path}")
      endif()
      if(path STREQUAL "new.txt" AND NOT committed_blob STREQUAL "missing")
        message(FATAL_ERROR "identity invented a committed blob for staged-only input")
      endif()
      set(found TRUE)
    endif()
  endforeach()
  if(NOT found)
    message(FATAL_ERROR "identity omitted tracked path ${path}")
  endif()
endfunction()

fixture_git(init)
fixture_git(config core.autocrlf false)
fixture_git(config core.eol lf)
file(WRITE "${root}/space name.txt" "original\r\nraw bytes\n")
file(WRITE "${root}/target.txt" "target")
if(UNIX)
  file(CREATE_LINK "target.txt" "${root}/link" SYMBOLIC)
endif()
fixture_git(add -- "space name.txt" target.txt)
if(UNIX)
  fixture_git(add -- link)
endif()
fixture_git(-c user.name=fixture -c user.email=fixture@users.noreply.github.com
  commit -m "test: initial identity fixture")
identity(write pass)
identity(verify pass)
expect_row("space name.txt" 100644 100644 TRUE)

file(APPEND "${root}/space name.txt" "unstaged")
identity(verify "manifest differs from current checkout")
identity(write pass)
expect_row("space name.txt" 100644 100644 FALSE)
fixture_git(add -- "space name.txt")
identity(verify "manifest differs from current checkout")
identity(write pass)
expect_row("space name.txt" 100644 100644 TRUE)
file(READ "${manifest}" staged_manifest)
if(NOT staged_manifest MATCHES "100644\t([0-9a-f]+)\t100644\t([0-9a-f]+)\t[0-9a-f]+\tspace name.txt" OR
   CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
  message(FATAL_ERROR "identity collapsed committed and staged blob fields")
endif()

fixture_git(update-index --chmod=+x -- "space name.txt")
identity(verify "manifest differs from current checkout")
identity(write pass)
expect_row("space name.txt" 100644 100755 TRUE)
file(WRITE "${root}/new.txt" "staged-only")
fixture_git(add -- new.txt)
identity(verify "manifest differs from current checkout")
identity(write pass)
expect_row(new.txt missing 100644 TRUE)

if(UNIX)
  file(REMOVE "${root}/link")
  file(CREATE_LINK "space name.txt" "${root}/link" SYMBOLIC)
  identity(verify "manifest differs from current checkout")
  identity(write pass)
  expect_row(link 120000 120000 FALSE)
  # Independent Git stdin hashing checks target text, never target-file bytes.
  file(WRITE "${WORK}/link-target" "space name.txt")
  execute_process(COMMAND git hash-object --stdin INPUT_FILE "${WORK}/link-target"
    OUTPUT_VARIABLE expected_link_blob OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE hash_result)
  file(READ "${manifest}" link_manifest)
  if(NOT "${hash_result}" STREQUAL "0" OR
     NOT link_manifest MATCHES "\t${expected_link_blob}\tlink\n")
    message(FATAL_ERROR "identity did not hash raw symlink target bytes")
  endif()
endif()

file(REMOVE "${root}/target.txt")
identity(write "missing a tracked input")
fixture_git(reset --hard HEAD)
execute_process(COMMAND git rev-parse HEAD:target.txt WORKING_DIRECTORY "${root}"
  OUTPUT_VARIABLE conflict_blob OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE blob_result)
if(NOT "${blob_result}" STREQUAL "0")
  message(FATAL_ERROR "identity conflict fixture cannot read its blob")
endif()
# Git's line-oriented index-info protocol needs LF bytes. Native CRLF text
# output gives Windows Git invalid CR-suffixed paths, which it ignores.
file(CONFIGURE OUTPUT "${WORK}/conflict-index" CONTENT
  "0 0000000000000000000000000000000000000000\ttarget.txt\n100644 ${conflict_blob} 1\ttarget.txt\n100644 ${conflict_blob} 2\ttarget.txt\n"
  NEWLINE_STYLE LF)
file(READ "${WORK}/conflict-index" conflict_hex HEX)
string(REGEX MATCHALL "0a" conflict_newlines "${conflict_hex}")
list(LENGTH conflict_newlines conflict_newline_count)
if(conflict_hex MATCHES "0d" OR NOT conflict_newline_count EQUAL 3)
  message(FATAL_ERROR "identity conflict fixture must use three LF-only protocol rows")
endif()
execute_process(COMMAND git update-index --index-info WORKING_DIRECTORY "${root}"
  INPUT_FILE "${WORK}/conflict-index" RESULT_VARIABLE conflict_result)
if(NOT "${conflict_result}" STREQUAL "0")
  message(FATAL_ERROR "identity conflict fixture cannot create unresolved stages")
endif()
execute_process(COMMAND git ls-files --stage -- target.txt WORKING_DIRECTORY "${root}"
  OUTPUT_VARIABLE conflict_entries OUTPUT_STRIP_TRAILING_WHITESPACE
  RESULT_VARIABLE stages_result)
string(REPLACE "\r\n" "\n" conflict_entries "${conflict_entries}")
if(NOT "${stages_result}" STREQUAL "0" OR NOT conflict_entries STREQUAL
    "100644 ${conflict_blob} 1\ttarget.txt\n100644 ${conflict_blob} 2\ttarget.txt")
  message(FATAL_ERROR "identity conflict fixture did not construct exact unresolved target stages")
endif()
identity(write "requires stage-zero index entries")
message(STATUS "Phase 21 committed/index/raw worktree, modes, symlink, missing and conflict controls passed")
