# Writes a sorted inventory of native frame hashes for every licensed game
# ROM plus the two-port DABG input scripts, and audio hashes for each game.
#
#   cmake -DBUILD=<build dir> -DOUT=<file> -DMOVIE_WRITER=<exe> -P write_hashes.cmake

cmake_minimum_required(VERSION 3.25)

if(NOT DEFINED BUILD OR NOT DEFINED OUT OR NOT DEFINED MOVIE_WRITER)
  message(FATAL_ERROR "write_hashes: pass -DBUILD=<build dir> -DOUT=<file> -DMOVIE_WRITER=<exe>")
endif()

set(tried "${BUILD}/runner/nesturbator-run" "${BUILD}/runner/nesturbator-run.exe")
set(runner "")
foreach(candidate IN LISTS tried)
  if(EXISTS "${candidate}" AND NOT IS_DIRECTORY "${candidate}")
    set(runner "${candidate}")
    break()
  endif()
endforeach()
if(runner STREQUAL "")
  list(JOIN tried " and " names)
  message(FATAL_ERROR "write_hashes: no runner at ${names}")
endif()
if(NOT EXISTS "${MOVIE_WRITER}")
  message(FATAL_ERROR "write_hashes: DABG movie writer is missing at ${MOVIE_WRITER}")
endif()

set(source_dir "${CMAKE_CURRENT_LIST_DIR}/../..")
include("${CMAKE_CURRENT_LIST_DIR}/hash_keys.cmake")
file(STRINGS "${source_dir}/tests/roms/manifest.txt" manifest_lines)
set(required_manifest
  "tests/roms/dabg.nes\thttps://github.com/NovaSquirrel/DABG/tree/5ecc60b6af3f726851bfeb1c2555388c5953e0c0\t5ecc60b6af3f726851bfeb1c2555388c5953e0c0\tZlib\teca79b9d0b546e96c1bc73099e239539fb9c7773ff10a431bb3a9cd6763208ca"
  "tests/roms/nesteroids.nes\thttps://github.com/battlelinegames/nesteroids/tree/ae65d78048af68f3e735c49d77a7f37e976a7afe\tae65d78048af68f3e735c49d77a7f37e976a7afe\tMIT\ta30dcfb12c1447dc121619c93b4083d2b83c7405a883ed490c3a59e52ce74f36"
  "tests/roms/rhde.nes\thttps://github.com/pinobatch/rhde-nes/tree/71b18aeb54fefa16373cb3ad2996a2aff90181b5\t71b18aeb54fefa16373cb3ad2996a2aff90181b5\tFSFAP\tb2c4748a5b3651e393572046daf126213653b58b55472cdfdf4b863834dd0241"
  "tests/roms/runner.nes\thttps://github.com/zorchenhimer/nes-runner/tree/47537be0ccb8baeb8462547a1c08888ee2a6cfac\t47537be0ccb8baeb8462547a1c08888ee2a6cfac\tMIT\t1a67bfabdde2d96eacb04eb7f9d17e8da6c082d4976c318315fe31e2d19b4384")
list(APPEND required_manifest ${NESTURBATOR_HOLYMAPPEREL_MANIFEST})
foreach(required IN LISTS required_manifest)
  if(NOT required IN_LIST manifest_lines)
    string(REGEX REPLACE "\t.*$" "" missing_path "${required}")
    message(FATAL_ERROR "write_hashes: manifest provenance missing or changed for ${missing_path}")
  endif()
endforeach()

# RHDE's iNES header declares zero CHR-ROM banks; its pinned README says it
# expects 8 KiB CHR RAM. Its native render hashes exercise the decompressed
# CHR data written at startup and subsequently fetched by the PPU.
file(READ "${source_dir}/tests/roms/rhde.nes" rhde_chr_count OFFSET 5 LIMIT 1 HEX)
if(NOT rhde_chr_count STREQUAL "00")
  message(FATAL_ERROR "write_hashes: RHDE byte 5 must declare CHR RAM (got ${rhde_chr_count})")
endif()

set(output_lines)
set(frame_args --hash-frame 1 --hash-frame 30 --hash-frame 60 --hash-frame 120 --hash-frame 180)
foreach(game_entry IN LISTS NESTURBATOR_HASH_GAMES)
  string(REPLACE ":" ";" game_parts "${game_entry}")
  list(GET game_parts 0 game)
  list(GET game_parts 1 game_file)
  set(rom "${source_dir}/tests/roms/${game_file}")
  execute_process(
    COMMAND "${runner}" --frames 180 --rom "${rom}" ${frame_args} --hash-audio
    OUTPUT_VARIABLE hashes
    ERROR_VARIABLE errors
    RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "write_hashes: ${game} boot run exited with ${rc}: ${errors}")
  endif()
  string(REPLACE "\r" "" hashes "${hashes}")
  string(REPLACE "\n" ";" hash_lines "${hashes}")
  set(found_frames)
  set(found_audio)
  foreach(line IN LISTS hash_lines)
    if(line MATCHES "^frame (1|30|60|120|180) ")
      list(APPEND output_lines "${game}/boot/${line}")
      list(APPEND found_frames "${CMAKE_MATCH_1}")
    elseif(line MATCHES "^audio (transitions|pcm) sha256 ([0-9a-f]+)$")
      string(LENGTH "${CMAKE_MATCH_2}" digest_length)
      if(NOT digest_length EQUAL 64)
        message(FATAL_ERROR "write_hashes: ${game} ${CMAKE_MATCH_1} digest has ${digest_length} hex characters")
      endif()
      list(APPEND output_lines "${game}/boot/audio/${CMAKE_MATCH_1} sha256 ${CMAKE_MATCH_2}")
      list(APPEND found_audio "${CMAKE_MATCH_1}")
    endif()
  endforeach()
  list(LENGTH found_frames found_count)
  if(NOT found_count EQUAL 5)
    message(FATAL_ERROR "write_hashes: ${game} boot has ${found_count} selected hash rows; expected 5")
  endif()
  list(REMOVE_DUPLICATES found_frames)
  list(SORT found_frames COMPARE NATURAL)
  if(NOT found_frames STREQUAL "1;30;60;120;180")
    message(FATAL_ERROR "write_hashes: ${game} boot inventory is incomplete or duplicated: ${found_frames}")
  endif()
  list(LENGTH found_audio audio_count)
  if(NOT audio_count EQUAL 2)
    message(FATAL_ERROR "write_hashes: ${game} boot has ${audio_count} audio hash rows; expected 2")
  endif()
  list(REMOVE_DUPLICATES found_audio)
  list(SORT found_audio)
  if(NOT found_audio STREQUAL "pcm;transitions")
    message(FATAL_ERROR "write_hashes: ${game} boot audio hashes are incomplete or duplicated: ${found_audio}")
  endif()
endforeach()

set(movie_dir "${BUILD}/game-movies")
file(MAKE_DIRECTORY "${movie_dir}")
foreach(port IN ITEMS p0 p1 both)
  set(movie "${movie_dir}/dabg-${port}.nmovie")
  execute_process(COMMAND "${MOVIE_WRITER}" "${movie}" "${port}"
    RESULT_VARIABLE rc ERROR_VARIABLE errors)
  if(NOT rc EQUAL 0 OR NOT EXISTS "${movie}")
    message(FATAL_ERROR "write_hashes: could not create DABG ${port} input script: ${errors}")
  endif()
  execute_process(
    COMMAND "${runner}" --movie "${movie}" --rom "${source_dir}/tests/roms/dabg.nes"
    OUTPUT_VARIABLE hashes ERROR_VARIABLE errors RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "write_hashes: DABG ${port} replay exited with ${rc}: ${errors}")
  endif()
  string(REPLACE "\r" "" hashes "${hashes}")
  string(REPLACE "\n" ";" hash_lines "${hashes}")
  set(found_frames)
  foreach(line IN LISTS hash_lines)
    if(line MATCHES "^frame (1|30|60|120|180) ")
      list(APPEND output_lines "dabg/${port}/${line}")
      list(APPEND found_frames "${CMAKE_MATCH_1}")
    endif()
  endforeach()
  list(LENGTH found_frames found_count)
  if(NOT found_count EQUAL 5)
    message(FATAL_ERROR "write_hashes: DABG ${port} has ${found_count} selected hash rows; expected 5")
  endif()
  list(REMOVE_DUPLICATES found_frames)
  list(SORT found_frames COMPARE NATURAL)
  if(NOT found_frames STREQUAL "1;30;60;120;180")
    message(FATAL_ERROR "write_hashes: DABG ${port} inventory is incomplete or duplicated: ${found_frames}")
  endif()
endforeach()

# nes-runner play: the generated nesrunner-pos movie (Start, then six jumps)
# replayed for 600 frames. Frames 1 to 180 repeat the boot; 300, 450 and 600
# are past the title-to-play transition. Both audio hashes cover the whole run.
set(play_movie "${movie_dir}/nesrunner-pos.nmovie")
execute_process(COMMAND "${MOVIE_WRITER}" "${play_movie}" nesrunner-pos
  RESULT_VARIABLE rc ERROR_VARIABLE errors)
if(NOT rc EQUAL 0 OR NOT EXISTS "${play_movie}")
  message(FATAL_ERROR "write_hashes: could not create nes-runner play input script: ${errors}")
endif()
execute_process(
  COMMAND "${runner}" --movie "${play_movie}" --rom "${source_dir}/tests/roms/runner.nes" --hash-audio
  OUTPUT_VARIABLE hashes ERROR_VARIABLE errors RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "write_hashes: nes-runner play replay exited with ${rc}: ${errors}")
endif()
string(REPLACE "\r" "" hashes "${hashes}")
string(REPLACE "\n" ";" hash_lines "${hashes}")
set(found_frames)
set(found_audio)
foreach(line IN LISTS hash_lines)
  if(line MATCHES "^frame (1|30|60|120|180|300|450|600) ")
    list(APPEND output_lines "nesrunner/play/${line}")
    list(APPEND found_frames "${CMAKE_MATCH_1}")
  elseif(line MATCHES "^audio (transitions|pcm) sha256 ([0-9a-f]+)$")
    string(LENGTH "${CMAKE_MATCH_2}" digest_length)
    if(NOT digest_length EQUAL 64)
      message(FATAL_ERROR "write_hashes: nes-runner play ${CMAKE_MATCH_1} digest has ${digest_length} hex characters")
    endif()
    list(APPEND output_lines "nesrunner/play/audio/${CMAKE_MATCH_1} sha256 ${CMAKE_MATCH_2}")
    list(APPEND found_audio "${CMAKE_MATCH_1}")
  endif()
endforeach()
list(LENGTH found_frames found_count)
list(SORT found_frames COMPARE NATURAL)
if(NOT found_count EQUAL 8 OR NOT found_frames STREQUAL "1;30;60;120;180;300;450;600")
  message(FATAL_ERROR "write_hashes: nes-runner play has frame rows ${found_frames}; expected 1;30;60;120;180;300;450;600 once each")
endif()
list(SORT found_audio)
if(NOT found_audio STREQUAL "pcm;transitions")
  message(FATAL_ERROR "write_hashes: nes-runner play audio rows are incomplete or duplicated: ${found_audio}")
endif()

# Holy Mapperel result screens: one row per ROM at frame N. The screen must be
# static, so frame 2N has to hash like frame N; only the frame N row is kept.
# The same run's audio hashes become the key's two audio rows.
# An entry ending in :save runs twice against one fresh save directory. The
# second run loads the save the first wrote, so its screen is pinned under the
# key <key>.saved, and it has to differ from the first run's screen.
function(holymapperel_hash_run key file n save_dir out_row out_digest out_pcm out_transitions)
  math(EXPR n2 "${n} * 2")
  if(file MATCHES "^derived/")
    set(rom "${BUILD}/tests/holymapperel/${file}")
  else()
    set(rom "${source_dir}/tests/roms/hm/${file}")
  endif()
  set(save_args)
  if(NOT save_dir STREQUAL "")
    set(save_args --save-dir "${save_dir}")
  endif()
  execute_process(
    COMMAND "${runner}" --frames ${n2} --rom "${rom}"
      ${save_args} --hash-frame ${n} --hash-frame ${n2} --hash-audio
    OUTPUT_VARIABLE hashes ERROR_VARIABLE errors RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "write_hashes: ${key} run exited with ${rc}: ${errors}")
  endif()
  string(REPLACE "\r" "" hashes "${hashes}")
  string(REPLACE "\n" ";" hash_lines "${hashes}")
  set(first "")
  set(first_digest "")
  set(second_digest "")
  set(rows 0)
  set(audio_pcm "")
  set(audio_transitions "")
  foreach(line IN LISTS hash_lines)
    if(line MATCHES "^audio (transitions|pcm) sha256 ([0-9a-f]+)$")
      string(LENGTH "${CMAKE_MATCH_2}" digest_length)
      if(NOT digest_length EQUAL 64)
        message(FATAL_ERROR "write_hashes: ${key} ${CMAKE_MATCH_1} digest has ${digest_length} hex characters")
      endif()
      if(CMAKE_MATCH_1 STREQUAL "pcm")
        set(audio_pcm "${CMAKE_MATCH_2}")
      else()
        set(audio_transitions "${CMAKE_MATCH_2}")
      endif()
    elseif(line MATCHES "^frame ${n} .* sha256 ([0-9a-f]+)$")
      set(first "${line}")
      set(first_digest "${CMAKE_MATCH_1}")
      math(EXPR rows "${rows} + 1")
    elseif(line MATCHES "^frame ${n2} .* sha256 ([0-9a-f]+)$")
      set(second_digest "${CMAKE_MATCH_1}")
      math(EXPR rows "${rows} + 1")
    endif()
  endforeach()
  if(NOT rows EQUAL 2)
    message(FATAL_ERROR "write_hashes: ${key} has ${rows} selected hash rows; expected 2")
  endif()
  if(NOT first_digest STREQUAL second_digest)
    message(FATAL_ERROR "write_hashes: ${key} frame ${n} and frame ${n2} differ; the result screen is not static")
  endif()
  if(audio_pcm STREQUAL "" OR audio_transitions STREQUAL "")
    message(FATAL_ERROR "write_hashes: ${key} is missing an audio hash row")
  endif()
  set(${out_pcm} "${audio_pcm}" PARENT_SCOPE)
  set(${out_transitions} "${audio_transitions}" PARENT_SCOPE)
  set(${out_row} "${first}" PARENT_SCOPE)
  set(${out_digest} "${first_digest}" PARENT_SCOPE)
endfunction()

set(hm_saved_count 0)
foreach(entry IN LISTS NESTURBATOR_HOLYMAPPEREL_ROMS)
  string(REPLACE ":" ";" parts "${entry}")
  list(GET parts 0 hm_key)
  list(GET parts 1 hm_file)
  list(GET parts 2 hm_n)
  list(LENGTH parts hm_parts)
  set(hm_save "")
  if(hm_parts GREATER 4)
    list(GET parts 4 hm_save)
  endif()
  if(hm_save STREQUAL "save")
    set(hm_save_dir "${BUILD}/hm-save-${hm_key}")
    file(REMOVE_RECURSE "${hm_save_dir}")
    file(MAKE_DIRECTORY "${hm_save_dir}")
    holymapperel_hash_run("${hm_key}" "${hm_file}" ${hm_n} "${hm_save_dir}" run1_row run1_digest run1_pcm run1_transitions)
    holymapperel_hash_run("${hm_key}" "${hm_file}" ${hm_n} "${hm_save_dir}" run2_row run2_digest run2_pcm run2_transitions)
    if(run1_digest STREQUAL run2_digest)
      message(FATAL_ERROR "write_hashes: ${hm_key} run 1 and run 2 hash alike; the save did not change the screen")
    endif()
    list(APPEND output_lines "holymapperel/${hm_key}/${run1_row}")
    list(APPEND output_lines "holymapperel/${hm_key}/audio/pcm sha256 ${run1_pcm}")
    list(APPEND output_lines "holymapperel/${hm_key}/audio/transitions sha256 ${run1_transitions}")
    list(APPEND output_lines "holymapperel/${hm_key}.saved/${run2_row}")
    list(APPEND output_lines "holymapperel/${hm_key}.saved/audio/pcm sha256 ${run2_pcm}")
    list(APPEND output_lines "holymapperel/${hm_key}.saved/audio/transitions sha256 ${run2_transitions}")
    math(EXPR hm_saved_count "${hm_saved_count} + 1")
  else()
    holymapperel_hash_run("${hm_key}" "${hm_file}" ${hm_n} "" run_row run_digest run_pcm run_transitions)
    list(APPEND output_lines "holymapperel/${hm_key}/${run_row}")
    list(APPEND output_lines "holymapperel/${hm_key}/audio/pcm sha256 ${run_pcm}")
    list(APPEND output_lines "holymapperel/${hm_key}/audio/transitions sha256 ${run_transitions}")
  endif()
endforeach()

list(SORT output_lines)

# The generated keys must equal the one expected list (hash_keys.cmake), so a
# row cannot go missing, appear twice or be added here without it.
set(generated_keys)
foreach(row IN LISTS output_lines)
  if(row MATCHES "^(.*) ticks [0-9]+ sha256 [0-9a-f]+$")
    list(APPEND generated_keys "${CMAKE_MATCH_1}")
  elseif(row MATCHES "^(.* sha256) [0-9a-f]+$")
    list(APPEND generated_keys "${CMAKE_MATCH_1}")
  else()
    message(FATAL_ERROR "write_hashes: malformed row: ${row}")
  endif()
endforeach()
list(SORT generated_keys)
nesturbator_expected_hash_keys(expected_keys)
if(NOT "${generated_keys}" STREQUAL "${expected_keys}")
  set(missing_keys ${expected_keys})
  set(extra_keys ${generated_keys})
  foreach(key IN LISTS generated_keys)
    list(REMOVE_ITEM missing_keys "${key}")
  endforeach()
  foreach(key IN LISTS expected_keys)
    list(REMOVE_ITEM extra_keys "${key}")
  endforeach()
  list(JOIN missing_keys ", " missing_text)
  list(JOIN extra_keys ", " extra_text)
  message(FATAL_ERROR "write_hashes: generated keys differ from tests/cmake/hash_keys.cmake; missing: [${missing_text}] extra: [${extra_text}]")
endif()
list(JOIN output_lines "\n" hashes)
file(CONFIGURE OUTPUT "${OUT}" CONTENT "@hashes@" @ONLY NEWLINE_STYLE LF)
message(STATUS "write_hashes: wrote sorted game inventory to ${OUT}")
