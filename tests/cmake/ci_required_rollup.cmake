cmake_minimum_required(VERSION 3.25)

# The ci-required roll-up (D-16). Inputs: CI_YML (the workflow), JQ (the jq
# program), WORK (a scratch directory). The check
#   1. requires ci-required's needs to list every other job in ci.yml, and
#   2. runs the jq expression taken from ci.yml's run line on synthetic needs
#      for each event, so a push may skip perf but a pull request may not.
foreach(var CI_YML JQ WORK)
  if(NOT DEFINED ${var})
    message(FATAL_ERROR "ci_required_rollup: ${var} is not set")
  endif()
endforeach()

file(READ "${CI_YML}" yml)
string(REPLACE "\n" ";" lines "${yml}")

set(jobs "")
set(in_jobs FALSE)
set(needs_line "")
set(run_line "")
set(in_required FALSE)
foreach(line IN LISTS lines)
  if(line MATCHES "^jobs:")
    set(in_jobs TRUE)
    continue()
  endif()
  if(NOT in_jobs)
    continue()
  endif()
  if(line MATCHES "^  ([a-z][a-z0-9-]*):$")
    list(APPEND jobs "${CMAKE_MATCH_1}")
    set(in_required FALSE)
    if(CMAKE_MATCH_1 STREQUAL "ci-required")
      set(in_required TRUE)
    endif()
  elseif(in_required)
    if(line MATCHES "^    needs: \\[(.*)\\]")
      set(needs_line "${CMAKE_MATCH_1}")
    elseif(line MATCHES "^        run: echo \"\\$NEEDS\" \\| jq -e --arg event \"\\$EVENT\" '(.*)'$")
      set(run_line "${CMAKE_MATCH_1}")
    endif()
  endif()
endforeach()

if(needs_line STREQUAL "")
  message(FATAL_ERROR "ci_required_rollup: no needs list found for ci-required")
endif()
if(run_line STREQUAL "")
  message(FATAL_ERROR "ci_required_rollup: no jq run line found for ci-required")
endif()

string(REPLACE "," ";" needs "${needs_line}")
set(needs_clean "")
foreach(n IN LISTS needs)
  string(STRIP "${n}" n)
  list(APPEND needs_clean "${n}")
endforeach()

foreach(job IN LISTS jobs)
  if(NOT job STREQUAL "ci-required" AND NOT job IN_LIST needs_clean)
    message(FATAL_ERROR "ci_required_rollup: ci-required needs omit ${job}")
  endif()
endforeach()

file(MAKE_DIRECTORY "${WORK}")

# Synthetic needs: every job success, with overrides.
function(needs_json out)
  set(json "{")
  set(first TRUE)
  foreach(n IN LISTS needs_clean)
    set(result success)
    foreach(ov IN LISTS ARGN)
      if(ov MATCHES "^${n}=(.*)$")
        set(result "${CMAKE_MATCH_1}")
      endif()
    endforeach()
    if(NOT first)
      string(APPEND json ",")
    endif()
    string(APPEND json "\"${n}\":{\"result\":\"${result}\"}")
    set(first FALSE)
  endforeach()
  string(APPEND json "}")
  set(${out} "${json}" PARENT_SCOPE)
endfunction()

function(expect name event want_zero)
  needs_json(json ${ARGN})
  file(WRITE "${WORK}/needs.json" "${json}")
  execute_process(
    COMMAND "${JQ}" -e --arg event "${event}" "${run_line}"
    INPUT_FILE "${WORK}/needs.json"
    RESULT_VARIABLE rc OUTPUT_QUIET ERROR_QUIET)
  if(want_zero AND NOT rc EQUAL 0)
    message(FATAL_ERROR "ci_required_rollup: ${name}: expected exit 0, got ${rc}")
  endif()
  if(NOT want_zero AND rc EQUAL 0)
    message(FATAL_ERROR "ci_required_rollup: ${name}: expected a failure, got exit 0")
  endif()
endfunction()

expect("push, perf skipped" push TRUE perf=skipped)
expect("workflow_dispatch, perf skipped" workflow_dispatch TRUE perf=skipped)
expect("pull_request, perf skipped" pull_request FALSE perf=skipped)
expect("pull_request, all success" pull_request TRUE)
expect("pull_request, perf failure" pull_request FALSE perf=failure)
expect("push, build failure" push FALSE build=failure perf=skipped)
expect("push, perf failure" push FALSE perf=failure)
expect("push, build skipped" push FALSE build=skipped perf=skipped)

message(STATUS "ci_required_rollup: all cases behave")
