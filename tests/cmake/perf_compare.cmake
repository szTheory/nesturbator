cmake_minimum_required(VERSION 3.25)

# PERF-02 (15-CONTEXT D-10, D-11, D-12, D-14, D-17): compare Cachegrind instruction counts
# of the base and head runners and print a Markdown table. Inputs:
#   -DMODE=report|gate   gate fails on a slowdown, report only prints
#   -DDIR=<dir>          holds <who>_<rom>_<n>.out; who is base_a, base_b or head; n is 60 or 360
#   -DALLOW=<file>       the allow file (tests/perf/allow.txt format); -DLABEL=<printed name>
#   -DOUT=<file>         the Markdown summary
#   -DTODAY=YYYY-MM-DD   the check date (default: today, UTC)
#   -DBASE_SHA -DHEAD_SHA -DVALGRIND_VERSION -DGCC_VERSION   footer text, checked before use
# Formula: d = Ir(360) - Ir(60) per ROM; Ir/frame = d / 300.
# A ROM FAILs when (d_head - d_base) * 100 > d_base, so exactly +1.00% passes and a speed-up
# never fails. Status words: ok, ALLOWED, FAIL, n/a, UNSTABLE.
#   UNSTABLE   base_a and base_b differ; fails in every mode and no allow line excuses it.
#   n/a        no base measurement (never fails); no head measurement in report mode.
#   FAIL       in gate mode a missing head also fails.

foreach(var MODE DIR ALLOW OUT)
  if(NOT DEFINED ${var})
    message(FATAL_ERROR "${var} is required")
  endif()
endforeach()
if(NOT MODE STREQUAL "report" AND NOT MODE STREQUAL "gate")
  message(FATAL_ERROR "MODE must be report or gate, not '${MODE}'")
endif()
if(NOT DEFINED LABEL)
  set(LABEL "tests/perf/allow.txt")
endif()
if(NOT DEFINED TODAY)
  string(TIMESTAMP TODAY "%Y-%m-%d" UTC)
endif()
if(NOT TODAY MATCHES "^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$")
  message(FATAL_ERROR "TODAY must be YYYY-MM-DD")
endif()

foreach(var BASE_SHA HEAD_SHA)
  if(NOT DEFINED ${var} OR "${${var}}" STREQUAL "")
    set(${var} "n/a")
  else()
    string(LENGTH "${${var}}" sha_len)
    if(NOT "${${var}}" MATCHES "^[0-9a-f]+$" OR NOT sha_len EQUAL 40)
      message(FATAL_ERROR "${var} is not a 40-digit lowercase hex SHA")
    endif()
  endif()
endforeach()
foreach(var VALGRIND_VERSION GCC_VERSION)
  if(NOT DEFINED ${var} OR "${${var}}" STREQUAL "")
    set(${var} "n/a")
  elseif(NOT "${${var}}" MATCHES "^[A-Za-z0-9 ._()+:~-]*$")
    message(FATAL_ERROR "unsafe version text in ${var}")
  endif()
endforeach()

# The ROMs and their mappers, fixed (D-09).
set(roms nesteroids runner M4_P256K_C256K)
set(mapper_nesteroids 0)
set(mapper_runner 1)
set(mapper_M4_P256K_C256K 4)

# Days since 1970-01-01 for a date with year >= 1970 and no leading zeros on month or day.
function(days_from_civil out y m d)
  if(m LESS_EQUAL 2)
    math(EXPR y "${y} - 1")
  endif()
  math(EXPR era "${y} / 400")
  math(EXPR yoe "${y} - ${era} * 400")
  if(m GREATER 2)
    math(EXPR mp "${m} - 3")
  else()
    math(EXPR mp "${m} + 9")
  endif()
  math(EXPR doy "(153 * ${mp} + 2) / 5 + ${d} - 1")
  math(EXPR doe "${yoe} * 365 + ${yoe} / 4 - ${yoe} / 100 + ${doy}")
  math(EXPR days "${era} * 146097 + ${doe} - 719468")
  set(${out} ${days} PARENT_SCOPE)
endfunction()

# Remove leading zeros from a digit string (CMake reads 08 as invalid octal).
function(strip_zeros out value)
  string(REGEX REPLACE "^0+([0-9])" "\\1" value "${value}")
  set(${out} "${value}" PARENT_SCOPE)
endfunction()

# Signed value / divisor, rounded toward zero, printed with a sign.
function(signed_div out value divisor)
  if(value LESS 0)
    math(EXPR abs "-(${value})")
    math(EXPR q "${abs} / ${divisor}")
    set(${out} "-${q}" PARENT_SCOPE)
  else()
    math(EXPR q "${value} / ${divisor}")
    set(${out} "+${q}" PARENT_SCOPE)
  endif()
endfunction()

# delta / base as a signed percent with two decimals, for display only.
function(signed_percent out delta base)
  if(delta LESS 0)
    math(EXPR abs "-(${delta})")
    set(sign "-")
  else()
    set(abs ${delta})
    set(sign "+")
  endif()
  math(EXPR x100 "${abs} * 10000 / ${base}")
  math(EXPR whole "${x100} / 100")
  math(EXPR frac "${x100} % 100")
  if(frac LESS 10)
    set(frac "0${frac}")
  endif()
  set(${out} "${sign}${whole}.${frac}%" PARENT_SCOPE)
endfunction()

# d = Ir(360) - Ir(60) for one side, or empty when a file or its summary line is missing.
function(read_side out who rom)
  set(irs "")
  foreach(n 60 360)
    set(file "${DIR}/${who}_${rom}_${n}.out")
    if(NOT EXISTS "${file}")
      set(${out} "" PARENT_SCOPE)
      return()
    endif()
    file(STRINGS "${file}" found REGEX "^summary:")
    list(LENGTH found count)
    if(NOT count EQUAL 1 OR NOT "${found}" MATCHES "^summary: *([0-9]+)$")
      set(${out} "" PARENT_SCOPE)
      return()
    endif()
    list(APPEND irs "${CMAKE_MATCH_1}")
  endforeach()
  list(GET irs 0 ir60)
  list(GET irs 1 ir360)
  math(EXPR d "${ir360} - ${ir60}")
  if(d LESS_EQUAL 0)
    set(d "")
  endif()
  set(${out} "${d}" PARENT_SCOPE)
endfunction()

set(errors "")

# Allow file (D-17): <rom> <max_percent_x100> <expires YYYY-MM-DD> <reason...>. Every problem
# is fatal in both modes. The reason is checked for presence and never printed (D-12).
string(REGEX MATCH "^([0-9]+)-([0-9]+)-([0-9]+)$" today_match "${TODAY}")
set(ty ${CMAKE_MATCH_1})
strip_zeros(tm "${CMAKE_MATCH_2}")
strip_zeros(td "${CMAKE_MATCH_3}")
days_from_civil(today_days ${ty} ${tm} ${td})
foreach(rom IN LISTS roms)
  set(cap_${rom} "")
endforeach()
file(STRINGS "${ALLOW}" allow_lines)
set(allow_n 0)
foreach(line IN LISTS allow_lines)
  math(EXPR allow_n "${allow_n} + 1")
  if(line MATCHES "^[ \t]*$" OR line MATCHES "^#")
    continue()
  endif()
  if(NOT line MATCHES "^([A-Za-z0-9_.-]+) ([0-9]+) ([0-9][0-9][0-9][0-9])-([0-9][0-9])-([0-9][0-9])( (.*))?$")
    message(FATAL_ERROR "malformed allow line: ${allow_n} of ${LABEL}")
  endif()
  set(a_rom "${CMAKE_MATCH_1}")
  set(a_cap "${CMAKE_MATCH_2}")
  set(a_y "${CMAKE_MATCH_3}")
  set(a_m "${CMAKE_MATCH_4}")
  set(a_d "${CMAKE_MATCH_5}")
  set(a_reason "${CMAKE_MATCH_7}")
  set(a_date "${CMAKE_MATCH_3}-${CMAKE_MATCH_4}-${CMAKE_MATCH_5}")
  string(STRIP "${a_reason}" a_reason)
  if(a_reason STREQUAL "")
    message(FATAL_ERROR "allow line has no reason: ${allow_n} of ${LABEL}")
  endif()
  if(NOT a_rom IN_LIST roms)
    message(FATAL_ERROR "unknown ROM in allow line: ${a_rom}")
  endif()
  if(NOT "${cap_${a_rom}}" STREQUAL "")
    message(FATAL_ERROR "duplicate allow line for ${a_rom}")
  endif()
  strip_zeros(a_cap "${a_cap}")
  strip_zeros(a_m "${a_m}")
  strip_zeros(a_d "${a_d}")
  days_from_civil(exp_days ${a_y} ${a_m} ${a_d})
  if(exp_days LESS today_days)
    message(FATAL_ERROR "allow line expired: ${a_rom} ${a_date}")
  endif()
  math(EXPR ahead "${exp_days} - ${today_days}")
  if(ahead GREATER 60)
    message(FATAL_ERROR "allow line for ${a_rom} expires more than 60 days after ${TODAY}")
  endif()
  set(cap_${a_rom} "${a_cap}")
  set(line_${a_rom} ${allow_n})
  set(exp_${a_rom} "${a_date}")
endforeach()


set(table "| ROM | mapper | base Ir/frame | head Ir/frame | delta Ir/frame | delta % | status |\n")
string(APPEND table "|---|---|---|---|---|---|---|\n")
set(notes "")

foreach(rom IN LISTS roms)
  read_side(base_a base_a ${rom})
  read_side(base_b base_b ${rom})
  read_side(head head ${rom})
  set(status "ok")
  set(base_cell "n/a")
  set(head_cell "n/a")
  set(delta_cell "n/a")
  set(pct_cell "n/a")
  if(NOT head STREQUAL "")
    math(EXPR per_frame "${head} / 300")
    set(head_cell "${per_frame}")
  endif()
  if(NOT base_a STREQUAL "")
    math(EXPR per_frame "${base_a} / 300")
    set(base_cell "${per_frame}")
  endif()
  if(NOT base_a STREQUAL "" AND NOT base_b STREQUAL "" AND NOT base_a EQUAL base_b)
    set(status "UNSTABLE")
    message(STATUS "UNSTABLE: ${rom} base_a ${base_a} base_b ${base_b}")
    list(APPEND errors "UNSTABLE: ${rom} base_a ${base_a} base_b ${base_b}")
  elseif(base_a STREQUAL "" OR base_b STREQUAL "")
    set(status "n/a")
  elseif(head STREQUAL "")
    if(MODE STREQUAL "gate")
      set(status "FAIL")
      list(APPEND errors "perf gate: missing head for ${rom}")
    else()
      set(status "n/a")
    endif()
  else()
    math(EXPR delta "${head} - ${base_a}")
    math(EXPR scaled "${delta} * 100")
    signed_div(delta_cell ${delta} 300)
    signed_percent(pct_cell ${delta} ${base_a})
    if(scaled GREATER base_a)
      set(status "FAIL")
      if(NOT "${cap_${rom}}" STREQUAL "")
        math(EXPR capped "${delta} * 10000")
        math(EXPR allowed "${cap_${rom}} * ${base_a}")
        math(EXPR cap_whole "${cap_${rom}} / 100")
        math(EXPR cap_frac "${cap_${rom}} % 100")
        if(cap_frac LESS 10)
          set(cap_frac "0${cap_frac}")
        endif()
        if(capped GREATER allowed)
          list(APPEND errors
            "perf gate: ${rom} ${pct_cell} exceeds its allow cap of ${cap_whole}.${cap_frac}%")
        else()
          set(status "ALLOWED")
          string(APPEND notes
            "ALLOWED ${rom} cap ${cap_whole}.${cap_frac}% expires ${exp_${rom}} (${LABEL} line ${line_${rom}})\n")
        endif()
      else()
        list(APPEND errors "perf gate: ${rom} ${pct_cell} exceeds +1.00%")
      endif()
    endif()
  endif()
  string(APPEND table
    "| ${rom} | ${mapper_${rom}} | ${base_cell} | ${head_cell} | ${delta_cell} | ${pct_cell} | ${status} |\n")
endforeach()

string(APPEND table "\n${notes}")
string(APPEND table "base ${BASE_SHA} head ${HEAD_SHA}\n")
string(APPEND table "valgrind: ${VALGRIND_VERSION}\n")
string(APPEND table "gcc: ${GCC_VERSION}\n")
string(APPEND table
  "Ir/frame = (Ir(360) - Ir(60)) / 300; FAIL when (d_head - d_base) * 100 > d_base\n")
file(WRITE "${OUT}" "${table}")
message(STATUS "\n${table}")
# message() wraps long lines; echo keeps each ALLOWED line whole in the log.
string(REGEX MATCHALL "ALLOWED [^\n]*" allowed_lines "${notes}")
foreach(l IN LISTS allowed_lines)
  execute_process(COMMAND ${CMAKE_COMMAND} -E echo "${l}")
endforeach()

# Exit: UNSTABLE always; every other FAIL only in gate mode.
set(fatal "")
foreach(e IN LISTS errors)
  if(e MATCHES "^UNSTABLE" OR MODE STREQUAL "gate")
    list(APPEND fatal "${e}")
  endif()
endforeach()
if(fatal)
  list(JOIN fatal "\n" fatal)
  message(FATAL_ERROR "${fatal}")
endif()
