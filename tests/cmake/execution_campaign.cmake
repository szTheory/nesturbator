  set(MODE "${CAMPAIGN_MODE}")
endif()

if(DEFINED SELFTEST_CHILD AND NOT SELFTEST_CHILD STREQUAL "")
  if(SELFTEST_CHILD STREQUAL "resource")
    message(FATAL_ERROR "ERROR: libFuzzer: out-of-memory; exact input not retained by this fixture")
  elseif(SELFTEST_CHILD STREQUAL "crash")
    file(WRITE "${CHILD_ARTIFACT}" "${CHILD_CONTENT}")
    message(FATAL_ERROR "ERROR: AddressSanitizer: synthetic crash")
  elseif(SELFTEST_CHILD STREQUAL "timeout")
    file(WRITE "${CHILD_ARTIFACT}" "${CHILD_CONTENT}")
    message(FATAL_ERROR "ALARM: libFuzzer: timeout after synthetic per-input delay")
  elseif(SELFTEST_CHILD STREQUAL "mutation")
    file(WRITE "${CHILD_ARTIFACT}" "mutation fixture\n")
  else()
    message(FATAL_ERROR "unknown child control: ${SELFTEST_CHILD}")
  endif()
  return()
endif()

foreach(required IN ITEMS SOURCE_DIR BUILD_DIR OUTPUT_DIR MODE)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "execution campaign needs ${required}")
  endif()
endforeach()
if(NOT DEFINED BUDGET_FILE OR "${BUDGET_FILE}" STREQUAL "")
  if(MODE STREQUAL "self-test")
    set(BUDGET_FILE "tests/fuzz/execution-budgets.txt")
  else()
    message(FATAL_ERROR "execution campaign needs BUDGET_FILE")
  endif()
endif()

get_filename_component(source_root "${SOURCE_DIR}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_LIST_DIR}/../..")
get_filename_component(build_root "${BUILD_DIR}" ABSOLUTE BASE_DIR "${source_root}")
get_filename_component(output_root "${OUTPUT_DIR}" ABSOLUTE BASE_DIR "${source_root}")
get_filename_component(budget_file "${BUDGET_FILE}" ABSOLUTE BASE_DIR "${source_root}")
file(RELATIVE_PATH output_relative "${source_root}" "${output_root}")
if(output_relative MATCHES "^\.\.[/\\]" OR output_relative STREQUAL "..")
  message(FATAL_ERROR "campaign output must stay inside the source checkout so artifact paths remain relative")
endif()
if(NOT EXISTS "${budget_file}" OR IS_DIRECTORY "${budget_file}")
  message(FATAL_ERROR "execution campaign budget file is missing: ${BUDGET_FILE}")
endif()

function(read_budget key out_value)
  file(STRINGS "${budget_file}" budget_lines)
  set(found "")
  foreach(line IN LISTS budget_lines)
    string(STRIP "${line}" line)
    if(line STREQUAL "" OR line MATCHES "^#")
      continue()
    endif()
    if(line MATCHES "^([A-Za-z0-9_.-]+)=(.*)$")
      if(CMAKE_MATCH_1 STREQUAL "${key}")
        if(NOT found STREQUAL "")
          message(FATAL_ERROR "duplicate budget field ${key}")
        endif()
        set(found "${CMAKE_MATCH_2}")
      endif()
    else()
      message(FATAL_ERROR "invalid budget line: ${line}")
    endif()
  endforeach()
  if(found STREQUAL "")
    message(FATAL_ERROR "missing budget field ${key}")
  endif()
  set(${out_value} "${found}" PARENT_SCOPE)
endfunction()

function(require_positive_integer key out_value)
  read_budget("${key}" value)
  if(NOT value MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "budget field ${key} must be a positive measured integer, got '${value}'")
  endif()
  set(${out_value} "${value}" PARENT_SCOPE)
endfunction()

function(hash_corpus target corpus_dir out_manifest out_count)
  file(GLOB_RECURSE entries LIST_DIRECTORIES FALSE "${corpus_dir}/*")
  list(SORT entries)
  set(manifest "")
  set(count 0)
  foreach(entry IN LISTS entries)
    file(SHA256 "${entry}" sha)
    file(RELATIVE_PATH relative "${source_root}" "${entry}")
    string(APPEND manifest "${target}\t${relative}\t${sha}\n")
    math(EXPR count "${count} + 1")
  endforeach()
  set(${out_manifest} "${manifest}" PARENT_SCOPE)
  set(${out_count} "${count}" PARENT_SCOPE)
endfunction()

function(require_artifact path expected_sha out_error)
  if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
    set(${out_error} "missing exact input artifact" PARENT_SCOPE)
    return()
  endif()
  file(SHA256 "${path}" actual_sha)
  if(NOT actual_sha STREQUAL "${expected_sha}")
    set(${out_error} "artifact bytes do not match the triggering input" PARENT_SCOPE)
    return()
  endif()
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(collect_reproducers artifact_dir destination_dir out_files out_error)
  if(NOT IS_DIRECTORY "${artifact_dir}")
    set(${out_files} "" PARENT_SCOPE)
    set(${out_error} "campaign artifact directory is missing" PARENT_SCOPE)
    return()
  endif()
  file(MAKE_DIRECTORY "${destination_dir}")
  file(GLOB artifacts LIST_DIRECTORIES FALSE "${artifact_dir}/*")
  set(copied_files "")
  foreach(artifact IN LISTS artifacts)
    get_filename_component(artifact_name "${artifact}" NAME)
    if(artifact_name MATCHES "^(crash-|timeout-|oom-|leak-)")
      set(reproducer "${destination_dir}/${artifact_name}")
      file(COPY_FILE "${artifact}" "${reproducer}" ONLY_IF_DIFFERENT)
      file(SHA256 "${artifact}" source_sha)
      file(SHA256 "${reproducer}" copied_sha)
      if(NOT source_sha STREQUAL copied_sha)
        set(${out_files} "${copied_files}" PARENT_SCOPE)
        set(${out_error} "copied artifact differs from the libFuzzer artifact" PARENT_SCOPE)
        return()
      endif()
      list(APPEND copied_files "${reproducer}")
    endif()
  endforeach()
  set(${out_files} "${copied_files}" PARENT_SCOPE)
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(check_target_acceptance target replay input out_accepted out_error)
  if(target STREQUAL "execution")
    execute_process(COMMAND "${replay}" --accept-only "${input}"
      RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0 OR NOT output MATCHES "ACCEPTANCE target=execution accepted=[01]")
      set(${out_error} "execution acceptance check failed: ${error}${output}" PARENT_SCOPE)
      return()
    endif()
    string(REGEX MATCH "accepted=([01])" acceptance_match "${output}")
    set(accepted "${CMAKE_MATCH_1}")
  elseif(target STREQUAL "rom-loader" OR target STREQUAL "state-loader")
    execute_process(COMMAND "${replay}" --accept-only "${input}"
      RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0 OR NOT output MATCHES "ACCEPTANCE target=[^ ]+ accepted=[01]")
      set(${out_error} "${target} acceptance check failed: ${error}${output}" PARENT_SCOPE)
      return()
    endif()
    string(REGEX MATCH "accepted=([01])" acceptance_match "${output}")
    set(accepted "${CMAKE_MATCH_1}")
  else()
    set(${out_error} "unknown fuzz target identity '${target}'" PARENT_SCOPE)
    return()
  endif()
  set(${out_accepted} "${accepted}" PARENT_SCOPE)
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(observe_failure target binary input control out_class out_operation out_error)
  require_positive_integer("campaign.${target}.per_input_timeout_seconds" input_timeout)
  require_positive_integer("campaign.${target}.max_len" max_len)
  require_positive_integer("campaign.${target}.rss_limit_mb" rss_limit)
  require_positive_integer("campaign.${target}.outer_timeout_seconds" outer_timeout)
  set(environment "NESTURBATOR_FUZZ_TRACE_OPERATION=1")
  if(NOT "${control}" STREQUAL "")
    list(APPEND environment "NESTURBATOR_FUZZ_CONTROL=${control}")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${environment} "${binary}"
      "-timeout=${input_timeout}" "-max_len=${max_len}" "-rss_limit_mb=${rss_limit}" "${input}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT "${outer_timeout}")
  set(combined "${error}\n${output}")
  if("${result}" MATCHES "timeout")
    set(failure_class outer-timeout)
  elseif(combined MATCHES "ERROR: AddressSanitizer|SUMMARY: AddressSanitizer|AddressSanitizer:.*Sanitizer")
    set(failure_class address-sanitizer)
  elseif(combined MATCHES "UndefinedBehaviorSanitizer|runtime error:")
    set(failure_class undefined-behavior)
  elseif(combined MATCHES "LeakSanitizer|detected memory leaks")
    set(failure_class leak-sanitizer)
  elseif(combined MATCHES "ALARM:.*timeout|Timeout:|libFuzzer: timeout after")
    set(failure_class per-input-timeout)
  elseif(combined MATCHES "out-of-memory|OOM|RSS limit")
    set(failure_class resource-limit)
  elseif(combined MATCHES "oracle failed:")
    set(failure_class oracle-failure)
  elseif(NOT "${result}" STREQUAL "0")
    set(failure_class process-failure)
  else()
    set(failure_class none)
  endif()
  string(REGEX MATCHALL "fuzz[.]operation=[A-Za-z0-9_.-]+" operation_markers "${combined}")
  if(operation_markers)
    list(GET operation_markers -1 last_marker)
    string(REPLACE "fuzz.operation=" "" operation "${last_marker}")
  else()
    set(operation "unavailable")
  endif()
  set(${out_class} "${failure_class}" PARENT_SCOPE)
  set(${out_operation} "${operation}" PARENT_SCOPE)
  set(${out_error} "${error}${output}" PARENT_SCOPE)
endfunction()

function(validate_minimized target original reduced expected_acceptance expected_class expected_operation
         binary replay control out_error)
  if(NOT EXISTS "${original}" OR NOT EXISTS "${reduced}")
    set(${out_error} "original or reduced input is missing" PARENT_SCOPE)
    return()
  endif()
  file(SHA256 "${original}" before_sha)
  file(SIZE "${original}" original_size)
  file(SIZE "${reduced}" reduced_size)
  if(NOT expected_acceptance MATCHES "^(accepted|rejected)$")
    set(${out_error} "expected acceptance must be accepted or rejected" PARENT_SCOPE)
    return()
  endif()
  if(reduced_size GREATER original_size)
    set(${out_error} "minimized input grew beyond its original" PARENT_SCOPE)
    return()
  endif()
  if(NOT expected_operation MATCHES "^[A-Za-z0-9_.-]+$")
    set(${out_error} "intended operation must be a named API identity" PARENT_SCOPE)
    return()
  endif()
  check_target_acceptance("${target}" "${replay}" "${original}" original_accepted measure_error)
  if(NOT measure_error STREQUAL "")
    set(${out_error} "original target-specific acceptance check failed: ${measure_error}" PARENT_SCOPE)
    return()
  endif()
  check_target_acceptance("${target}" "${replay}" "${reduced}" reduced_accepted measure_error)
  if(NOT measure_error STREQUAL "")
    set(${out_error} "reduced target-specific acceptance check failed: ${measure_error}" PARENT_SCOPE)
    return()
  endif()
  if(expected_acceptance STREQUAL "accepted")
    set(expected_accepted 1)
  else()
    set(expected_accepted 0)
  endif()
  if(NOT original_accepted EQUAL expected_accepted OR NOT reduced_accepted EQUAL expected_accepted)
    set(${out_error} "${target} acceptance changed or did not match the expected ${expected_acceptance} result (observed ${original_accepted}/${reduced_accepted})" PARENT_SCOPE)
    return()
  endif()
  observe_failure("${target}" "${binary}" "${original}" "${control}" original_class original_operation original_output)
  observe_failure("${target}" "${binary}" "${reduced}" "${control}" reduced_class reduced_operation reduced_output)
  if(NOT original_class STREQUAL "${expected_class}" OR NOT reduced_class STREQUAL "${expected_class}")
    set(${out_error} "observed failure class did not match ${expected_class} (original=${original_class}, reduced=${reduced_class})" PARENT_SCOPE)
    return()
  endif()
  if(NOT original_operation STREQUAL "${expected_operation}" OR
     NOT reduced_operation STREQUAL "${expected_operation}")
    set(${out_error} "observed operation did not match ${expected_operation} (original=${original_operation}, reduced=${reduced_operation})" PARENT_SCOPE)
    return()
  endif()
  file(SHA256 "${original}" after_sha)
  if(NOT before_sha STREQUAL after_sha)
    set(${out_error} "minimization changed the preserved original" PARENT_SCOPE)
    return()
  endif()
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(classify_run process_result process_stderr artifact_count out_status out_class)
  set(status completed)
  set(failure_class none)
  if("${process_result}" MATCHES "timeout")
    set(status incomplete-outer-timeout)
    set(failure_class outer-cancellation)
  elseif(NOT process_result EQUAL 0)
    set(status failed)
    if(process_stderr MATCHES "timeout after|Timeout:|ALARM:.*timeout")
      set(failure_class per-input-timeout)
    elseif(process_stderr MATCHES "out-of-memory|oom|RSS limit|rss limit")
      set(failure_class resource-limit)
    elseif(process_stderr MATCHES "ERROR: AddressSanitizer|runtime error:|UndefinedBehaviorSanitizer|SUMMARY: ThreadSanitizer")
      set(failure_class sanitizer-crash)
    else()
      set(failure_class process-failure)
    endif()
    if(artifact_count EQUAL 0)
      set(status failed-evidence-incomplete)
    endif()
  endif()
  set(${out_status} "${status}" PARENT_SCOPE)
  set(${out_class} "${failure_class}" PARENT_SCOPE)
endfunction()

function(classify_stop actual_runs run_limit elapsed_seconds time_limit out_reason)
  if("${actual_runs}" GREATER_EQUAL "${run_limit}")
    set(reason run-count-cap)
  elseif("${elapsed_seconds}" GREATER_EQUAL "${time_limit}")
    set(reason max-total-time)
  else()
    set(reason completed-before-configured-caps)
  endif()
  set(${out_reason} "${reason}" PARENT_SCOPE)
endfunction()

function(minimize_failure target binary replay original reduced expected_acceptance expected_class
         expected_operation control log_dir out_error)
  require_positive_integer("campaign.${target}.runs" run_cap)
  require_positive_integer("campaign.${target}.max_total_time_seconds" total_time)
  require_positive_integer("campaign.${target}.per_input_timeout_seconds" input_timeout)
  require_positive_integer("campaign.${target}.max_len" max_len)
  require_positive_integer("campaign.${target}.rss_limit_mb" rss_limit)
  require_positive_integer("campaign.${target}.outer_timeout_seconds" outer_timeout)
  file(MAKE_DIRECTORY "${log_dir}")
  file(SHA256 "${original}" original_sha_before)
  set(environment "NESTURBATOR_FUZZ_TRACE_OPERATION=1")
  if(NOT "${control}" STREQUAL "")
    list(APPEND environment "NESTURBATOR_FUZZ_CONTROL=${control}")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${environment} "${binary}"
      "-minimize_crash=1" "-runs=${run_cap}" "-max_total_time=${total_time}"
      "-timeout=${input_timeout}" "-max_len=${max_len}" "-rss_limit_mb=${rss_limit}"
      "-exact_artifact_path=${reduced}" "${original}"
    RESULT_VARIABLE minimize_result OUTPUT_VARIABLE minimize_out ERROR_VARIABLE minimize_err
    TIMEOUT "${outer_timeout}")
  file(WRITE "${log_dir}/minimize.stdout" "${minimize_out}")
  file(WRITE "${log_dir}/minimize.stderr" "${minimize_err}")
  if(NOT "${minimize_result}" STREQUAL "0" OR NOT EXISTS "${reduced}")
    set(${out_error} "bounded minimizer failed or emitted no reduced input (${minimize_result}): ${minimize_err}${minimize_out}" PARENT_SCOPE)
    return()
  endif()
  validate_minimized("${target}" "${original}" "${reduced}" "${expected_acceptance}"
    "${expected_class}" "${expected_operation}" "${binary}" "${replay}" "${control}" validation_error)
  if(NOT validation_error STREQUAL "")
    set(${out_error} "reduced input did not retain target acceptance and observed failure: ${validation_error}" PARENT_SCOPE)
    return()
  endif()
  file(SIZE "${original}" original_size)
  file(SIZE "${reduced}" reduced_size)
  if(reduced_size GREATER original_size)
    set(${out_error} "minimized input grew from ${original_size} to ${reduced_size} bytes" PARENT_SCOPE)
    return()
  endif()
  file(SHA256 "${original}" original_sha_after)
  if(NOT original_sha_before STREQUAL original_sha_after)
    set(${out_error} "minimization changed its preserved original" PARENT_SCOPE)
    return()
  endif()
  file(SHA256 "${reduced}" reduced_sha)
  observe_failure("${target}" "${binary}" "${original}" "${control}"
    original_class original_operation original_output)
  observe_failure("${target}" "${binary}" "${reduced}" "${control}"
    reduced_class reduced_operation reduced_output)
  if(NOT original_class STREQUAL "${expected_class}" OR
     NOT reduced_class STREQUAL "${expected_class}" OR
     NOT original_operation STREQUAL "${expected_operation}" OR
     NOT reduced_operation STREQUAL "${expected_operation}")
    set(${out_error} "failure changed while writing exact replay logs" PARENT_SCOPE)
    return()
  endif()
  file(WRITE "${log_dir}/original-replay.log" "${original_output}")
  file(WRITE "${log_dir}/reduced-replay.log" "${reduced_output}")
  file(WRITE "${log_dir}/minimize-result.tsv"
    "target\t${target}\nacceptance\t${expected_acceptance}\nobserved_failure_class\t${expected_class}\n"
    "observed_operation\t${expected_operation}\noriginal_bytes\t${original_size}\nreduced_bytes\t${reduced_size}\n"
    "original_sha256\t${original_sha_after}\nreduced_sha256\t${reduced_sha}\ncontrol\t${control}\n")
  set(${out_error} "" PARENT_SCOPE)
endfunction()

if(MODE STREQUAL "self-test")
  classify_stop(100000 100000 4.48 10 stop_by_runs)
  classify_stop(322 1000 16.05 15 stop_by_time)
  classify_stop(20 1000 1.2 15 stop_before_caps)
  if(NOT stop_by_runs STREQUAL "run-count-cap" OR
     NOT stop_by_time STREQUAL "max-total-time" OR
     NOT stop_before_caps STREQUAL "completed-before-configured-caps")
    message(FATAL_ERROR "campaign stop-cause controls misclassified completed run evidence")
  endif()
  set(fixtures "${output_root}/fixtures")
  file(REMOVE_RECURSE "${fixtures}/artifacts" "${fixtures}/uploaded" "${fixtures}/minimize")
  file(MAKE_DIRECTORY "${fixtures}" "${fixtures}/artifacts" "${fixtures}/uploaded")
  set(input "${fixtures}/triggering-input")
  set(resource_artifact "${output_root}/artifacts/state-loader/resource-must-not-claim-input")
  set(replay_binary "${build_root}/tests/fuzz.execution")
  file(WRITE "${input}" "descriptor-only fixture")
  file(SHA256 "${input}" input_sha)
  file(REMOVE_RECURSE "${output_root}/artifacts/rom-loader" "${output_root}/reproducers/rom-loader"
    "${output_root}/artifacts/state-loader" "${output_root}/reproducers/state-loader")

  foreach(kind IN ITEMS crash timeout resource)
    if(kind STREQUAL "resource")
      set(artifact_dir "${output_root}/artifacts/state-loader")
      set(upload_dir "${output_root}/reproducers/state-loader")
    else()
      set(artifact_dir "${output_root}/artifacts/rom-loader")
      set(upload_dir "${output_root}/reproducers/rom-loader")
    endif()
    file(REMOVE_RECURSE "${artifact_dir}" "${upload_dir}")
    file(MAKE_DIRECTORY "${artifact_dir}")
    set(artifact "${artifact_dir}/${kind}-synthetic-control")
    execute_process(COMMAND "${CMAKE_COMMAND}"
        "-DSELFTEST_CHILD=${kind}" "-DCHILD_ARTIFACT=${artifact}"
        "-DCHILD_CONTENT=descriptor-only fixture" -P "${CMAKE_CURRENT_LIST_FILE}"
      RESULT_VARIABLE child_result OUTPUT_VARIABLE child_out ERROR_VARIABLE child_err)
    if("${child_result}" STREQUAL "0")
      message(FATAL_ERROR "${kind} child control unexpectedly succeeded")
    endif()
    if(kind STREQUAL "resource")
      if(EXISTS "${resource_artifact}" OR NOT child_err MATCHES "out-of-memory")
        message(FATAL_ERROR "resource control fabricated an exact input artifact or lost its diagnostic")
      endif()
      classify_run("${child_result}" "${child_err}" 0 child_status child_class)
      if(NOT child_status STREQUAL "failed-evidence-incomplete" OR NOT child_class STREQUAL "resource-limit")
        message(FATAL_ERROR "resource failure without an input was incorrectly classified ${child_status}/${child_class}")
      endif()
    else()
      collect_reproducers("${artifact_dir}" "${upload_dir}" uploaded_files collect_error)
      list(LENGTH uploaded_files uploaded_count)
      if(NOT collect_error STREQUAL "" OR NOT uploaded_count EQUAL 1)
        message(FATAL_ERROR "${kind} artifact collector did not copy exactly one fixture: ${collect_error} (${uploaded_count})")
      endif()
      list(GET uploaded_files 0 uploaded_artifact)
      require_artifact("${uploaded_artifact}" "${input_sha}" artifact_error)
      if(NOT artifact_error STREQUAL "")
        message(FATAL_ERROR "${kind} collector failed to copy exact bytes through campaign discovery: ${artifact_error}")
      endif()
      classify_run("${child_result}" "${child_err}" 1 child_status child_class)
      if(kind STREQUAL "crash" AND
         (NOT child_status STREQUAL "failed" OR NOT child_class STREQUAL "sanitizer-crash"))
        message(FATAL_ERROR "crash evidence was incorrectly classified ${child_status}/${child_class}")
      endif()
      if(kind STREQUAL "timeout" AND
         (NOT child_status STREQUAL "failed" OR NOT child_class STREQUAL "per-input-timeout"))
        message(FATAL_ERROR "per-input timeout evidence was incorrectly classified ${child_status}/${child_class}")
      endif()
    endif()
  endforeach()

  set(missing_artifact_dir "${output_root}/artifacts/execution-missing")
  file(REMOVE_RECURSE "${missing_artifact_dir}" "${output_root}/reproducers/execution")
  collect_reproducers("${missing_artifact_dir}" "${output_root}/reproducers/execution"
    missing_uploads collector_error)
  list(LENGTH missing_uploads missing_upload_count)
  classify_run(1 "synthetic collector lost the input" "${missing_upload_count}"
    missing_status missing_class)
  if(collector_error STREQUAL "" OR NOT missing_upload_count EQUAL 0 OR
     NOT missing_status STREQUAL "failed-evidence-incomplete")
    message(FATAL_ERROR "broken collector/missing input was not classified incomplete")
  endif()

  set(invalid_execution "${fixtures}/unaccepted-execution")
  file(WRITE "${invalid_execution}" "not an accepted execution descriptor")
  check_target_acceptance("execution" "${replay_binary}" "${invalid_execution}"
    invalid_accepted invalid_error)
  if(NOT invalid_error STREQUAL "" OR NOT invalid_accepted EQUAL 0)
    message(FATAL_ERROR "unaccepted execution control did not remain rejected: ${invalid_error}")
  endif()

  if(FUZZ_CONTROLS_REQUIRED)
    foreach(required_binary IN ITEMS ROM_LOADER_FUZZER STATE_LOADER_FUZZER EXECUTION_FUZZER
        ROM_LOADER_REPLAY STATE_LOADER_REPLAY)
      if(NOT DEFINED ${required_binary} OR NOT EXISTS "${${required_binary}}")
        message(FATAL_ERROR "required Linux libFuzzer minimization control needs ${required_binary}")
      endif()
    endforeach()
    if(NOT EXISTS "${replay_binary}")
      message(FATAL_ERROR "required execution acceptance replay is missing: ${replay_binary}")
    endif()

    set(rom_original "${fixtures}/minimize/rom-loader-original")
    set(state_original "${fixtures}/minimize/state-loader-original")
    set(execution_original "${fixtures}/minimize/execution-original")
    file(MAKE_DIRECTORY "${fixtures}/minimize")
    file(COPY_FILE "${source_root}/tests/fuzz/corpus/valid-mmc1"
      "${rom_original}" ONLY_IF_DIFFERENT)
    file(COPY_FILE "${source_root}/tests/fuzz/corpus_state/valid-m0-small"
      "${state_original}" ONLY_IF_DIFFERENT)
    file(APPEND "${state_original}" "SE")
    file(COPY_FILE "${source_root}/tests/fuzz/corpus_execution/nrom-deep"
      "${execution_original}" ONLY_IF_DIFFERENT)
    file(APPEND "${execution_original}" "E-extra")

    minimize_failure("rom-loader" "${ROM_LOADER_FUZZER}" "${ROM_LOADER_REPLAY}"
      "${rom_original}" "${fixtures}/minimize/rom-loader-reduced" "accepted"
      "address-sanitizer" "nesturbator_load_cartridge" "rom-loader"
      "${fixtures}/minimize/rom-loader" mini_error)
    if(NOT mini_error STREQUAL "")
      message(FATAL_ERROR "ROM-loader minimization control failed: ${mini_error}")
    endif()
    minimize_failure("state-loader" "${STATE_LOADER_FUZZER}" "${STATE_LOADER_REPLAY}"
      "${state_original}" "${fixtures}/minimize/state-loader-reduced" "accepted"
      "address-sanitizer" "nesturbator_load_state" "state-loader"
      "${fixtures}/minimize/state-loader" mini_error)
    if(NOT mini_error STREQUAL "")
      message(FATAL_ERROR "state-loader minimization control failed: ${mini_error}")
    endif()
    minimize_failure("execution" "${EXECUTION_FUZZER}" "${replay_binary}"
      "${execution_original}" "${fixtures}/minimize/execution-reduced" "accepted"
      "address-sanitizer" "nesturbator_load_cartridge" "execution"
      "${fixtures}/minimize/execution" mini_error)
    if(NOT mini_error STREQUAL "")
      message(FATAL_ERROR "execution minimization control failed: ${mini_error}")
    endif()

    observe_failure("execution" "${ROM_LOADER_FUZZER}" "${execution_original}" "execution"
      wrong_target_class wrong_target_operation wrong_target_output)
    if(NOT wrong_target_class STREQUAL "none")
      message(FATAL_ERROR "wrong-target control unexpectedly reproduced ${wrong_target_class}")
    endif()
    validate_minimized("execution" "${execution_original}" "${fixtures}/minimize/execution-reduced"
      "accepted" "undefined-behavior" "nesturbator_load_cartridge" "${EXECUTION_FUZZER}"
      "${replay_binary}" "execution" wrong_class)
    if(wrong_class STREQUAL "")
      message(FATAL_ERROR "minimization accepted a caller class that differed from the observed sanitizer class")
    endif()
    validate_minimized("execution" "${execution_original}" "${fixtures}/minimize/execution-reduced"
      "accepted" "address-sanitizer" "nesturbator_destroy" "${EXECUTION_FUZZER}"
      "${replay_binary}" "execution" wrong_operation)
    if(wrong_operation STREQUAL "")
      message(FATAL_ERROR "minimization accepted a caller operation that differed from the pre-call trace")
    endif()
    validate_minimized("execution" "${invalid_execution}" "${invalid_execution}"
      "accepted" "address-sanitizer" "nesturbator_load_cartridge" "${EXECUTION_FUZZER}"
      "${replay_binary}" "execution" unaccepted_execution)
    if(unaccepted_execution STREQUAL "")
      message(FATAL_ERROR "minimization accepted an unaccepted execution descriptor")
    endif()
  endif()

  set(source_fixture "${output_root}/fixtures/source-corpus")
  set(working_fixture "${output_root}/fixtures/working-corpus")
  file(MAKE_DIRECTORY "${source_fixture}" "${working_fixture}")
  file(WRITE "${source_fixture}/seed" "source descriptor\n")
  file(COPY "${source_fixture}/" DESTINATION "${working_fixture}")
  file(SHA256 "${source_fixture}/seed" source_seed_sha)
  execute_process(COMMAND "${CMAKE_COMMAND}"
      "-DSELFTEST_CHILD=mutation" "-DCHILD_ARTIFACT=${working_fixture}/generated"
      "-DCHILD_CONTENT=unused" -P "${CMAKE_CURRENT_LIST_FILE}"
    RESULT_VARIABLE mutation_result OUTPUT_VARIABLE mutation_out ERROR_VARIABLE mutation_err)
  file(SHA256 "${source_fixture}/seed" source_seed_after_sha)
  if(NOT mutation_result EQUAL 0 OR NOT source_seed_sha STREQUAL source_seed_after_sha OR
     NOT EXISTS "${working_fixture}/generated")
    message(FATAL_ERROR "writable-copy mutation modified or failed to preserve the source corpus")
  endif()

  execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 2
    RESULT_VARIABLE outer_result OUTPUT_VARIABLE outer_out ERROR_VARIABLE outer_err TIMEOUT 0.1)
  if(NOT "${outer_result}" MATCHES "timeout")
    message(FATAL_ERROR "outer cancellation was not observed as an incomplete run: ${outer_result} ${outer_err}")
  endif()
  set(outer_status incomplete)
  if(outer_status STREQUAL "completed")
    message(FATAL_ERROR "outer-killed run was classified clean")
  endif()

  if(DEFINED REPLAY_BINARY AND EXISTS "${REPLAY_BINARY}")
    execute_process(COMMAND "${REPLAY_BINARY}" --oracle-failure
      RESULT_VARIABLE oracle_result OUTPUT_VARIABLE oracle_out ERROR_VARIABLE oracle_err)
    if(NOT oracle_result EQUAL 1 OR NOT oracle_err MATCHES "intentional execution oracle failure")
      message(FATAL_ERROR "oracle control did not remain distinct from a sanitizer finding")
    endif()
  endif()
  if(FUZZ_CONTROLS_REQUIRED)
    message(STATUS "execution campaign controls passed: actual Linux libFuzzer binaries minimized synthetic failures; target acceptance, observed class and pre-call operation matched on originals and reductions; campaign collector copied exact artifacts and rejected missing evidence")
  else()
    message(STATUS "execution campaign controls passed: shared campaign collector copied exact synthetic artifacts and rejected missing evidence; Linux libFuzzer minimization controls run when those targets are enabled")
  endif()
  return()
elseif(MODE STREQUAL "minimize")
  if(NOT DEFINED REPLAY_BINARY OR "${REPLAY_BINARY}" STREQUAL "")
    set(REPLAY_BINARY "${build_root}/tests/fuzz.execution")
  endif()
  foreach(required IN ITEMS FUZZ_TARGET INPUT BINARY REPLAY_BINARY EXPECTED_ACCEPTANCE EXPECTED_CLASS EXPECTED_OPERATION)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
      message(FATAL_ERROR "minimization mode needs ${required}")
    endif()
  endforeach()
  if(NOT FUZZ_TARGET MATCHES "^(rom-loader|state-loader|execution)$" OR
     NOT EXPECTED_ACCEPTANCE MATCHES "^(accepted|rejected)$" OR NOT EXISTS "${INPUT}" OR
     NOT EXISTS "${BINARY}" OR NOT EXISTS "${REPLAY_BINARY}")
    message(FATAL_ERROR "minimization target/input/binary is not valid")
  endif()
  file(MAKE_DIRECTORY "${output_root}/originals" "${output_root}/reduced" "${output_root}/logs")
  get_filename_component(input_name "${INPUT}" NAME)
  set(original_copy "${output_root}/originals/${input_name}")
  set(reduced_copy "${output_root}/reduced/${input_name}")
  file(COPY_FILE "${INPUT}" "${original_copy}" ONLY_IF_DIFFERENT)
  set(control "")
  if(DEFINED CONTROL)
    set(control "${CONTROL}")
  endif()
  file(RELATIVE_PATH binary_relative "${source_root}" "${BINARY}")
  file(RELATIVE_PATH replay_relative "${source_root}" "${REPLAY_BINARY}")
  file(WRITE "${output_root}/logs/minimize-command.txt"
    "target=${FUZZ_TARGET}\ninput=originals/${input_name}\nexpected_acceptance=${EXPECTED_ACCEPTANCE}\n"
    "expected_class=${EXPECTED_CLASS}\nexpected_operation=${EXPECTED_OPERATION}\ncontrol=${control}\n"
    "fuzzer=${binary_relative}\nacceptance_replay=${replay_relative}\n")
  minimize_failure("${FUZZ_TARGET}" "${BINARY}" "${REPLAY_BINARY}" "${original_copy}"
    "${reduced_copy}" "${EXPECTED_ACCEPTANCE}" "${EXPECTED_CLASS}" "${EXPECTED_OPERATION}"
    "${control}" "${output_root}/logs" minimize_error)
  if(NOT minimize_error STREQUAL "")
    message(FATAL_ERROR "minimized input rejected: ${minimize_error}")
  endif()
  file(SIZE "${original_copy}" original_size)
  file(SIZE "${reduced_copy}" reduced_size)
  if(reduced_size EQUAL original_size)
    message(STATUS "same instrumented ${FUZZ_TARGET} target reproduced the observed failure and operation; no smaller input was found")
  else()
    message(STATUS "same instrumented ${FUZZ_TARGET} target reproduced the failure and operation in a smaller input")
  endif()
  return()
elseif(NOT MODE STREQUAL "pilot" AND NOT MODE STREQUAL "campaign")
  message(FATAL_ERROR "execution campaign supports pilot, campaign, minimize or self-test")
endif()

