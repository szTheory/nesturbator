function(read_budget key out_value)
  file(STRINGS "${budget_file}" budget_lines)
  set(found "")
  foreach(line IN LISTS budget_lines)
    string(STRIP "${line}" line)
    if(line STREQUAL "" OR line MATCHES "^#")
      continue()
    endif()
    if(line MATCHES "^([A-Za-z0-9_.-]+)=(.*)$")
      if(CMAKE_MATCH_1 STREQUAL "${key}")
        if(NOT found STREQUAL "")
          message(FATAL_ERROR "duplicate budget field ${key}")
        endif()
        set(found "${CMAKE_MATCH_2}")
      endif()
    else()
      message(FATAL_ERROR "invalid budget line: ${line}")
    endif()
  endforeach()
  if(found STREQUAL "")
    message(FATAL_ERROR "missing budget field ${key}")
  endif()
  set(${out_value} "${found}" PARENT_SCOPE)
endfunction()

function(require_positive_integer key out_value)
  read_budget("${key}" value)
  if(NOT value MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "budget field ${key} must be a positive measured integer, got '${value}'")
  endif()
  set(${out_value} "${value}" PARENT_SCOPE)
endfunction()

function(hash_corpus target corpus_dir out_manifest out_count)
  file(GLOB_RECURSE entries LIST_DIRECTORIES FALSE "${corpus_dir}/*")
  list(SORT entries)
  set(manifest "")
  set(count 0)
  foreach(entry IN LISTS entries)
    file(SHA256 "${entry}" sha)
    file(RELATIVE_PATH relative "${source_root}" "${entry}")
    string(APPEND manifest "${target}\t${relative}\t${sha}\n")
    math(EXPR count "${count} + 1")
  endforeach()
  set(${out_manifest} "${manifest}" PARENT_SCOPE)
  set(${out_count} "${count}" PARENT_SCOPE)
endfunction()

function(require_artifact path expected_sha out_error)
  if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
    set(${out_error} "missing exact input artifact" PARENT_SCOPE)
    return()
  endif()
  file(SHA256 "${path}" actual_sha)
  if(NOT actual_sha STREQUAL "${expected_sha}")
    set(${out_error} "artifact bytes do not match the triggering input" PARENT_SCOPE)
    return()
  endif()
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(validate_minimized original reduced original_class reduced_class expected_operation out_error)
  if(NOT EXISTS "${original}" OR NOT EXISTS "${reduced}")
    set(${out_error} "original or reduced input is missing" PARENT_SCOPE)
    return()
  endif()
  file(SHA256 "${original}" before_sha)
  file(SIZE "${original}" original_size)
  file(SIZE "${reduced}" reduced_size)
  if(NOT original_class STREQUAL reduced_class)
    set(${out_error} "minimized input changed failure class" PARENT_SCOPE)
    return()
  endif()
  if(reduced_size GREATER original_size)
    set(${out_error} "minimized input grew beyond its original" PARENT_SCOPE)
    return()
  endif()
  if(NOT expected_operation MATCHES "^[0-9]+$")
    set(${out_error} "intended operation is not a measured integer" PARENT_SCOPE)
    return()
  endif()
  file(SHA256 "${original}" after_sha)
  if(NOT before_sha STREQUAL after_sha)
    set(${out_error} "minimization changed the preserved original" PARENT_SCOPE)
    return()
  endif()
  set(${out_error} "" PARENT_SCOPE)
endfunction()

function(classify_run process_result process_stderr artifact_count out_status out_class)
  set(status completed)
  set(failure_class none)
  if("${process_result}" MATCHES "timeout")
    set(status incomplete-outer-timeout)
    set(failure_class outer-cancellation)
  elseif(NOT process_result EQUAL 0)
    set(status failed)
    if(process_stderr MATCHES "timeout after|Timeout:|ALARM:.*timeout")
      set(failure_class per-input-timeout)
    elseif(process_stderr MATCHES "out-of-memory|oom|RSS limit|rss limit")
      set(failure_class resource-limit)
    elseif(process_stderr MATCHES "ERROR: AddressSanitizer|runtime error:|UndefinedBehaviorSanitizer|SUMMARY: ThreadSanitizer")
      set(failure_class sanitizer-crash)
    else()
      set(failure_class process-failure)
    endif()
    if(artifact_count EQUAL 0)
      set(status failed-evidence-incomplete)
    endif()
  endif()
  set(${out_status} "${status}" PARENT_SCOPE)
  set(${out_class} "${failure_class}" PARENT_SCOPE)
endfunction()

if(MODE STREQUAL "self-test")
  file(MAKE_DIRECTORY "${output_root}/fixtures")
  set(input "${output_root}/fixtures/triggering-input")
  set(crash_artifact "${output_root}/fixtures/crash-expected")
  set(timeout_artifact "${output_root}/fixtures/timeout-expected")
  set(resource_artifact "${output_root}/fixtures/resource-must-not-claim-input")
  file(WRITE "${input}" "descriptor-only fixture")
  file(SHA256 "${input}" input_sha)

  foreach(kind IN ITEMS crash timeout resource)
    if(kind STREQUAL "crash")
      set(artifact "${crash_artifact}")
    elseif(kind STREQUAL "timeout")
      set(artifact "${timeout_artifact}")
    else()
      set(artifact "${resource_artifact}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}"
        "-DSELFTEST_CHILD=${kind}" "-DCHILD_ARTIFACT=${artifact}"
        "-DCHILD_CONTENT=descriptor-only fixture" -P "${CMAKE_CURRENT_LIST_FILE}"
      RESULT_VARIABLE child_result OUTPUT_VARIABLE child_out ERROR_VARIABLE child_err)
    if(child_result EQUAL 0)
      message(FATAL_ERROR "${kind} child control unexpectedly succeeded")
    endif()
    if(kind STREQUAL "resource")
      if(EXISTS "${resource_artifact}" OR NOT child_err MATCHES "out-of-memory")
        message(FATAL_ERROR "resource control fabricated an exact input artifact or lost its diagnostic")
      endif()
      classify_run("${child_result}" "${child_err}" 0 child_status child_class)
      if(NOT child_status STREQUAL "failed-evidence-incomplete" OR NOT child_class STREQUAL "resource-limit")
        message(FATAL_ERROR "resource failure without an input was incorrectly classified ${child_status}/${child_class}")
      endif()
    else()
      require_artifact("${artifact}" "${input_sha}" artifact_error)
      if(NOT artifact_error STREQUAL "")
        message(FATAL_ERROR "${kind} collector failed to retain exact input: ${artifact_error}")
      endif()
      classify_run("${child_result}" "${child_err}" 1 child_status child_class)
      if(kind STREQUAL "crash" AND
         (NOT child_status STREQUAL "failed" OR NOT child_class STREQUAL "sanitizer-crash"))
        message(FATAL_ERROR "crash evidence was incorrectly classified ${child_status}/${child_class}")
      endif()
      if(kind STREQUAL "timeout" AND
         (NOT child_status STREQUAL "failed" OR NOT child_class STREQUAL "per-input-timeout"))
        message(FATAL_ERROR "per-input timeout evidence was incorrectly classified ${child_status}/${child_class}")
      endif()
    endif()
  endforeach()

  require_artifact("${output_root}/fixtures/collector-was-broken" "${input_sha}" missing_error)
  if(missing_error STREQUAL "")
    message(FATAL_ERROR "deliberately broken collector was accepted")
  endif()

  set(reduced "${output_root}/fixtures/reduced-input")
  file(WRITE "${reduced}" "short\n")
  validate_minimized("${input}" "${reduced}" "address-sanitizer" "timeout" 7 bad_minimization)
  if(bad_minimization STREQUAL "")
    message(FATAL_ERROR "minimization with a changed failure class was accepted")
  endif()
  validate_minimized("${input}" "${reduced}" "address-sanitizer" "address-sanitizer" "unknown" bad_operation)
  if(bad_operation STREQUAL "")
    message(FATAL_ERROR "minimization with an unmeasured operation was accepted")
  endif()
  file(SHA256 "${input}" input_after_sha)
  if(NOT input_sha STREQUAL input_after_sha)
    message(FATAL_ERROR "minimization changed the original input")
  endif()

  set(source_fixture "${output_root}/fixtures/source-corpus")
  set(working_fixture "${output_root}/fixtures/working-corpus")
  file(MAKE_DIRECTORY "${source_fixture}" "${working_fixture}")
  file(WRITE "${source_fixture}/seed" "source descriptor\n")
  file(COPY "${source_fixture}/" DESTINATION "${working_fixture}")
  file(SHA256 "${source_fixture}/seed" source_seed_sha)
  execute_process(COMMAND "${CMAKE_COMMAND}"
      "-DSELFTEST_CHILD=mutation" "-DCHILD_ARTIFACT=${working_fixture}/generated"
      "-DCHILD_CONTENT=unused" -P "${CMAKE_CURRENT_LIST_FILE}"
    RESULT_VARIABLE mutation_result OUTPUT_VARIABLE mutation_out ERROR_VARIABLE mutation_err)
  file(SHA256 "${source_fixture}/seed" source_seed_after_sha)
  if(NOT mutation_result EQUAL 0 OR NOT source_seed_sha STREQUAL source_seed_after_sha OR
     NOT EXISTS "${working_fixture}/generated")
    message(FATAL_ERROR "writable-copy mutation modified or failed to preserve the source corpus")
  endif()

  execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 2
    RESULT_VARIABLE outer_result OUTPUT_VARIABLE outer_out ERROR_VARIABLE outer_err TIMEOUT 0.1)
  if(NOT "${outer_result}" MATCHES "timeout")
    message(FATAL_ERROR "outer cancellation was not observed as an incomplete run: ${outer_result} ${outer_err}")
  endif()
  set(outer_status incomplete)
  if(outer_status STREQUAL "completed")
    message(FATAL_ERROR "outer-killed run was classified clean")
  endif()

  if(DEFINED REPLAY_BINARY AND EXISTS "${REPLAY_BINARY}")
    execute_process(COMMAND "${REPLAY_BINARY}" --oracle-failure
      RESULT_VARIABLE oracle_result OUTPUT_VARIABLE oracle_out ERROR_VARIABLE oracle_err)
    if(NOT oracle_result EQUAL 1 OR NOT oracle_err MATCHES "intentional execution oracle failure")
      message(FATAL_ERROR "oracle control did not remain distinct from a sanitizer finding")
    endif()
  endif()
  message(STATUS "execution campaign controls passed: exact crash/timeout inputs retained, resource evidence limitation visible, broken collection rejected, originals preserved and outer cancellation incomplete")
  return()
elseif(MODE STREQUAL "minimize")
  foreach(required IN ITEMS FUZZ_TARGET INPUT BINARY EXPECTED_CLASS EXPECTED_OPERATION)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
      message(FATAL_ERROR "minimization mode needs ${required}")
    endif()
  endforeach()
  if(NOT FUZZ_TARGET MATCHES "^(rom-loader|state-loader|execution)$" OR NOT EXISTS "${INPUT}" OR NOT EXISTS "${BINARY}")
    message(FATAL_ERROR "minimization target/input/binary is not valid")
  endif()
  require_positive_integer("campaign.${FUZZ_TARGET}.runs" run_cap)
  require_positive_integer("campaign.${FUZZ_TARGET}.per_input_timeout_seconds" input_timeout)
  require_positive_integer("campaign.${FUZZ_TARGET}.rss_limit_mb" rss_limit)
  file(MAKE_DIRECTORY "${output_root}/originals" "${output_root}/reduced" "${output_root}/logs")
  get_filename_component(input_name "${INPUT}" NAME)
  set(original_copy "${output_root}/originals/${input_name}")
  set(reduced_copy "${output_root}/reduced/${input_name}")
  file(COPY_FILE "${INPUT}" "${original_copy}" ONLY_IF_DIFFERENT)
  file(SHA256 "${original_copy}" original_sha)
  file(SIZE "${original_copy}" original_size)
  file(WRITE "${output_root}/logs/minimize-command.txt"
    "target=${FUZZ_TARGET}\ninput=originals/${input_name}\nclass=${EXPECTED_CLASS}\noperation=${EXPECTED_OPERATION}\n"
    "command=${BINARY} -minimize_crash=1 -runs=${run_cap} -timeout=${input_timeout} -rss_limit_mb=${rss_limit} -exact_artifact_path=reduced/${input_name} originals/${input_name}\n")
  execute_process(COMMAND "${BINARY}" "-minimize_crash=1" "-runs=${run_cap}"
      "-timeout=${input_timeout}" "-rss_limit_mb=${rss_limit}"
      "-exact_artifact_path=${reduced_copy}" "${original_copy}"
    WORKING_DIRECTORY "${output_root}" RESULT_VARIABLE minimize_result
    OUTPUT_VARIABLE minimize_out ERROR_VARIABLE minimize_err
    TIMEOUT "${input_timeout}")
  file(WRITE "${output_root}/logs/minimize.stdout" "${minimize_out}")
  file(WRITE "${output_root}/logs/minimize.stderr" "${minimize_err}")
  if(NOT minimize_result EQUAL 0 OR NOT EXISTS "${reduced_copy}")
    message(FATAL_ERROR "bounded minimization failed or emitted no reduced input: ${minimize_result}; see logs/minimize.stderr")
  endif()
  validate_minimized("${original_copy}" "${reduced_copy}" "${EXPECTED_CLASS}" "${EXPECTED_CLASS}" "${EXPECTED_OPERATION}" minimize_error)
  if(NOT minimize_error STREQUAL "")
    message(FATAL_ERROR "minimized input rejected: ${minimize_error}")
  endif()
  file(SHA256 "${original_copy}" original_after_sha)
  if(NOT original_sha STREQUAL original_after_sha)
    message(FATAL_ERROR "preserved original hash changed during minimization")
  endif()
  file(SIZE "${reduced_copy}" reduced_size)
  if(reduced_size EQUAL original_size)
    message(STATUS "minimization preserved failure class and original; libFuzzer found no smaller input")
  else()
    message(STATUS "minimization emitted a smaller bounded reproducer; same-class replay must be recorded before regression acceptance")
  endif()
  return()
elseif(NOT MODE STREQUAL "pilot" AND NOT MODE STREQUAL "campaign")
  message(FATAL_ERROR "execution campaign supports pilot, campaign, minimize or self-test")
endif()

if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
  message(FATAL_ERROR "${MODE} requires the measured Linux Clang/libFuzzer toolchain")
endif()
find_program(clang_program NAMES clang REQUIRED)
find_program(ninja_program NAMES ninja REQUIRED)
find_program(time_program NAMES time PATHS /usr/bin REQUIRED NO_DEFAULT_PATH)

foreach(cap IN ITEMS max_prg_bytes max_chr_bytes max_input_bytes max_generated_bytes
    max_state_bytes max_allocation_bytes max_frames_per_phase max_frame_calls max_operations)
  require_positive_integer("execution.${cap}" execution_${cap})
endforeach()
require_positive_integer(execution.fixed_replay_timeout_seconds fixed_replay_timeout_seconds)
math(EXPR expected_input "16 + ${execution_max_prg_bytes} + ${execution_max_chr_bytes}")
if(NOT expected_input EQUAL execution_max_input_bytes)
  message(FATAL_ERROR "execution.max_input_bytes must equal recipe + PRG cap + CHR cap (${expected_input})")
endif()
if(NOT execution_max_generated_bytes EQUAL expected_input)
  message(FATAL_ERROR "execution.max_generated_bytes must equal generated image cap (${expected_input})")
endif()

if(MODE STREQUAL "pilot")
  set(budget_prefix pilot)
  foreach(field IN ITEMS runs max_total_time_seconds per_input_timeout_seconds max_len rss_limit_mb outer_timeout_seconds seed)
    require_positive_integer("pilot.${field}" limit_${field})
  endforeach()
  read_budget(pilot.source pilot_source)
  if(pilot_source STREQUAL "UNSELECTED")
    message(FATAL_ERROR "pilot.source must explain its measured replay basis")
  endif()
  set(limit_runs "${limit_runs}")
  set(limit_max_total_time_seconds "${limit_max_total_time_seconds}")
  set(limit_per_input_timeout_seconds "${limit_per_input_timeout_seconds}")
  set(limit_max_len "${limit_max_len}")
  set(limit_rss_limit_mb "${limit_rss_limit_mb}")
  set(limit_outer_timeout_seconds "${limit_outer_timeout_seconds}")
  set(limit_seed "${limit_seed}")
elseif(MODE STREQUAL "campaign")
  set(budget_prefix campaign)
  read_budget(campaign.source campaign_source)
  if(campaign_source STREQUAL "UNSELECTED")
    message(FATAL_ERROR "campaign limits remain UNSELECTED until the Linux pilot is recorded")
  endif()
  foreach(target IN ITEMS rom-loader state-loader execution)
    foreach(field IN ITEMS runs max_total_time_seconds per_input_timeout_seconds max_len rss_limit_mb outer_timeout_seconds seed)
      require_positive_integer("campaign.${target}.${field}" ${target}_${field})
    endforeach()
    if(${${target}_max_total_time_seconds} GREATER_EQUAL ${${target}_outer_timeout_seconds})
      message(FATAL_ERROR "campaign.${target}: outer timeout must exceed mutation time for cleanup and evidence collection")
    endif()
  endforeach()
endif()

if(EXISTS "${output_root}/campaign.tsv")
  message(FATAL_ERROR "campaign output already contains a prior run; choose a fresh OUTPUT_DIR so artifacts cannot mix")
endif()
file(MAKE_DIRECTORY "${output_root}" "${output_root}/logs" "${output_root}/originals"
  "${output_root}/working" "${output_root}/artifacts" "${output_root}/reproducers")
execute_process(COMMAND git -C "${source_root}" rev-parse HEAD
  RESULT_VARIABLE revision_result OUTPUT_VARIABLE source_revision OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT revision_result EQUAL 0)
  message(FATAL_ERROR "could not identify the exact campaign source revision")
endif()
find_program(uname_program NAMES uname REQUIRED)
execute_process(COMMAND "${uname_program}" -m
  RESULT_VARIABLE machine_result OUTPUT_VARIABLE machine_type OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT machine_result EQUAL 0 OR machine_type STREQUAL "")
  message(FATAL_ERROR "could not identify execution host architecture")
endif()
set(source_platform "${CMAKE_HOST_SYSTEM_NAME}-${machine_type}")
execute_process(COMMAND "${clang_program}" --version
  RESULT_VARIABLE clang_result OUTPUT_VARIABLE clang_version ERROR_VARIABLE clang_error)
if(NOT clang_result EQUAL 0)
  message(FATAL_ERROR "could not identify Linux Clang version: ${clang_error}")
endif()
string(REPLACE "\n" " " clang_version "${clang_version}")
string(STRIP "${clang_version}" clang_version)
if(DEFINED ENV{GITHUB_RUN_ID} AND NOT "$ENV{GITHUB_RUN_ID}" STREQUAL "")
  set(run_identity "$ENV{GITHUB_SERVER_URL}/$ENV{GITHUB_REPOSITORY}/actions/runs/$ENV{GITHUB_RUN_ID}")
else()
  set(run_identity local-unhosted)
endif()

set(target_corpus_names rom-loader state-loader execution)
set(target_corpus_dirs corpus corpus_state corpus_execution)
set(source_manifest "")
set(source_corpus_count 0)
foreach(index RANGE 0 2)
  list(GET target_corpus_names ${index} target)
  list(GET target_corpus_dirs ${index} corpus_dir)
  set(source_dir "${source_root}/tests/fuzz/${corpus_dir}")
  if(NOT IS_DIRECTORY "${source_dir}")
    message(FATAL_ERROR "required ${target} source corpus is missing: tests/fuzz/${corpus_dir}")
  endif()
  hash_corpus("${target}" "${source_dir}" target_manifest target_count)
  if(target_count EQUAL 0)
    message(FATAL_ERROR "required ${target} source corpus is empty")
  endif()
  if(target STREQUAL "execution" AND NOT target_count EQUAL 8)
    message(FATAL_ERROR "execution corpus must contain all eight qualified descriptors; found ${target_count}")
  endif()
  string(APPEND source_manifest "${target_manifest}")
  math(EXPR source_corpus_count "${source_corpus_count} + ${target_count}")
endforeach()
string(SHA256 source_corpus_sha256 "${source_manifest}")
file(WRITE "${output_root}/corpora-before.tsv" "target\tpath\tsha256\n${source_manifest}")
file(COPY "${source_root}/tests/fuzz/corpus/" DESTINATION "${output_root}/originals/rom-loader")
file(COPY "${source_root}/tests/fuzz/corpus_state/" DESTINATION "${output_root}/originals/state-loader")
file(COPY "${source_root}/tests/fuzz/corpus_execution/" DESTINATION "${output_root}/originals/execution")

set(c_flags "-fsanitize=fuzzer-no-link,address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer")
set(release_flags "-O1 -DNDEBUG")
set(link_flags "-fsanitize=address,undefined")
set(configure_command "cmake -S . -B <build> -G Ninja -DCMAKE_C_COMPILER=clang -DCMAKE_BUILD_TYPE=Release -DCMAKE_COMPILE_WARNING_AS_ERROR=ON -DCMAKE_C_FLAGS_RELEASE=${release_flags} -DCMAKE_C_FLAGS=${c_flags} -DCMAKE_EXE_LINKER_FLAGS=${link_flags} -DNESTURBATOR_LIBFUZZER=ON")
file(WRITE "${output_root}/logs/commands.txt" "source=${source_revision}\nplatform=${source_platform}\nrun=${run_identity}\nmode=${MODE}\nconfigure=${configure_command}\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${source_root}" -B "${build_root}" -G Ninja
    "-DCMAKE_C_COMPILER=${clang_program}" -DCMAKE_BUILD_TYPE=Release
    "-DCMAKE_C_FLAGS_RELEASE=${release_flags}"
    -DCMAKE_COMPILE_WARNING_AS_ERROR=ON "-DCMAKE_C_FLAGS=${c_flags}"
    "-DCMAKE_EXE_LINKER_FLAGS=${link_flags}" -DNESTURBATOR_LIBFUZZER=ON
  RESULT_VARIABLE configure_result OUTPUT_VARIABLE configure_out ERROR_VARIABLE configure_err)
file(WRITE "${output_root}/logs/configure.stdout" "${configure_out}")
file(WRITE "${output_root}/logs/configure.stderr" "${configure_err}")
if(NOT configure_result EQUAL 0)
  message(FATAL_ERROR "Linux Clang/libFuzzer configure failed; see logs/configure.stderr")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${build_root}" --target
    fuzz.rom_loader.libfuzzer fuzz.state.libfuzzer fuzz.execution.libfuzzer fuzz.execution
  RESULT_VARIABLE build_result OUTPUT_VARIABLE build_out ERROR_VARIABLE build_err)
file(WRITE "${output_root}/logs/build.stdout" "${build_out}")
file(WRITE "${output_root}/logs/build.stderr" "${build_err}")
if(NOT build_result EQUAL 0)
  message(FATAL_ERROR "matched Linux libFuzzer/ASan/UBSan target build failed; see logs/build.stderr")
endif()
set(execution_replay "${build_root}/tests/fuzz.execution")
set(execution_seed_dir "${source_root}/tests/fuzz/corpus_execution")
file(GLOB execution_seeds LIST_DIRECTORIES FALSE "${execution_seed_dir}/*")
list(SORT execution_seeds)
execute_process(COMMAND "${execution_replay}" --check-seeds ${execution_seeds}
  RESULT_VARIABLE seed_check_result OUTPUT_VARIABLE seed_check_out ERROR_VARIABLE seed_check_err)
if(NOT seed_check_result EQUAL 0)
  file(WRITE "${output_root}/logs/execution-seed-check.stdout" "${seed_check_out}")
  file(WRITE "${output_root}/logs/execution-seed-check.stderr" "${seed_check_err}")
  message(FATAL_ERROR "Linux build did not qualify all eight execution descriptors")
endif()
file(WRITE "${output_root}/execution-seeds.tsv"
  "path\tsha256\taccepted\tmapper\tsubmapper\tframes\tframe_ok\tframe_jam\tapi_operations\tlast_operation\tpeak_allocation_bytes\tmax_state_bytes\tguest_ticks\tstop_status\n")
foreach(seed IN LISTS execution_seeds)
  file(SHA256 "${seed}" seed_sha)
  file(RELATIVE_PATH seed_relative "${source_root}" "${seed}")
  execute_process(COMMAND "${execution_replay}" --measure 1 "${seed}"
    RESULT_VARIABLE seed_measure_result OUTPUT_VARIABLE seed_measure_out ERROR_VARIABLE seed_measure_err)
  if(NOT seed_measure_result EQUAL 0 OR NOT seed_measure_out MATCHES "\"inputs\":1")
    message(FATAL_ERROR "Linux execution seed measurement failed for ${seed_relative}: ${seed_measure_err}${seed_measure_out}")
  endif()
  foreach(metric IN ITEMS accepted last_mapper last_submapper frames frame_ok frame_jam api_operations
      last_operation peak_allocation_bytes max_state_bytes guest_ticks last_stop_status)
    string(JSON seed_${metric} GET "${seed_measure_out}" "${metric}")
  endforeach()
  file(APPEND "${output_root}/execution-seeds.tsv"
    "${seed_relative}\t${seed_sha}\t${seed_accepted}\t${seed_last_mapper}\t${seed_last_submapper}\t"
    "${seed_frames}\t${seed_frame_ok}\t${seed_frame_jam}\t${seed_api_operations}\t${seed_last_operation}\t"
    "${seed_peak_allocation_bytes}\t${seed_max_state_bytes}\t${seed_guest_ticks}\t${seed_last_stop_status}\n")
endforeach()
file(WRITE "${output_root}/campaign.tsv"
  "source_revision\t${source_revision}\nrun_identity\t${run_identity}\nplatform\t${source_platform}\nmode\t${MODE}\n"
  "campaign_source_corpus_sha256\t${source_corpus_sha256}\nsource_corpus_integrity\tPENDING\n"
  "target\tstatus\tfailure_class\treproducer_count\n")

foreach(target IN ITEMS rom-loader state-loader execution)
  if(MODE STREQUAL "pilot")
    foreach(field IN ITEMS runs max_total_time_seconds per_input_timeout_seconds max_len rss_limit_mb outer_timeout_seconds seed)
      set(${target}_${field} "${limit_${field}}")
    endforeach()
  endif()
  if(${target}_max_total_time_seconds GREATER_EQUAL ${target}_outer_timeout_seconds)
    message(FATAL_ERROR "${target}: outer timeout must exceed max_total_time_seconds to retain cleanup/upload reserve")
  endif()
  if(target STREQUAL "rom-loader")
    set(source_dir "${source_root}/tests/fuzz/corpus")
  elseif(target STREQUAL "state-loader")
    set(source_dir "${source_root}/tests/fuzz/corpus_state")
  else()
    set(source_dir "${source_root}/tests/fuzz/corpus_execution")
  endif()
  set(original_dir "${output_root}/originals/${target}")
  set(working_dir "${output_root}/working/${target}")
  set(artifact_dir "${output_root}/artifacts/${target}")
  file(RELATIVE_PATH source_relative "${source_root}" "${source_dir}")
  file(MAKE_DIRECTORY "${working_dir}" "${artifact_dir}" "${output_root}/reproducers/${target}")
  file(COPY "${source_dir}/" DESTINATION "${working_dir}")
  hash_corpus("${target}" "${source_dir}" before_run_manifest before_run_count)
  set(run_record "${output_root}/${target}-run.tsv")
  file(WRITE "${run_record}"
    "source_revision\t${source_revision}\nrun_identity\t${run_identity}\nplatform\t${source_platform}\ntarget\t${target}\n"
    "mode\t${MODE}\ncompiler\t${clang_version}\nsanitizers\tASan,UBSan,libFuzzer\nbuild_flags\t${release_flags};${c_flags};${link_flags}\n"
    "source_corpus_manifest_sha256\t${source_corpus_sha256}\nsource_corpus_count\t${before_run_count}\n"
    "source_corpus\t${source_relative}\nwork_corpus\tworking/${target}\nartifact_dir\tartifacts/${target}\n"
    "execution_seed_metrics\texecution-seeds.tsv;includes accepted mapper, completed/frame counts, last API operation, allocation/state/ticks and exact descriptor hashes\n"
    "fixed_replay_timeout_seconds\t${fixed_replay_timeout_seconds}\n"
    "limits\truns=${${target}_runs};max_total_time=${${target}_max_total_time_seconds};timeout=${${target}_per_input_timeout_seconds};max_len=${${target}_max_len};rss_limit_mb=${${target}_rss_limit_mb};outer=${${target}_outer_timeout_seconds};seed=${${target}_seed}\n")
  if(target STREQUAL "rom-loader")
    set(binary "${build_root}/tests/fuzz.rom_loader.libfuzzer")
  elseif(target STREQUAL "state-loader")
    set(binary "${build_root}/tests/fuzz.state.libfuzzer")
  else()
    set(binary "${build_root}/tests/fuzz.execution.libfuzzer")
  endif()
  if(NOT EXISTS "${binary}")
    message(FATAL_ERROR "built libFuzzer target is missing: ${binary}")
  endif()
  set(fuzzer_command "-runs=${${target}_runs}" "-max_total_time=${${target}_max_total_time_seconds}"
    "-timeout=${${target}_per_input_timeout_seconds}" "-max_len=${${target}_max_len}"
    "-rss_limit_mb=${${target}_rss_limit_mb}" "-seed=${${target}_seed}"
    -print_final_stats=1)
  file(RELATIVE_PATH binary_relative "${source_root}" "${binary}")
  file(RELATIVE_PATH working_relative "${source_root}" "${working_dir}")
  file(RELATIVE_PATH artifact_relative "${source_root}" "${artifact_dir}")
  list(APPEND fuzzer_command "-artifact_prefix=${artifact_relative}/" "${working_relative}")
  string(JOIN " " fuzzer_command_text ${fuzzer_command})
  file(APPEND "${run_record}" "command\t${time_program} -f 'outer_elapsed_seconds=%e peak_rss_kb=%M' ${binary_relative} ${fuzzer_command_text}\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env "LC_ALL=C" "${time_program}"
      -f "outer_elapsed_seconds=%e peak_rss_kb=%M" "${binary}" ${fuzzer_command}
    WORKING_DIRECTORY "${source_root}"
    RESULT_VARIABLE run_result OUTPUT_VARIABLE run_out ERROR_VARIABLE run_err
    TIMEOUT "${${target}_outer_timeout_seconds}")
  file(WRITE "${output_root}/logs/${target}.stdout" "${run_out}")
  file(WRITE "${output_root}/logs/${target}.stderr" "${run_err}")
  file(APPEND "${run_record}" "process_result\t${run_result}\n")
  set(run_status completed)
  set(failure_class none)
  set(reproducer_count 0)
  file(GLOB artifacts LIST_DIRECTORIES FALSE "${artifact_dir}/*")
  foreach(artifact IN LISTS artifacts)
    get_filename_component(artifact_name "${artifact}" NAME)
    if(artifact_name MATCHES "^(crash-|timeout-|oom-|leak-)")
      set(reproducer "${output_root}/reproducers/${target}/${artifact_name}")
      file(COPY_FILE "${artifact}" "${reproducer}" ONLY_IF_DIFFERENT)
      file(SHA256 "${reproducer}" reproducer_sha)
      file(SIZE "${reproducer}" reproducer_size)
      file(APPEND "${run_record}" "reproducer\treproducers/${target}/${artifact_name};sha256=${reproducer_sha};bytes=${reproducer_size}\n")
      math(EXPR reproducer_count "${reproducer_count} + 1")
    endif()
  endforeach()
  classify_run("${run_result}" "${run_err}" "${reproducer_count}" run_status failure_class)
  string(REGEX MATCH "outer_elapsed_seconds=([0-9.]+)[ ]+peak_rss_kb=([0-9]+)" timing_match "${run_err}")
  if(NOT timing_match STREQUAL "")
    set(elapsed_seconds "${CMAKE_MATCH_1}")
    math(EXPR peak_rss_bytes "${CMAKE_MATCH_2} * 1024")
    file(APPEND "${run_record}" "elapsed_seconds\t${elapsed_seconds}\npeak_rss_bytes\t${peak_rss_bytes}\n")
  elseif(NOT run_status STREQUAL "incomplete-outer-timeout")
    file(APPEND "${run_record}" "observed_elapsed_and_peak_rss\tunavailable; process exited before GNU time emitted its summary\n")
  endif()
  if(run_status STREQUAL "failed-evidence-incomplete")
    file(APPEND "${run_record}" "evidence_gap\tprocess failed without an exact retained input; diagnostics retained in logs/${target}.stderr\n")
  elseif(run_status STREQUAL "incomplete-outer-timeout")
    file(APPEND "${run_record}" "stopping_cause\touter cancellation; campaign incomplete regardless of partial artifacts\n")
  endif()
  if(run_status STREQUAL "completed")
    if(timing_match STREQUAL "")
      set(run_status completed-unaccounted)
      file(APPEND "${run_record}" "evidence_gap\tGNU time elapsed/RSS record missing\n")
    endif()
    string(REPLACE "\t" " " fuzzer_log "${run_err}")
    string(REGEX MATCH "#([0-9]+) +DONE +cov: +([0-9]+) +ft: +([0-9]+) +corp: +([^\n]+)" fuzzer_summary "${fuzzer_log}")
    if(NOT fuzzer_summary STREQUAL "")
      file(APPEND "${run_record}" "actual_runs\t${CMAKE_MATCH_1}\nfinal_coverage_edges\t${CMAKE_MATCH_2}\nfinal_features\t${CMAKE_MATCH_3}\nfinal_corpus\t${CMAKE_MATCH_4}\n")
    else()
      set(run_status completed-unaccounted)
      file(APPEND "${run_record}" "evidence_gap\tlibFuzzer DONE run/coverage summary not found\n")
    endif()
  endif()
  file(APPEND "${run_record}" "stopping_status\t${run_status}\nfailure_class\t${failure_class}\n")
  hash_corpus("${target}" "${source_dir}" after_run_manifest after_run_count)
  if(NOT before_run_manifest STREQUAL after_run_manifest)
    file(APPEND "${run_record}" "source_corpus_integrity\tFAILED\n")
    message(FATAL_ERROR "${target} source corpus changed during mutation; see ${target}-run.tsv")
  endif()
  file(APPEND "${run_record}" "source_corpus_integrity\tPASS\n")
  if(NOT run_status STREQUAL "completed")
    file(APPEND "${output_root}/campaign.tsv" "${target}\t${run_status}\t${failure_class}\t${reproducer_count}\n")
    file(APPEND "${output_root}/campaign.tsv" "source_corpus_integrity\tPASS_FOR_COMPLETED_TARGETS_ONLY\n")
    message(FATAL_ERROR "${target} finite fuzz run ${run_status} (${failure_class}); evidence retained under output directory")
  endif()
  file(APPEND "${output_root}/campaign.tsv" "${target}\t${run_status}\tnone\t${reproducer_count}\n")
endforeach()

set(final_manifest "")
foreach(index RANGE 0 2)
  list(GET target_corpus_names ${index} target)
  list(GET target_corpus_dirs ${index} corpus_dir)
  hash_corpus("${target}" "${source_root}/tests/fuzz/${corpus_dir}" target_manifest target_count)
  string(APPEND final_manifest "${target_manifest}")
endforeach()
string(SHA256 final_corpus_sha256 "${final_manifest}")
if(NOT source_corpus_sha256 STREQUAL final_corpus_sha256)
  message(FATAL_ERROR "source corpus changed during campaign; final results are invalid")
endif()
file(WRITE "${output_root}/corpora-after.tsv" "target\tpath\tsha256\n${final_manifest}")
file(APPEND "${output_root}/campaign.tsv" "source_corpus_integrity\tPASS\n")
message(STATUS "${MODE} execution campaign completed under the selected finite limits; exact run records, copied corpora, logs and artifacts are under the build output directory")
