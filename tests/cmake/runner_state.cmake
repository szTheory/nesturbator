# The runner.state.* cases: nesturbator-run with --state-at-frame and --load-state.
#
#   cmake -DRUNNER=<nesturbator-run> -DMUTATE=<runner.state_mutate> -DROM=<dabg.nes>
#         -DOTHER_ROM=<another game> -DSAVE_FIXTURE=<runner.save_rom output dir>
#         -DWORK=<scratch dir, recreated> -DCASE=<case> -P runner_state.cmake

cmake_minimum_required(VERSION 3.25)

foreach(var RUNNER MUTATE ROM OTHER_ROM SAVE_FIXTURE WORK CASE)
  if(NOT DEFINED ${var} OR "${${var}}" STREQUAL "")
    message(FATAL_ERROR "runner_state: -D${var}=... is required")
  endif()
endforeach()

file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")

# Runs the runner with ARGN; sets run_exit, run_out and run_err in the caller.
function(run_runner)
  execute_process(COMMAND "${RUNNER}" ${ARGN}
    OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE rc)
  string(REPLACE "\r" "" out "${out}")
  string(REPLACE "\r" "" err "${err}")
  set(run_exit "${rc}" PARENT_SCOPE)
  set(run_out "${out}" PARENT_SCOPE)
  set(run_err "${err}" PARENT_SCOPE)
endfunction()

function(expect_exit want)
  if(NOT "${run_exit}" STREQUAL "${want}")
    message(FATAL_ERROR "runner_state ${CASE}: exit ${run_exit}, wanted ${want}\n${run_err}")
  endif()
endfunction()

function(expect_err text)
  string(FIND "${run_err}" "${text}" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "runner_state ${CASE}: stderr lacks '${text}':\n${run_err}")
  endif()
endfunction()

# The "frame N ..." line of the runner output.
function(frame_line n var)
  string(REGEX MATCH "frame ${n} ticks [0-9]+ sha256 [0-9a-f]+" line "${run_out}")
  if("${line}" STREQUAL "")
    message(FATAL_ERROR "runner_state ${CASE}: no frame ${n} line in:\n${run_out}")
  endif()
  set(${var} "${line}" PARENT_SCOPE)
endfunction()

function(expect_only_files dir)
  file(GLOB found RELATIVE "${dir}" "${dir}/*")
  list(SORT found)
  set(want ${ARGN})
  list(SORT want)
  if(NOT "${found}" STREQUAL "${want}")
    message(FATAL_ERROR "runner_state ${CASE}: ${dir} holds '${found}', wanted '${want}'")
  endif()
endfunction()

# Makes a state of ROM_PATH at frame 60 at ${WORK}/good.state.
function(make_state rom_path)
  run_runner(--rom "${rom_path}" --frames 60 --state-at-frame "60:${WORK}/good.state")
  expect_exit(0)
endfunction()

# A rejection: the mutated copy is refused with exit 5 and the named word.
function(expect_rejected mode word)
  make_state("${ROM}")
  execute_process(COMMAND "${MUTATE}" "${WORK}/good.state" "${WORK}/bad.state" ${mode}
    RESULT_VARIABLE mrc)
  if(NOT mrc EQUAL 0)
    message(FATAL_ERROR "runner_state ${CASE}: runner.state_mutate ${mode} failed")
  endif()
  run_runner(--rom "${ROM}" --load-state "${WORK}/bad.state" --frames 70)
  expect_exit(5)
  expect_err("nesturbator-run: cannot load state ${WORK}/bad.state (${word})")
endfunction()

if(CASE STREQUAL "roundtrip")
  # A run that saves at 60 and a run that loads it and continues agree on frame 120.
  run_runner(--rom "${ROM}" --frames 120 --state-at-frame "60:${WORK}/s60.state" --hash-frame 120)
  expect_exit(0)
  frame_line(120 straight)
  run_runner(--rom "${ROM}" --load-state "${WORK}/s60.state" --frames 120 --hash-frame 120)
  expect_exit(0)
  frame_line(120 resumed)
  if(NOT "${straight}" STREQUAL "${resumed}")
    message(FATAL_ERROR "runner_state roundtrip: '${straight}' differs from '${resumed}'")
  endif()
  expect_only_files("${WORK}" s60.state)
elseif(CASE STREQUAL "reject_game")
  run_runner(--rom "${OTHER_ROM}" --frames 60 --state-at-frame "60:${WORK}/other.state")
  expect_exit(0)
  run_runner(--rom "${ROM}" --load-state "${WORK}/other.state" --frames 70)
  expect_exit(5)
  expect_err("(wrong game)")
elseif(CASE STREQUAL "reject_size")
  expect_rejected(truncate "wrong length")
elseif(CASE STREQUAL "reject_checksum")
  expect_rejected(flip "damaged")
elseif(CASE STREQUAL "reject_format")
  expect_rejected(version "another format version")
elseif(CASE STREQUAL "reject_invalid")
  expect_rejected(invalid "invalid contents")
elseif(CASE STREQUAL "missing_file")
  run_runner(--rom "${ROM}" --load-state "${WORK}/absent.state" --frames 10)
  expect_exit(1)
  expect_err("cannot read state")
elseif(CASE STREQUAL "directory")
  file(MAKE_DIRECTORY "${WORK}/dir.state")
  run_runner(--rom "${ROM}" --load-state "${WORK}/dir.state" --frames 10)
  expect_exit(1)
  expect_err("cannot read state")
elseif(CASE STREQUAL "idempotent")
  # The same command twice replaces the file with identical bytes and leaves nothing else.
  run_runner(--rom "${ROM}" --frames 30 --state-at-frame "30:${WORK}/a.state")
  expect_exit(0)
  file(READ "${WORK}/a.state" first HEX)
  run_runner(--rom "${ROM}" --frames 30 --state-at-frame "30:${WORK}/a.state")
  expect_exit(0)
  file(READ "${WORK}/a.state" second HEX)
  if(NOT "${first}" STREQUAL "${second}")
    message(FATAL_ERROR "runner_state idempotent: the two files differ")
  endif()
  expect_only_files("${WORK}" a.state)
elseif(CASE STREQUAL "save_dir")
  # A state's battery bytes reach the .sav at exit when --save-dir is given (Open Question 2).
  set(battery "${SAVE_FIXTURE}/battery.nes")
  file(MAKE_DIRECTORY "${WORK}/a" "${WORK}/b" "${WORK}/s")
  run_runner(--rom "${battery}" --frames 60 --save-dir "${WORK}/a"
    --state-at-frame "60:${WORK}/s/battery.state")
  expect_exit(0)
  run_runner(--rom "${battery}" --load-state "${WORK}/s/battery.state" --frames 61
    --save-dir "${WORK}/b")
  expect_exit(0)
  file(READ "${WORK}/a/battery.sav" sav_a HEX)
  file(READ "${WORK}/b/battery.sav" sav_b HEX)
  string(SUBSTRING "${sav_a}" 0 10 magic)
  if(NOT "${magic}" STREQUAL "5341564500")
    message(FATAL_ERROR "runner_state save_dir: run A's save lacks the marker (${magic})")
  endif()
  if(NOT "${sav_a}" STREQUAL "${sav_b}")
    message(FATAL_ERROR "runner_state save_dir: run B's .sav differs from run A's")
  endif()
else()
  message(FATAL_ERROR "runner_state: unknown case ${CASE}")
endif()
