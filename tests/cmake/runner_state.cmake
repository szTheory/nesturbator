# The runner.state.* cases: nesturbator-run with --state-at-frame and --load-state.
#
#   cmake -DRUNNER=<nesturbator-run> -DMUTATE=<runner.state_mutate> -DROM=<dabg.nes>
#         -DOTHER_ROM=<another game> -DSAVE_FIXTURE=<runner.save_rom output dir>
#         -DWORK=<scratch dir, recreated> -DCASE=<case> [-DHASHES=<tests/runner/hashes.txt>]
#         -P runner_state.cmake

cmake_minimum_required(VERSION 3.25)

foreach(var RUNNER MUTATE ROM OTHER_ROM SAVE_FIXTURE WORK CASE)
  if(NOT DEFINED ${var} OR "${${var}}" STREQUAL "")
    message(FATAL_ERROR "runner_state: -D${var}=... is required")
  endif()
endforeach()

file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")

# Runs the runner with ARGN; sets run_exit, run_out and run_err in the caller.
function(run_runner)
  execute_process(COMMAND "${RUNNER}" ${ARGN}
    OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE rc)
  string(REPLACE "\r" "" out "${out}")
  string(REPLACE "\r" "" err "${err}")
  set(run_exit "${rc}" PARENT_SCOPE)
  set(run_out "${out}" PARENT_SCOPE)
  set(run_err "${err}" PARENT_SCOPE)
endfunction()

function(expect_exit want)
  if(NOT "${run_exit}" STREQUAL "${want}")
    message(FATAL_ERROR "runner_state ${CASE}: exit ${run_exit}, wanted ${want}\n${run_err}")
  endif()
endfunction()

function(expect_err text)
  string(FIND "${run_err}" "${text}" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "runner_state ${CASE}: stderr lacks '${text}':\n${run_err}")
  endif()
endfunction()

# The "frame N ..." line of the runner output.
function(frame_line n var)
  string(REGEX MATCH "frame ${n} ticks [0-9]+ sha256 [0-9a-f]+" line "${run_out}")
  if("${line}" STREQUAL "")
    message(FATAL_ERROR "runner_state ${CASE}: no frame ${n} line in:\n${run_out}")
  endif()
  set(${var} "${line}" PARENT_SCOPE)
endfunction()

# The "state N ticks T size S sha256 H" line: sets ${line} (whole line), ${hash} and ${size}.
function(state_line n line_var hash_var size_var)
  string(REGEX MATCH "state ${n} ticks [0-9]+ size ([0-9]+) sha256 ([0-9a-f]+)" line "${run_out}")
  if("${line}" STREQUAL "")
    message(FATAL_ERROR "runner_state ${CASE}: no state ${n} line in:\n${run_out}")
  endif()
  set(${line_var} "${line}" PARENT_SCOPE)
  set(${size_var} "${CMAKE_MATCH_1}" PARENT_SCOPE)
  set(${hash_var} "${CMAKE_MATCH_2}" PARENT_SCOPE)
endfunction()

function(expect_only_files dir)
  file(GLOB found RELATIVE "${dir}" "${dir}/*")
  list(SORT found)
  set(want ${ARGN})
  list(SORT want)
  if(NOT "${found}" STREQUAL "${want}")
    message(FATAL_ERROR "runner_state ${CASE}: ${dir} holds '${found}', wanted '${want}'")
  endif()
endfunction()

function(fixture_run)
  execute_process(COMMAND "${NMI_FIXTURE}" ${ARGN}
    OUTPUT_VARIABLE out ERROR_VARIABLE err RESULT_VARIABLE rc)
  string(REPLACE "\r" "" out "${out}")
  string(REPLACE "\r" "" err "${err}")
  set(fixture_exit "${rc}" PARENT_SCOPE)
  set(fixture_out "${out}" PARENT_SCOPE)
  set(fixture_err "${err}" PARENT_SCOPE)
endfunction()

function(audio_lines var)
  string(REGEX MATCH "audio transitions sha256 [0-9a-f]+\naudio pcm sha256 [0-9a-f]+" lines "${run_out}")
  if("${lines}" STREQUAL "")
    message(FATAL_ERROR "runner_state ${CASE}: audio hashes missing from:\n${run_out}")
  endif()
  set(${var} "${lines}" PARENT_SCOPE)
endfunction()

function(expect_marker_failure expected)
  fixture_run(verify "${WORK}/nmi.nes" "${WORK}/bad.state" "${expected}")
  if(NOT "${fixture_exit}" STREQUAL "9" OR
     NOT "${fixture_err}" MATCHES "guest NMI marker mismatch: expected ${expected}")
    message(FATAL_ERROR "runner_state ${CASE}: wrong-load control did not fail on its guest marker (exit ${fixture_exit})\n${fixture_out}${fixture_err}")
  endif()
endfunction()

# Makes a state of ROM_PATH at frame 60 at ${WORK}/good.state.
function(make_state rom_path)
  run_runner(--rom "${rom_path}" --frames 60 --state-at-frame "60:${WORK}/good.state")
  expect_exit(0)
endfunction()

# A rejection: the mutated copy is refused with exit 5 and the named word.
function(expect_rejected mode word)
  make_state("${ROM}")
  execute_process(COMMAND "${MUTATE}" "${WORK}/good.state" "${WORK}/bad.state" ${mode}
    RESULT_VARIABLE mrc)
  if(NOT mrc EQUAL 0)
    message(FATAL_ERROR "runner_state ${CASE}: runner.state_mutate ${mode} failed")
  endif()
  run_runner(--rom "${ROM}" --load-state "${WORK}/bad.state" --frames 70)
  expect_exit(5)
  expect_err("nesturbator-run: cannot load state ${WORK}/bad.state (${word})")
endfunction()

if(CASE STREQUAL "roundtrip")
  # A run that saves at 60 and a run that loads it and continues agree on frame 120.
  run_runner(--rom "${ROM}" --frames 120 --state-at-frame "60:${WORK}/s60.state" --hash-frame 120)
  expect_exit(0)
  frame_line(120 straight)
  run_runner(--rom "${ROM}" --load-state "${WORK}/s60.state" --frames 120 --hash-frame 120)
  expect_exit(0)
  frame_line(120 resumed)
  if(NOT "${straight}" STREQUAL "${resumed}")
    message(FATAL_ERROR "runner_state roundtrip: '${straight}' differs from '${resumed}'")
  endif()
  expect_only_files("${WORK}" s60.state)
elseif(CASE STREQUAL "reject_game")
  run_runner(--rom "${OTHER_ROM}" --frames 60 --state-at-frame "60:${WORK}/other.state")
  expect_exit(0)
  run_runner(--rom "${ROM}" --load-state "${WORK}/other.state" --frames 70)
  expect_exit(5)
  expect_err("(wrong game)")
elseif(CASE STREQUAL "reject_size")
  expect_rejected(truncate "wrong length")
elseif(CASE STREQUAL "reject_checksum")
  expect_rejected(flip "damaged")
elseif(CASE STREQUAL "reject_format")
  expect_rejected(version "another format version")
elseif(CASE STREQUAL "reject_invalid")
  expect_rejected(invalid "invalid contents")
elseif(CASE STREQUAL "missing_file")
  run_runner(--rom "${ROM}" --load-state "${WORK}/absent.state" --frames 10)
  expect_exit(1)
  expect_err("cannot read state")
elseif(CASE STREQUAL "directory")
  file(MAKE_DIRECTORY "${WORK}/dir.state")
  run_runner(--rom "${ROM}" --load-state "${WORK}/dir.state" --frames 10)
  expect_exit(1)
  expect_err("cannot read state")
elseif(CASE STREQUAL "idempotent")
  # The same command twice replaces the file with identical bytes and leaves nothing else.
  run_runner(--rom "${ROM}" --frames 30 --state-at-frame "30:${WORK}/a.state")
  expect_exit(0)
  file(READ "${WORK}/a.state" first HEX)
  run_runner(--rom "${ROM}" --frames 30 --state-at-frame "30:${WORK}/a.state")
  expect_exit(0)
  file(READ "${WORK}/a.state" second HEX)
  if(NOT "${first}" STREQUAL "${second}")
    message(FATAL_ERROR "runner_state idempotent: the two files differ")
  endif()
  expect_only_files("${WORK}" a.state)
elseif(CASE STREQUAL "save_dir")
  # A state's battery bytes reach the .sav at exit when --save-dir is given (Open Question 2).
  set(battery "${SAVE_FIXTURE}/battery.nes")
  file(MAKE_DIRECTORY "${WORK}/a" "${WORK}/b" "${WORK}/s")
  run_runner(--rom "${battery}" --frames 60 --save-dir "${WORK}/a"
    --state-at-frame "60:${WORK}/s/battery.state")
  expect_exit(0)
  run_runner(--rom "${battery}" --load-state "${WORK}/s/battery.state" --frames 61
    --save-dir "${WORK}/b")
  expect_exit(0)
  file(READ "${WORK}/a/battery.sav" sav_a HEX)
  file(READ "${WORK}/b/battery.sav" sav_b HEX)
  string(SUBSTRING "${sav_a}" 0 10 magic)
  if(NOT "${magic}" STREQUAL "5341564500")
    message(FATAL_ERROR "runner_state save_dir: run A's save lacks the marker (${magic})")
  endif()
  if(NOT "${sav_a}" STREQUAL "${sav_b}")
    message(FATAL_ERROR "runner_state save_dir: run B's .sav differs from run A's")
  endif()
elseif(CASE STREQUAL "frame0")
  # The power-on state: the printed hash and size describe the file that is written.
  run_runner(--rom "${ROM}" --frames 1 --state-at-frame "0:${WORK}/s0.state" --hash-state 0)
  expect_exit(0)
  state_line(0 line hash size)
  file(SHA256 "${WORK}/s0.state" file_hash)
  file(SIZE "${WORK}/s0.state" file_size)
  if(NOT "${hash}" STREQUAL "${file_hash}" OR NOT "${size}" STREQUAL "${file_size}")
    message(FATAL_ERROR "runner_state frame0: '${line}' does not describe the file (${file_size} bytes, ${file_hash})")
  endif()
  string(FIND "${line}" "state 0 ticks 0 " pos)
  if(NOT pos EQUAL 0)
    message(FATAL_ERROR "runner_state frame0: power-on ticks are not 0: '${line}'")
  endif()
elseif(CASE STREQUAL "same_k")
  # N equals the loaded state's frame: the line hashes the state just loaded.
  make_state("${ROM}")
  file(SHA256 "${WORK}/good.state" file_hash)
  run_runner(--rom "${ROM}" --load-state "${WORK}/good.state" --frames 60 --hash-state 60)
  expect_exit(0)
  state_line(60 line hash size)
  if(NOT "${hash}" STREQUAL "${file_hash}")
    message(FATAL_ERROR "runner_state same_k: '${line}' differs from the file's ${file_hash}")
  endif()
elseif(CASE STREQUAL "continue_hash")
  run_runner(--rom "${ROM}" --frames 120 --state-at-frame "60:${WORK}/s60.state" --hash-state 120)
  expect_exit(0)
  state_line(120 straight hash size)
  run_runner(--rom "${ROM}" --load-state "${WORK}/s60.state" --frames 120 --hash-state 120)
  expect_exit(0)
  state_line(120 resumed hash size)
  if(NOT "${straight}" STREQUAL "${resumed}")
    message(FATAL_ERROR "runner_state continue_hash: '${straight}' differs from '${resumed}'")
  endif()
elseif(CASE STREQUAL "nmi_roundtrip")
  if(NOT DEFINED NMI_FIXTURE OR "${NMI_FIXTURE}" STREQUAL "")
    message(FATAL_ERROR "runner_state nmi_roundtrip: -DNMI_FIXTURE=<helper> is required")
  endif()
  fixture_run(write "${WORK}/nmi.nes")
  if(NOT "${fixture_exit}" STREQUAL "0")
    message(FATAL_ERROR "runner_state nmi_roundtrip: could not generate NROM fixture: ${fixture_err}")
  endif()
  run_runner(--rom "${WORK}/nmi.nes" --frames 4
    --state-at-frame "0:${WORK}/frame0.state" --state-at-frame "1:${WORK}/frame1.state"
    --state-at-frame "4:${WORK}/straight.state" --hash-frame 4 --hash-state 4 --hash-audio)
  expect_exit(0)
  frame_line(4 straight_frame)
  state_line(4 straight_state straight_state_hash straight_state_size)
  fixture_run(verify "${WORK}/nmi.nes" "${WORK}/frame0.state" 0)
  if(NOT "${fixture_exit}" STREQUAL "0")
    message(FATAL_ERROR "runner_state nmi_roundtrip: frame-0 marker failed: ${fixture_err}")
  endif()
  fixture_run(verify "${WORK}/nmi.nes" "${WORK}/frame1.state" 1)
  if(NOT "${fixture_exit}" STREQUAL "0")
    message(FATAL_ERROR "runner_state nmi_roundtrip: first NMI marker failed: ${fixture_err}")
  endif()
  fixture_run(verify "${WORK}/nmi.nes" "${WORK}/straight.state" 4)
  if(NOT "${fixture_exit}" STREQUAL "0")
    message(FATAL_ERROR "runner_state nmi_roundtrip: final guest event sequence failed: ${fixture_err}")
  endif()
  run_runner(--rom "${WORK}/nmi.nes" --load-state "${WORK}/frame1.state" --frames 4
    --state-at-frame "4:${WORK}/resumed.state" --hash-frame 4 --hash-state 4 --hash-audio)
  expect_exit(0)
  frame_line(4 resumed_frame)
  state_line(4 resumed_state resumed_state_hash resumed_state_size)
  if(NOT "${straight_frame}" STREQUAL "${resumed_frame}" OR
     NOT "${straight_state}" STREQUAL "${resumed_state}")
    message(FATAL_ERROR "runner_state nmi_roundtrip: final frame or state differs\n${straight_frame}\n${resumed_frame}\n${straight_state}\n${resumed_state}")
  endif()
  file(SHA256 "${WORK}/straight.state" straight_file_hash)
  file(SHA256 "${WORK}/resumed.state" resumed_file_hash)
  if(NOT "${straight_file_hash}" STREQUAL "${resumed_file_hash}")
    message(FATAL_ERROR "runner_state nmi_roundtrip: serialized final bytes differ")
  endif()
  fixture_run(reference "${WORK}/nmi.nes" 2 4)
  if(NOT "${fixture_exit}" STREQUAL "0")
    message(FATAL_ERROR "runner_state nmi_roundtrip: independent suffix reference failed: ${fixture_err}")
  endif()
  set(run_out "${fixture_out}")
  frame_line(4 reference_frame)
  audio_lines(reference_audio)
  set(run_out "${run_out}")
  run_runner(--rom "${WORK}/nmi.nes" --load-state "${WORK}/frame1.state" --frames 4 --hash-frame 4 --hash-audio)
  expect_exit(0)
  frame_line(4 replay_frame)
  audio_lines(replay_audio)
  if(NOT "${reference_frame}" STREQUAL "${replay_frame}" OR
     NOT "${reference_audio}" STREQUAL "${replay_audio}")
    message(FATAL_ERROR "runner_state nmi_roundtrip: resumed native output or same-suffix audio differs\n${reference_frame}\n${replay_frame}\n${reference_audio}\n${replay_audio}")
  endif()
elseif(CASE STREQUAL "nmi_idempotent")
  fixture_run(write "${WORK}/nmi.nes")
  if(NOT "${fixture_exit}" STREQUAL "0")
    message(FATAL_ERROR "runner_state nmi_idempotent: could not generate NROM fixture: ${fixture_err}")
  endif()
  run_runner(--rom "${WORK}/nmi.nes" --frames 2 --state-at-frame "2:${WORK}/a.state")
  expect_exit(0)
  fixture_run(verify "${WORK}/nmi.nes" "${WORK}/a.state" 2)
  if(NOT "${fixture_exit}" STREQUAL "0")
    message(FATAL_ERROR "runner_state nmi_idempotent: first event sequence failed: ${fixture_err}")
  endif()
  file(READ "${WORK}/a.state" first HEX)
  run_runner(--rom "${WORK}/nmi.nes" --frames 2 --state-at-frame "2:${WORK}/a.state")
  expect_exit(0)
  file(READ "${WORK}/a.state" second HEX)
  if(NOT "${first}" STREQUAL "${second}")
    message(FATAL_ERROR "runner_state nmi_idempotent: repeated NMI state bytes differ")
  endif()
  expect_only_files("${WORK}" a.state nmi.nes)
elseif(CASE STREQUAL "nmi_wrong_load")
  fixture_run(write "${WORK}/nmi.nes")
  if(NOT "${fixture_exit}" STREQUAL "0")
    message(FATAL_ERROR "runner_state nmi_wrong_load: could not generate NROM fixture: ${fixture_err}")
  endif()
  run_runner(--rom "${WORK}/nmi.nes" --frames 3 --state-at-frame "3:${WORK}/expected.state")
  expect_exit(0)
  fixture_run(verify "${WORK}/nmi.nes" "${WORK}/expected.state" 3)
  if(NOT "${fixture_exit}" STREQUAL "0")
    message(FATAL_ERROR "runner_state nmi_wrong_load: expected state is invalid: ${fixture_err}")
  endif()
  run_runner(--rom "${WORK}/nmi.nes" --frames 1 --state-at-frame "1:${WORK}/stale.state")
  expect_exit(0)
  fixture_run(verify "${WORK}/nmi.nes" "${WORK}/stale.state" 1)
  if(NOT "${fixture_exit}" STREQUAL "0")
    message(FATAL_ERROR "runner_state nmi_wrong_load: valid stale checkpoint failed: ${fixture_err}")
  endif()
  run_runner(--rom "${WORK}/nmi.nes" --load-state "${WORK}/stale.state" --frames 2
    --state-at-frame "2:${WORK}/bad.state")
  expect_exit(0)
  fixture_run(verify "${WORK}/nmi.nes" "${WORK}/bad.state" 2)
  if(NOT "${fixture_exit}" STREQUAL "0")
    message(FATAL_ERROR "runner_state nmi_wrong_load: stale continuation did not finish normally: ${fixture_err}")
  endif()
  expect_marker_failure(3)
  run_runner(--rom "${WORK}/nmi.nes" --frames 2 --state-at-frame "2:${WORK}/omitted.state")
  expect_exit(0)
  fixture_run(verify "${WORK}/nmi.nes" "${WORK}/omitted.state" 2)
  if(NOT "${fixture_exit}" STREQUAL "0")
    message(FATAL_ERROR "runner_state nmi_wrong_load: omitted-load run did not finish normally: ${fixture_err}")
  endif()
  execute_process(COMMAND "${NMI_FIXTURE}" verify "${WORK}/nmi.nes" "${WORK}/omitted.state" 3
    OUTPUT_VARIABLE wrong_out ERROR_VARIABLE wrong_err RESULT_VARIABLE wrong_rc)
  if(NOT "${wrong_rc}" STREQUAL "9" OR
     NOT "${wrong_err}" MATCHES "guest NMI marker mismatch: expected 3")
    message(FATAL_ERROR "runner_state ${CASE}: omitted-load control did not fail on its marker (exit ${wrong_rc})\n${wrong_out}${wrong_err}")
  endif()
elseif(CASE STREQUAL "range_frames")
  make_state("${ROM}")
  run_runner(--rom "${ROM}" --load-state "${WORK}/good.state" --frames 59)
  expect_exit(2)
  expect_err("--frames 59 is before the loaded state's frame 60")
elseif(CASE STREQUAL "range_hash_frame")
  make_state("${ROM}")
  run_runner(--rom "${ROM}" --load-state "${WORK}/good.state" --frames 70 --hash-frame 60)
  expect_exit(2)
  expect_err("frame 60")
  # 61 is the first frame a resumed run computes.
  run_runner(--rom "${ROM}" --load-state "${WORK}/good.state" --frames 70 --hash-frame 61)
  expect_exit(0)
elseif(CASE STREQUAL "range_state")
  make_state("${ROM}")
  run_runner(--rom "${ROM}" --load-state "${WORK}/good.state" --frames 70 --hash-state 59)
  expect_exit(2)
  expect_err("frame 60")
  run_runner(--rom "${ROM}" --load-state "${WORK}/good.state" --frames 70
    --state-at-frame "59:${WORK}/x.state")
  expect_exit(2)
  expect_err("frame 60")
  run_runner(--rom "${ROM}" --load-state "${WORK}/good.state" --frames 70 --hash-state 71)
  expect_exit(2)
elseif(CASE STREQUAL "every_frame")
  # STATE-03: saving a state after every frame from 0 to 180 changes no pinned hash.
  if(NOT DEFINED HASHES OR "${HASHES}" STREQUAL "")
    message(FATAL_ERROR "runner_state every_frame: -DHASHES=<hashes.txt> is required")
  endif()
  set(state_args)
  foreach(n RANGE 0 180)
    list(APPEND state_args --hash-state ${n})
  endforeach()
  run_runner(--rom "${ROM}" --frames 180
    --hash-frame 1 --hash-frame 30 --hash-frame 60 --hash-frame 120 --hash-frame 180
    ${state_args})
  expect_exit(0)
  foreach(n IN ITEMS 1 30 60 120 180)
    frame_line(${n} line)
    file(STRINGS "${HASHES}" pinned REGEX "^dabg/boot/frame ${n} ticks ")
    list(LENGTH pinned pinned_count)
    if(NOT pinned_count EQUAL 1)
      message(FATAL_ERROR "runner_state every_frame: ${pinned_count} pinned rows for dabg frame ${n}")
    endif()
    if(NOT "dabg/boot/${line}" STREQUAL "${pinned}")
      message(FATAL_ERROR "runner_state every_frame: '${line}' differs from the pinned '${pinned}'")
    endif()
  endforeach()
  # One state line per N, none missing.
  string(REGEX MATCHALL "(^|\n)state [0-9]+ ticks" state_matches "${run_out}")
  list(LENGTH state_matches state_count)
  if(NOT state_count EQUAL 181)
    message(FATAL_ERROR "runner_state every_frame: ${state_count} state lines; expected 181")
  endif()
else()
  message(FATAL_ERROR "runner_state: unknown case ${CASE}")
endif()
