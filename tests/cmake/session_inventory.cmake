cmake_minimum_required(VERSION 3.25)

# Exercise the registered inventory, including CTest's real label exclusion.
set(expected retroarch.session.source_root retroarch.session.controls retroarch.session.readiness)
if(SHORT_RUNS)
  set(expected)
endif()
foreach(mode full filtered)
  set(filter)
  if(mode STREQUAL filtered)
    set(filter -LE "^retroarch-session$")
  endif()
  execute_process(COMMAND "${CTEST}" --test-dir "${BUILD}" --show-only=json-v1 ${filter}
    RESULT_VARIABLE status OUTPUT_VARIABLE inventory ERROR_VARIABLE error)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "cannot read ${mode} CTest inventory: ${error}")
  endif()
  string(JSON count LENGTH "${inventory}" tests)
  math(EXPR last "${count} - 1")
  set(actual)
  foreach(index RANGE 0 ${last})
    string(JSON name GET "${inventory}" tests ${index} name)
    if(name MATCHES "^retroarch[.]session[.]")
      list(APPEND actual "${name}")
    endif()
  endforeach()
  if(mode STREQUAL filtered)
    if(actual)
      message(FATAL_ERROR "hosted session exclusion still selects: ${actual}")
    endif()
  else()
    list(SORT actual)
    list(SORT expected)
    if(NOT "${actual}" STREQUAL "${expected}")
      message(FATAL_ERROR "session registration mismatch: ${actual}; expected ${expected}")
    endif()
  endif()
endforeach()
message(STATUS "session inventory: full/short registration and hosted exclusion passed")
